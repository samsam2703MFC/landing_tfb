---
/**
 * Le carrousel du catalogue, en tête de fiche module.
 *
 * Il remplace la grille « les autres modules » qui vivait en bas de page :
 * un visiteur qui compare deux modules ne devait pas avoir à redescendre
 * tout l'écran entre chaque. Ici la navigation reste sous les yeux, et la
 * fiche du module choisi se lit juste en dessous.
 *
 * Le module courant est amené au centre au chargement — c'est la seule
 * chose que le CSS ne sait pas faire pour un conteneur qui défile, et le
 * repli sans JavaScript reste correct : la bande est simplement défilable
 * à la main, avec le module courant marqué.
 */
import Icone from './Icone.astro';
import Pastille from './Pastille.astro';
import { leviersDe } from '../lib/leviers.mjs';
import { lien } from '../lib/lien.mjs';

const { modules = [], actif, t } = Astro.props;

const rang = modules.findIndex((m) => m.slug === actif);
const precedent = rang > 0 ? modules[rang - 1] : modules[modules.length - 1];
const suivant = rang >= 0 && rang < modules.length - 1 ? modules[rang + 1] : modules[0];
---

<section class="carrousel" aria-label={t('module.carrousel')}>
  <div class="dedans carrousel__dedans">
    <div class="carrousel__tete">
      <span class="oeil">{t('module.carrousel')}</span>
      <span class="carrousel__rang fb-num">{rang + 1} / {modules.length}</span>
      <span class="carrousel__fleches">
        <a
          class="carrousel__fleche"
          href={lien(`/modules/${precedent.slug}`)}
          title={`${t('module.precedent')} — ${precedent.nom || precedent.slug}`}
          aria-label={t('module.precedent')}
        ><Icone nom="chevron-left" taille={16} classe="icone--miroir" /></a>
        <a
          class="carrousel__fleche"
          href={lien(`/modules/${suivant.slug}`)}
          title={`${t('module.suivant')} — ${suivant.nom || suivant.slug}`}
          aria-label={t('module.suivant')}
        ><Icone nom="chevron-right" taille={16} classe="icone--miroir" /></a>
      </span>
    </div>

    <ul class="carrousel__bande" role="list" data-carrousel>
      {modules.map((m) => {
        const ici = m.slug === actif;
        return (
          <li class="carrousel__case">
            <a
              class={`vignette ${ici ? 'vignette--ici' : ''}`}
              href={lien(`/modules/${m.slug}`)}
              aria-current={ici ? 'page' : undefined}
              data-ici={ici ? '' : undefined}
            >
              <span class="vignette__tete">
                <span class="vignette__icone"><Icone nom={m.icone || m.fonctions?.[0]?.icone || 'layers'} taille={18} /></span>
                <span class="vignette__noms">
                  <span class="vignette__nom">{m.nom || m.slug}</span>
                  <span class="vignette__groupe">{m.groupe}</span>
                </span>
              </span>
              <span class="vignette__pied">
                <span class="pastilles">{leviersDe(m.leviers).map((l) => <Pastille levier={l} />)}</span>
                <span class="vignette__compte fb-num">
                  {t('module.compte_fonctions', { n: (m.fonctions || []).length })}
                </span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
    <p class="carrousel__aide">{t('module.carrousel.aide')}</p>
  </div>
</section>

<script is:inline>
  (function () {
    var bande = document.querySelector('[data-carrousel]');
    var ici = bande && bande.querySelector('[data-ici]');
    if (!ici) return;
    // Centrage immédiat, sans animation : la page ne doit pas donner
    // l'impression de bouger toute seule au chargement. On mesure l'écart
    // réel entre les deux centres — `offsetLeft` se compte depuis un tout
    // autre repère et décalerait la bande.
    var cadre = bande.getBoundingClientRect();
    var vue = ici.getBoundingClientRect();
    bande.scrollLeft += vue.left + vue.width / 2 - (cadre.left + cadre.width / 2);
  })();
</script>

<style is:global>
  .carrousel {
    background: #fff;
    border-block-end: 1px solid var(--slate-200);
    padding: 18px 40px 16px;
  }
  .carrousel__dedans { display: flex; flex-direction: column; gap: 10px; }
  .carrousel__tete { display: flex; align-items: center; gap: 12px; }
  .carrousel__rang { font-size: var(--text-xs); color: var(--slate-400); }
  .carrousel__fleches { margin-inline-start: auto; display: flex; gap: 6px; }
  .carrousel__fleche {
    display: inline-flex; align-items: center; justify-content: center;
    inline-size: 30px; block-size: 30px;
    border: 1px solid var(--slate-200); border-radius: var(--radius-control);
    color: var(--slate-600); text-decoration: none;
    transition: var(--transition-control);
  }
  .carrousel__fleche:hover { background: var(--slate-50); border-color: var(--slate-300); color: var(--navy-900); }

  /* La bande défile horizontalement et s'aimante : le module choisi vient
     se caler au centre, qu'on y arrive au clic, au doigt ou à la flèche. */
  .carrousel__bande {
    list-style: none; margin: 0; padding: 2px 0 8px;
    display: flex; gap: 10px;
    overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-behavior: auto;
    scrollbar-width: thin;
  }
  .carrousel__case { scroll-snap-align: center; flex: none; }

  .vignette {
    display: flex; flex-direction: column; gap: 10px; justify-content: space-between;
    inline-size: 15rem; block-size: 100%;
    padding: 12px 14px;
    border: 1px solid var(--slate-200); border-radius: var(--radius-card);
    background: #fff; color: inherit; text-decoration: none;
    transition: var(--transition-control);
  }
  .vignette:hover { border-color: var(--plum-300); box-shadow: var(--shadow-sm); text-decoration: none; }
  /* Le module de la fiche : encre pleine, pour qu'on sache d'un coup d'œil
     où l'on est dans le catalogue. */
  .vignette--ici {
    background: var(--gradient-ink); border-color: transparent; color: #fff;
    box-shadow: var(--shadow-md);
  }
  .vignette--ici:hover { border-color: transparent; }

  .vignette__tete { display: flex; align-items: center; gap: 10px; min-inline-size: 0; }
  .vignette__icone {
    display: inline-flex; align-items: center; justify-content: center;
    inline-size: 32px; block-size: 32px; border-radius: var(--radius-sm);
    background: var(--brand-subtle); color: var(--brand-hover); flex: none;
  }
  .vignette--ici .vignette__icone { background: rgba(255, 255, 255, 0.12); color: #fff; }
  .vignette__noms { display: flex; flex-direction: column; gap: 1px; min-inline-size: 0; }
  .vignette__nom {
    font: 600 var(--text-sm) / 1.25 var(--font-display);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .vignette__groupe { font: 400 11px/1.3 var(--font-sans); color: var(--slate-400); }
  .vignette--ici .vignette__groupe { color: rgba(255, 255, 255, 0.6); }
  .vignette__pied { display: flex; align-items: center; gap: 8px; }
  .vignette__compte { margin-inline-start: auto; font-size: 11px; color: var(--slate-400); }
  .vignette--ici .vignette__compte { color: rgba(255, 255, 255, 0.6); }

  .carrousel__aide { margin: 0; font: 400 var(--text-xs) / 1.4 var(--font-sans); color: var(--slate-400); }

  @media (max-width: 820px) {
    .carrousel { padding: 14px 20px 12px; }
    .vignette { inline-size: 13rem; }
    /* Au doigt, 30 px se rate : les flèches sont la seule façon de passer au
       module suivant sans faire défiler la bande. */
    .carrousel__fleche { inline-size: 38px; block-size: 38px; }
  }
</style>
