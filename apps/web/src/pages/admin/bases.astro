---
/**
 * Les bases de données des clients.
 *
 * Chaque client a la sienne, de structure identique aux autres. C'est ce qui
 * isole un client d'un autre : pas un filtre dans une requête, la connexion
 * elle-même.
 *
 * L'écran ne remontre jamais un mot de passe. Il en affiche les quatre derniers
 * caractères — assez pour reconnaître celui qu'on a saisi, inutile à qui lit
 * par-dessus l'épaule. Le laisser vide au réenregistrement conserve l'ancien.
 */
import Console from '../../components/Console.astro';
import Icone from '../../components/Icone.astro';
import { lien } from '../../lib/lien.mjs';
import { compteurs, listerProspects } from '../../lib/admin/donnees.mjs';
import {
  CHAMPS_BASE, dejaPrise, enregistrerBase, listerBases, motDePasseEnregistre,
  sonderServeur, supprimerBase, testerBase,
} from '../../lib/donnees/bases.mjs';
import { coffreOuvert } from '../../lib/onboarding/coffre.mjs';

let message = null;
let souci = null;
/** Ce que le serveur a répondu quand on lui a demandé ses bases. */
let sondage = null;
/** Le formulaire à réafficher après un sondage, pour ne pas retaper. */
let saisie = null;

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const action = String(f.get('action') || 'enregistrer');
  const prospectId = Number(f.get('prospect_id'));

  if (action === 'sonder') {
    saisie = Object.fromEntries(CHAMPS_BASE.map((c) => [c.nom, String(f.get(c.nom) || '')]));
    // Le mot de passe déjà enregistré évite de le retaper pour resonder. Il
    // reste dans cette fonction : il ne repart jamais vers l'écran.
    const motDePasse = String(f.get('mot_de_passe') || '').trim() || await motDePasseEnregistre(prospectId);
    sondage = await sonderServeur({ ...saisie, motDePasse });
    if (!sondage.ok) souci = sondage.dit;
    else if (sondage.bases.length === 0) message = 'Connexion établie, mais ce compte ne voit aucune base — vérifiez ses droits.';
    else message = `${sondage.bases.length} base(s) visible(s) par ce compte.`;
  } else if (action === 'tester') {
    const r = await testerBase(prospectId);
    if (r.ok) message = `Connexion établie — ${r.detail.tables} table(s) dans « ${r.detail.base} ».`;
    else souci = r.dit;
  } else if (action === 'supprimer') {
    await supprimerBase(prospectId);
    message = 'Base retirée. Les ressources en portée « base client » ne répondront plus pour ce client.';
  } else {
    const valeurs = Object.fromEntries(CHAMPS_BASE.map((c) => [c.nom, f.get(c.nom)]));
    // Un champ laissé vide ne remplace pas le mot de passe enregistré : sans
    // cela, corriger un numéro de port effacerait l'accès à la base.
    const motDePasse = String(f.get('mot_de_passe') || '').trim() || null;
    const r = await enregistrerBase(prospectId, valeurs, motDePasse);
    if (r.ok) message = 'Base enregistrée. Testez la connexion avant de vous y fier.';
    else souci = r.erreur;
  }
}

const [chiffres, prospects, bases] = await Promise.all([compteurs(), listerProspects(), listerBases()]);
const parProspect = new Map(bases.map((b) => [b.prospectId, b]));
const coffre = coffreOuvert();
const ouvert = Number(Astro.url.searchParams.get('client') || 0);

// Après un sondage, l'écran réaffiche ce qui a été tapé ; sinon ce qui est
// enregistré. Sans ça, choisir une base dans la liste effacerait l'hôte.
const propose = Astro.url.searchParams.get('base');
const courant = (nom) => (saisie ? saisie[nom] : undefined)
  ?? (nom === 'base' && propose ? propose : undefined)
  ?? parProspect.get(ouvert)?.[nom]
  ?? (nom === 'port' ? 3306 : '');

// Deux clients sur la même base, c'est l'isolation supprimée sans que rien ne
// casse. Le dire au moment de choisir, pas après.
/** Ce que le sondage a trouvé, s'il a abouti. Vide sinon. */
const trouvees = sondage?.ok ? sondage.bases : [];

const conflits = ouvert > 0 && courant('hote') && courant('base')
  ? await dejaPrise(courant('hote'), courant('port'), courant('base'), ouvert)
  : [];
---

<Console titre="Bases clientes" actif="bases" compteurs={chiffres} message={message} erreur={souci}>
  <p class="intro">
    Chaque client a <strong>sa</strong> base, de structure identique aux autres. Une ressource du
    catalogue se déclare donc une fois et s'exécute chez n'importe lequel, sans jamais nommer le
    client dans le SQL — l'isolation est la connexion.
  </p>

  {!coffre && (
    <p class="cellule avert">
      <Icone nom="triangle-alert" taille={16} />
      <span>
        <strong>Coffre fermé.</strong> Aucun mot de passe ne peut être enregistré tant que
        <span class="mono"> SECRETS_CLE_1 </span> n'est pas posée sur le serveur. Fabriquez-en une
        avec <span class="mono">node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"</span>
        et rangez-la dans le fichier d'environnement, jamais dans le dépôt.
      </span>
    </p>
  )}

  <div class="cellule">
    <table>
      <thead>
        <tr><th>Client</th><th>Base</th><th>État</th><th>Dernier test</th><th></th></tr>
      </thead>
      <tbody>
        {prospects.map((p) => {
          const b = parProspect.get(Number(p.id));
          return (
            <tr>
              <td>{p.raison_sociale}</td>
              <td class="mono">
                {b ? `${b.hote}:${b.port}/${b.base}` : <span class="rien">aucune base déclarée</span>}
                {b?.motDePasseMasque && <span class="masque"> · {b.motDePasseMasque}</span>}
              </td>
              <td>
                {!b ? <span class="etat">—</span>
                  : b.statut === 'active' ? <span class="etat etat--ok">active</span>
                  : b.statut === 'erreur' ? <span class="etat etat--ko">erreur</span>
                  : <span class="etat">non testée</span>}
              </td>
              <td class="mono petit">
                {b?.dernierTestLe ? String(b.dernierTestLe).replace('T', ' ').slice(0, 16) : '—'}
                {b?.dernierTest?.dit && <div class="dit">{b.dernierTest.dit}</div>}
              </td>
              <td class="fin">
                {b && (
                  <form method="post" class="enligne">
                    <input type="hidden" name="action" value="tester" />
                    <input type="hidden" name="prospect_id" value={p.id} />
                    <button class="bouton bouton--sobre bouton--sm" type="submit">Tester</button>
                  </form>
                )}
                <a class="bouton bouton--sobre bouton--sm" href={lien(`/admin/bases?client=${p.id}`)}>
                  {b ? 'Modifier' : 'Déclarer'}
                </a>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  {ouvert > 0 && (
    <form method="post" class="cellule edition">
      <input type="hidden" name="prospect_id" value={ouvert} />
      <h3>{prospects.find((p) => Number(p.id) === ouvert)?.raison_sociale || `Client ${ouvert}`}</h3>

      <div class="grille">
        {CHAMPS_BASE.map((c) => (
          <label class="champ">
            <span>{c.libelle}</span>
            {c.nom === 'base' && trouvees.length > 0 ? (
              <>
                {/* Une liste plutôt qu'un champ libre dès qu'on sait ce que le
                    serveur contient : on ne devine pas un nom de base, et une
                    faute de frappe ici lie un client à rien du tout. */}
                <select name="base" required>
                  {trouvees.map((b) => (
                    <option value={b.nom} selected={b.nom === courant('base')}>
                      {b.nom}{b.tables > 0 ? ` — ${b.tables} table(s), ~${b.lignes.toLocaleString('fr-FR')} ligne(s)` : ' — vide'}
                    </option>
                  ))}
                </select>
                <em>{trouvees.length} base(s) vues par ce compte. Le contenu dit laquelle sert vraiment.</em>
              </>
            ) : (
              <>
                <input type={c.nom === 'port' ? 'number' : 'text'} name={c.nom}
                       value={courant(c.nom)}
                       required={c.nom === 'hote' || c.nom === 'base'} />
                {c.aide && <em>{c.aide}</em>}
                {c.nom === 'base' && (
                  <em>Ou cherchez-les sur le serveur ci-dessous pour choisir dans une liste.</em>
                )}
              </>
            )}
          </label>
        ))}
        <label class="champ">
          <span>Mot de passe</span>
          <input type="password" name="mot_de_passe" autocomplete="new-password"
                 placeholder={parProspect.get(ouvert) ? 'inchangé si vide' : ''} />
          <em>
            Chiffré par le coffre, jamais réaffiché. Le laisser vide conserve celui qui est
            enregistré.
          </em>
        </label>
      </div>

      {conflits.length > 0 && (
        <p class="conflit">
          <Icone nom="triangle-alert" taille={16} />
          <span>
            Cette base est déjà celle de <strong>{conflits.join(', ')}</strong>. Deux clients sur la
            même base, c'est l'isolation supprimée sans que rien ne casse : les écrans marchent, les
            requêtes répondent, et chacun lit les données de l'autre.
          </span>
        </p>
      )}

      <div class="pied">
        <button class="bouton bouton--sobre" type="submit" name="action" value="sonder" formnovalidate>
          <Icone nom="search" taille={15} /> Chercher les bases sur ce serveur
        </button>
        <button class="bouton bouton--marque" type="submit" disabled={!coffre && !parProspect.get(ouvert)}>
          <Icone nom="save" taille={15} /> Enregistrer
        </button>
        <a class="bouton bouton--sobre" href={lien('/admin/bases')}>Annuler</a>
        {parProspect.get(ouvert) && (
          <button class="bouton bouton--danger bouton--sm" type="submit" name="action" value="supprimer"
                  formnovalidate>
            Retirer cette base
          </button>
        )}
      </div>
    </form>
  )}

  <p class="note">
    Aucun identifiant ne figure dans le dépôt. Le mot de passe est chiffré par le même coffre que
    les secrets des caisses, et la clé vit dans l'environnement du serveur. Un dump de cette base ne
    donne rien d'exploitable sans elle.
  </p>

  <p class="note">
    Une ressource en portée « base client » ne retombe <strong>jamais</strong> sur la base de la
    console : sans base déclarée, l'appel échoue. C'est volontaire — une requête qui interrogerait
    la base d'administration par défaut rendrait les prospects et les offres de tout le monde, avec
    un SQL d'apparence irréprochable.
  </p>
</Console>

<style>
  .intro, .note { max-inline-size: 78ch; color: var(--slate-600); }
  .note { font-size: var(--text-sm); margin-block-start: var(--space-3); }
  .avert { display: flex; gap: 10px; align-items: flex-start; padding: 12px 16px; margin-block-end: var(--space-4); }
  table { inline-size: 100%; border-collapse: collapse; }
  th { text-align: start; font: 600 var(--text-xs) / 1.4 var(--font-sans); text-transform: uppercase;
       letter-spacing: .09em; color: var(--slate-500); padding: 10px 14px; }
  td { padding: 10px 14px; border-block-start: 1px solid var(--slate-200); font-size: var(--text-sm);
       vertical-align: top; }
  .rien { color: var(--slate-500); font-family: var(--font-sans); }
  .masque { color: var(--slate-500); }
  .petit { font-size: var(--text-xs); }
  .dit { color: var(--red-700, #931f35); margin-block-start: 3px; max-inline-size: 34ch; }
  .fin { text-align: end; white-space: nowrap; }
  .enligne { display: inline; }
  .etat { font: 600 var(--text-xs) / 1.5 var(--font-sans); padding: 2px 9px; border-radius: 999px;
          background: var(--slate-100); color: var(--slate-600); }
  .etat--ok { background: var(--green-100, #dbf1e6); color: var(--green-700, #0e5c41); }
  .etat--ko { background: var(--red-100, #fbe0e4); color: var(--red-700, #931f35); }
  .edition { padding: 16px; margin-block-start: var(--space-4); }
  .edition h3 { margin: 0 0 var(--space-3); }
  .grille { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-4); }
  .champ { display: flex; flex-direction: column; gap: 4px; }
  .champ > span { font: 500 var(--text-sm) / 1.3 var(--font-sans); }
  .champ input { inline-size: 100%; }
  .champ em { font-style: normal; font-size: var(--text-xs); color: var(--slate-500); }
  .pied { display: flex; gap: var(--space-3); align-items: center; margin-block-start: var(--space-4); }
  .mono { font-family: var(--font-mono); }
  .aide { color: var(--slate-600); font-size: var(--text-xs); max-inline-size: 78ch; margin-block-end: 8px; }
  .conflit { display: flex; gap: 10px; align-items: flex-start; padding: 11px 14px;
             border-radius: var(--radius-control); margin-block-start: var(--space-4);
             background: var(--amber-100, #fceed6); color: var(--amber-700, #8a5900);
             font-size: var(--text-sm); max-inline-size: 82ch; }
  .trouvees { display: flex; flex-direction: column; gap: 5px; margin-block-start: var(--space-4); }
  .trouvee { display: flex; align-items: baseline; gap: 12px; padding: 7px 12px;
             border: 1px solid var(--slate-200); border-radius: var(--radius-control);
             background: #fff; font-size: var(--text-sm); }
  .trouvee:hover { border-color: var(--plum-500, #7b4488); text-decoration: none; }
  .trouvee span { color: var(--slate-500); font-size: var(--text-xs); }
  .trouvee--choisie { border-color: var(--plum-500, #7b4488);
                      background: color-mix(in srgb, var(--plum-500, #7b4488) 7%, #fff); }
</style>
