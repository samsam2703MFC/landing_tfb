---
/**
 * Les connexions, tous clients confondus.
 *
 * L'écran de l'équipe technique : où ça coince, chez qui, depuis quand. La
 * colonne qui compte est la dernière synchronisation — une connexion « active »
 * qui n'a rien lu depuis trois jours ment sur son état, et le tableau de bord
 * du client affiche des chiffres simplement figés.
 */
import Console from '../../../components/Console.astro';
import Icone from '../../../components/Icone.astro';
import { compteurs } from '../../../lib/admin/donnees.mjs';
import { listerConnexions, testerConnexion } from '../../../lib/admin/onboarding.mjs';
import { listerTaches, synchroniser } from '../../../lib/admin/sync.mjs';

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
let erreur = null;

if (Astro.request.method === 'POST') {
  try {
    const f = await Astro.request.formData();
    const action = String(f.get('action') || '');
    const id = f.get('id');
    const qui = (Astro.locals.session || {}).id || null;
    let dit = '';
    if (action === 'tester') {
      const r = await testerConnexion(id, { utilisateurId: qui });
      dit = r.ok
        ? `Test réussi : ${r.detail.lignes} ligne(s) lue(s) sur 30 jours.`
        : `Test échoué : ${r.message}`;
    } else if (action === 'synchroniser') {
      const r = await synchroniser(id);
      dit = r.ok
        ? `${r.compteurs.inserees} ligne(s) écrite(s), ${r.compteurs.doublons} déjà connue(s).`
        : `Synchronisation interrompue : ${r.message}`;
    }
    return Astro.redirect(`${BASE}/admin/connexions?ok=${encodeURIComponent(dit)}`, 303);
  } catch (err) {
    erreur = err.message;
  }
}

let connexions = [];
let taches = [];
let chiffres = {};
try {
  connexions = await listerConnexions({});
  taches = await listerTaches();
  chiffres = await compteurs();
} catch (err) {
  // Pas de « base injoignable » systématique : ces écrans échouent pour
  // beaucoup de raisons — une clé qui ne se déchiffre plus, une caisse qui ne
  // répond pas — et coller la mauvaise cause fait chercher au mauvais endroit.
  erreur = erreur || err.message;
}

const parConnexion = new Map(taches.map((t) => [t.connexion_id, t]));
const filtre = Astro.url.searchParams.get('statut') || '';
const vues = filtre ? connexions.filter((c) => c.statut === filtre) : connexions;

/** Une connexion active qui n'a rien lu depuis deux fois sa fréquence ment. */
function endormie(c) {
  if (c.statut !== 'active' || !c.derniere_sync_le) return false;
  const tache = parConnexion.get(c.id);
  const heures = (Number(tache?.frequence_heures) || 24) * 2;
  return Date.now() - new Date(c.derniere_sync_le).getTime() > heures * 3600000;
}

const message = Astro.url.searchParams.get('ok');
const jourHeure = (v) => (v ? new Date(v).toLocaleString('fr-BE', { dateStyle: 'short', timeStyle: 'short' }) : '—');
---

<Console
  titre="Connexions"
  fil="TFB Admin · Onboarding · Connexions"
  actif="connexions"
  message={message}
  erreur={erreur}
  compteurs={chiffres}
>
  <section class="bloc" style="margin-block-end:20px">
    <div class="bloc__tete">
      <div>
        <h2>Filtrer</h2>
        <p>{connexions.length} connexion(s) · {connexions.filter(endormie).length} endormie(s).</p>
      </div>
    </div>
    <form method="get" class="filtres">
      <div class="champ">
        <label for="f-statut">État</label>
        <select id="f-statut" name="statut">
          <option value="">Tous</option>
          {['brouillon', 'test', 'active', 'erreur', 'pause'].map((s) => (
            <option value={s} selected={filtre === s}>{s}</option>
          ))}
        </select>
      </div>
      <div class="actions actions--case">
        <button class="bouton bouton--sobre" type="submit">Filtrer</button>
      </div>
    </form>
  </section>

  <section class="bloc">
    <div class="bloc__tete">
      <div>
        <h2>Toutes les caisses branchées</h2>
        <p>Un client peut en avoir plusieurs : un réseau qui a grandi par rachats n'a pas la même caisse partout.</p>
      </div>
      <a class="bouton bouton--sobre bouton--sm" href={`${BASE}/admin/connecteurs`}>
        <Icone nom="settings" taille={16} /> Connecteurs
      </a>
    </div>

    {vues.length === 0 ? (
      <div class="bloc__pied">Aucune connexion. Elles se créent depuis une mise en route.</div>
    ) : (
      <div class="roule">
        <table class="connexions">
          <thead>
            <tr>
              <th>Client</th><th>Groupe</th><th>Caisse</th><th>État</th>
              <th>Dernière synchro</th><th>Dernier souci</th><th></th>
            </tr>
          </thead>
          <tbody>
            {vues.map((c) => (
              <tr>
                <td><strong>{c.raison_sociale || '—'}</strong></td>
                <td>{c.libelle}</td>
                <td>{c.connecteur_nom}<code class="slug">{c.connecteur_cle}</code></td>
                <td>
                  <span class={c.statut === 'active' ? 'etat etat--on'
                    : c.statut === 'erreur' ? 'etat etat--manque' : 'etat'}>{c.statut}</span>
                  {endormie(c) && <span class="etat etat--manque">endormie</span>}
                </td>
                <td class="champ__aide fb-num">{jourHeure(c.derniere_sync_le)}</td>
                <td>
                  {c.dernier_test && !c.dernier_test.ok
                    ? <span class="etat etat--manque">{c.dernier_test.code}</span>
                    : <span class="champ__aide">—</span>}
                </td>
                <td>
                  <div class="actions">
                    <form method="post">
                      <input type="hidden" name="action" value="tester" />
                      <input type="hidden" name="id" value={c.id} />
                      <button class="bouton bouton--sobre bouton--sm" type="submit">Tester</button>
                    </form>
                    <form method="post">
                      <input type="hidden" name="action" value="synchroniser" />
                      <input type="hidden" name="id" value={c.id} />
                      <button class="bouton bouton--sobre bouton--sm" type="submit">Relancer</button>
                    </form>
                    <a class="bouton bouton--sobre bouton--sm"
                       href={`${BASE}/admin/onboarding/${c.prospect_id}/configuration?connexion=${c.id}`}>
                      Ouvrir
                    </a>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <div class="bloc__pied">
      « Endormie » veut dire : active, mais rien lu depuis deux fois sa fréquence. C'est le seul
      état vraiment dangereux — le client voit toujours des chiffres, ils sont simplement figés.
    </div>
  </section>
</Console>

<style is:global>
  .connexions { min-inline-size: 82rem; }
  .connexions td, .connexions th { white-space: nowrap; }
  .connexions .actions { flex-wrap: nowrap; }
</style>
