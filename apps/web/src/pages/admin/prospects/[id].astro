---
/**
 * Les coordonnées d'un client démarché.
 *
 * Elles sont partagées par toutes ses offres — corriger une faute de frappe
 * sur le numéro de TVA les corrige toutes, y compris celles déjà envoyées.
 * C'est voulu : un numéro de TVA faux reste faux, quel que soit le statut de
 * l'offre, et le client s'en apercevra à la facturation.
 *
 * Les montants, eux, ne bougent jamais après l'envoi — ce sont deux choses
 * différentes, et la page le dit.
 */
import OngletsClient from '../../../components/OngletsClient.astro';
import Console from '../../../components/Console.astro';
import Icone from '../../../components/Icone.astro';
import {
  CHAMPS_PROSPECT,
  ajouterPiece,
  chargerProspect,
  compteurs,
  enregistrerDossier,
  enregistrerProspect,
  listerOffres,
  listerPieces,
  noterViesProspect,
  supprimerPiece,
} from '../../../lib/admin/donnees.mjs';
import { cheminAutorise } from '../../../lib/admin/session.mjs';
import { serviceVies } from '../../../lib/onboarding/vies.mjs';
import {
  CHAMPS_DOSSIER,
  GROUPES_DOSSIER,
  TYPES_PIECE,
  dossierComplet,
} from '../../../lib/contrats/gabarit.mjs';

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
const { id } = Astro.params;
let erreur = null;

if (Astro.request.method === 'POST') {
  try {
    const f = await Astro.request.formData();
    const action = String(f.get('action') || 'coordonnees');
    let dit = 'Coordonnées enregistrées.';
    if (action === 'dossier') {
      await enregistrerDossier(id, Object.fromEntries(CHAMPS_DOSSIER.map((c) => [c.nom, f.get(c.nom)])));
      dit = 'Dossier enregistré.';
    } else if (action === 'piece') {
      await ajouterPiece(id, {
        type: f.get('type'),
        fichier: f.get('fichier'),
        deposePar: (Astro.locals.session || {}).id || null,
      });
      dit = 'Pièce déposée.';
    } else if (action === 'piece-suppression') {
      await supprimerPiece(f.get('piece_id'));
      dit = 'Pièce retirée.';
    } else if (action === 'vies') {
      // On enregistre d'abord les coordonnées : vérifier un numéro qu'on
      // vient de taper sans l'enregistrer vérifierait celui d'avant, et le
      // message porterait sur autre chose que ce qui est à l'écran.
      await enregistrerProspect(id, Object.fromEntries(CHAMPS_PROSPECT.map((c) => [c.nom, f.get(c.nom)])));
      const r = await serviceVies().verifier(f.get('tva'), f.get('pays'));
      if (!r.ok) throw new Error(r.message);
      // On ne recopie **jamais** le nom d'ici : la fiche d'un prospect porte
      // souvent un nom d'usage — « Le Pain Quotidien » plutôt que « LPQ
      // HOLDING SA » — et l'écraser sans le demander ferait perdre le nom que
      // le commercial emploie au téléphone. L'étape « Votre entreprise » du
      // parcours, elle, le propose avec une case à cocher.
      await noterViesProspect(id, r);
      dit = r.nom
        ? `TVA vérifiée auprès de VIES — le registre dit « ${r.nom} ».`
        : 'TVA vérifiée auprès de VIES : le numéro est valide. Cet État membre ne publie pas le nom.';
    } else {
      await enregistrerProspect(id, Object.fromEntries(CHAMPS_PROSPECT.map((c) => [c.nom, f.get(c.nom)])));
    }
    return Astro.redirect(`${BASE}/admin/prospects/${id}?ok=${encodeURIComponent(dit)}`, 303);
  } catch (err) {
    erreur = err.message;
  }
}

let prospect = null;
let offres = [];
let pieces = [];
let chiffres = {};
try {
  prospect = await chargerProspect(id);
  if (prospect) {
    offres = (await listerOffres()).filter((o) => o.prospect_id === prospect.id);
    pieces = await listerPieces(prospect.id);
  }
  chiffres = await compteurs();
} catch (err) {
  erreur = erreur || `Base injoignable : ${err.message}`;
}

/**
 * Son commercial.
 *
 * Il se lit sur les offres, jamais sur une colonne du prospect : une seconde
 * écriture du même fait finirait par contredire la première, et le jour venu
 * personne ne saurait laquelle paie. La plus récente offre à porter un auteur
 * donne celui qui suit le client aujourd'hui — c'est aussi la règle de la
 * liste, et les deux écrans doivent dire la même chose.
 */
const dateOffre = (o) => new Date(o.cree_le || 0).getTime() || 0;
const recentes = [...offres].sort((a, b) => dateOffre(b) - dateOffre(a));
const commercial = (recentes.find((o) => o.auteur_nom) || {}).auteur_nom || null;

const etat = prospect ? dossierComplet(prospect, { pieces }) : { complet: false, manque: [] };
const libellePiece = (cle) => (TYPES_PIECE.find((t) => t.cle === cle) || {}).libelle || cle;
const poids = (o) => (o > 1024 * 1024 ? `${(o / 1024 / 1024).toFixed(1)} Mo` : `${Math.round(o / 1024)} ko`);
const jour = (v) => (v ? new Date(v).toLocaleDateString('fr-BE') : null);

if (!prospect && !erreur) return new Response('Client introuvable', { status: 404 });

const message = Astro.url.searchParams.get('ok');
---

<Console
  titre={prospect?.raison_sociale || 'Client'}
  fil={`TFB Admin · Commercial · ${prospect?.raison_sociale || 'Client'}`}
  actif="offres"
  message={message}
  erreur={erreur}
  compteurs={chiffres}
>
  {prospect && (
    <>
      <OngletsClient prospect={prospect.id} actif="fiche" />
      <section class="bloc" style="margin-block-end:20px">
        <div class="bloc__tete">
          <div>
            <h2>Coordonnées</h2>
            <p>
              Partagées par les {offres.length} offre(s) de ce client, envoyées comprises.
              Les montants d'une offre envoyée, eux, ne changent pas.
            </p>
          </div>
          {/* Le commercial en tête de fiche : c'est la première question posée
              sur un client, et il fallait jusqu'ici ouvrir une offre pour y
              répondre. « Aucun » n'est écrit que s'il y a des offres — sur un
              client sans offre, l'absence n'est pas une anomalie. */}
          {commercial
            ? <span class="etat">Commercial · {commercial}</span>
            : offres.length > 0 && <span class="etat etat--manque">Aucun commercial</span>}
          <span class={prospect.tva_verifiee_le ? 'etat etat--on' : 'etat'}>
            {prospect.tva_verifiee_le ? `TVA vérifiée le ${jour(prospect.tva_verifiee_le)}` : 'TVA non vérifiée'}
          </span>
          {/* Le lien n'apparaît que pour qui peut l'ouvrir : une entrée qui
              mènerait à un 403 laisse croire à un droit qu'on n'a pas. */}
          {cheminAutorise('/admin/charte', (Astro.locals.session || {}).role) && (
            <a class="etat" href={`${BASE}/admin/charte/${prospect.id}`}>Sa charte</a>
          )}
        </div>

        {prospect.tva_verifiee_nom && prospect.tva_verifiee_nom !== prospect.raison_sociale && (
          <div class="champ">
            <span class="champ__aide">
              Le registre européen connaît ce numéro sous le nom
              <strong> {prospect.tva_verifiee_nom}</strong>. Ce n'est pas une erreur si vous employez
              un nom d'usage — mais c'est le nom du registre qui doit figurer sur le contrat.
            </span>
          </div>
        )}

        {/*
          Aucun champ caché « action » : un formulaire qui porte à la fois un
          `<input type="hidden" name="action">` et un bouton `name="action"`
          envoie **les deux**, et `formData.get()` rend le premier — donc
          toujours le champ caché. « Vérifier la TVA » aurait alors enregistré
          les coordonnées sans rien vérifier, en disant l'avoir fait. Le
          bouton d'enregistrement n'en porte pas : sans action, on retombe
          dessus.
        */}
        <form method="post">
          <div class="duo">
            {CHAMPS_PROSPECT.map((c) => (
              <div class="champ" style={c.zone ? 'grid-column:1/-1' : undefined}>
                <label for={`p-${c.nom}`}>
                  {c.libelle}{c.requis && <span class="champ__requis" aria-hidden="true"> *</span>}
                </label>
                {c.zone ? (
                  <textarea id={`p-${c.nom}`} name={c.nom} rows="2">{prospect[c.nom] || ''}</textarea>
                ) : (
                  <input
                    id={`p-${c.nom}`}
                    type={c.type || 'text'}
                    name={c.nom}
                    value={prospect[c.nom] || ''}
                    required={c.requis}
                    maxlength={c.taille}
                    placeholder={c.exemple}
                  />
                )}
              </div>
            ))}
          </div>
          <div class="actions">
            <button class="bouton bouton--marque" type="submit">Enregistrer</button>
            <button class="bouton bouton--sobre" type="submit" name="action" value="vies">
              <Icone nom="search" taille={16} /> Vérifier la TVA
            </button>
          </div>
          <span class="champ__aide">
            « Vérifier la TVA » enregistre les coordonnées, puis interroge VIES, le registre de la
            Commission européenne. Il dit si le numéro existe et à quel nom — de quoi attraper une
            faute de frappe avant qu'elle ne finisse sur une facture. La raison sociale n'est pas
            remplacée : l'étape « Votre entreprise » du parcours le propose, avec une case à cocher.
          </span>
        </form>
      </section>

      <section class="bloc" style="margin-block-end:20px">
        <div class="bloc__tete">
          <div>
            <h2>Le dossier</h2>
            <p>
              Ce qu'il faut pour signer et facturer. Rien n'est obligatoire ici — c'est
              au moment d'éditer le contrat qu'on refuse d'avancer sans, et l'écran dit
              alors précisément ce qui manque. Bloquer plus tôt ferait fuir un prospect
              qu'on n'a pas encore convaincu.
            </p>
          </div>
          <span class={etat.complet ? 'etat etat--on' : 'etat etat--manque'}>
            {etat.complet ? 'complet' : `${etat.manque.length} manque(s)`}
          </span>
        </div>

        {!etat.complet && (
          <div class="champ">
            <span class="champ__aide">
              Pour éditer un contrat, il manque : {etat.manque.map((m) => m.libelle).join(', ')}.
            </span>
          </div>
        )}

        <form method="post">
          <input type="hidden" name="action" value="dossier" />
          {GROUPES_DOSSIER.map((g) => (
            <div class="groupe">
              <span class="groupe__titre">{g.titre}</span>
              <p class="champ__aide">{g.aide}</p>
              <div class="duo">
                {CHAMPS_DOSSIER.filter((c) => c.groupe === g.cle).map((c) => (
                  <div class="champ" style={c.zone ? 'grid-column:1/-1' : undefined}>
                    {c.case ? (
                      <>
                        <span class="legende">{c.libelle}</span>
                        <label class="case case--seule">
                          <input type="checkbox" name={c.nom} value="1" checked={Boolean(prospect[c.nom])} />
                          <span><strong>Oui</strong></span>
                        </label>
                      </>
                    ) : (
                      <>
                        <label for={`d-${c.nom}`}>{c.libelle}</label>
                        {c.zone ? (
                          <textarea id={`d-${c.nom}`} name={c.nom} rows="2" placeholder={c.exemple}>{prospect[c.nom] || ''}</textarea>
                        ) : c.nombre ? (
                          <span class="tarif__saisie">
                            <input id={`d-${c.nom}`} type="text" name={c.nom} value={prospect[c.nom] ?? 30} inputmode="numeric" />
                            <span class="tarif__unite">{c.unite}</span>
                          </span>
                        ) : (
                          <input
                            id={`d-${c.nom}`}
                            type={c.type || 'text'}
                            name={c.nom}
                            value={prospect[c.nom] || ''}
                            placeholder={c.exemple}
                          />
                        )}
                      </>
                    )}
                  </div>
                ))}
              </div>
            </div>
          ))}
          <div class="actions">
            <button class="bouton bouton--marque" type="submit">Enregistrer le dossier</button>
          </div>
        </form>
      </section>

      <section class="bloc" style="margin-block-end:20px">
        <div class="bloc__tete">
          <div>
            <h2>Les pièces</h2>
            <p>
              Stockées en base, comme les logos des réseaux : elles survivent au
              déploiement et partent avec la sauvegarde. PDF, PNG, JPEG ou WebP, 8 Mo
              au plus.
            </p>
          </div>
        </div>

        {pieces.length === 0 ? (
          <div class="champ"><span class="champ__aide">Aucune pièce déposée.</span></div>
        ) : (
          <div class="roule">
            <table>
              <thead>
                <tr><th>Type</th><th>Fichier</th><th class="nombre">Poids</th><th></th></tr>
              </thead>
              <tbody>
                {pieces.map((p) => (
                  <tr>
                    <td><strong>{libellePiece(p.type)}</strong></td>
                    <td>
                      <a href={`${BASE}/admin/pieces/${p.id}`}>{p.nom}</a>
                      <code class="slug">{p.type_mime}</code>
                    </td>
                    <td class="nombre fb-num champ__aide">{poids(p.taille)}</td>
                    <td>
                      <form method="post" class="actions" onsubmit="return confirm('Retirer cette pièce du dossier ?')">
                        <input type="hidden" name="action" value="piece-suppression" />
                        <input type="hidden" name="piece_id" value={p.id} />
                        <button class="bouton bouton--sobre bouton--sm" type="submit">Retirer</button>
                      </form>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        <form method="post" enctype="multipart/form-data">
          <input type="hidden" name="action" value="piece" />
          <div class="duo">
            <div class="champ">
              <label for="pi-type">Type de pièce</label>
              <select id="pi-type" name="type">
                {TYPES_PIECE.map((t) => (
                  <option value={t.cle}>{t.libelle}{t.requise ? ' — requise' : ''}</option>
                ))}
              </select>
            </div>
            <div class="champ">
              <label for="pi-fichier">Fichier</label>
              <input id="pi-fichier" type="file" name="fichier" accept="application/pdf,image/png,image/jpeg,image/webp" required />
            </div>
          </div>
          <div class="actions">
            <button class="bouton bouton--marque" type="submit">
              <Icone nom="plus" taille={16} /> Déposer
            </button>
          </div>
        </form>
      </section>

      <section class="bloc">
        <div class="bloc__tete">
          <div>
            <h2>Ses offres</h2>
            <p>Dernière version de chaque référence, et qui l'a faite.</p>
          </div>
          <a class="bouton bouton--sobre bouton--sm" href={`${BASE}/admin/offres/nouvelle`}>Nouvelle offre</a>
        </div>

        {offres.length === 0 ? (
          <div class="bloc__pied">Aucune offre pour ce client.</div>
        ) : (
          <div class="roule">
            <table>
              <thead>
                <tr>
                  <th>Référence</th>
                  <th style="inline-size:7rem">Version</th>
                  <th style="inline-size:9rem">Statut</th>
                  <th style="inline-size:12rem">Commercial</th>
                </tr>
              </thead>
              <tbody>
                {offres.map((o) => (
                  <tr>
                    <td><a href={`${BASE}/admin/offres/${o.reference}`}><strong>{o.reference}</strong></a></td>
                    <td>version {o.version}</td>
                    <td><span class="etat">{o.statut}</span></td>
                    {/* Par offre, et pas seulement en tête de fiche : un client
                        repris change de commercial, et les anciennes offres
                        restent au nom de celui qui les a signées — c'est lui
                        qu'elles commissionnent. */}
                    <td>{o.auteur_nom || <span class="champ__aide">—</span>}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>
    </>
  )}
</Console>

<style is:global>
  /* Un groupe du dossier : un titre et de l'air, sans le trait d'un
     `fieldset` — un filet qui flotte entre deux rangées ajoute une ligne à
     lire sans rien dire. Et sans `legend` non plus : une légende se pose sur
     la bordure de son cadre et ignore le rembourrage du haut, si bien que le
     titre du deuxième groupe se collait à la dernière saisie du premier. */
</style>
