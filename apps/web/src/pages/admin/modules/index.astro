---
/**
 * La table des modules. C'est ici qu'on règle l'ordre d'affichage et qu'on
 * masque un module sans le supprimer — un module supprimé de la base
 * reviendrait à la prochaine ingestion, alors qu'un module masqué reste
 * masqué.
 */
import Console from '../../../components/Console.astro';
import Icone from '../../../components/Icone.astro';
import Pastille from '../../../components/Pastille.astro';
import { lien } from '../../../lib/lien.mjs';
import { leviersDe } from '../../../lib/leviers.mjs';
import {
  ajouterPack,
  basculerFonction,
  basculerModule,
  basculerPack,
  chargerModuleAdmin,
  compteurs,
  enregistrerLigneModule,
  enregistrerPack,
  famillesConnues,
  listerModules,
  packNonSouscriptible,
  packsVendables,
  supprimerPack,
  UNITES_PACK,
  tarifsEnVigueur,
  validerFonction,
  validerModule,
} from '../../../lib/admin/donnees.mjs';
import { LEVIERS, titreLevier } from '../../../lib/leviers.mjs';
import { depuisCents } from '../../../lib/offres/montants.mjs';
import { formater } from '../../../lib/offres/calcul.mjs';

/** Les icônes proposées, prises dans le jeu embarqué. */
const ICONES = [
  'shopping-cart', 'layout-dashboard', 'store', 'building-2', 'chef-hat', 'clipboard-check',
  'truck', 'monitor', 'handshake', 'credit-card', 'megaphone', 'utensils', 'graduation-cap',
  'receipt', 'wallet', 'percent', 'layers', 'bar-chart', 'package', 'map-pin', 'users',
  'book-open', 'qr-code', 'smartphone', 'bot', 'chart-line',
];

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
let erreur = null;

if (Astro.request.method === 'POST') {
  try {
    const f = await Astro.request.formData();
    const slug = String(f.get('slug') || '');

    const action = String(f.get('action') || '');

    // La relecture : le module et ses composants encore « nouveaux » passent
    // d'un coup en ligne.
    if (action === 'valider-module') {
      await validerModule(slug);
      return Astro.redirect(`${BASE}/admin/modules?ok=${encodeURIComponent(`${slug} validé et publié.`)}`, 303);
    }
    if (action === 'valider-fonction') {
      await validerFonction(f.get('id'));
      return Astro.redirect(`${BASE}/admin/modules?ok=${encodeURIComponent('Composant validé et mis en ligne.')}`, 303);
    }
    if (action === 'bascule-fonction') {
      await basculerFonction(f.get('id'), f.get('en_ligne') === '1');
      return Astro.redirect(`${BASE}/admin/modules?ok=${encodeURIComponent('Composant mis à jour.')}`, 303);
    }

    // Les packs : créés, modifiés, activés ou supprimés depuis le bloc du
    // haut. Ils vivent ici parce que c'est ici qu'on décide ce qu'ils
    // contiennent — un pack et ses modules ne se règlent pas à deux écrans
    // de distance.
    if (action === 'pack-ajout') {
      const cle = await ajouterPack({
        nom: f.get('nom'), description: f.get('description'), prix: f.get('prix'),
        unite: f.get('unite'), base: f.get('base'), ordre: f.get('ordre'),
        stripe_product_id: f.get('stripe_product_id'), stripe_price_id: f.get('stripe_price_id'),
      });
      return Astro.redirect(`${BASE}/admin/modules?ok=${encodeURIComponent(`Pack « ${cle} » créé.`)}`, 303);
    }
    if (action === 'pack-enregistrer') {
      await enregistrerPack(f.get('cle'), {
        nom: f.get('nom'), description: f.get('description'), prix: f.get('prix'),
        unite: f.get('unite'), base: f.get('base'), ordre: f.get('ordre'),
        stripe_product_id: f.get('stripe_product_id'), stripe_price_id: f.get('stripe_price_id'),
      });
      return Astro.redirect(`${BASE}/admin/modules?ok=${encodeURIComponent('Pack enregistré.')}`, 303);
    }
    if (action === 'pack-bascule') {
      await basculerPack(f.get('cle'), f.get('actif') === '1');
      return Astro.redirect(`${BASE}/admin/modules?ok=${encodeURIComponent('Pack mis à jour.')}`, 303);
    }
    if (action === 'pack-suppression') {
      await supprimerPack(f.get('cle'));
      return Astro.redirect(
        `${BASE}/admin/modules?ok=${encodeURIComponent('Pack supprimé. Ses modules redeviennent des options.')}`,
        303,
      );
    }

    // Deux actions sur la même table : basculer la publication, ou
    // enregistrer la ligne modifiée sur place.
    if (action === 'publication') {
      const actif = f.get('actif') === '1';
      await basculerModule(slug, actif);
      return Astro.redirect(
        `${BASE}/admin/modules?ok=${encodeURIComponent(`${slug} ${actif ? 'publié' : 'masqué'}.`)}`,
        303,
      );
    }

    await enregistrerLigneModule(slug, {
      groupe: f.get('groupe'),
      icone: f.get('icone'),
      ordre: f.get('ordre'),
      prix: f.get('prix'),
      pack: f.get('pack'),
      leviers: f.getAll('leviers').map(String),
    });
    return Astro.redirect(`${BASE}/admin/modules?ok=${encodeURIComponent(`${slug} enregistré.`)}`, 303);
  } catch (err) {
    erreur = err.message;
  }
}

const message = Astro.url.searchParams.get('ok');

let modules = [];
let chiffres = {};
let familles = [];
let prixParDefaut = 0;
let packs = [];
try {
  modules = await listerModules();
  packs = await packsVendables();
  prixParDefaut = (await tarifsEnVigueur()).prix_module_cents;
  chiffres = await compteurs();
  familles = await famillesConnues();
  // Les composants de chaque module, pour la ligne dépliable.
  for (const m of modules) {
    const complet = await chargerModuleAdmin(m.slug).catch(() => null);
    m.composants = complet?.fonctions || [];
  }
} catch (err) {
  erreur = erreur || `Base injoignable : ${err.message}`;
}

const total = modules.reduce((n, m) => n + m.nb_fonctions, 0);
---

<Console
  titre="Modules"
  fil="TFB Admin · Contenu · Modules"
  actif="modules"
  message={message}
  erreur={erreur}
  compteurs={chiffres}
>
  <section class="bloc" style="margin-block-end:20px">
    <div class="bloc__tete">
      <div>
        <h2>Les packs</h2>
        <p>
          <span class="jeton">landing_packs</span> — ce qui se vend d'un bloc. Un module
          rattaché à un pack ne se facture plus à l'unité : le prix du pack le couvre.
          Les packs marqués <strong>modèle de base</strong> sont cochés d'avance sur une
          offre neuve.
        </p>
      </div>
    </div>

    {packs.length > 0 && (
      <div class="roule">
        <table>
          <thead>
            <tr>
              <th>Pack</th>
              <th style="inline-size:13rem">Stripe</th>
              <th style="inline-size:9rem">Prix</th>
              <th style="inline-size:13rem">Facturé</th>
              <th style="inline-size:5rem">Ordre</th>
              <th style="inline-size:7rem">Base</th>
              <th style="inline-size:14rem"><span class="invisible">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            {packs.map((p) => (
              <tr>
                <td>
                  <form method="post" id={`pack-${p.cle}`}>
                    <input type="hidden" name="action" value="pack-enregistrer" />
                    <input type="hidden" name="cle" value={p.cle} />
                  </form>
                  <input
                    form={`pack-${p.cle}`}
                    type="text"
                    name="nom"
                    value={p.nom}
                    aria-label={`Nom du pack ${p.cle}`}
                  />
                  <code class="slug">{p.cle}</code>
                  <span class="champ__aide">
                    {p.modules.map((m) => m.nom).join(' · ') || 'Aucun module rattaché.'}
                  </span>
                  {packNonSouscriptible(p) && (
                    <span class="pack__bloque">
                      <Icone nom="triangle-alert" taille={13} />
                      {packNonSouscriptible(p)}
                    </span>
                  )}
                </td>
                <td>
                  {/* Stripe dit ce qui est payé ; la colonne `pack` des modules
                      dit ce que ça ouvre. Les deux identifiants se copient
                      depuis le même écran de Stripe et se confondent : le
                      préfixe est vérifié à l'enregistrement. */}
                  <input
                    form={`pack-${p.cle}`}
                    type="text"
                    name="stripe_product_id"
                    value={p.stripe_product_id || ''}
                    placeholder="prod_…"
                    spellcheck="false"
                    aria-label={`Produit Stripe du pack ${p.cle}`}
                  />
                  <input
                    form={`pack-${p.cle}`}
                    type="text"
                    name="stripe_price_id"
                    value={p.stripe_price_id || ''}
                    placeholder="price_…"
                    spellcheck="false"
                    aria-label={`Prix Stripe du pack ${p.cle}`}
                  />
                </td>
                <td>
                  <span class="tarif__saisie">
                    <input
                      form={`pack-${p.cle}`}
                      type="text"
                      name="prix"
                      value={depuisCents(p.prix_cents)}
                      inputmode="decimal"
                      aria-label={`Prix du pack ${p.cle}`}
                    />
                    <span class="tarif__unite">€</span>
                  </span>
                </td>
                <td>
                  <select form={`pack-${p.cle}`} name="unite" aria-label={`Unité du pack ${p.cle}`}>
                    {UNITES_PACK.map((u) => (
                      <option value={u.cle} selected={p.unite === u.cle}>{u.libelle}</option>
                    ))}
                  </select>
                </td>
                <td>
                  <input
                    class="num"
                    form={`pack-${p.cle}`}
                    type="number"
                    name="ordre"
                    min="1"
                    value={p.ordre ?? 100}
                    aria-label={`Ordre du pack ${p.cle}`}
                  />
                </td>
                <td>
                  {/* Dans une cellule étroite, la vignette encadrée se pliait
                      sur trois lignes : une case et son mot suffisent. */}
                  <label class="coche">
                    <input form={`pack-${p.cle}`} type="checkbox" name="base" value="1" checked={p.base} />
                    <span class="champ__aide">modèle de base</span>
                  </label>
                </td>
                <td>
                  <div class="actions">
                    <button class="bouton bouton--marque bouton--sm" type="submit" form={`pack-${p.cle}`}>
                      Enregistrer
                    </button>
                    <form method="post" onsubmit="return confirm('Supprimer ce pack ? Ses modules redeviennent des options facturées à l’unité.')">
                      <input type="hidden" name="action" value="pack-suppression" />
                      <input type="hidden" name="cle" value={p.cle} />
                      <button class="bouton bouton--sobre bouton--sm" type="submit">Supprimer</button>
                    </form>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <form method="post">
      <input type="hidden" name="action" value="pack-ajout" />
      <div class="duo">
        <div class="champ">
          <label for="pk-nom">Nom du pack<span class="champ__requis" aria-hidden="true"> *</span></label>
          <input id="pk-nom" type="text" name="nom" required placeholder="Pack webshop" />
          <span class="champ__aide">Le nom donne la clé technique, et figure tel quel sur l'offre.</span>
        </div>
        <div class="champ champ--nombre">
          <label for="pk-prix">Prix<span class="champ__requis" aria-hidden="true"> *</span></label>
          <span class="tarif__saisie">
            <input id="pk-prix" type="text" name="prix" required inputmode="decimal" placeholder="99" />
            <span class="tarif__unite">€</span>
          </span>
        </div>
        <div class="champ">
          <label for="pk-unite">Facturé</label>
          <select id="pk-unite" name="unite">
            {UNITES_PACK.map((u) => <option value={u.cle}>{u.libelle}</option>)}
          </select>
        </div>
        <div class="champ">
          <span class="legende">Modèle de base</span>
          <label class="case case--seule">
            <input type="checkbox" name="base" value="1" />
            <span>
              <strong>Compris d'office</strong>
              <span class="champ__aide">Coché d'avance sur toute offre neuve.</span>
            </span>
          </label>
        </div>
        {/* Facultatifs à la création : on crée souvent le pack avant d'avoir
            ouvert Stripe. Le pack apparaît alors comme non souscriptible dans
            le tableau ci-dessus, ce qui vaut mieux qu'un champ obligatoire
            qu'on remplit avec n'importe quoi pour passer. */}
        <div class="champ">
          <label for="pk-prod">Produit Stripe</label>
          <input id="pk-prod" type="text" name="stripe_product_id" placeholder="prod_…" spellcheck="false" />
          <span class="champ__aide">Sans lui, le pack ne peut pas être souscrit.</span>
        </div>
        <div class="champ">
          <label for="pk-price">Prix Stripe</label>
          <input id="pk-price" type="text" name="stripe_price_id" placeholder="price_…" spellcheck="false" />
          <span class="champ__aide">Le prix qui sera réellement facturé.</span>
        </div>
        <div class="champ" style="grid-column:1/-1">
          <label for="pk-desc">Description</label>
          <textarea id="pk-desc" name="description" rows="2" placeholder="Ce que le pack comprend, en une phrase."></textarea>
        </div>
      </div>
      <div class="actions">
        <button class="bouton bouton--marque" type="submit">
          <Icone nom="plus" taille={16} /> Créer le pack
        </button>
      </div>
    </form>

    <div class="bloc__pied">
      Le rattachement d'un module se règle dans la colonne <strong>Pack</strong> du tableau
      ci-dessous. Un module qui quitte un pack redevient une option, facturée dès
      l'enregistrement suivant de l'offre.
    </div>
  </section>

  <section class="bloc">
    <div class="bloc__tete">
      <div>
        <h2>Modules</h2>
        <p>
          <span class="jeton">landing_modules</span> — régénérés depuis les dépôts GitHub par le pipeline.
          L'ordre gouverne l'affichage sur l'accueil et dans le fil d'onboarding.
        </p>
      </div>
    </div>

    <div class="roule">
      <table>
        <thead>
          <tr>
            <th colspan="8" style="padding:0">
              <span class="ligne-module ligne-module--entete">
                <span>Module</span>
                <span>Icône</span>
                <span>Famille</span>
                <span>Leviers</span>
                <span>Ordre</span>
                <span>Pack</span>
                <span>Prix / mois</span>
                <span>Comp.</span>
                <span>Capt.</span>
                <span>Statut</span>
                <span></span>
              </span>
            </th>
          </tr>
        </thead>
        <tbody>
          {modules.map((m) => (
            <tr>
              <td colspan="8" style="padding:0">
                <form method="post" class="ligne-module">
                  <input type="hidden" name="slug" value={m.slug} />

                  <div class="ligne-module__nom">
                    <span style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                      <a href={lien(`/admin/modules/${m.slug}`)}><strong>{m.nom || m.slug}</strong></a>
                      {m.nouveau && <span class="neuf">nouveau</span>}
                    </span>
                    <code class="slug">{m.slug}</code>
                  </div>

                  <label class="ligne-module__icone" title="Icône du module">
                    <span class="apercu"><Icone nom={m.icone || 'layers'} taille={16} /></span>
                    <select name="icone">
                      {ICONES.map((i) => <option value={i} selected={i === m.icone}>{i}</option>)}
                    </select>
                  </label>

                  <select name="groupe" title="Famille" aria-label="Famille">
                    {familles.map((g) => <option value={g} selected={g === m.groupe}>{g}</option>)}
                  </select>

                  <span class="choix-leviers">
                    {LEVIERS.map((l) => (
                      <label class="choix-levier" title={titreLevier(l)} style={`--fond:${l.fond};--encre:${l.encre}`}>
                        <input type="checkbox" name="leviers" value={l.cle} checked={(m.leviers || []).includes(l.cle)} />
                        <span>{l.lettre}</span>
                      </label>
                    ))}
                  </span>

                  <input class="ligne-module__ordre num" type="number" name="ordre" min="1" value={m.ordre ?? 100} title="Ordre" aria-label="Ordre" />

                  <select
                    class="ligne-module__socle"
                    name="pack"
                    title="Un module empaqueté ne se facture pas à l'unité : le prix du pack le couvre."
                    aria-label={`Pack de ${m.nom || m.slug}`}
                  >
                    <option value="" selected={!m.pack}>à l'unité</option>
                    {packs.map((p) => (
                      <option value={p.cle} selected={m.pack === p.cle}>{p.nom}</option>
                    ))}
                  </select>

                  <span class="tarif__saisie ligne-module__prix">
                    <input
                      type="text"
                      name="prix"
                      value={m.prix_cents ? depuisCents(m.prix_cents) : ''}
                      inputmode="decimal"
                      placeholder={depuisCents(prixParDefaut)}
                      title={`Prix mensuel. Vide : le tarif général, ${formater(prixParDefaut)}.`}
                      aria-label={`Prix mensuel de ${m.nom || m.slug}`}
                    />
                    <span class="tarif__unite">€</span>
                  </span>

                  <span class="num ligne-module__compte">{m.nb_fonctions}</span>
                  <span class="num ligne-module__compte" style={m.nb_captures === 0 ? 'color:var(--text-warning)' : undefined}>
                    {m.nb_captures}
                  </span>

                  <span class={m.actif ? 'etat etat--on' : 'etat'}>{m.actif ? 'publié' : 'masqué'}</span>

                  <span class="actions actions--case">
                    {m.nouveau && (
                      <button class="bouton bouton--valider bouton--sm" type="submit" name="action" value="valider-module">
                        Valider
                      </button>
                    )}
                    <button class="bouton bouton--marque bouton--sm" type="submit">Enregistrer</button>
                    <button
                      class="bouton bouton--sobre bouton--sm"
                      type="submit"
                      name="action"
                      value="publication"
                    >{m.actif ? 'Masquer' : 'Publier'}</button>
                    <input type="hidden" name="actif" value={m.actif ? '0' : '1'} />
                  </span>
                </form>

                <details class="composants">
                  <summary>
                    <Icone nom="chevron-right" taille={14} classe="icone--miroir composants__fleche" />
                    {(m.composants || []).length} composant(s)
                    {m.nb_nouvelles > 0 && <span class="neuf">{m.nb_nouvelles} à valider</span>}
                  </summary>
                  <div class="composants__liste">
                    {(m.composants || []).map((c) => (
                      <div class="composant-ligne">
                        <span class="composant-ligne__nom">
                          {c.nom || c.cle}
                          {c.nouveau && <span class="neuf">nouveau</span>}
                        </span>
                        <span class="pastilles">{leviersDe(c.leviers).map((l) => <Pastille levier={l} />)}</span>
                        <form method="post" class="composant-ligne__etat">
                          <input type="hidden" name="slug" value={m.slug} />
                          <input type="hidden" name="id" value={c.id} />
                          {c.nouveau ? (
                            <Fragment>
                              <span class="interrupteur interrupteur--bloque" title="À valider avant mise en ligne"></span>
                              <span class="composant-ligne__mot">hors ligne</span>
                              <button class="bouton bouton--valider bouton--sm" type="submit" name="action" value="valider-fonction">
                                Valider
                              </button>
                            </Fragment>
                          ) : (
                            <Fragment>
                              <input type="hidden" name="en_ligne" value={c.en_ligne ? '0' : '1'} />
                              <button
                                class={c.en_ligne ? 'interrupteur interrupteur--on' : 'interrupteur'}
                                type="submit"
                                name="action"
                                value="bascule-fonction"
                                title={c.en_ligne ? 'Mettre hors ligne' : 'Mettre en ligne'}
                              ><span></span></button>
                              <span class="composant-ligne__mot" style={c.en_ligne ? 'color:var(--text-success)' : undefined}>
                                {c.en_ligne ? 'en ligne' : 'hors ligne'}
                              </span>
                            </Fragment>
                          )}
                        </form>
                        <span class="composant-ligne__gain">{c.benefice || '—'}</span>
                      </div>
                    ))}
                  </div>
                </details>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="bloc__pied">
      {modules.length} module(s), {total} composants. Famille, icône, leviers et ordre se modifient
      directement ici. Le reste de la fiche — accroche, description, liens — est derrière le nom du module.
      Un module s'ajoute au dépôt, pas ici : une ligne dans <span class="jeton">modules.json</span> et sa
      fiche dans <span class="jeton">pipeline/contenu-initial.mjs</span>.
    </div>
  </section>
</Console>

<style is:global>
  /* Pourquoi ce pack ne peut pas être souscrit, sur la ligne du pack.
     Pas un bandeau en tête d'écran : la phrase doit être à côté de ce qu'elle
     désigne, sinon il faut compter les lignes pour savoir de quel pack on
     parle. */
  .pack__bloque {
    display: flex; align-items: flex-start; gap: 6px; margin-block-start: 6px;
    font: var(--text-xs) / 1.4 var(--font-sans); color: var(--text-warning);
  }
  .pack__bloque svg { flex: none; margin-block-start: 1px; }
  /* Les deux identifiants Stripe, l'un sous l'autre. En monospace parce qu'on
     les compare à l'œil avec le tableau de bord de Stripe, et qu'un l et un 1
     doivent se distinguer. */
  input[name='stripe_product_id'], input[name='stripe_price_id'] {
    font-family: var(--font-mono); font-size: var(--text-xs);
  }
  input[name='stripe_price_id'] { margin-block-start: 4px; }
  /* Une ligne de module est un formulaire : la grille tient les colonnes
     alignées entre l'en-tête et les lignes, sans table imbriquée. */
  .ligne-module {
    display: grid;
    grid-template-columns:
      /* La colonne d'ordre fait six rems et non quatre et demi : un champ
         numérique porte ses flèches, et Chromium refuse de le rendre sous
         quatre-vingt-douze pixels — il débordait de huit sur le pack d'à
         côté, sans jamais rétrécir. */
      minmax(9rem, 1.2fr) 10rem 9rem 9.5rem 6rem 7rem 7rem 3.5rem 3.5rem 5.5rem auto;
    gap: 12px;
    align-items: center;
    padding: 11px 16px;
    inline-size: 100%;
    /* Onze colonnes : sous cette largeur, elles se tassent jusqu'à ce que les
       six pastilles de levier débordent sur le champ d'ordre. La rangée
       défile plutôt — c'est le rôle du rouleau qui l'entoure. */
    min-inline-size: 96rem;
  }
  .ligne-module--entete {
    padding-block: 0;
    font: 600 var(--text-xs) / 1 var(--font-sans);
    letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--slate-400);
  }
  .ligne-module__nom { min-inline-size: 0; }
  /* Les six pastilles tiennent sur une ligne : c'est ce qui rend la colonne
