---
/**
 * Onboarding — le parcours d'un nouveau client.
 *
 * Le fil des modules dans l'ordre où l'information circule. Un clic sur un
 * module ouvre son panneau : ce qu'on y gagne, pourquoi le prendre, l'inventaire
 * de son menu et à quoi sert chaque entrée, et ce qu'il échange avec les autres
 * modules. Tout est rattaché aux 6 leviers de gestion.
 *
 * Le panneau est rendu côté serveur pour les huit modules et révélé au clic :
 * pas d'appel réseau, et la page reste lisible sans JavaScript.
 */
import Layout from '../components/Layout.astro';
import { LEVIERS, chargerParcours } from '../lib/db.mjs';
import { lien } from '../lib/lien.mjs';

const modules = await chargerParcours();
const parSlug = new Map(modules.map((m) => [m.slug, m]));

/** Combien de modules actionnent chaque levier — la barre de couverture. */
const couverture = LEVIERS.map((l) => ({
  ...l,
  modules: modules.filter((m) => (m.leviers || []).includes(l.cle)),
}));
---

<Layout
  titre="Onboarding"
  description="Comment l'information circule entre les modules de l'ERP, et ce que chacun apporte aux 6 leviers de gestion."
  modules={modules}
>
  <!-- Ouverture -->
  <section class="sect sect--haut">
    <div class="contenant">
      <p class="oeil">Prise en main</p>
      <h1 class="titre-geant">Comment l'information circule</h1>
      <p class="chapo">
        Huit modules, une seule donnée. Suivez le fil : chaque étape montre ce qu'elle
        reçoit, ce qu'elle produit, et sur lesquels des six leviers de gestion elle agit.
        Cliquez sur un module pour ouvrir sa fiche.
      </p>
    </div>
  </section>

  <!-- Les 6 leviers -->
  <section class="sect" id="leviers">
    <div class="contenant">
      <p class="oeil">La grille de lecture</p>
      <h2>Les 6 leviers de gestion</h2>
      <p class="chapo chapo--court">
        Tout ce que fait la plateforme se juge à ces six questions. Chaque module,
        chaque écran, y répond ou n'a pas de raison d'exister.
      </p>

      <ol class="leviers">
        {couverture.map((l) => (
          <li class="levier" data-levier={l.cle}>
            <span class="levier__lettre">{l.lettre}</span>
            <span class="levier__nom">{l.nom}</span>
            <span class="levier__q">{l.question}</span>
            <span class="levier__n">{l.modules.length} module{l.modules.length > 1 ? 's' : ''}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Le fil -->
  <section class="sect sect--sombre" id="fil">
    <div class="contenant">
      <p class="oeil oeil--clair">Le parcours</p>
      <h2 class="sur-sombre">Le fil, de la vente au terrain</h2>

      <div class="fil">
        {modules.map((m, i) => (
          <button
            class="noeud"
            type="button"
            data-cible={m.slug}
            aria-expanded="false"
            aria-controls={`fiche-${m.slug}`}
          >
            <span class="noeud__rang">{String(i + 1).padStart(2, '0')}</span>
            <span class="noeud__nom">{m.nom}</span>
            <span class="noeud__groupe">{m.groupe}</span>
            <span class="noeud__leviers">
              {(m.leviers || []).map((c) => (
                <i class="pastille" data-levier={c}>{LEVIERS.find((l) => l.cle === c)?.lettre}</i>
              ))}
            </span>
          </button>
        ))}
      </div>

      <!-- Les fiches, une par module -->
      {modules.map((m) => (
        <article class="fiche" id={`fiche-${m.slug}`} hidden>
          <header class="fiche__tete">
            <div>
              <p class="oeil oeil--clair">{m.groupe}</p>
              <h3 class="sur-sombre">{m.nom}</h3>
              <p class="fiche__accroche">{m.accroche}</p>
            </div>
            <a class="bouton bouton--fantome" href={lien(`/modules/${m.slug}`)}>Fiche complète</a>
          </header>

          {m.onboarding && (
            <p class="fiche__onboarding">{m.onboarding}</p>
          )}

          <div class="fiche__colonnes">
            <!-- Ce qu'on y gagne -->
            <div>
              <h4 class="fiche__titre">Ce que vous y gagnez</h4>
              <ul class="gains">
                {(m.benefices || []).map((b) => (
                  <li><strong>{b.titre}</strong><span>{b.texte}</span></li>
                ))}
              </ul>
            </div>

            <!-- Pourquoi le prendre -->
            <div>
              <h4 class="fiche__titre">Pourquoi le prendre</h4>
              <ul class="pourquoi">
                {(m.problemes || []).map((p) => (
                  <li><strong>{p.titre}</strong><span>{p.texte}</span></li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Le menu, item par item -->
          <h4 class="fiche__titre">Le menu du module, et à quoi sert chaque entrée</h4>
          <ul class="menu">
            {(m.fonctions || []).map((f) => (
              <li class="menu__item">
                <div class="menu__tete">
                  <span class="menu__nom">{f.nom}</span>
                  <span class="menu__leviers">
                    {(f.leviers || []).map((c) => (
                      <i class="pastille pastille--sm" data-levier={c} title={LEVIERS.find((l) => l.cle === c)?.nom}>
                        {LEVIERS.find((l) => l.cle === c)?.lettre}
                      </i>
                    ))}
                  </span>
                </div>
                <p class="menu__desc">{f.description}</p>
                {f.benefice && <p class="menu__benef">{f.benefice}</p>}
              </li>
            ))}
          </ul>

          <!-- Les liens avec les autres modules -->
          {(m.liens || []).length > 0 && (
            <>
              <h4 class="fiche__titre">Ce qu'il échange avec les autres</h4>
              <ul class="liens">
                {m.liens.map((l) => {
                  const autre = parSlug.get(l.slug);
                  return (
                    <li class={`lien lien--${l.sens}`}>
                      <span class="lien__sens">{l.sens === 'envoie' ? 'envoie vers' : 'reçoit de'}</span>
                      <a href={lien(`/modules/${l.slug}`)}>{autre ? autre.nom : l.slug}</a>
                      <span class="lien__quoi">{l.quoi}</span>
                    </li>
                  );
                })}
              </ul>
            </>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- Appel -->
  <section class="sect">
    <div class="contenant" style="max-width: 60ch;">
      <p class="oeil">La suite</p>
      <h2>Commencer par la console marque</h2>
      <p class="chapo chapo--court">
        C'est l'entrée du réseau : les boutiques, le catalogue, et ce que chaque
        franchisé peut modifier chez lui. Tout le reste lit ces décisions.
      </p>
      <p style="margin-top: var(--space-6);">
        <a class="bouton" href={lien('/#contact')}>Demander une démonstration</a>
      </p>
    </div>
  </section>
</Layout>

<script is:inline>
  // Ouvrir une fiche, fermer les autres. Sans JavaScript, toutes les fiches
  // restent masquées mais les fiches modules complètes demeurent accessibles.
  const noeuds = document.querySelectorAll('.noeud');
  const fiches = document.querySelectorAll('.fiche');

  function ouvrir(slug) {
    fiches.forEach((f) => { f.hidden = f.id !== `fiche-${slug}`; });
    noeuds.forEach((n) => {
      const actif = n.dataset.cible === slug;
      n.classList.toggle('noeud--actif', actif);
      n.setAttribute('aria-expanded', String(actif));
    });
    const cible = document.getElementById(`fiche-${slug}`);
    if (cible) cible.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  noeuds.forEach((n) => n.addEventListener('click', () => ouvrir(n.dataset.cible)));

  // Le premier module est ouvert d'emblée : une page vide n'apprend rien.
  if (noeuds.length > 0) {
    const depart = location.hash.replace('#', '') || noeuds[0].dataset.cible;
    ouvrir(document.getElementById(`fiche-${depart}`) ? depart : noeuds[0].dataset.cible);
  }
</script>
