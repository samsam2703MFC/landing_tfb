---
/**
 * L'annexe vue depuis la console : le commercial la relit avant d'envoyer, et
 * l'imprime en PDF. Le client, lui, ouvre la même annexe par un lien signé.
 */
import Annexe from '../../../../components/Annexe.astro';
import { chargerOffre } from '../../../../lib/admin/donnees.mjs';

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
const { reference } = Astro.params;
const version = Astro.url.searchParams.get('version');

const offre = await chargerOffre(reference, version);
if (!offre) return new Response('Offre introuvable', { status: 404 });
---

<Annexe offre={offre} retour={`${BASE}/admin/offres/${offre.reference}?version=${offre.version}`} />
