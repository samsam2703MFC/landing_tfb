---
/**
 * La charte d'un client — un formulaire fabriqué depuis le registre.
 *
 * Cet écran ne connaît aucune variable en particulier : il rend ce que le
 * registre déclare, le contrôle choisi par le type. Ajouter une variable, c'est
 * une entrée dans registre.mjs et zéro ligne ici.
 *
 * La colonne de droite dit d'où vient chaque valeur. « Surchargé » contre
 * « Hérité » est ce qui permet de voir en un coup d'œil ce qui diffère vraiment
 * pour ce client — sans quoi on lit 21 lignes sans savoir lesquelles comptent.
 */
import OngletsClient from '../../../components/OngletsClient.astro';
import Console from '../../../components/Console.astro';
import Icone from '../../../components/Icone.astro';
import { lien } from '../../../lib/lien.mjs';
import { chargerMarque, chargerProspect, compteurs } from '../../../lib/admin/donnees.mjs';
import {
  MAISON,
  charteBrouillon,
  charteMaison,
  chartePubliee,
  charteHeritee,
  marque,
  journalCharte,
  modifierBrouillon,
  publierCharte,
} from '../../../lib/admin/charte.mjs';
import { REGISTRE, controlerCharte, resoudreTout, valeursResolues } from '../../../lib/charte/registre.mjs';
import { cleCharte } from '../../../lib/admin/session.mjs';
import { lireFeuille, tailleFeuille } from '../../../lib/charte/import.mjs';
import { cssCharte, facesCharte } from '../../../lib/charte/theme.mjs';
import {
  GRAISSES, ROLES, STYLES, TYPES_ACCEPTES,
  ajouterPolice, listerPolices, supprimerPolice,
} from '../../../lib/charte/polices.mjs';

const id = Number(Astro.params.prospect);
/**
 * Trois portées sur un seul écran.
 *
 * `?portee=marque` édite la charte d'une enseigne — celle que **tous ses
 * clients** portent. Sans le paramètre, on édite un client ; l'identifiant 0
 * reste la maison.
 *
 * Un seul écran plutôt que trois : il fait six cents lignes, il porte
 * l'éditeur, l'aperçu, l'import CSS et les polices, et les recopier deux fois
 * garantirait que deux des trois copies prennent du retard.
 */
const estMarque = Astro.url.searchParams.get('portee') === 'marque';
const cible = estMarque ? marque(id) : id;
const suffixe = estMarque ? '?portee=marque' : '';
const estMaison = !estMarque && id === MAISON;

let erreur = null;
let message = null;
/** Ce que l'import a repris et ce qu'il a laissé — affiché après la bascule. */
let rapport = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') || '');
  // Qui a publié : le nom du compte, pas son identifiant numérique. Le journal
  // est relu par des humains, et « 4 » ne dit rien à personne.
  const session = Astro.locals.session || {};
  const qui = session.nom || session.identifiant || (session.secours ? 'clé de secours' : null);

  if (action === 'import-css') {
    // Deux entrées, un seul analyseur. Le collage passe en premier : quand les
    // deux champs sont remplis, c'est celui qu'on vient de taper qui compte.
    const fichier = form.get('feuille');
    const colle = String(form.get('colle') || '').trim();
    const trop = 2 * 1024 * 1024;

    let texte = null;
    if (colle) {
      if (colle.length > trop) erreur = 'Texte trop long — deux mégaoctets suffisent largement à une charte.';
      else texte = colle;
    } else if (!fichier || typeof fichier === 'string' || !fichier.size) {
      erreur = 'Collez du CSS ou choisissez un fichier.';
    } else if (fichier.size > trop) {
      erreur = 'Feuille trop lourde — deux mégaoctets suffisent largement à une charte.';
    } else {
      texte = await fichier.text();
    }

    if (texte !== null) {
      const lu = lireFeuille(texte);
      if (Object.keys(lu.valeurs).length === 0) {
        erreur = 'Aucune variable reconnue dans cette feuille. Les valeurs attendues sont des propriétés personnalisées (--brand, --primary, …).';
        rapport = { ...lu, taille: tailleFeuille(texte) };
      } else {
        const r = await modifierBrouillon(cible, lu.valeurs, qui);
        if (r.ok) {
          message = `${lu.repris.length} valeur(s) reprises dans le brouillon. Rien de la feuille n’est servi — elle a été lue, pas installée.`;
          rapport = { ...lu, taille: tailleFeuille(texte) };
        } else {
          erreur = Object.values(r.erreurs)[0] || 'Valeurs refusées.';
        }
      }
    }
  } else if (action === 'police') {
    const r = await ajouterPolice(id, {
      famille: form.get('famille'), role: form.get('role'),
      graisse: form.get('graisse'), style: form.get('style'),
    }, form.get('fichier'));
    if (r.ok) message = `Police « ${r.famille} » importée. Choisissez « Les polices importées » dans les réglages de police pour l’utiliser.`;
    else erreur = r.erreur;
  } else if (action === 'police-suppression') {
    await supprimerPolice(Number(form.get('police_id')));
    message = 'Police retirée.';
  } else if (action === 'publier') {
    const r = await publierCharte(cible, qui);
    if (r.ok) message = `Publiée en v${r.version}.`;
    else erreur = Object.values(r.erreurs)[0] || 'Publication refusée.';
  } else if (action === 'reinitialiser') {
    await modifierBrouillon(cible, { [String(form.get('cle'))]: null }, qui);
    message = 'Surcharge retirée — la valeur est de nouveau héritée.';
  } else if (action === 'rendre') {
    // Rendre TOUT à ce qu'il y a dessous, d'un geste.
    //
    // Un client déjà charté ne voit rien changer quand on le rattache à une
    // enseigne : ses vingt-cinq surcharges l'emportent, une par une. Les
    // retirer à la main demandait vingt-cinq clics, et on en oubliait une —
    // celle-là restant la seule à ne pas suivre l'enseigne, sans que rien ne
    // le dise.
    //
    // Le brouillon seulement : rien ne change pour le client tant qu'on n'a
    // pas publié, et le geste se relit avant de valider. C'est la règle de
    // tout cet écran, et ce n'est pas le moment de la casser — c'est
    // justement l'action la plus destructrice qu'il porte.
    await modifierBrouillon(cible, Object.fromEntries(REGISTRE.map((r) => [r.cle, null])), qui);
    message = estMarque
      ? 'Toutes les surcharges retirées — cette marque sert la charte maison. Publiez pour l’appliquer.'
      : 'Toutes les surcharges retirées — ce client sert la charte de son enseigne. Publiez pour l’appliquer.';
  } else {
    const cle = String(form.get('cle') || '');
    const brute = form.get('valeur');
    // Un champ vidé vaut « je ne surcharge plus », pas « surcharge par du
    // vide » : sans ça, effacer une couleur écrirait la chaîne vide en base et
    // le défaut maison ne reprendrait jamais la main.
    const valeur = brute === null || String(brute).trim() === '' ? null : String(brute).trim();
    const r = await modifierBrouillon(cible, { [cle]: valeur }, qui);
    if (r.ok) message = valeur === null ? 'Surcharge retirée — la valeur est de nouveau héritée.' : 'Enregistré dans le brouillon.';
    else erreur = Object.values(r.erreurs)[0] || 'Valeur refusée.';
  }
}

const [prospect, marqueFiche, brouillon, publie, dessous, journal, chiffres, polices] = await Promise.all([
  estMaison || estMarque ? Promise.resolve(null) : chargerProspect(id),
  estMarque ? chargerMarque(id) : Promise.resolve(null),
  charteBrouillon(cible),
  chartePubliee(cible),
  // Ce qui est SOUS ce qu'on édite. Pour un client, c'est la maison plus sa
  // marque : sans ce second niveau, l'écran dirait « hérité de la charte
  // maison » sur une couleur qui vient en réalité de son enseigne.
  estMaison ? Promise.resolve({}) : estMarque ? charteMaison().then((m) => m.donnees) : charteHeritee(id),
  journalCharte(cible),
  compteurs(),
  estMarque ? Promise.resolve([]) : listerPolices(id).catch(() => []),
]);

const resolutions = resoudreTout(brouillon.donnees, dessous);
const erreursCouple = controlerCharte({ ...dessous, ...brouillon.donnees });
const surcharges = resolutions.filter((r) => r.depuis === 'client').length;
const enAttente = brouillon.majLe !== null;
const nom = estMaison
  ? 'Charte maison'
  : estMarque
    ? `Charte — ${marqueFiche?.nom || `Marque ${id}`}`
    : (prospect?.raison_sociale || `Prospect ${id}`);

// Combien de clients porteront ce qu'on publie ici. Modifier une enseigne
// n'est pas modifier un client : le dire avant, pas après.
const portes = estMarque ? (marqueFiche?.clients || 0) : 0;

// La marque de ce client, si elle en a une : c'est d'elle que viennent les
// valeurs que l'écran dit « héritées », et il doit pouvoir y mener.
const sonEnseigne = !estMaison && !estMarque && prospect?.marque_id
  ? { id: Number(prospect.marque_id), nom: prospect.marque_nom }
  : null;

// Le lien remis au client : signé, donc non devinable, et stable d'une
// publication à l'autre — il n'aurait aucun intérêt s'il fallait le renvoyer à
// chaque changement de couleur.
const lienClient = estMaison || estMarque ? null : lien(`/charte/${id}?cle=${cleCharte(id)}`);

const COUCHES = {
  client: estMarque ? 'cette marque' : 'ce client',
  // « hérité » recouvre la maison ET la marque : les distinguer clé par clé
  // demanderait de résoudre deux fois, et l'écran de l'enseigne est à un clic.
  maison: estMarque ? 'charte maison' : (sonEnseigne ? 'maison ou enseigne' : 'charte maison'),
  registre: 'registre',
};

// La charte du brouillon telle qu'elle sortira, pour qui veut la relire ou la
// reprendre ailleurs. C'est le pendant du collage : on entre du CSS, on en
// ressort — sans quoi la charte serait un aller sans retour.
const feuilleProduite = [
  facesCharte(polices),
  `:root {\n  ${cssCharte({ ...valeursResolues({}, dessous), ...brouillon.donnees }, polices)}\n}`,
].filter(Boolean).join('\n');
---

{/* La charte d'un client appartient au groupe Clients du rail, et porte déjà
    son bandeau à sept onglets : `fiche-client` le surligne sans en empiler un
    second. La charte maison, elle, EST un onglet du groupe. */}
<Console
  titre={nom}
  actif={estMaison ? 'charte-maison' : estMarque ? 'clients' : 'fiche-client'}
  compteurs={chiffres}
>
  {/* La charte maison n'appartient à personne : elle n'a pas de fiche client,
      et un onglet « Fiche » y mènerait à un prospect qui n'existe pas. */}
  {!estMaison && !estMarque && <OngletsClient prospect={id} actif="charte" />}

  {/* Une charte d'enseigne habille tout son réseau. Le dire avant de publier,
      pas après : « j'ai changé une couleur » et « j'ai rhabillé trente
      franchisés » sont le même geste ici. */}
  {estMarque && (
    <p class="bandeau bandeau--attente">
      Cette charte habille <strong>{portes} client(s)</strong> rattaché(s) à cette marque.
      Chacun peut encore surcharger une valeur sur sa propre fiche ; tout le reste vient d'ici.
    </p>
  )}

  {sonEnseigne && (
    <p class="bandeau bandeau--attente">
      Ce client porte l'enseigne <strong>{sonEnseigne.nom}</strong>. Ce qui est marqué « hérité »
      vient d'elle, ou de la charte maison si elle ne l'a pas fixé —
      <a href={lien(`/admin/charte/${sonEnseigne.id}?portee=marque`)}> ouvrir sa charte</a>.
      Ce qu'on surcharge ici ne vaut que pour ce client.
    </p>
  )}

  {/* Le retour à l'héritage, d'un geste.
      Il ne s'affiche que s'il y a quelque chose à rendre : un bouton qui ne
      ferait rien apprend à ne pas lire les boutons. */}
  {!estMaison && surcharges > 0 && (
    <p class="bandeau bandeau--attente">
      <strong>{surcharges} valeur(s) surchargée(s)</strong> ici — elles l'emportent sur
      {estMarque ? ' la charte maison' : (sonEnseigne ? ` la charte de ${sonEnseigne.nom}` : ' la charte maison')},
      y compris sur ce qu'elle changera demain.
      <form method="post" class="rendre"
        onsubmit={`return confirm('Retirer les ${surcharges} surcharges ? Le brouillon repartira de ce qui est hérité — rien ne change pour le client tant que vous n\'avez pas publié.')`}>
        <input type="hidden" name="action" value="rendre" />
        <button class="bouton bouton--sobre bouton--sm" type="submit">
          {estMarque ? 'Rendre à la charte maison' : sonEnseigne ? `Rendre à ${sonEnseigne.nom}` : 'Rendre à la charte maison'}
        </button>
      </form>
    </p>
  )}
  {erreur && <p class="bandeau bandeau--erreur">{erreur}</p>}
  {message && <p class="bandeau bandeau--ok">{message}</p>}

  {enAttente && (
    <p class="bandeau bandeau--attente">
      <Icone nom="triangle-alert" taille={16} />
      <span>
        <strong>Brouillon</strong> — ces valeurs ne sont pas encore servies. Le client reçoit
        toujours <span class="mono">v{publie.version}</span>.
      </span>
    </p>
  )}

  <div class="entete">
    <div>
      <h2>{nom}</h2>
      <p class="sous">
        {estMaison
          ? 'Les défauts appliqués à tous les clients qui ne surchargent rien.'
          : `${surcharges} personnalisation(s) sur ${REGISTRE.length} · version servie v${publie.version}`}
      </p>
    </div>
    {lienClient && (
      <a class="lien" href={lienClient} target="_blank" rel="noreferrer">
        <Icone nom="external-link" taille={14} /> page charte du client
      </a>
    )}
    <form method="post">
      <input type="hidden" name="action" value="publier" />
      <button class="bouton" type="submit" disabled={!enAttente || Object.keys(erreursCouple).length > 0}>
        <Icone nom="upload" taille={15} />
        {Object.keys(erreursCouple).length > 0 ? 'Corriger l’erreur d’abord' : `Publier v${publie.version + 1}`}
      </button>
    </form>
  </div>

  <div class="bloc">
    {resolutions.map((r) => {
      const v = REGISTRE.find((x) => x.cle === r.cle);
      const err = erreursCouple[r.cle];
      const surcharge = r.depuis === 'client';
      return (
        <div class:list={['ligne', surcharge && 'ligne--surcharge']}>
          <div class="ligne__quoi">
            <span class="ligne__libelle">{v.libelle}</span>
            <span class="mono ligne__cle">{r.cle} · {v.type}</span>
            {v.aide && <span class="ligne__aide">{v.aide}</span>}
            {err && <span class="ligne__erreur"><Icone nom="circle-alert" taille={13} /> {err}</span>}
          </div>

          <form class="ligne__champ" method="post">
            <input type="hidden" name="cle" value={r.cle} />
            {v.type === 'liste' ? (
              <select name="valeur" onchange="this.form.submit()">
                {v.options.map((o) => (
                  <option value={o.valeur} selected={o.valeur === r.valeur}>{o.libelle}</option>
                ))}
              </select>
            ) : v.type === 'couleur' ? (
              <span class="couleur">
                <span class="pastille" style={`background:${r.valeur}`} aria-hidden="true"></span>
                <input type="text" name="valeur" value={r.valeur ?? ''} size="9" />
              </span>
            ) : (
              <input type="text" name="valeur" value={r.valeur ?? ''} />
            )}
            <button class="bouton bouton--sobre" type="submit">Enregistrer</button>
          </form>

          <div class="ligne__etat">
            <span class:list={['jeton', surcharge ? 'jeton--client' : 'jeton--herite']}>
              {surcharge ? 'Surchargé' : `Hérité — ${COUCHES[r.depuis]}`}
            </span>
            {surcharge && (
              <form method="post">
                <input type="hidden" name="action" value="reinitialiser" />
                <input type="hidden" name="cle" value={r.cle} />
                <button class="reinit" type="submit">Réinitialiser</button>
              </form>
            )}
          </div>
        </div>
      );
    })}
  </div>

  <p class="note">
    Une ligne absente vaut héritage : « Réinitialiser » <strong>supprime</strong> la surcharge, il ne
    stocke pas une valeur vide. Le contraste est indicatif ici et bloquant à la publication — il faut
    pouvoir poser une couleur claire puis changer son encre.
  </p>

  {lienClient && (
    <div class="bloc partage">
      <h3>Le lien à remettre au client</h3>
      <p class="note">
        Il montre la charte <strong>publiée</strong>, pas le brouillon, et reste valable après chaque
        publication. Signé, donc non devinable : changer le numéro dans l'URL n'ouvre la charte de
        personne d'autre.
      </p>
      <input class="mono" type="text" readonly value={new URL(lienClient, Astro.url).href} onclick="this.select()" />
    </div>
  )}


  <div class="bloc import">
    <h3>Importer une charte existante</h3>
    <p class="note">
      La feuille est <strong>lue</strong>, pas installée. On y cherche les variables qui décrivent
      une marque et on les reporte ci-dessus ; rien de son contenu n'atteint une balise{' '}
      <span class="mono">&lt;style&gt;</span>. Le CSS n'est pas inerte — un{' '}
      <span class="mono">url()</span> dans un sélecteur d'attribut exfiltre ce qu'un utilisateur
      tape, et une règle <span class="mono">content</span> réécrit ce qu'un client lit. Ce qui n'a
      pas pu être repris est affiché, jamais ignoré en silence.
    </p>
    <form method="post" enctype="multipart/form-data">
      <input type="hidden" name="action" value="import-css" />
      <textarea name="colle" rows="7" class="colle" spellcheck="false"
                placeholder={':root {\n  --brand: #7A1F3D;\n  --accent: rgb(212, 160, 23);\n  --radius-card: 8px;\n}'}></textarea>
      <div class="enligne">
        <button class="bouton bouton--sobre" type="submit">
          <Icone nom="download" taille={15} /> Lire ce CSS
        </button>
        <span class="ou">ou depuis un fichier</span>
        <input type="file" name="feuille" accept=".css,text/css" />
      </div>
    </form>

    {rapport && (
      <div class="rapport">
        <p class="aide">
          {rapport.taille.blocs} bloc(s) lus · {Math.round(rapport.taille.octets / 1024)} ko
          {rapport.taille.fontFaces > 0 && ` · ${rapport.taille.fontFaces} @font-face non repris — importez les fichiers ci-dessous`}
          {rapport.taille.imports > 0 && ` · ${rapport.taille.imports} @import ignoré(s) : ils feraient charger depuis un hôte que personne n'a vérifié`}
        </p>

        {rapport.repris.length > 0 && (
          <>
            <h4>Repris</h4>
            <div class="jetons">
              {rapport.repris.map((r) => (
                <span class="jeton jeton--client">
                  <span class="mono">{r.depuis}</span> → {r.libelle} <b class="mono">{r.valeur}</b>
                </span>
              ))}
            </div>
          </>
        )}

        {rapport.ignores.length > 0 && (
          <>
            <h4>Vu, non repris — {rapport.ignores.length} variable(s)</h4>
            <div class="jetons">
              {rapport.ignores.map((v) => (
                <span class="jeton jeton--herite mono">{v.nom}</span>
              ))}
            </div>
          </>
        )}
      </div>
    )}
  </div>

  <details class="bloc import">
    <summary>Le CSS que produit cette charte</summary>
    <p class="aide">
      Ce que le client reçoit, à l'instant, brouillon compris. À relire, ou à reprendre dans un
      autre outil — l'import n'est pas un aller sans retour.
    </p>
    <textarea class="colle colle--sortie" rows="10" readonly spellcheck="false"
              onclick="this.select()">{feuilleProduite}</textarea>
  </details>

  <div class="bloc import">
    <h3>Les polices du client</h3>
    <p class="note">
      Un fichier de police est un binaire inerte : il se dessine, il ne s'exécute pas. C'est
      pourquoi il est accepté tel quel là où le CSS ne l'est pas. Le{' '}
      <span class="mono">@font-face</span> est fabriqué à partir de ce que vous déclarez ici, jamais
      repris du fichier. Pour les utiliser, choisissez{' '}
      <em>« Les polices importées du client »</em> dans les réglages de police ci-dessus.
    </p>

    {polices.length > 0 && (
      <div class="roule">
        <table class="polices">
          <tbody>
            {polices.map((p) => (
              <tr>
                <td><b>{p.famille}</b></td>
                <td class="mono">{p.graisse} · {p.style === 'italic' ? 'italique' : 'normal'} · {p.format}</td>
                <td>{ROLES.find((r) => r.valeur === p.role)?.libelle || p.role}</td>
                <td class="mono">{Math.round(p.octets / 1024)} ko</td>
                <td class="fin">
                  <form method="post" class="enligne">
                    <input type="hidden" name="action" value="police-suppression" />
                    <input type="hidden" name="police_id" value={p.id} />
                    <button class="reinit" type="submit">Retirer</button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <form method="post" enctype="multipart/form-data" class="ajout">
      <input type="hidden" name="action" value="police" />
      <label class="mini"><span>Famille</span>
        <input type="text" name="famille" placeholder="Belleville Sans" required />
      </label>
      <label class="mini"><span>Rôle</span>
        <select name="role">{ROLES.map((r) => <option value={r.valeur}>{r.libelle}</option>)}</select>
      </label>
      <label class="mini"><span>Graisse</span>
        <select name="graisse">{GRAISSES.map((g) => <option value={g} selected={g === '400'}>{g}</option>)}</select>
      </label>
      <label class="mini"><span>Style</span>
        <select name="style">{STYLES.map((s) => <option value={s.valeur}>{s.libelle}</option>)}</select>
      </label>
      <label class="mini fichier"><span>Fichier</span>
        <input type="file" name="fichier" accept={TYPES_ACCEPTES} required />
      </label>
      <button class="bouton bouton--sobre" type="submit">
        <Icone nom="upload" taille={15} /> Importer
      </button>
    </form>
    <p class="aide">
      woff2, woff, otf ou ttf — reconnu aux premiers octets, pas à l'extension. 2 Mo maximum : une
      woff2 latine en pèse une trentaine de kilo-octets, et une caisse en 3G ne télécharge pas
      davantage.
    </p>
  </div>

  {journal.length > 0 && (
    <div class="bloc">
      <h3>Publications</h3>
      {journal.map((e) => (
        <div class="journal">
          <span class="mono jeton jeton--client">v{e.version}</span>
          <span class="mono">{String(e.publieLe).replace('T', ' ').slice(0, 16)}</span>
          <span>{e.publiePar || '—'}</span>
          <span class="journal__cles">
            {e.modifiees.length === 0
              ? 'aucune valeur modifiée'
              : e.modifiees.map((c) => <span class="mono cle-modifiee">{c}</span>)}
          </span>
        </div>
      ))}
    </div>
  )}
</Console>

