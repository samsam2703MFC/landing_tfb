# Frontal HTTPS. Caddy obtient et renouvelle le certificat tout seul :
# il suffit que le domaine pointe vers ce serveur (A/AAAA) et que les
# ports 80 et 443 soient ouverts.

{
	# Adresse utilisée par Let's Encrypt pour les alertes d'expiration.
	email {$ACME_EMAIL:admin@localhost}
}

# SITE_ADDRESS vaut le domaine (HTTPS automatique) ou « :80 » quand aucun
# domaine n'est configuré — le site est alors servi en clair sur l'IP.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy web:4321
}
