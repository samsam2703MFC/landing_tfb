# ---------------------------------------------------------------------------
# landing-tfb — variables d'environnement
#
# Copier en `.env` dans infra/ sur le serveur (jamais commité). Aucune valeur
# en dur ailleurs dans le projet : tout passe par ces variables.
#
# Les noms DB_LOGIN / DB_NAME / DB_PASS / SSH_* reprennent exactement les
# secrets GitHub déjà présents sur le dépôt.
# ---------------------------------------------------------------------------

# --- Base de données existante ---------------------------------------------
# `pg` (PostgreSQL) ou `mysql` (MySQL / MariaDB).
# Le pipeline y crée trois tables : tfb_modules, tfb_fonctions, tfb_site.
DB_CLIENT=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_LOGIN=tfb_landing
DB_NAME=tfb_landing
DB_PASS=change-moi

# --- Montage ----------------------------------------------------------------
# Chemin sous lequel la landing est servie, à côté des autres applications du
# serveur : https://<serveur>/landing_tfb/. Mettre « / » pour servir à la
# racine d'un domaine dédié. Lu au BUILD — un changement impose un déploiement.
BASE_PATH=/landing_tfb

# --- Domaine et ports -------------------------------------------------------
# Laisser vide tant qu'aucun domaine ne pointe vers ce serveur : la landing
# est alors servie en HTTP simple, joignable par l'IP.
SITE_DOMAIN=
# Ports publiés sur l'hôte. Décalés par défaut pour ne pas percuter un serveur
# web déjà en place. Dès qu'un domaine est configuré, mettre 80 et 443 pour
# que Caddy obtienne le certificat tout seul.
HTTP_PORT=8090
HTTPS_PORT=8443
# Adresse à laquelle Let's Encrypt signale l'expiration des certificats.
ACME_EMAIL=

# --- Console d'administration ------------------------------------------------
# Mot de passe unique d'accès à <BASE_PATH>/admin, où se modifie le contenu du
# site sans redéploiement. Tant qu'il est vide (ou laissé à « change-moi »),
# la console répond 503 : mieux vaut fermée qu'ouverte.
# 10 caractères minimum, sans apostrophe. Le changer déconnecte toutes les
# sessions ouvertes.
# Si le secret GitHub ADMIN_PASSWORD existe, cette ligne est réécrite à chaque
# déploiement à partir de sa valeur : le secret fait alors foi.
ADMIN_PASSWORD=
# Facultatif : clé de signature du cookie de session. Sans elle, elle est
# dérivée du mot de passe ci-dessus, ce qui suffit.
ADMIN_SECRET=

# --- Anthropic (ingestion seulement) ----------------------------------------
# Nécessaire uniquement pour lancer le pipeline ; la landing n'en a pas besoin.
ANTHROPIC_API_KEY=
# Modèle utilisé pour la génération de contenu (facultatif).
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- GitHub (ingestion seulement) -------------------------------------------
# Jeton de lecture sur les dépôts modules. Inutile si tous sont publics.
GH_INGEST_TOKEN=

# --- Réglage facultatif -----------------------------------------------------
# Durée du cache mémoire de la landing, en millisecondes.
CACHE_TTL_MS=60000
