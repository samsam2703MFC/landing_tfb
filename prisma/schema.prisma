// The Franchise Buddy — landing + back-office content schema.
// Table names, columns and constraints follow uploads/prompt_technique_tfb.md §2
// verbatim: snake_case, `tfb_` prefix, created_at / updated_at timestamps.
//
// Translatable copy is never a direct column — it goes through tfb_translations.
// Media is never a blob — the filesystem holds the file, the DB holds the path.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// §2.1 — the 8 active locales. 'fr' is is_default and the fallback for every
/// missing translation; 'ar' is is_rtl.
model Language {
  id        Int     @id @default(autoincrement())
  code      String  @unique @db.VarChar(5)
  name      String  @db.VarChar(50)
  isRtl     Boolean @default(false) @map("is_rtl")
  isActive  Boolean @default(true) @map("is_active")
  isDefault Boolean @default(false) @map("is_default")
  sortOrder Int     @default(0) @map("sort_order")

  translations Translation[]

  @@map("tfb_languages")
}

/// §2.2 — generic i18n store. Every string rendered on the landing is a row here.
model Translation {
  id           Int    @id @default(autoincrement())
  entityType   String @map("entity_type") @db.VarChar(50)
  entityId     Int    @map("entity_id")
  field        String @db.VarChar(50)
  languageCode String @map("language_code") @db.VarChar(5)
  value        String @db.Text

  language Language @relation(fields: [languageCode], references: [code], onDelete: Cascade, onUpdate: Cascade)

  @@unique([entityType, entityId, field, languageCode], map: "uq_translation_scope")
  @@index([entityType, entityId])
  @@index([languageCode])
  @@map("tfb_translations")
}

/// §2.3 — enseignes shown in the trust strip.
model Brand {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(120)
  slug       String   @unique @db.VarChar(120)
  logoPath   String?  @map("logo_path") @db.VarChar(255)
  websiteUrl String?  @map("website_url") @db.VarChar(255)
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  sections      Section[]
  subscriptions Subscription[]

  @@map("tfb_brands")
}

/// §2.4 — landing sections: which ones render, and in what order.
/// `config` holds display parameters only; never copy.
model Section {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(80)
  type      String   @db.VarChar(50)
  brandId   Int?     @map("brand_id")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  config    Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([brandId])
  @@map("tfb_sections")
}

/// §2.5 — modules, written by the morning routine when a new feature ships.
/// name / description / bullets / metric all live in tfb_translations.
model Module {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(80)
  slug        String   @unique @db.VarChar(120)
  redirectUrl String?  @map("redirect_url") @db.VarChar(255)
  repo        String?  @db.VarChar(150)
  moduleGroup String?  @map("module_group") @db.VarChar(80)
  /// Icon file stem in public/icons — one glyph per module.
  icon        String?  @db.VarChar(60)
  isActive    Boolean  @default(true) @map("is_active")
  isNew       Boolean  @default(true) @map("is_new")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  screenshots ModuleScreenshot[]
  packs       PackModule[]
  overrides   LicenseOverride[]

  @@map("tfb_modules")
}

/// §2.6 — one row per carousel frame. `file_path` is a relative server path.
model ModuleScreenshot {
  id        Int      @id @default(autoincrement())
  moduleId  Int      @map("module_id")
  filePath  String   @map("file_path") @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@map("tfb_module_screenshots")
}

/// §2.7 — plans. `amount` is in cents; NULL means "sur devis" (talk to sales).
model Plan {
  id            Int      @id @default(autoincrement())
  key           String   @unique @db.VarChar(80)
  stripePriceId String?  @map("stripe_price_id") @db.VarChar(120)
  amount        Int?
  currency      String   @default("EUR") @db.VarChar(3)
  interval      String   @db.VarChar(20)
  isActive      Boolean  @default(true) @map("is_active")
  isFeatured    Boolean  @default(false) @map("is_featured")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("tfb_plans")
}

/// §21 — a pack IS a Stripe product. Its prices are Stripe prices; what it opens
/// is `tfb_pack_modules`, here, in our database.
///
/// Stripe says what is paid, we say what that grants. The composition never goes
/// into Stripe metadata: an authorisation model editable from a dashboard text
/// field is not an authorisation model.
///
/// A pack with no `stripe_product_id` cannot be sold and never reaches the landing.
model Pack {
  id              Int      @id @default(autoincrement())
  key             String   @unique @db.VarChar(80)
  stripeProductId String?  @unique @map("stripe_product_id") @db.VarChar(120)
  /// subscription | one_time | addon | free | purchase — how it is billed, not
  /// what it opens. `purchase` is §15's outright application purchase.
  kind            String   @default("subscription") @db.VarChar(20)
  /// Icon file stem in public/icons.
  icon            String?  @db.VarChar(60)
  isActive        Boolean  @default(false) @map("is_active")
  isFeatured      Boolean  @default(false) @map("is_featured")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  prices  PackPrice[]
  modules PackModule[]

  @@map("tfb_packs")
}

/// §21.2 — the billing variants of one pack. Monthly, yearly and one-off are three
/// prices of the same product, not three packs.
model PackPrice {
  id            Int      @id @default(autoincrement())
  packId        Int      @map("pack_id")
  stripePriceId String   @unique @map("stripe_price_id") @db.VarChar(120)
  /// In cents. NULL means "sur devis" — routed to the contact form, never to Checkout.
  amount        Int?
  currency      String   @default("EUR") @db.VarChar(3)
  /// month | year | one_time
  interval      String   @db.VarChar(20)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  pack Pack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId])
  @@map("tfb_pack_prices")
}

/// §21.1 — the composition: which modules a pack opens.
model PackModule {
  packId    Int      @map("pack_id")
  moduleId  Int      @map("module_id")
  createdAt DateTime @default(now()) @map("created_at")

  pack   Pack   @relation(fields: [packId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([packId, moduleId])
  @@index([moduleId])
  @@map("tfb_pack_modules")
}

/// §21.2 — a module opened or closed outside the pack, for one licence.
///
/// `license_id` is the billing service's own id, kept as a string: that service
/// owns licences and this table must not pretend otherwise. There is no foreign
/// key across the service boundary, on purpose.
///
/// No unique constraint on (license_id, module_id): the newest row that is neither
/// revoked nor expired wins, and the older ones stay as the audit trail. A partial
/// unique index would say this better, but MySQL has none — so the resolver
/// enforces it, and `revoked_at` is what retires a derogation.
model LicenseOverride {
  id        Int       @id @default(autoincrement())
  licenseId String    @map("license_id") @db.VarChar(64)
  moduleId  Int       @map("module_id")
  /// true = opened despite the pack. false = closed despite the pack.
  grant     Boolean
  /// Why. Required — an untraceable derogation is how access drifts.
  reason    String    @db.Text
  expiresAt DateTime? @map("expires_at")
  createdBy String    @map("created_by") @db.VarChar(150)
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  revokedBy String?   @map("revoked_by") @db.VarChar(150)

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@index([moduleId])
  @@map("tfb_license_overrides")
}

/// §17 — an agent who brings or supports clients.
model Agent {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(150)
  email     String   @unique @db.VarChar(150)
  /// commercial | technique — what they are paid for, not what they are called.
  kind      String   @default("commercial") @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignments AgentAssignment[]

  @@map("tfb_agents")
}

/// §17 — a negotiated split, named and reusable.
///
/// "30 %" and "90 % the first year then 20 %" are both plans; the difference is
/// how many tiers they have. Storing a bare percentage on each client instead
/// would make every renegotiation a search-and-replace across rows, and make it
/// impossible to say later which deal someone was actually on.
model CommissionPlan {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(80)
  label     String   @db.VarChar(150)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tiers       CommissionTier[]
  assignments AgentAssignment[]

  @@map("tfb_commission_plans")
}

/// §17 — one step of a plan: from this many months of seniority, this rate.
model CommissionTier {
  id        Int @id @default(autoincrement())
  planId    Int @map("plan_id")
  /// Months of seniority at which this tier starts. 0 is the first year.
  fromMonth Int @map("from_month")
  /// Basis points: 9000 = 90,00 %. Never a float — money computed from a float
  /// is money that disagrees with itself at the fourth decimal.
  percentBp Int @map("percent_bp")

  plan CommissionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, fromMonth], map: "uq_tier_start")
  @@index([planId])
  @@map("tfb_commission_tiers")
}

/// §17 — this agent handles this client, on this plan, from this date.
///
/// `tenant_slug` is the billing service's own identifier, kept as a plain string:
/// that service owns tenants, and a foreign key across the boundary would be a
/// lie. Same reasoning as tfb_license_overrides.
///
/// `ended_at` rather than deletion: a closed assignment still explains the
/// commissions paid while it was open.
model AgentAssignment {
  id         Int       @id @default(autoincrement())
  agentId    Int       @map("agent_id")
  tenantSlug String    @map("tenant_slug") @db.VarChar(120)
  /// Restricts the assignment to one pack. NULL covers everything the client buys.
  packKey    String?   @map("pack_key") @db.VarChar(80)
  planId     Int?      @map("plan_id")
  /// Seniority is counted from here — not from the invoice, and not from the
  /// client's own start date. A client handed to another agent restarts at the
  /// first tier with them, and the previous assignment ends the same day.
  startedAt  DateTime  @map("started_at")
  endedAt    DateTime? @map("ended_at")
  note       String?   @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  agent Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  plan  CommissionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([tenantSlug])
  @@map("tfb_agent_assignments")
}

/// §16 — the commercial cycle's stages, in order.
model SalesStage {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(80)
  label     String   @db.VarChar(150)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tfb_sales_stages")
}

/// §16 — a service included in or sold alongside an offer.
model Service {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(80)
  label     String   @db.VarChar(150)
  /// In cents, like every other amount here. NULL = quoted case by case.
  amount    Int?
  currency  String   @default("EUR") @db.VarChar(3)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tfb_services")
}

/// §16 — the legal entity that issues the invoice.
model BillingEntity {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(80)
  name      String   @db.VarChar(150)
  vatNumber String?  @map("vat_number") @db.VarChar(40)
  address   String?  @db.VarChar(255)
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tfb_billing_entities")
}

/// §18 — every Stripe event we have accepted, by its own id.
///
/// Stripe redelivers until it gets a 2xx, so the same event arrives more than once
/// as a matter of course. `stripe_event_id` is unique: the second delivery is
/// recognised and skipped instead of applied twice.
///
/// `created` is Stripe's own timestamp, not ours. Delivery order is not guaranteed,
/// and an older `customer.subscription.updated` overtaking a newer one would roll a
/// subscription's status backwards — comparing this field is what prevents it.
model StripeEvent {
  id            Int      @id @default(autoincrement())
  stripeEventId String   @unique @map("stripe_event_id") @db.VarChar(120)
  type          String   @db.VarChar(120)
  /// Seconds since the epoch, as Stripe sends it.
  created       Int
  /// applied | skipped | ignored | failed — what we did, not what Stripe sent.
  outcome       String   @db.VarChar(20)
  /// One line of why, for the console. Never the payload: it carries customer data.
  detail        String?  @db.VarChar(255)
  receivedAt    DateTime @default(now()) @map("received_at")

  @@index([receivedAt])
  @@index([type])
  @@map("tfb_stripe_events")
}

/// §2.8 — subscriptions, kept in sync by the Stripe webhook.
model Subscription {
  id                   Int       @id @default(autoincrement())
  brandId              Int?      @map("brand_id")
  email                String    @db.VarChar(150)
  stripeCustomerId     String?   @map("stripe_customer_id") @db.VarChar(120)
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id") @db.VarChar(120)
  planId               Int       @map("plan_id")
  status               String    @db.VarChar(30)
  currentPeriodEnd     DateTime? @map("current_period_end")
  /// Stripe's own timestamp for the last event applied to this row. Delivery order
  /// is not guaranteed, so an event older than this one is stale and is skipped —
  /// without it, a late `updated` rolls the status backwards.
  lastEventCreated     Int?      @map("last_event_created")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  brand Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  plan  Plan   @relation(fields: [planId], references: [id])

  @@index([brandId])
  @@index([planId])
  @@map("tfb_subscriptions")
}

/// §2.9 — contact form submissions. status: new | read | archived.
model ContactMessage {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(120)
  email        String   @db.VarChar(150)
  company      String?  @db.VarChar(150)
  message      String   @db.Text
  languageCode String?  @map("language_code") @db.VarChar(5)
  status       String   @default("new") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([status])
  @@map("tfb_contact_messages")
}

/// §2.10 — back-office accounts. role: superadmin | admin.
model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         String   @default("admin") @db.VarChar(30)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("tfb_admin_users")
}

/// §2.11 — global key/value settings.
model Setting {
  key   String @id @db.VarChar(120)
  value Json

  @@map("tfb_settings")
}
