---
/**
 * Fiche d'un module, d'après la maquette Claude Design.
 *
 * Le parti pris : ce que le module fait disparaître, ce qu'il apporte et ce
 * qu'il échange tiennent en trois colonnes lisibles d'un coup d'œil. Le détail
 * — description longue, entrées de menu, flux — est replié, parce qu'un
 * franchiseur ne le lit qu'après avoir décidé que le module l'intéresse.
 */
import { marked } from 'marked';
import Layout from '../../components/Layout.astro';
import Icone from '../../components/Icone.astro';
import Pastille from '../../components/Pastille.astro';
import { chargerModule, chargerModules } from '../../lib/db.mjs';
import { leviersDe } from '../../lib/leviers.mjs';
import { lien } from '../../lib/lien.mjs';

const { slug } = Astro.params;
const module = await chargerModule(slug);

if (!module) {
  return new Response('Module introuvable', { status: 404 });
}

const modules = await chargerModules();
const parSlug = new Map(modules.map((m) => [m.slug, m]));
const autres = modules.filter((m) => m.slug !== module.slug);

const problemes = module.problemes || [];
const benefices = module.benefices || [];
const fonctions = module.fonctions || [];
const captures = module.captures || [];
const liens = (module.liens || []).map((l) => ({
  ...l,
  nom: parSlug.get(l.slug)?.nom || l.slug,
  sortant: l.sens !== 'recoit',
}));

// La description est du markdown ; on la découpe en paragraphes pour la
// disposer en deux colonnes plutôt qu'en un seul pavé.
const paragraphes = String(module.description || '')
  .split(/\n{2,}/)
  .map((p) => p.trim())
  .filter(Boolean)
  .map((p) => marked.parseInline(p));

const icone = module.icone || fonctions[0]?.icone || 'layers';
---

<Layout titre={module.nom || module.slug} description={module.accroche} actif="modules">
  <!-- ── En-tête ─────────────────────────────────────────────────────── -->
  <section class="fiche-tete">
    <div class="dedans">
      <nav class="miette">
        <a href={lien('/#modules')}>Modules</a>
        <Icone nom="chevron-right" taille={14} classe="icone--miroir" />
        <span>{module.nom || module.slug}</span>
      </nav>
      <div class="fiche-tete__ligne">
        <span class="fiche-tete__icone"><Icone nom={icone} taille={24} /></span>
        <div class="fiche-tete__texte">
          <h1 class="fiche-tete__nom">{module.nom || module.slug}</h1>
          <p class="chapo chapo--clair">{module.accroche}</p>
        </div>
        <span class="pastilles">
          {leviersDe(module.leviers).map((l) => <Pastille levier={l} />)}
        </span>
      </div>
    </div>
  </section>

  <!-- ── Ce qu'il fait disparaître / apporte / échange ────────────────── -->
  <section class="bande bande--serree">
    <div class="dedans trois">
      <div class="colonne">
        <span class="oeil">Fait disparaître</span>
        <ul class="puces">
          {problemes.map((p) => (
            <li title={p.texte}><span class="puce puce--rouge"></span>{p.titre}</li>
          ))}
          {problemes.length === 0 && <li class="colonne__vide">Non renseigné.</li>}
        </ul>
      </div>

      <div class="colonne">
        <span class="oeil">Apporte</span>
        <ul class="puces">
          {benefices.map((b) => (
            <li title={b.texte}><span class="puce puce--verte"></span>{b.titre}</li>
          ))}
          {benefices.length === 0 && <li class="colonne__vide">Non renseigné.</li>}
        </ul>
      </div>

      <div class="colonne">
        <span class="oeil">Échange avec</span>
        <ul class="puces">
          {liens.map((l) => (
            <li title={l.quoi}>
              <span class={`icone-flux ${l.sortant ? 'icone-flux--sort' : 'icone-flux--entre'}`}>
                <Icone nom={l.sortant ? 'arrow-right' : 'arrow-left'} taille={14} classe="icone--miroir" />
              </span>
              <a href={lien(`/modules/${l.slug}`)}>{l.nom}</a>
            </li>
          ))}
          {liens.length === 0 && <li class="colonne__vide">Aucun échange déclaré.</li>}
        </ul>
        {module.public_cible && <p class="colonne__note">{module.public_cible}</p>}
      </div>
    </div>
  </section>

  <!-- ── Les écrans ──────────────────────────────────────────────────── -->
  {captures.length > 0 && (
    <section class="bande bande--serree">
      <div class="dedans centre">
        <span class="oeil">Les écrans</span>
        <ul class="defile" role="list">
          {captures.map((c) => (
            <li class="defile__vue">
              <figure class="capture">
                <img src={lien(`/captures/${c.fichier}`)} alt={c.titre || module.nom} loading="lazy" decoding="async" />
                {c.titre && <figcaption class="capture__pied">{c.titre}</figcaption>}
              </figure>
            </li>
          ))}
        </ul>
        {captures.length > 1 && (
          <p class="defile__note">{captures.length} écrans — faites défiler horizontalement.</p>
        )}
      </div>
    </section>
  )}

  <!-- ── Le menu ─────────────────────────────────────────────────────── -->
  {fonctions.length > 0 && (
    <section class="bande bande--serree">
      <div class="dedans">
        <div class="menu-tete">
          <span class="oeil">Le menu</span>
          <span class="fb-num menu-compte">{fonctions.length} entrées</span>
        </div>
        <div class="menu-grille">
          {fonctions.map((f) => (
            <span class="menu-puce" title={`${f.description || ''}${f.benefice ? `\n→ ${f.benefice}` : ''}`}>
              <span class="menu-puce__nom">{f.nom || f.cle}</span>
              <span class="pastilles">
                {leviersDe(f.leviers).map((l) => <Pastille levier={l} />)}
              </span>
            </span>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── Le détail, replié ───────────────────────────────────────────── -->
  <section class="bande" style="padding-block-start:8px">
    <div class="dedans plis">
      {paragraphes.length > 0 && (
        <details class="pli">
          <summary class="pli__tete">
            <span class="h-bloc">Le module en détail</span>
            <Icone nom="chevron-down" taille={16} classe="pli__chevron" />
          </summary>
          <div class="pli__corps pli__corps--prose">
            <div class="colonnes-texte">
              {paragraphes.map((p) => <p set:html={p} />)}
            </div>
          </div>
        </details>
      )}

      {fonctions.length > 0 && (
        <details class="pli">
          <summary class="pli__tete">
            <span class="h-bloc">À quoi sert chaque entrée</span>
            <Icone nom="chevron-down" taille={16} classe="pli__chevron" />
          </summary>
          <div class="pli__corps pli__corps--prose">
            <ol class="entrees">
              {fonctions.map((f, i) => (
                <li>
                  <span class="fb-num entrees__num">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <p class="entrees__nom">
                      {f.nom || f.cle}
                      <span class="pastilles">{leviersDe(f.leviers).map((l) => <Pastille levier={l} />)}</span>
                    </p>
                    <p class="texte">{f.description}</p>
                    {f.benefice && <p class="entrees__gain">{f.benefice}</p>}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </details>
      )}

      {liens.length > 0 && (
        <details class="pli">
          <summary class="pli__tete">
            <span class="h-bloc">Le flux, en clair</span>
            <Icone nom="chevron-down" taille={16} classe="pli__chevron" />
          </summary>
          <div class="pli__corps pli__corps--prose">
            <ol class="entrees">
              {liens.map((l, i) => (
                <li>
                  <span class="fb-num entrees__num">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <p class="entrees__nom">
                      {l.sortant ? 'envoie vers' : 'reçoit de'}{' '}
                      <a href={lien(`/modules/${l.slug}`)}>{l.nom}</a>
                    </p>
                    <p class="texte">{l.quoi}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </details>
      )}
    </div>
  </section>

  <!-- ── Les autres modules ──────────────────────────────────────────── -->
  {autres.length > 0 && (
    <section class="bande bande--grise">
      <div class="dedans">
        <div class="entete-section" style="margin-block-end:24px">
          <span class="oeil">Le reste du catalogue</span>
          <h2 class="h-section">Les {autres.length} autres modules</h2>
        </div>
        <div class="grille-modules">
          {autres.map((m) => (
            <a class="module" href={lien(`/modules/${m.slug}`)}>
              <div class="module__tete">
                <span class="module__icone"><Icone nom={m.icone || m.fonctions?.[0]?.icone || 'layers'} taille={20} /></span>
                <span class="module__noms">
                  <span class="module__nom">{m.nom || m.slug}</span>
                  <span class="module__groupe">{m.groupe}</span>
                </span>
              </div>
              <p class="texte module__accroche">{m.accroche}</p>
              <div class="module__pied">
                <span class="pastilles">{leviersDe(m.leviers).map((l) => <Pastille levier={l} />)}</span>
                <span class="module__compte fb-num">{(m.fonctions || []).length} fonctions</span>
                <Icone nom="chevron-right" taille={14} classe="icone--miroir module__fleche" />
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>

<style is:global>
  /* ── En-tête de fiche ──────────────────────────────────────────────── */
  .fiche-tete { background: var(--gradient-ink); color: #fff; padding: 40px 40px 32px; }
  .miette {
    display: flex; align-items: center; gap: 10px;
    font: 400 var(--text-sm) / 1.3 var(--font-sans); color: rgba(255, 255, 255, 0.68);
    margin-block-end: 16px;
  }
  .miette a { color: rgba(255, 255, 255, 0.68); text-decoration: none; }
  .miette a:hover { color: #fff; }
  .miette > span:last-child { color: #fff; }
  .fiche-tete__ligne { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .fiche-tete__icone {
    display: inline-flex; align-items: center; justify-content: center;
    inline-size: 46px; block-size: 46px; border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.16);
    color: #fff; flex: none;
  }
  .fiche-tete__texte { display: flex; flex-direction: column; gap: 4px; min-inline-size: 0; flex: 1; }
  .fiche-tete__nom {
    margin: 0; color: #fff;
    font: 700 var(--text-3xl) / 1.12 var(--font-display); letter-spacing: var(--tracking-display);
  }
  .fiche-tete .chapo { max-width: 64ch; font-size: var(--text-base); }
  @media (max-width: 820px) { .fiche-tete { padding: 28px 20px; } }

  /* ── Les trois colonnes ────────────────────────────────────────────── */
  .trois { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 32px; }
  .colonne { display: flex; flex-direction: column; gap: 10px; }
  .puces { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 7px; }
  .puces li {
    display: flex; gap: 9px; align-items: baseline;
    font: 500 14px/1.45 var(--font-sans); cursor: help;
  }
  .puces a { text-decoration: none; }
  .puce { inline-size: 6px; block-size: 6px; border-radius: 2px; flex: none; transform: translateY(-2px); }
  .puce--rouge { background: var(--red-500); }
  .puce--verte { background: var(--teal-500); }
  .icone-flux { flex: none; }
  .icone-flux--sort { color: var(--plum-600); }
  .icone-flux--entre { color: var(--teal-700); }
  .colonne__vide { color: var(--slate-400); font-weight: 400; cursor: default; }
  .colonne__note { margin: 4px 0 0; font: 400 12.5px/1.5 var(--font-sans); color: var(--slate-400); }

  /* ── Défilé de captures ────────────────────────────────────────────── */
  .centre { display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .defile {
    list-style: none; margin: 0; padding: 0;
    display: flex; gap: 16px;
    inline-size: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    padding-block-end: 8px;
  }
  .defile__vue { flex: 0 0 min(660px, 88%); scroll-snap-align: center; }
  .defile__vue .capture { display: block; margin: 0; }
  .defile__note { margin: 0; font: 400 var(--text-xs) / 1.4 var(--font-sans); color: var(--slate-400); }

  /* ── Le menu ───────────────────────────────────────────────────────── */
  .menu-tete { display: flex; align-items: baseline; gap: 10px; margin-block-end: 12px; }
  .menu-compte { font: 500 var(--text-xs) / 1 var(--font-mono); color: var(--slate-400); }
  .menu-grille { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 6px; }
  .menu-puce {
    display: flex; align-items: center; gap: 8px;
    background: var(--slate-50); border: 1px solid var(--slate-100);
    border-radius: var(--radius-control); padding: 8px 10px;
    cursor: help;
    transition: var(--transition-control);
  }
  .menu-puce:hover { border-color: var(--slate-300); background: #fff; }
  .menu-puce__nom {
    font: 500 13px/1.3 var(--font-sans);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    flex: 1; min-inline-size: 0;
  }
  .menu-puce .pastilles { margin-inline-start: auto; }

  /* ── Contenu replié ────────────────────────────────────────────────── */
  .pli__corps--prose { display: block; }
  .colonnes-texte { columns: 2 380px; column-gap: 40px; }
  .colonnes-texte p {
    margin: 0 0 14px;
    font: 400 14.5px/1.68 var(--font-sans); color: var(--slate-700);
    break-inside: avoid-column;
  }
  .entrees { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .entrees li {
    display: flex; gap: 14px; align-items: baseline;
    padding-block: 12px; border-block-end: 1px solid var(--slate-100);
  }
  .entrees li:last-child { border-block-end: 0; }
  .entrees__num { font: 500 13px/1 var(--font-mono); color: var(--plum-600); flex: none; inline-size: 24px; }
  .entrees__nom {
    margin: 0 0 3px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    font: 600 14.5px/1.35 var(--font-sans);
  }
  .entrees__gain {
    margin: 4px 0 0;
    font: 500 12.5px/1.5 var(--font-sans); color: var(--teal-700);
  }
</style>
