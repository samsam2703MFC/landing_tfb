---
/**
 * Étape 2 — ce que nous allons lire, et ce que nous ne lirons pas.
 *
 * L'écran qui rassure, et il n'existe pas en version générale : ce qui est
 * écrit à gauche est exactement ce que la connexion ira chercher, calculé
 * depuis les modules cochés. La colonne de droite, elle, ne dépend de rien —
 * c'est une promesse, et elle vaut pour tout le monde.
 */
import Console from '../../../../components/Console.astro';
import Icone from '../../../../components/Icone.astro';
import { chargerProspect, compteurs } from '../../../../lib/admin/donnees.mjs';
import { etatParcours, marquerEtape, ouvrirParcours } from '../../../../lib/admin/onboarding.mjs';

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
const { prospect: prospectId } = Astro.params;
let erreur = null;

if (Astro.request.method === 'POST') {
  try {
    const parcours = await ouvrirParcours(prospectId);
    await marquerEtape(parcours.id, 'prerequis', {
      utilisateurId: (Astro.locals.session || {}).id || null,
    });
    return Astro.redirect(`${BASE}/admin/onboarding/${prospectId}/parc`, 303);
  } catch (err) {
    erreur = err.message;
  }
}

let prospect = null;
let etat = null;
let chiffres = {};
try {
  prospect = await chargerProspect(prospectId);
  if (prospect) etat = await etatParcours(prospect.id);
  chiffres = await compteurs();
} catch (err) {
  // Pas de « base injoignable » systématique : ces écrans échouent pour
  // beaucoup de raisons — une clé qui ne se déchiffre plus, une caisse qui ne
  // répond pas — et coller la mauvaise cause fait chercher au mauvais endroit.
  erreur = erreur || err.message;
}

if (!prospect && !erreur) return new Response('Client introuvable', { status: 404 });
const message = Astro.url.searchParams.get('ok');
---

<Console
  titre="Ce que nous allons lire"
  fil={`TFB Admin · Onboarding · ${prospect?.raison_sociale || ''}`}
  actif="onboarding"
  message={message}
  erreur={erreur}
  compteurs={chiffres}
>
  {prospect && etat && (
    <form method="post">
      <div class="barre-actions">
        <a class="bouton bouton--sobre bouton--sm" href={`${BASE}/admin/onboarding/${prospect.id}/modules`}>
          <Icone nom="arrow-left" taille={16} /> Les modules
        </a>
        <button class="bouton bouton--marque" type="submit">J'ai compris, continuer</button>
      </div>

      <section class="bloc" style="margin-block-end:20px">
        <div class="bloc__tete">
          <div>
            <h2>Étape 2 — Ce que nous allons lire, et ce que nous ne lirons pas</h2>
            <p>
              La colonne de gauche est calculée depuis vos {etat.retenus.length} module(s) : c'est
              exactement ce que la connexion ira chercher, ni plus, ni moins.
            </p>
          </div>
        </div>

        <div class="bloc__corps">
          <div class="duo">
            <div class="promesse promesse--oui">
              <h3><Icone nom="circle-check" taille={16} /> Nous lisons</h3>
              <ul>
                {etat.capacites.requises.map((c) => (
                  <li><strong>{c.capacite}</strong> — pour {c.modules.join(', ')}.</li>
                ))}
                {etat.capacites.optionnelles.map((c) => (
                  <li>
                    <strong>{c.capacite}</strong> <span class="etat">si disponible</span>
                    <span class="champ__aide">{c.note_degradee}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="promesse promesse--non">
              <h3><Icone nom="x" taille={16} /> Nous ne lisons pas, et n'écrivons jamais</h3>
              <ul>
                <li>
                  Aucune <strong>donnée de vos clients finaux</strong> — nom, courriel, téléphone.
                  Elles sont retirées avant écriture, pas après.
                </li>
                <li>Aucun <strong>stock</strong>, aucun <strong>employé</strong>, aucune commande fournisseur.</li>
                <li>
                  <strong>Rien n'est écrit dans votre caisse.</strong> L'accès demandé est en
                  lecture seule, et le flux ne va que dans un sens.
                </li>
              </ul>
            </div>
          </div>
        </div>

        <div class="bloc__pied">
          Vos indicateurs, vos six leviers, votre food cost, vos objectifs et vos alertes sont
          <strong>calculés chez nous</strong> à partir de ces seules lignes. Votre caisse n'en sait
          rien et n'a rien à faire.
        </div>
      </section>

      <section class="bloc">
        <div class="bloc__tete">
          <div>
            <h2>Une seule connexion par caisse</h2>
            <p>
              Vous avez coché {etat.retenus.length} module(s), et ils demandent
              {' '}{etat.capacites.requises.length} type(s) de donnée. Cela ne fait pas
              {' '}{etat.capacites.requises.length} branchements : une seule connexion par caisse
              les fournit tous.
            </p>
          </div>
        </div>
        <div class="bloc__pied">
          Si vos boutiques n'ont pas toutes la même caisse — c'est fréquent dans un réseau qui a
          grandi par rachats — il y aura une connexion par caisse, et vos chiffres se recolleront
          en un seul tableau de bord. C'est l'étape suivante.
        </div>
      </section>
    </form>
  )}
</Console>

