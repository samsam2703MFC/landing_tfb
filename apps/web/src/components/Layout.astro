---
/**
 * Gabarit des pages publiques, repris de la maquette Claude Design.
 *
 * Tout s'appuie sur les jetons du design system TFB, importés ci-dessous et
 * identiques à ceux du bundle de maquette — aucune couleur, aucun espacement
 * n'est écrit en dur.
 *
 * Deux règles tenues partout, parce que l'arabe arrivera :
 *   · propriétés logiques uniquement (`inline-size`, `margin-inline-start`…),
 *     jamais `left`/`right` ;
 *   · les glyphes directionnels portent `.icone--miroir` pour se retourner.
 */
import '../design-system/styles.css';
import Icone from './Icone.astro';
import { lien } from '../lib/lien.mjs';
import { chargerLangues } from '../lib/db.mjs';
import { textes } from '../lib/textes.mjs';

const {
  titre,
  description,
  large = false,      // 1200 px pour l'accueil, 1080 px pour les fiches
  fond = '#fff',
  actif = null,       // 'accueil' | 'modules' | 'contact'
} = Astro.props;

const t = await textes();

// La marque et le titre de repli viennent de la base : rien à recompiler
// pour changer ce que lit un onglet de navigateur.
const marque = t('site.marque');
const titreComplet = titre ? `${titre} — ${marque}` : `${marque} — ${t('site.titre_defaut')}`;
const canonique = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const largeur = large ? '1200px' : '1080px';

// Les langues publiées seulement : un sélecteur qui propose une langue non
// traduite mentirait au visiteur.
const langues = (await chargerLangues()).filter((l) => l.publiee);

const NAV = [
  { cle: 'accueil', libelle: t('nav.accueil'), href: '/' },
  { cle: 'modules', libelle: t('nav.modules'), href: '/#modules' },
  { cle: 'contact', libelle: t('nav.contact'), href: '/#contact' },
];
---

<html lang="fr" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    {description && <meta name="description" content={description} />}
    {canonique && <link rel="canonical" href={canonique} />}
    <meta property="og:title" content={titreComplet} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:image" content={lien('/brand/logo-mark.png')} />
    <meta name="theme-color" content="#0c1329" />
    <link rel="icon" type="image/png" href={lien('/brand/logo-mark.png')} />
    <link rel="apple-touch-icon" href={lien('/brand/logo-mark.png')} />

    <style is:global>
      html { scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

      body {
        font: var(--type-body);
        color: var(--navy-900);
        background: var(--fond-page, #fff);
      }

      /* ── Trames ────────────────────────────────────────────────────────── */
      .bande { padding: 96px 40px; }
      .bande--serree { padding: 40px 40px 8px; }
      .bande--sombre { background: var(--gradient-ink); color: #fff; }
      .bande--grise { background: var(--slate-50); }
      .dedans { max-width: var(--largeur, 1200px); margin: 0 auto; }

      /* ── Titres ────────────────────────────────────────────────────────── */
      .oeil {
        font: var(--weight-semibold) var(--text-xs) / 1.2 var(--font-sans);
        letter-spacing: var(--tracking-caps);
        text-transform: uppercase;
        color: var(--text-brand);
      }
      .oeil--clair { color: var(--ember-300); }
      .h-geant { margin: 0; font: 700 var(--text-6xl) / 1.08 var(--font-display); letter-spacing: var(--tracking-display); }
      .h-grand { margin: 0; font: 700 var(--text-5xl) / 1.1 var(--font-display); letter-spacing: var(--tracking-display); }
      .h-section { margin: 0; font: 600 var(--text-4xl) / 1.24 var(--font-display); letter-spacing: var(--tracking-tight); }
      .h-bloc { margin: 0; font: 600 var(--text-lg) / 1.3 var(--font-display); letter-spacing: var(--tracking-tight); }
      .h-carte { margin: 0; font: 600 var(--text-md) / 1.35 var(--font-display); letter-spacing: var(--tracking-tight); }
      .chapo { margin: 0; font: 400 var(--text-md) / var(--leading-relaxed) var(--font-sans); color: var(--slate-600); }
      .chapo--clair { color: rgba(255, 255, 255, 0.68); }
      .texte { margin: 0; font: 400 14px / 1.6 var(--font-sans); color: var(--slate-600); }

      @media (max-width: 820px) {
        .bande { padding: 56px 20px; }
        .h-geant { font-size: var(--text-4xl); }
        .h-grand { font-size: var(--text-3xl); }
        .h-section { font-size: var(--text-2xl); }
      }

      /* ── Boutons ───────────────────────────────────────────────────────── */
      .bouton {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        block-size: 38px; padding-inline: 18px;
        border-radius: var(--radius-control);
        font: 600 var(--text-sm) / 1 var(--font-sans);
        text-decoration: none; cursor: pointer; border: 1px solid transparent;
        transition: var(--transition-control);
      }
      .bouton--lg { block-size: 46px; padding-inline: 24px; font-size: var(--text-base); }
      .bouton:hover { text-decoration: none; }

      /* Braise : la couleur de conversion. Encre marine dessus, jamais blanc. */
      .bouton--chaud { background: var(--ember-500); border-color: var(--ember-500); color: var(--navy-900); }
      .bouton--chaud:hover { background: var(--ember-600); border-color: var(--ember-600); color: var(--navy-900); }
      .bouton--marque { background: var(--plum-500); border-color: var(--plum-500); color: #fff; }
      .bouton--marque:hover { background: var(--plum-600); border-color: var(--plum-600); color: #fff; }
      .bouton--inverse { background: transparent; border-color: rgba(255, 255, 255, 0.35); color: #fff; }
      .bouton--inverse:hover { background: rgba(255, 255, 255, 0.1); color: #fff; }
      .bouton--sobre { background: #fff; border-color: var(--slate-200); color: var(--slate-600); }
      .bouton--sobre:hover { background: var(--slate-50); border-color: var(--slate-300); color: var(--navy-900); }

      /* ── En-tête ───────────────────────────────────────────────────────── */
      .entete {
        position: sticky; top: 0; z-index: 40;
        display: flex; align-items: center; gap: 28px;
        block-size: 68px; padding-inline: 40px;
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(14px);
        border-block-end: 1px solid var(--slate-100);
      }
      .entete__marque {
        display: flex; align-items: center; gap: 10px;
        text-decoration: none; color: var(--navy-900);
        font: 700 var(--text-md) / 1.05 var(--font-display);
        letter-spacing: var(--tracking-tight);
        flex: none;
      }
      .entete__marque:hover { text-decoration: none; color: var(--navy-900); }
      .entete__nav { display: flex; align-items: center; gap: 22px; }
      .entete__nav a {
        color: var(--slate-600); text-decoration: none;
        font: 400 var(--text-sm) / 1.3 var(--font-sans);
        transition: color var(--duration-fast) var(--ease-standard);
      }
      .entete__nav a:hover { color: var(--text-brand); text-decoration: none; }
      .entete__nav a[aria-current] {
        color: var(--plum-600); font-weight: var(--weight-semibold);
        text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 2px;
      }
      .entete__droite { margin-inline-start: auto; display: flex; align-items: center; gap: 12px; }
      .entete__onboarding {
        display: inline-flex; align-items: center; gap: 7px;
        block-size: 34px; padding-inline: 14px;
        border-radius: var(--radius-control);
        background: var(--ember-100); border: 1px solid var(--ember-300);
        color: var(--navy-900); text-decoration: none;
        font: 600 var(--text-sm) / 1 var(--font-sans);
        transition: var(--transition-control);
      }
      .entete__onboarding:hover { background: var(--ember-300); color: var(--navy-900); text-decoration: none; transform: translateY(-1px); }
      .entete__onboarding[aria-current] { background: var(--ember-500); border-color: var(--ember-500); }

      @media (max-width: 900px) {
        .entete { padding-inline: 20px; gap: 16px; }
        .entete__nav, .entete__droite .bouton { display: none; }
      }
      /* Sous 560 px, le mot-symbole suffit : garder le nom écrit poussait la
         barre à 465 px de large et décalait toute la page vers la gauche. */
      @media (max-width: 560px) {
        .entete { padding-inline: 14px; gap: 10px; }
        .entete__marque span { display: none; }
      }

      .langues {
        display: inline-flex; align-items: center; gap: 6px;
        block-size: 34px; padding-inline: 10px;
        border: 1px solid var(--slate-200); border-radius: var(--radius-control);
        color: var(--slate-500);
      }
      .langues a {
        font: 600 11px/1 var(--font-mono); color: var(--slate-600); text-decoration: none;
      }
      .langues a:hover { color: var(--text-brand); text-decoration: none; }

      /* ── Pied ──────────────────────────────────────────────────────────── */
      .pied { background: var(--gradient-ink); color: #fff; padding: 56px 40px 32px; }
      .pied__dedans { max-width: var(--largeur, 1200px); margin: 0 auto; display: flex; flex-direction: column; gap: 28px; }
      .pied__haut { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
      .pied__nom { font: 700 var(--text-base) / 1.05 var(--font-display); }
      .pied__nav { margin-inline-start: auto; display: flex; gap: 20px; flex-wrap: wrap; }
      .pied a { color: rgba(255, 255, 255, 0.68); text-decoration: none; font: 400 var(--text-sm) / 1.4 var(--font-sans); }
      .pied a:hover { color: #fff; text-decoration: none; }
      .pied__bas {
        display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
        border-block-start: 1px solid rgba(255, 255, 255, 0.16);
        padding-block-start: 20px;
        font: 400 var(--text-xs) / 1.4 var(--font-sans); color: rgba(255, 255, 255, 0.5);
      }

  /* ── Replis ────────────────────────────────────────────────────────── */
  .plis { display: flex; flex-direction: column; gap: 12px; }
  .pli {
    border: 1px solid var(--slate-200);
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-xs);
    background: #fff;
  }
  .pli__tete {
    display: flex; align-items: center; gap: 16px;
    padding: 18px 20px; cursor: pointer;
    list-style: none;
    transition: background var(--duration-fast) var(--ease-standard);
  }
  .pli__tete::-webkit-details-marker { display: none; }
  .pli__tete:hover { background: var(--slate-25); }
  .pli__intitule { display: flex; flex-direction: column; gap: 4px; }
  .pli .pli__chevron {
    margin-inline-start: auto;
    color: var(--slate-400);
    transition: transform var(--duration-slow) var(--ease-standard);
  }
  .pli[open] .pli__chevron { transform: rotate(180deg); }
  .pli__corps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 12px;
    padding: 4px 20px 20px;
  }

  .carte { border-radius: var(--radius-card); padding: 22px 24px; display: flex; flex-direction: column; gap: 8px; }
  .carte--probleme { background: var(--slate-50); border: 1px solid var(--slate-100); }
  .carte--reponse { background: #fff; border: 1px solid var(--slate-200); box-shadow: var(--shadow-xs); gap: 10px; }
  .carte__icone {
    display: inline-flex; align-items: center; justify-content: center;
    inline-size: 30px; block-size: 30px; border-radius: var(--radius-control);
    background: var(--teal-100); color: var(--teal-700);
  }

  /* ── Titres de section ─────────────────────────────────────────────── */
  .entete-section { display: flex; flex-direction: column; gap: 14px; max-width: 660px; margin-block-end: 36px; }

  /* ── Catalogue ─────────────────────────────────────────────────────── */
  .entete-modules { display: flex; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-block-end: 36px; }
  .entete-modules .entete-section { margin-block-end: 0; }
  .entete-modules__lien { margin-inline-start: auto; font: 500 var(--text-sm) / 1.3 var(--font-sans); }

  .grille-modules { display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 16px; }
  .module {
    display: flex; flex-direction: column; gap: 12px;
    background: #fff; border: 1px solid var(--slate-200);
    border-radius: var(--radius-card); padding: 20px;
    text-decoration: none; color: inherit;
    box-shadow: var(--shadow-xs);
    transition: transform var(--duration-base) var(--ease-standard), box-shadow var(--duration-base) var(--ease-standard);
  }
  .module:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); text-decoration: none; color: inherit; }
  .module__tete { display: flex; align-items: center; gap: 12px; }
  .module__icone {
    display: inline-flex; align-items: center; justify-content: center;
    inline-size: 38px; block-size: 38px; border-radius: var(--radius-control);
    background: var(--plum-50); color: var(--plum-600); flex: none;
  }
  .module__noms { display: flex; flex-direction: column; gap: 2px; min-inline-size: 0; }
  .module__nom { font: 600 var(--text-md) / 1.2 var(--font-display); letter-spacing: var(--tracking-tight); }
  .module__groupe {
    font: 600 10px/1.2 var(--font-sans); letter-spacing: var(--tracking-caps);
    text-transform: uppercase; color: var(--slate-400);
  }
  .module__accroche { flex: 1; }
  .module__pied {
    display: flex; align-items: center; gap: 3px;
    border-block-start: 1px solid var(--slate-100); padding-block-start: 12px;
  }
  .module__compte { margin-inline-start: auto; font: 400 var(--text-xs) / 1 var(--font-mono); color: var(--slate-400); }
  .module .module__fleche { color: var(--plum-600); }

  /* ── Captures ──────────────────────────────────────────────────────── */
  .captures {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px;
  }
  .capture {
    display: block; text-decoration: none; color: inherit;
    border: 1px solid var(--slate-200); border-radius: var(--radius-card);
    overflow: hidden; background: #fff; box-shadow: var(--shadow-xs);
    transition: transform var(--duration-base) var(--ease-standard), box-shadow var(--duration-base) var(--ease-standard);
  }
  .capture:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); text-decoration: none; }
  .capture img { display: block; inline-size: 100%; block-size: auto; background: var(--slate-50); }
  .capture__pied {
    display: block; padding: 12px 14px;
    border-block-start: 1px solid var(--slate-100);
    font: 400 var(--text-sm) / 1.4 var(--font-sans); color: var(--slate-600);
  }
  .capture__pied strong { display: block; color: var(--navy-900); }

      /* ── Apparition au défilement ──────────────────────────────────────── */
      /* Sans JavaScript, tout est visible : l'animation ne fait qu'adoucir. */
      @media (prefers-reduced-motion: no-preference) {
        .js-anime [data-monte] {
          opacity: 0;
          transform: translateY(16px);
          transition: opacity .46s var(--ease-standard), transform .46s var(--ease-standard);
        }
        .js-anime [data-monte].est-la { opacity: 1; transform: none; }
      }
    </style>
  </head>

  <body style={`--largeur:${largeur};--fond-page:${fond}`}>
    <header class="entete">
      <a class="entete__marque" href={lien('/')}>
        <img src={lien('/brand/logo-mark.png')} alt="" width="30" height="30" />
        <span>{marque}</span>
      </a>
      <nav class="entete__nav">
        {NAV.map((e) => (
          <a href={lien(e.href)} aria-current={actif === e.cle ? 'page' : undefined}>{e.libelle}</a>
        ))}
      </nav>
      <div class="entete__droite">
        <a class="entete__onboarding" href={lien('/onboarding')} aria-current={actif === 'onboarding' ? 'page' : undefined}>
          <Icone nom="sparkles" taille={14} />
          {t('nav.onboarding')}
        </a>
        {langues.length > 0 && (
          <span class="langues">
            <Icone nom="globe" taille={14} />
            {langues.map((l) => (
              <a href={lien(l.defaut ? '/' : `/${l.code}/`)} lang={l.code}>{l.code.toUpperCase()}</a>
            ))}
          </span>
        )}
        <a class="bouton bouton--chaud" href={lien('/#contact')}>
          {t('nav.demo')}
          <Icone nom="arrow-right" taille={14} classe="icone--miroir" />
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="pied">
      <div class="pied__dedans">
        <div class="pied__haut">
          <img src={lien('/brand/logo-mark-inverse.png')} alt="" width="28" height="28" />
          <span class="pied__nom">{marque}</span>
          <nav class="pied__nav">
            <a href={lien('/onboarding')}>{t('nav.onboarding')}</a>
            <a href={lien('/#modules')}>{t('pied.fiches')}</a>
            <a href={lien('/#leviers')}>{t('pied.leviers')}</a>
            <a href={lien('/#contact')}>{t('nav.contact')}</a>
          </nav>
        </div>
        <div class="pied__bas">
          <span>{t('pied.mention')}</span>
          <span style="margin-inline-start:auto">{t('pied.note')}</span>
        </div>
      </div>
    </footer>

    <!-- Apparition au défilement. La classe n'est posée que si le script tourne :
         sans lui, rien n'est masqué. -->
    <script is:inline>
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var cibles = document.querySelectorAll('[data-monte]');
        if (!cibles.length) return;
        document.body.classList.add('js-anime');
        var vu = new IntersectionObserver(function (entrees) {
          entrees
            .filter(function (e) { return e.isIntersecting; })
            .sort(function (a, b) { return a.boundingClientRect.top - b.boundingClientRect.top; })
            .forEach(function (e, i) {
              e.target.style.transitionDelay = Math.min(i * 70, 420) + 'ms';
              e.target.classList.add('est-la');
              vu.unobserve(e.target);
            });
        }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
        cibles.forEach(function (el) { vu.observe(el); });
        // Filet : un onglet ouvert en arrière-plan ne déclenche pas l'observateur.
        setTimeout(function () {
          cibles.forEach(function (el) { el.classList.add('est-la'); });
        }, 4000);
      })();
    </script>
  </body>
</html>
