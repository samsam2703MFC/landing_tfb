---
/**
 * Habillage de la console, d'après la maquette Claude Design.
 *
 * Rail encré de 248 px, barre haute de 60 px, tables denses : c'est une
 * densité de back office, pas de page marketing. Mêmes jetons que le site
 * public — changer la marque change les deux.
 *
 * Les compteurs du rail viennent de la base : un rail qui annonce « Modules »
 * sans dire combien ne sert à rien.
 */
import '../design-system/styles.css';
import Icone from './Icone.astro';
import { lien } from '../lib/lien.mjs';
import { ROLES_DITS, cheminAutorise } from '../lib/admin/session.mjs';

const {
  titre,
  fil = 'Console',
  message = null,
  erreur = null,
  actif = null,
  compteurs = {},
} = Astro.props;

// Le rôle vient du cookie signé, posé par le middleware. Sans session — cas
// qui ne devrait pas arriver, la garde est en amont — on suppose le rôle le
// plus étroit plutôt que le plus large.
const session = Astro.locals.session || { role: 'commercial', secours: false };

const TOUTES = [
  {
    // Le tableau de bord n'appartient à aucune rubrique : il est le point
    // d'entrée des deux rôles, et le ranger sous « Contenu landing » laissait
    // un commercial avec une rubrique de ce nom contenant ce seul lien.
    entrees: [
      { cle: 'accueil', href: '/admin', libelle: 'Tableau de bord', icone: 'layout-dashboard' },
    ],
  },
  {
    titre: 'Contenu landing',
    entrees: [
      { cle: 'modules', href: '/admin/modules', libelle: 'Modules', icone: 'layers', compte: compteurs.modules,
        alerte: compteurs.aValider > 0 ? compteurs.aValider : null },
      { cle: 'composants', href: '/admin/composants', libelle: 'Composants', icone: 'panels-top-left', compte: compteurs.fonctions },
      { cle: 'leviers', href: '/admin/leviers', libelle: 'Leviers', icone: 'tag', compte: 6 },
      { cle: 'captures', href: '/admin/captures', libelle: 'Captures', icone: 'image', compte: compteurs.captures },
      { cle: 'textes', href: '/admin/textes', libelle: 'Textes', icone: 'file-text', compte: compteurs.textes },
      { cle: 'site', href: '/admin/site', libelle: "Page d'accueil", icone: 'panels-top-left' },
      { cle: 'questions', href: '/admin/questions', libelle: 'Questionnaire', icone: 'clipboard-check', compte: compteurs.questions },
      { cle: 'langues', href: '/admin/langues', libelle: 'Langues', icone: 'languages', compte: compteurs.langues },
      { cle: 'traductions', href: '/admin/traductions', libelle: 'Traductions', icone: 'globe' },
    ],
  },
  {
    // L'onboarding commercial : ce qu'on vend, à quel prix, et à qui.
    titre: 'Commercial',
    entrees: [
      { cle: 'offres', href: '/admin/offres', libelle: 'Offres', icone: 'receipt', compte: compteurs.offres },
      { cle: 'etapes', href: '/admin/etapes', libelle: 'Étapes', icone: 'list-checks', compte: compteurs.etapes },
      { cle: 'contrats', href: '/admin/contrats', libelle: 'Contrats', icone: 'handshake', compte: compteurs.contrats },
      { cle: 'tarifs', href: '/admin/tarifs', libelle: 'Tarifs', icone: 'percent' },
      { cle: 'prestations', href: '/admin/prestations', libelle: 'Prestations', icone: 'wallet', compte: compteurs.prestations },
    ],
  },
  {
    titre: 'Système',
    entrees: [
      { cle: 'sync', href: '/admin/sync', libelle: 'Sync GitHub', icone: 'arrow-up-down', compte: compteurs.modules },
      { cle: 'utilisateurs', href: '/admin/utilisateurs', libelle: 'Comptes', icone: 'users' },
      { cle: 'reglages', href: '/admin/reglages', libelle: 'Réglages', icone: 'settings' },
    ],
  },
  {
    titre: 'Réseau',
    entrees: [
      { cle: 'leads', href: '/admin/leads', libelle: 'Demandes', icone: 'users', compte: compteurs.leads },
      { cle: 'clients', href: '/admin/clients', libelle: 'Réseaux clients', icone: 'building', compte: compteurs.clients },
    ],
  },
];

/**
 * Le rail ne montre que ce que le rôle peut ouvrir. Une entrée qui mènerait à
 * un 403 est pire qu'une entrée absente : elle laisse croire à un droit qu'on
 * n'a pas, et fait perdre du temps à comprendre pourquoi.
 *
 * C'est un confort d'affichage, pas une sécurité — le contrôle qui compte est
 * dans le middleware, en amont de chaque page.
 */
const RUBRIQUES = TOUTES
  .map((r) => ({ ...r, entrees: r.entrees.filter((e) => cheminAutorise(e.href, session.role)) }))
  .filter((r) => r.entrees.length > 0);
---

<html lang="fr" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre ? `${titre} — TFB Admin` : 'TFB Admin'}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href={lien('/brand/logo-mark.png')} />
    <meta name="theme-color" content="#0c1329" />

    <style is:global>
      /* La console ne charge pas la feuille de base du design system — elle a
         la sienne — et se retrouvait donc en `content-box`, seule de tout le
         site. Un champ à cent pour cent de sa colonne y ajoutait son
         rembourrage et sa bordure, et débordait de son bloc de quatorze
         pixels par la droite. Invisible tant qu'on regarde la gauche, où la
         marge est correcte. */
      *, *::before, *::after { box-sizing: border-box; }

      body { font: var(--type-body); color: var(--navy-900); background: var(--slate-50); margin: 0; }

      /* ── Ossature ──────────────────────────────────────────────────────── */
      .console { display: flex; min-block-size: 100vh; }

      .rail {
        inline-size: var(--sidebar-width); flex: none;
        display: flex; flex-direction: column; gap: 20px;
        padding: 16px 12px;
        background: var(--gradient-ink);
        border-inline-end: 1px solid var(--alpha-white-16);
        color: #fff;
        position: sticky; top: 0; block-size: 100vh; overflow-y: auto;
      }
      .rail__marque { display: flex; align-items: center; gap: 10px; padding: 4px 8px 14px; text-decoration: none; color: #fff; }
      .rail__marque:hover { color: #fff; text-decoration: none; }
      .rail__marque b { display: block; font: 700 var(--text-base) / 1.05 var(--font-display); }
      .rail__marque span { display: block; font: 400 var(--text-xs) / 1.4 var(--font-sans); color: rgba(255, 255, 255, 0.5); }

      .rail__groupe { display: flex; flex-direction: column; gap: 4px; }
      .rail__titre {
        font: 600 11px/1.2 var(--font-sans); letter-spacing: var(--tracking-caps); text-transform: uppercase;
        color: rgba(255, 255, 255, 0.42); padding-inline: 10px; margin-block-end: 6px;
      }
      .rail__lien {
        display: flex; align-items: center; gap: 12px;
        block-size: 38px; padding-inline: 10px;
        border-radius: var(--radius-control);
        color: rgba(255, 255, 255, 0.72); text-decoration: none;
        font: 400 var(--text-sm) / 1 var(--font-sans);
        transition: var(--transition-control);
      }
      .rail__lien:hover { background: var(--alpha-white-08); color: #fff; text-decoration: none; }
      .rail__lien[aria-current] {
        background: var(--alpha-white-16); color: #fff;
        font-weight: var(--weight-semibold);
        box-shadow: inset 3px 0 0 var(--teal-300);
      }
      .rail__compte {
        margin-inline-start: auto;
        font: 500 11px/1 var(--font-mono);
        color: rgba(255, 255, 255, 0.5);
        background: var(--alpha-white-08);
        border-radius: var(--radius-pill); padding: 3px 7px;
      }
      .rail__bas { margin-block-start: auto; display: flex; flex-direction: column; gap: 4px; }
      .rail__qui {
        padding: 10px; margin-block-end: 6px;
        border-radius: var(--radius-control);
        background: rgba(255, 255, 255, 0.06);
        display: flex; flex-direction: column; gap: 2px;
      }
      .rail__qui b { font: 600 var(--text-sm) / 1.2 var(--font-sans); color: #fff; }
      .rail__qui span { font: 400 11px/1.3 var(--font-sans); color: rgba(255, 255, 255, 0.5); }
      .rail__bas form { margin: 0; }
      .rail__bas button {
        inline-size: 100%; text-align: start;
        background: none; border: 0; cursor: pointer;
        display: flex; align-items: center; gap: 12px;
        min-block-size: 38px; padding-block: 0; padding-inline: 10px;
        border-radius: var(--radius-control);
        color: rgba(255, 255, 255, 0.72);
        font: 400 var(--text-sm) / 1 var(--font-sans);
        transition: var(--transition-control);
      }
      .rail__bas button:hover { background: var(--alpha-white-08); color: #fff; }

      /* ── Colonne de droite ─────────────────────────────────────────────── */
      .zone { display: flex; flex-direction: column; flex: 1; min-inline-size: 0; }

      .barre {
        position: sticky; top: 0; z-index: 10;
        display: flex; align-items: center; gap: 16px;
        block-size: var(--topbar-height); flex: none;
        padding-inline: 24px;
        background: #fff;
        border-block-end: 1px solid var(--slate-200);
      }
      .barre__titres { display: flex; flex-direction: column; gap: 1px; min-inline-size: 0; }
      .barre__fil { font: 400 var(--text-xs) / 1.4 var(--font-sans); color: var(--slate-400); }
      .barre h1 { margin: 0; font: 600 var(--text-xl) / 1.2 var(--font-display); letter-spacing: var(--tracking-tight); }
      .barre__actions { margin-inline-start: auto; display: flex; align-items: center; gap: 12px; }

      .page { flex: 1; min-block-size: 0; padding: 24px; display: flex; flex-direction: column; gap: 24px; }

      /* ── Retours ───────────────────────────────────────────────────────── */
      .alerte {
        border-radius: var(--radius-card); padding: 12px 16px;
        font: var(--type-body-sm); border: 1px solid transparent;
      }
      .alerte--ok { background: var(--surface-success-subtle); color: var(--text-success); border-color: var(--green-500); }
      .alerte--ko { background: var(--surface-danger-subtle); color: var(--text-danger); border-color: var(--border-danger); }
      .alerte--attention { background: var(--amber-100); color: var(--amber-700); border-color: var(--status-warning); }

      /* ── Tuiles de chiffres ────────────────────────────────────────────── */
      .tuiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
      .tuile {
        display: flex; flex-direction: column; gap: 10px;
        padding: 20px; border-radius: var(--radius-card);
        background: #fff; border: 1px solid var(--slate-200);
        box-shadow: var(--shadow-sm);
      }
      .tuile--encre { background: var(--gradient-ink); border-color: var(--alpha-white-16); color: #fff; }
      .tuile__oeil {
        font: 600 var(--text-xs) / 1.2 var(--font-sans);
        letter-spacing: var(--tracking-caps); text-transform: uppercase;
        color: var(--slate-400);
      }
      .tuile--encre .tuile__oeil { color: rgba(255, 255, 255, 0.68); }
      .tuile__chiffre { font: 600 var(--text-3xl) / 1.05 var(--font-display); letter-spacing: var(--tracking-display); }
      .tuile__note { font: 400 var(--text-sm) / 1.5 var(--font-sans); color: var(--slate-600); }
      /* Le tableau de bord liste les modules à relire : ces liens sont le
         chemin vers le travail à faire, pas de la prose. 15 px se rate. */
      .tuile__note a { display: inline-flex; align-items: center; min-block-size: 24px; }
      .tuile--encre .tuile__note { color: rgba(255, 255, 255, 0.68); }

      /* ── Blocs ─────────────────────────────────────────────────────────── */
      .bloc {
        border-radius: var(--radius-card); background: #fff;
        border: 1px solid var(--slate-200); box-shadow: var(--shadow-sm);
        overflow: hidden;
      }
      .bloc__tete {
        display: flex; align-items: flex-end; gap: 16px; flex-wrap: wrap;
        padding: 20px 20px 12px;
      }
      .bloc__tete > div { display: flex; flex-direction: column; gap: 4px; }
      .bloc__tete h2 { margin: 0; font: 600 var(--text-md) / 1.24 var(--font-sans); letter-spacing: var(--tracking-tight); }
      .bloc__tete p { margin: 0; font: 400 var(--text-sm) / 1.5 var(--font-sans); color: var(--slate-600); }
      .bloc__actions { margin-inline-start: auto; display: flex; gap: 8px; flex-wrap: wrap; }
      .bloc__corps { padding: 20px; display: flex; flex-direction: column; gap: 16px; }
      .bloc__pied {
        padding: 12px 20px; border-block-start: 1px solid var(--slate-100);
        background: var(--slate-25);
        font: 400 var(--text-sm) / 1.5 var(--font-sans); color: var(--slate-600);
      }

      /* ── Tables ────────────────────────────────────────────────────────── */
      .roule { overflow-x: auto; }
      table { inline-size: 100%; border-collapse: collapse; }
      /* Sur téléphone, une table à sept colonnes en `table-layout: fixed`
         écrase la colonne Module à 15 px et empile ses lettres à la verticale.
         On lui donne une largeur plancher : `.roule` la fait défiler, ce pour
         quoi il existe. */
      @media (max-width: 820px) {
        .roule table { min-inline-size: 720px; }
      }
      th {
        text-align: start;
        font: 600 var(--text-xs) / 1 var(--font-sans);
        letter-spacing: var(--tracking-wide); text-transform: uppercase;
        color: var(--slate-400);
        padding: 12px 16px;
        border-block-end: 1px solid var(--slate-200);
        background: var(--slate-25);
        white-space: nowrap;
      }
      th.a-droite, td.a-droite { text-align: end; }
      td { padding: 11px 16px; border-block-end: 1px solid var(--slate-100); vertical-align: middle; }
      tbody tr:hover { background: var(--slate-50); }
      .num { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
      .slug { display: block; font: 400 11.5px/1.5 var(--font-mono); color: var(--slate-400); }
      /* Dans une phrase, un `.slug` en bloc coupait le texte en trois : le
         nom sur une ligne, la clé sur une autre, et le point tout seul sur la
         troisième. Sous un titre de cellule, le bloc reste ce qu'il faut. */
      p .slug, .bloc__tete p .slug { display: inline; }

      .etat {
        display: inline-flex; align-items: center; gap: 7px;
        padding: 3px 9px; border-radius: var(--radius-pill);
        font: 500 var(--text-xs) / 1.4 var(--font-sans);
        background: var(--slate-100); color: var(--slate-600);
        white-space: nowrap;
      }
      .etat::before { content: ''; inline-size: 6px; block-size: 6px; border-radius: 50%; background: var(--status-neutral); }
      .etat--on { background: var(--green-100); color: var(--green-700); }
      .etat--on::before { background: var(--status-success); }
      .etat--manque { background: var(--amber-100); color: var(--amber-700); }
      .etat--manque::before { background: var(--status-warning); }

      /* ── Boutons ───────────────────────────────────────────────────────── */
      /* Trois choses à tenir ensemble, et chacune se voyait :
         · `padding-block: 0` explicite — un <button> porte un padding de 1 px
           du navigateur, un <a class="bouton"> non. Les deux se côtoient dans
           les mêmes barres d'actions et ne s'alignaient pas ;
         · un interligne de 1 fait exactement la hauteur de la police : les
           jambages de « g » et « p » n'ont plus de place et le texte paraît
           tomber au fond du bouton ;
         · `min-block-size` plutôt que `block-size` : un intitulé long qui
           passe à la ligne débordait au lieu de faire grandir le bouton. */
      .bouton {
        display: inline-flex; align-items: center; justify-content: center; gap: 7px;
        min-block-size: 36px; padding-block: 0; padding-inline: 16px;
        border-radius: var(--radius-control);
        border: 1px solid transparent;
        font: 600 var(--text-sm) / 1.3 var(--font-sans);
        text-decoration: none; cursor: pointer;
        transition: var(--transition-control);
      }
      .bouton--sm { min-block-size: 30px; padding-inline: 12px; font-size: var(--text-xs); }
      .bouton--marque { background: var(--plum-500); border-color: var(--plum-500); color: #fff; }
      .bouton--marque:hover { background: var(--plum-600); border-color: var(--plum-600); color: #fff; text-decoration: none; }
      .bouton--sobre { background: #fff; border-color: var(--slate-200); color: var(--slate-600); }
      .bouton--sobre:hover { background: var(--slate-50); border-color: var(--slate-300); color: var(--navy-900); text-decoration: none; }
      /* Le vert de la validation : c'est le geste qui met en ligne. */
      .bouton--valider { background: var(--teal-500); border-color: var(--teal-700); color: #fff; }
      .bouton--valider:hover { background: var(--teal-700); border-color: var(--teal-700); color: #fff; text-decoration: none; }
      .bouton--danger { background: #fff; border-color: var(--red-500); color: var(--red-700); }
      .bouton--danger:hover { background: var(--red-100); color: var(--red-700); text-decoration: none; }
      .actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }

      /* La barre d'enregistrement d'un long formulaire.
         Elle existe parce qu'un `slot="actions"` posé sur un bouton **dans**
         un <form> n'est pas un enfant direct du gabarit : Astro l'ignore, et
         le bouton s'affichait orphelin au milieu de la page. Collante, elle
         évite en plus de redescendre au bas d'un écran de traduction. */
      .barre-actions {
        position: sticky; top: 0; z-index: 20;
        display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
        margin-block-end: 32px; padding: 16px;
        /* Opaque, et non translucide : au défilement, le contenu passe sous la
           barre. À 92 % d'opacité on voyait une vignette affleurer derrière le
           bouton, et les deux se lisaient comme un seul bloc mal aligné. */
        background: #fff;
        border: 1px solid var(--slate-200); border-radius: var(--radius-card);
        box-shadow: var(--shadow-sm);
      }
      .barre-actions__note { font: 400 var(--text-xs) / 1.4 var(--font-sans); color: var(--slate-400); }

      /* Un champ qui n'attend qu'un nombre n'a pas besoin de 380 px.
         Dans une grille en colonnes égales, il s'étirait jusqu'à éloigner
         son unité du chiffre de toute la largeur de la colonne. */
      .champ--nombre .tarif__saisie { max-inline-size: 11rem; }

      /* Un bloc pose son padding sur son en-tête, son pied et son corps, mais
         pas sur ce qu'on dépose directement entre les deux : un champ, une
         grille, une barre de filtres s'y collaient contre la bordure. On les
         rentre tous d'un coup, plutôt que de citer un à un les écrans où le
         cas se présente — le prochain formulaire ajouté sera bon d'office.
      
         C'est une **marge**, et le mot compte : un padding rentre le contenu
         sans déplacer la bordure, si bien qu'une bande encadrée — la saisie
         des points de vente, un encadré d'alerte — venait buter contre le
         bord du bloc alors que son texte, lui, était bien rentré. */
      .bloc > :not(.bloc__tete):not(.bloc__pied):not(.bloc__corps):not(.roule) {
        margin-inline: 16px;
      }
      /* …sauf une table, qui doit aller d'une bordure à l'autre. Quand elle
         vit dans un formulaire déjà rentré, elle en ressort. */
      .bloc > form > .roule, .bloc > fieldset > .roule { margin-inline: -16px; }
      /* Le dernier élément ne doit pas non plus toucher le fond du bloc. */
      .bloc > :last-child:not(.bloc__pied):not(.roule) { padding-block-end: 16px; }
      /* …ni coller au pied quand il y en a un. Une table, elle, s'y adosse :
         son dernier filet et le liseré du pied ne font qu'un trait. */
      .bloc > :not(.bloc__tete):not(.roule) + .bloc__pied { margin-block-start: 16px; }
      /* Adossée ne veut pas dire collée : le texte du pied garde ses distances
         avec la dernière ligne de la table, dont la cellule est peu rembourrée
         par le bas. */
      .roule + .bloc__pied { padding-block-start: 18px; }
      /* Un bouton qui suit une table a besoin du même recul. */
      .roule + .actions { margin-block-start: 20px; }
      /* Deux champs empilés dans un corps de bloc ne se touchent pas : sans
         grille pour les espacer, rien ne le fait à leur place. */
      .bloc__corps > .champ + .champ { margin-block-start: 16px; }
      /* Un fieldset nu ne redouble pas la marge de ses enfants. */
      .bloc > fieldset.nu > :not(.roule) { margin-inline: 0; }
      /* Un champ et son bouton sur la même ligne, dans une cellule de table.
         Ces règles vivaient dans l'écran Comptes, donc nulle part ailleurs :
         la liste des offres s'en sert aussi. */
      .ligne-serree { display: flex; align-items: center; gap: 6px; }
      .ligne-serree input, .ligne-serree select { min-inline-size: 0; }

      /* Dans une table, les actions d'une ligne tiennent sur une ligne. */
      td .actions { flex-wrap: nowrap; }
      td .actions form { margin: 0; }

      /* Entre le dernier champ et le bouton qui referme le formulaire, il
         faut de l'air : collé au champ, le bouton se lit comme une case de
         plus du formulaire au lieu du geste qui le valide. La règle est
         globale pour que le prochain formulaire ajouté soit bon d'office. */
      .page .actions { margin-block-start: 16px; }
      /* …sauf quand les actions sont une case parmi d'autres sur la même
         rangée — cellule de table, en-tête de bloc, ligne d'édition en
         grille. La rangée a déjà son `gap` ; une marge en plus ne ferait
         que décaler le bouton de ses voisins. */
      .page .actions:first-child,
      .page td .actions,
      .page summary .actions,
      .bloc__tete .actions,
      .page .actions--case { margin-block-start: 0; }

      /* ── Formulaires ───────────────────────────────────────────────────── */
      /* `align-content: start` : sans lui, un champ plus court que ses voisins
         est étiré à leur hauteur, et l'espace en trop se répartit **entre ses
         rangées**. Une étiquette seule au-dessus d'une saisie gagnait douze
         pixels quand sa voisine en avait trois — les saisies d'une même
         rangée ne partaient plus du même trait. */
      .champ { display: grid; gap: 5px; align-content: start; }
      .champ > label, .legende { font: var(--type-label); color: var(--slate-600); }
      .champ__aide { font: 400 var(--text-xs) / 1.4 var(--font-sans); color: var(--slate-400); }
      /* Quand l'aide vit dans l'étiquette, elle doit passer à la ligne :
         « Mention en cas d'exonérationImprimée sur l'offre… » se lisait comme
         un seul mot. */
      label > .champ__aide { display: block; margin-block-start: 2px; }
      /* L'astérisque des champs obligatoires. Le navigateur les refuse déjà,
         mais il ne le dit qu'au moment de valider : l'œil doit savoir avant. */
      .champ__requis { color: var(--plum-600); }

      /* ── Vignettes ─────────────────────────────────────────────────────
         Une case à cocher ou un bouton radio dans un encadré cliquable : un
         pack, une option, une formule. Ces styles vivaient dans la fiche
         d'offre, donc les vignettes des autres écrans s'affichaient nues —
         un `<strong>` collé à son aide, sans bordure ni respiration. Elles
         appartiennent à la console, pas à un écran. */
      .cases { display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(min(19rem, 100%), 1fr)); }
      .case, .formule {
        display: flex; align-items: start; gap: 10px;
        padding: 13px 15px; min-block-size: 52px;
        border: 1px solid var(--slate-200); border-radius: var(--radius-control);
        cursor: pointer; transition: var(--transition-control);
      }
      .case:hover, .formule:hover { border-color: var(--plum-300); background: var(--slate-50); }
      .case:has(:checked), .formule:has(:checked) { border-color: var(--plum-500); background: var(--plum-50); }
      .case > span, .formule > span { display: flex; flex-direction: column; gap: 2px; min-inline-size: 0; }
      .case__prix { font-size: var(--text-sm); color: var(--slate-600); }
      .case__tete { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
      .case__tete .case__prix { margin-inline-start: auto; white-space: nowrap; }
      /* Ce que le module rapporte, dit en une ligne : c'est l'argument de
         vente, il mérite d'être lisible sans survoler quoi que ce soit. */
      .case__apporte { font: 500 var(--text-xs) / 1.4 var(--font-sans); color: var(--teal-700); }
      .case--module { align-items: start; }
      .case--seule { inline-size: 100%; }

      /* La version nue : une case à cocher et son mot, sans encadré. Dans une
         cellule de table ou une liste dense, la vignette est trop grande. */
      .coche { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; }
      .coche input { inline-size: auto; margin: 0; cursor: pointer; }

      /* Dans une rangée de champs, une vignette occupe toute la hauteur de sa
         case : sinon elle flotte au-dessus des saisies voisines, plus courte
         qu'elles, et la rangée se lit de travers. */
      .duo > .champ:has(> .case) { grid-template-rows: auto 1fr; }
      .duo > .champ > .case { block-size: 100%; }

      /* Un champ chiffré et son unité, et les colonnes de montants.
         Ces classes vivaient dans le `is:global` de l'écran Tarifs, donc
         elles ne s'appliquaient nulle part ailleurs : sur Prestations et sur
         Offres, le « € » flottait à côté d'un champ non aligné. Une classe
         employée par plusieurs écrans appartient au gabarit. */
      .tarif__saisie { display: flex; align-items: center; gap: 6px; }
      .tarif__saisie input { text-align: end; font-variant-numeric: tabular-nums; }
      .tarif__unite {
        font: 500 var(--text-sm) / 1 var(--font-sans);
        color: var(--slate-400); inline-size: 1ch; flex: none;
      }
      .nombre { text-align: end; font-variant-numeric: tabular-nums; }

      /* Visible du seul lecteur d'écran. `display: none` le cacherait aussi à
         lui ; une colonne d'actions sans nom laisse annoncer « colonne 6 ». */
      .invisible {
        position: absolute; inline-size: 1px; block-size: 1px;
        margin: -1px; padding: 0; overflow: hidden;
        clip-path: inset(50%); white-space: nowrap; border: 0;
      }
      /* Tous les champs de saisie, désignés par ce qu'ils ne sont pas : une
         liste blanche de types en oublie toujours un — `email` et `date` y
         manquaient, et se retrouvaient sans style ni taille de police. */
      input:not([type='checkbox']):not([type='radio']):not([type='hidden']),
      textarea, select {
        inline-size: 100%;
        padding: 8px 10px;
        border: 1px solid var(--slate-200);
        border-radius: var(--radius-control);
        background: #fff; color: var(--navy-900);
        font: var(--type-body-sm);
        transition: var(--transition-control);
      }
      select { cursor: pointer; }
      /* Voir index.astro : sous 16 px, iOS zoome au premier appui. */
      @media (max-width: 820px) {
        input:not([type='checkbox']):not([type='radio']):not([type='hidden']),
        textarea, select { font-size: 16px; }
      }

      /* Au doigt, un lien de 15 px de haut dans une cellule ou un en-tête se
         rate. On ne grossit la cible que sur écran tactile : au clavier et à
         la souris, la ligne de texte reste telle qu'elle est dessinée. */
      @media (pointer: coarse) {
        .roule td a, .bloc__tete a, .bloc__pied a {
          display: inline-flex; align-items: center; min-block-size: 24px;
        }
      }
      textarea { resize: vertical; line-height: var(--leading-normal); }
      textarea.code { font-family: var(--font-mono); font-size: var(--text-sm); }
      input:focus-visible, textarea:focus-visible, select:focus-visible {
        outline: none; border-color: var(--plum-400); box-shadow: var(--shadow-focus);
      }
      .duo { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }

      /* ── Choix de leviers ──────────────────────────────────────────────── */
      .choix-leviers { display: flex; flex-wrap: wrap; gap: 4px; }
      .choix-levier { position: relative; display: inline-flex; }
      .choix-levier input { position: absolute; inset: 0; opacity: 0; cursor: pointer; margin: 0; }
      .choix-levier span {
        display: inline-flex; align-items: center; justify-content: center;
        inline-size: 22px; block-size: 22px; border-radius: var(--radius-xs);
        font: 600 11px/1 var(--font-mono);
        background: var(--slate-100); color: var(--slate-400);
        border: 1px solid transparent;
        transition: var(--transition-control);
      }
      .choix-levier input:checked + span { background: var(--fond); color: var(--encre); }
      .choix-levier input:focus-visible + span { box-shadow: var(--shadow-focus); }
      .choix-leviers--large .choix-levier span { inline-size: auto; padding-inline: 10px; gap: 6px; }

      /* ── Replis ────────────────────────────────────────────────────────── */
      details.fiche { border: 1px solid var(--slate-200); border-radius: var(--radius-card); background: #fff; }
      details.fiche > summary {
        cursor: pointer; list-style: none;
        padding: 12px 16px;
        display: flex; align-items: center; justify-content: space-between; gap: 12px;
        font: var(--type-title);
      }
      details.fiche > summary::-webkit-details-marker { display: none; }
      details.fiche > summary::marker { content: ''; }
      details.fiche > summary:hover { background: var(--slate-25); }
      details.fiche[open] > summary { border-block-end: 1px solid var(--slate-100); }
      .fiche__corps { padding: 16px; display: grid; gap: 12px; }

      /* ── Ce qui attend une relecture ───────────────────────────────────── */
      .neuf {
        display: inline-flex; align-items: center;
        padding: 1px 8px; border-radius: var(--radius-pill);
        background: var(--ember-500); color: var(--navy-900);
        font: 600 10.5px/1.5 var(--font-sans);
        letter-spacing: 0.04em; text-transform: uppercase;
        white-space: nowrap;
      }
      .rail__compte--neuf { background: var(--ember-500); color: var(--navy-900); }

      /* Le commutateur « en ligne », verrouillé tant que c'est à valider. */
      .interrupteur {
        position: relative; inline-size: 34px; block-size: 19px;
        border-radius: var(--radius-pill);
        border: 1px solid var(--slate-300); background: var(--slate-200);
        cursor: pointer; padding: 0; flex: none;
        transition: background var(--duration-fast) var(--ease-standard);
      }
      .interrupteur > span, .interrupteur::after {
        content: ''; position: absolute; inset-block-start: 2px; inset-inline-start: 2px;
        inline-size: 13px; block-size: 13px; border-radius: 50%;
        background: #fff; box-shadow: 0 1px 2px rgba(12, 19, 41, 0.2);
        transition: inset-inline-start var(--duration-fast) var(--ease-standard);
      }
      .interrupteur--on { background: var(--teal-500); border-color: var(--teal-700); }
      .interrupteur--on > span { inset-inline-start: 16px; }
      .interrupteur--bloque { cursor: not-allowed; opacity: 0.55; }
      .interrupteur--bloque::after { content: ''; }

      /* ── Composants dépliés sous une ligne de module ───────────────────── */
      .composants { border-block-start: 1px solid var(--slate-100); background: var(--slate-25); }
      .composants > summary {
        cursor: pointer; list-style: none;
        display: flex; align-items: center; gap: 8px;
        padding: 8px 16px 8px 38px;
        font: var(--type-body-sm); color: var(--slate-600);
      }
      .composants > summary::-webkit-details-marker { display: none; }
      .composants > summary::marker { content: ''; }
      .composants > summary:hover { background: var(--slate-50); }
      .composants[open] .composants__fleche { transform: rotate(90deg); }
      .composants .composants__fleche { transition: transform var(--duration-base) var(--ease-standard); }
      .composants__liste { padding: 0 16px 12px 38px; display: flex; flex-direction: column; }
      .composant-ligne {
        display: grid;
        grid-template-columns: minmax(12rem, 1fr) 8rem 13rem minmax(10rem, 1.4fr);
        gap: 14px; align-items: center;
        padding-block: 8px;
        border-block-end: 1px solid var(--slate-100);
        font: var(--type-body-sm);
      }
      .composant-ligne:last-child { border-block-end: 0; }
      .composant-ligne__nom { display: flex; align-items: center; gap: 8px; font-weight: var(--weight-medium); }
      .composant-ligne__etat { display: flex; align-items: center; gap: 8px; margin: 0; }
      .composant-ligne__mot { font: 500 11px/1 var(--font-mono); color: var(--slate-500); }
      .composant-ligne__gain {
        color: var(--slate-500); font-size: var(--text-sm);
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      }
      @media (max-width: 1100px) { .composant-ligne { grid-template-columns: 1fr; gap: 4px; } }

      .jeton {
        display: inline-block; font: 400 11.5px/1.5 var(--font-mono);
        background: var(--slate-100); color: var(--slate-600);
        padding: 2px 6px; border-radius: var(--radius-xs);
      }
      .repet { display: grid; gap: 12px; }
      .repet__item {
        display: grid; gap: 8px; padding: 14px;
        border: 1px solid var(--slate-100); border-radius: var(--radius-card);
        background: var(--slate-25);
      }
      .repet__trio { grid-template-columns: minmax(9rem, 1fr) minmax(7rem, auto) 2fr; }

      @media (max-width: 900px) {
        .console { flex-direction: column; }
        .rail { inline-size: 100%; position: static; block-size: auto; }
        .repet__trio { grid-template-columns: 1fr; }
      }
      @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
    </style>
  </head>

  <body>
    <div class="console">
      <nav class="rail">
        <a class="rail__marque" href={lien('/admin')}>
          <img src={lien('/brand/logo-mark-inverse.png')} alt="" width="28" height="28" />
          <span>
            <b>TFB Admin</b>
            <span>Back office · /admin</span>
          </span>
        </a>

        {RUBRIQUES.map((rubrique) => (
          <div class="rail__groupe">
            {rubrique.titre && <div class="rail__titre">{rubrique.titre}</div>}
            {rubrique.entrees.map((e) => (
              <a class="rail__lien" href={lien(e.href)} aria-current={actif === e.cle ? 'page' : undefined}>
                <Icone nom={e.icone} taille={18} />
                {e.libelle}
                {e.alerte ? (
                  <span class="rail__compte rail__compte--neuf" title={`${e.alerte} élément(s) à valider`}>{e.alerte} ⚑</span>
                ) : (
                  e.compte !== undefined && e.compte !== null && <span class="rail__compte">{e.compte}</span>
                )}
              </a>
            ))}
          </div>
        ))}

        <div class="rail__bas">
          {/* Qui est connecté, et à quel titre. Une console où l'on ne sait
              pas sous quel compte on agit produit des offres orphelines. */}
          <div class="rail__qui">
            {session.secours ? (
              <><b>Clé de secours</b><span>aucun compte — rien ne portera de nom</span></>
            ) : (
              <><b>{session.nom || session.identifiant || 'Compte'}</b><span>{(ROLES_DITS[session.role] || ROLES_DITS.commercial).nom.toLowerCase()}</span></>
            )}
          </div>
          <a class="rail__lien" href={lien('/')} target="_blank">
            <Icone nom="external-link" taille={18} />
            Voir la landing
          </a>
          <form method="post" action={lien('/admin/deconnexion')}>
            <button type="submit">
              <Icone nom="log-out" taille={18} />
              Se déconnecter
            </button>
          </form>
        </div>
      </nav>

      <div class="zone">
        <header class="barre">
          <div class="barre__titres">
            <span class="barre__fil">{fil}</span>
            <h1>{titre}</h1>
          </div>
          <div class="barre__actions">
            <slot name="actions" />
          </div>
        </header>

        <div class="page">
          {message && <div class="alerte alerte--ok">{message}</div>}
          {erreur && <div class="alerte alerte--ko">{erreur}</div>}
          <slot />
        </div>
      </div>
    </div>
  </body>
</html>
