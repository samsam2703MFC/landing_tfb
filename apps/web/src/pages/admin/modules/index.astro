---
/**
 * Liste des modules. C'est ici qu'on règle l'ordre d'affichage et qu'on
 * masque un module sans le supprimer — un module retiré de la base
 * reviendrait à la prochaine ingestion, alors qu'un module masqué reste
 * masqué.
 */
import Console from '../../../components/Console.astro';
import { lien } from '../../../lib/lien.mjs';
import { LEVIERS } from '../../../lib/db.mjs';
import { basculerModule, listerModules } from '../../../lib/admin/donnees.mjs';

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');

let message = null;
let erreur = null;

if (Astro.request.method === 'POST') {
  try {
    const formulaire = await Astro.request.formData();
    const slug = String(formulaire.get('slug') || '');
    const actif = formulaire.get('actif') === '1';
    await basculerModule(slug, actif);
    return Astro.redirect(
      `${BASE}/admin/modules?ok=${encodeURIComponent(`${slug} ${actif ? 'affiché' : 'masqué'}.`)}`,
      303,
    );
  } catch (err) {
    erreur = err.message;
  }
}

message = Astro.url.searchParams.get('ok');

let modules = [];
try {
  modules = await listerModules();
} catch (err) {
  erreur = erreur || `Base injoignable : ${err.message}`;
}

const lettre = (cle) => LEVIERS.find((l) => l.cle === cle)?.lettre || '?';
---

<Console titre="Modules" fil={['Console', 'Modules']} message={message} erreur={erreur}>
  <section class="bloc">
    <div class="bloc__tete">
      <div>
        <h2>{modules.length} module(s)</h2>
        <p>L'ordre gouverne l'affichage sur la page d'accueil et dans le fil d'onboarding.</p>
      </div>
    </div>

    <table>
      <thead>
        <tr>
          <th>Ordre</th>
          <th>Module</th>
          <th>Famille</th>
          <th>Leviers</th>
          <th>Fonctions</th>
          <th>Captures</th>
          <th>État</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {modules.map((module) => (
          <tr>
            <td class="num">{module.ordre}</td>
            <td>
              <a href={lien(`/admin/modules/${module.slug}`)}><strong>{module.nom || module.slug}</strong></a>
              <div><span class="jeton">{module.slug}</span></div>
            </td>
            <td>{module.groupe || '—'}</td>
            <td>
              <div class="choix-leviers">
                {(module.leviers || []).map((cle) => (
                  <span class="choix-levier" data-levier={cle}><span data-lettre={lettre(cle)}></span></span>
                ))}
                {(module.leviers || []).length === 0 && '—'}
              </div>
            </td>
            <td class="num">{module.nb_fonctions}</td>
            <td class="num">{module.nb_captures}</td>
            <td><span class={module.actif ? 'etat etat--on' : 'etat'}>{module.actif ? 'Affiché' : 'Masqué'}</span></td>
            <td>
              <div class="actions">
                <a class="bouton bouton--sobre bouton--sm" href={lien(`/admin/modules/${module.slug}`)}>Modifier</a>
                <form method="post">
                  <input type="hidden" name="slug" value={module.slug} />
                  <input type="hidden" name="actif" value={module.actif ? '0' : '1'} />
                  <button class="bouton bouton--sobre bouton--sm" type="submit">
                    {module.actif ? 'Masquer' : 'Afficher'}
                  </button>
                </form>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <p style="font: var(--type-caption); color: var(--text-tertiary);">
    Un module s'ajoute au dépôt, pas ici : une ligne dans <span class="jeton">modules.json</span> et sa fiche dans
    <span class="jeton">pipeline/contenu-initial.mjs</span>. La console modifie ce qui est publié, elle ne
    remplace pas la source.
  </p>
</Console>
