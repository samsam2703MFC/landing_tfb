---
/**
 * Page d'accueil, d'après la maquette Claude Design.
 *
 * L'ordre du discours est celui décidé avec le client : ses problèmes
 * d'abord, nos réponses ensuite, puis seulement l'outil. Tout le contenu
 * vient des tables `landing_*` — rien n'est écrit en dur ici.
 */
import Layout from '../components/Layout.astro';
import Icone from '../components/Icone.astro';
import Pastille from '../components/Pastille.astro';
import { chargerClients, chargerParcours, chargerSite } from '../lib/db.mjs';
import { textes } from '../lib/textes.mjs';
import { LEVIERS, leviersDe } from '../lib/leviers.mjs';
import { lien } from '../lib/lien.mjs';

// La langue vient du préfixe d'URL, posé par le middleware.
const langue = Astro.locals.langue || 'fr';
const [t, site, modules, clients] = await Promise.all([
  textes(langue),
  chargerSite(langue),
  // Le parcours complet : on a besoin des fonctions pour l'icône et le compte.
  chargerParcours(langue),
  chargerClients(),
]);

// Le formulaire renvoie ici avec ?envoye=1 après enregistrement de la demande.
const envoye = Astro.url.searchParams.get('envoye') === '1';

const titre = site?.titre || "La valeur d'un réseau, c'est sa capacité à être transmis";
const sousTitre =
  site?.sous_titre || "Un ERP qui met le savoir-faire dans l'outil plutôt que dans la tête de quelques personnes.";
const problemes = site?.problemes || [];
const reponses = site?.reponses || [];
const ctaTexte = site?.cta_texte || 'Demander une démonstration';

/**
 * Les familles, avec leur clé d'ancrage et leur compte. La clé sert d'id de
 * bouton radio : c'est elle qui fait marcher le filtre sans JavaScript.
 */
const cleFamille = (nom) =>
  String(nom).toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const familles = [...new Set(modules.map((m) => m.groupe).filter(Boolean))].map((nom) => ({
  nom,
  cle: cleFamille(nom),
  nombre: modules.filter((m) => m.groupe === nom).length,
}));

/**
 * La règle qui masque tout ce qui n'appartient pas à la famille cochée.
 * Écrite ici parce qu'elle dépend du contenu de la base — et enveloppée dans
 * un `@supports` : sans `:has()`, le catalogue reste entier plutôt que figé.
 */
const filtreFamilles = `@supports selector(:has(*)) {\n${familles
  .map(
    (f) =>
      `  body:has(#famille-${f.cle}:checked) .module:not([data-famille='${f.cle}']) { display: none; }`,
  )
  .join('\n')}\n}`;

/** Une icône par réponse, prise dans l'ordre — purement décoratif. */
const ICONES_REPONSES = ['smartphone', 'circle-check', 'book-open', 'settings', 'triangle-alert', 'chart-line'];
---

<Layout
  description={site?.meta_description || sousTitre}
  large={true}
  actif="accueil"
>
  <!-- ── L'accroche ──────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="dedans hero__dedans" data-monte>
      <span class="oeil oeil--clair">{t('accueil.oeil')}</span>
      <h1 class="h-geant hero__titre">{titre}</h1>
      <p class="chapo chapo--clair hero__chapo">{sousTitre}</p>
      <div class="hero__actions">
        <a class="bouton bouton--chaud bouton--lg" href={lien('/#contact')}>
          {ctaTexte}
          <Icone nom="arrow-right" taille={16} classe="icone--miroir" />
        </a>
        <a class="bouton bouton--inverse bouton--lg" href={lien('/#modules')}>{t('accueil.cta_secondaire')}</a>
      </div>
    </div>
  </section>

  <!-- ── Ses problèmes, puis nos réponses ────────────────────────────── -->
  <section class="bande bande--serree">
    <div class="dedans plis">
      {problemes.length > 0 && (
        <details class="pli">
          <summary class="pli__tete">
            <span class="pli__intitule">
              <span class="oeil">{t('accueil.problemes.oeil')}</span>
              <span class="h-bloc">{t('accueil.problemes.titre')}</span>
            </span>
            <Icone nom="chevron-down" taille={16} classe="pli__chevron" />
          </summary>
          <div class="pli__corps">
            {problemes.map((p) => (
              <article class="carte carte--probleme">
                <h3 class="h-carte">{p.titre}</h3>
                <p class="texte">{p.texte}</p>
              </article>
            ))}
          </div>
        </details>
      )}

      {reponses.length > 0 && (
        <details class="pli">
          <summary class="pli__tete">
            <span class="pli__intitule">
              <span class="oeil">{t('accueil.reponses.oeil')}</span>
              <span class="h-bloc">{t('accueil.reponses.titre')}</span>
            </span>
            <Icone nom="chevron-down" taille={16} classe="pli__chevron" />
          </summary>
          <div class="pli__corps">
            {reponses.map((r, i) => (
              <article class="carte carte--reponse">
                <span class="carte__icone"><Icone nom={ICONES_REPONSES[i % ICONES_REPONSES.length]} taille={16} /></span>
                <h3 class="h-carte">{r.titre}</h3>
                <p class="texte">{r.texte}</p>
              </article>
            ))}
          </div>
        </details>
      )}
    </div>
  </section>

  <!-- ── Les six leviers ─────────────────────────────────────────────── -->
  <section class="bande" id="leviers">
    <div class="dedans">
      <div class="entete-section" data-monte>
        <span class="oeil">{t('accueil.leviers.oeil')}</span>
        <h2 class="h-section">{t('accueil.leviers.titre')}</h2>
        <p class="chapo">{t('accueil.leviers.chapo')}</p>
      </div>
      <div class="leviers">
        {LEVIERS.map((l) => (
          <div class="levier" data-monte>
            <div class="levier__tete">
              <Pastille levier={l} taille="md" />
              <code>{l.cle}</code>
            </div>
            <div>
              <div class="levier__nom">{l.nom}</div>
              <div class="levier__question">{l.question}</div>
            </div>
          </div>
        ))}
        <div class="leviers__note">
          <span>{t('accueil.leviers.note')}</span>
          <span class="pastilles">
            <Pastille levier={LEVIERS[0]} />
            <Pastille levier={LEVIERS[3]} />
          </span>
          <span>{t('accueil.leviers.note2')}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Le catalogue ────────────────────────────────────────────────── -->
  <section class="bande bande--grise" id="modules">
    <div class="dedans">
      <div class="entete-modules">
        <div class="entete-section entete-section--filtre" data-monte>
          <h2 class="oeil">{t('accueil.modules.oeil')}</h2>
          <div class="familles" role="group" aria-label={t('accueil.modules.familles')}>
            <input class="familles__choix" type="radio" name="famille" id="famille-toutes" checked />
            <label class="badge-famille" for="famille-toutes">
              {t('accueil.modules.toutes')} <b>{modules.length}</b>
            </label>
            {familles.map((f) => (
              <Fragment>
                <input class="familles__choix" type="radio" name="famille" id={`famille-${f.cle}`} />
                <label class="badge-famille" for={`famille-${f.cle}`}>{f.nom} <b>{f.nombre}</b></label>
              </Fragment>
            ))}
          </div>
        </div>
        <a href={lien('/onboarding')} class="entete-modules__lien">{t('accueil.modules.lien')}</a>
      </div>

      <div class="grille-modules">
        {modules.map((m) => (
          <a class="module" href={lien(`/modules/${m.slug}`)} data-famille={cleFamille(m.groupe || '')} data-monte>
            <div class="module__tete">
              <span class="module__icone"><Icone nom={m.icone || m.fonctions?.[0]?.icone || 'layers'} taille={20} /></span>
              <span class="module__noms">
                <span class="module__nom">{m.nom || m.slug}</span>
                <span class="module__groupe">{m.groupe}</span>
              </span>
            </div>
            <p class="texte module__accroche">{m.accroche}</p>
            <div class="module__pied">
              <span class="pastilles">
                {leviersDe(m.leviers).map((l) => <Pastille levier={l} />)}
              </span>
              <span class="module__compte fb-num">{t('module.compte_fonctions', { n: (m.fonctions || []).length })}</span>
              <Icone nom="chevron-right" taille={14} classe="icone--miroir module__fleche" />
            </div>
          </a>
        ))}
      </div>
    </div>
    <style set:html={filtreFamilles}></style>
  </section>

  <!-- ── Les réseaux qui travaillent avec nous ───────────────────────── -->
  {clients.length > 0 && (
    <section class="bande bande--serree" id="clients">
      <div class="dedans bandeau">
        <span class="bandeau__oeil">{t('accueil.clients.oeil')}</span>
        {clients.map((c) => (
          <span class="bandeau__nom" title={c.note || undefined}>{c.nom}</span>
        ))}
      </div>
    </section>
  )}

  <!-- ── Contact ─────────────────────────────────────────────────────── -->
  <section class="bande" id="contact">
    <div class="dedans">
      <div class="contact">
        <div class="contact__discours" data-monte>
          <h2 class="h-grand" style="color:#fff">{ctaTexte}</h2>
          <p class="chapo chapo--clair" style="max-width:44ch">{t('accueil.contact.chapo')}</p>
          <p class="contact__mail">
            <Icone nom="mail" taille={16} />
            <span class="fb-num">{t('accueil.contact.email')}</span>
          </p>
        </div>

        {envoye ? (
          <div class="contact__form contact__merci" data-monte>
            <span class="contact__coche"><Icone nom="circle-check" taille={22} /></span>
            <strong>{t('accueil.contact.merci_titre')}</strong>
            <p class="texte">{t('accueil.contact.merci')}</p>
          </div>
        ) : (
        <form class="contact__form" method="post" action={lien('/contact')} data-monte>
          {/* Le point de réception est unique, sans préfixe : sans ce champ,
              un visiteur qui écrit depuis /en/ serait remercié en français. */}
          <input type="hidden" name="langue" value={langue} />
          <label class="champ">
            <span>{t('accueil.contact.nom')}</span>
            <input type="text" name="nom" placeholder={t('accueil.contact.nom_exemple')} required />
          </label>
          <label class="champ">
            <span>{t('accueil.contact.reseau')}</span>
            <input type="text" name="reseau" placeholder={t('accueil.contact.reseau_exemple')} required />
          </label>
          <label class="champ">
            <span>{t('accueil.contact.email_libelle')}</span>
            <input type="email" name="email" placeholder={t('accueil.contact.email_exemple')} required />
          </label>
          <label class="champ">
            <span>{t('accueil.contact.situation')}</span>
            <textarea name="situation" rows="4" placeholder={t('accueil.contact.situation_exemple')}></textarea>
          </label>
          <!-- Piège à robots : invisible, jamais rempli par un humain. -->
          <div aria-hidden="true" class="piege">
            <label>Votre site web<input type="text" name="site_web" tabindex="-1" autocomplete="off" /></label>
          </div>
          <button class="bouton bouton--chaud bouton--lg" type="submit">
            {ctaTexte}
            <Icone nom="arrow-right" taille={16} classe="icone--miroir" />
          </button>
        </form>
        )}
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  /* ── Accroche ──────────────────────────────────────────────────────── */
  .hero {
    padding: 88px 40px 80px;
    color: #fff;
    background:
      radial-gradient(720px 360px at 82% 12%, rgba(240, 145, 42, 0.13), transparent 62%),
      linear-gradient(155deg, #1e2b57 0%, #0c1329 62%);
  }
  .hero__dedans { display: flex; flex-direction: column; gap: 22px; align-items: flex-start; }
  .hero__titre { max-width: 22ch; color: #fff; }
  .hero__chapo { max-width: 56ch; font-size: var(--text-lg); }
  .hero__actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-block-start: 6px; }
  @media (max-width: 820px) { .hero { padding: 56px 20px; } }

  /* ── Leviers ───────────────────────────────────────────────────────── */
  .leviers {
    border: 1px solid var(--slate-200);
    border-radius: var(--radius-panel);
    overflow: hidden;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  }
  .levier {
    padding: 24px; display: flex; flex-direction: column; gap: 10px;
    border-inline-end: 1px solid var(--slate-100);
    border-block-end: 1px solid var(--slate-100);
  }
  .levier__tete { display: flex; align-items: center; gap: 10px; }
  .levier__tete code { font: 400 11px/1 var(--font-mono); color: var(--slate-400); }
  .levier__nom { font: 600 var(--text-base) / 1.3 var(--font-display); }
  .levier__question { font: 400 var(--text-sm) / 1.5 var(--font-sans); color: var(--slate-600); }
  .leviers__note {
    grid-column: 1 / -1;
    display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
    padding: 14px 24px; background: var(--slate-25);
    font: 400 var(--text-xs) / 1.4 var(--font-sans); color: var(--slate-500);
  }

  /* ── Filtre par famille ────────────────────────────────────────────── */
  .entete-section--filtre { gap: 12px; max-width: none; }
  .entete-section--filtre h2 { margin: 0; }
  .familles { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  /* Le bouton radio porte l'état, le badge porte l'apparence : le filtre
     tient sans une ligne de JavaScript. */
  .familles__choix { position: absolute; opacity: 0; pointer-events: none; }
  .badge-famille {
    display: inline-flex; align-items: center; gap: 8px;
    block-size: 34px; padding-inline: 14px;
    border: 1px solid var(--slate-200); border-radius: var(--radius-pill);
    background: #fff; color: var(--slate-600);
    font: 500 var(--text-sm) / 1 var(--font-sans);
    cursor: pointer; user-select: none;
    transition: var(--transition-control);
  }
  .badge-famille:hover { border-color: var(--plum-300); color: var(--navy-900); }
  .badge-famille b {
    font: 500 12px/1 var(--font-mono); font-variant-numeric: tabular-nums;
    color: var(--slate-400);
  }
  .familles__choix:checked + .badge-famille {
    background: var(--plum-500); border-color: var(--plum-500); color: #fff;
  }
  .familles__choix:checked + .badge-famille b { color: rgba(255, 255, 255, 0.72); }
  .familles__choix:focus-visible + .badge-famille { box-shadow: var(--shadow-focus); }

  /* ── Bandeau des réseaux ───────────────────────────────────────────── */
  .bandeau {
    display: flex; align-items: center; gap: 32px; flex-wrap: wrap;
    border-block-start: 1px solid var(--slate-100); padding-block-start: 32px;
  }
  .bandeau__oeil {
    font: 400 var(--text-xs) / 1.4 var(--font-sans);
    letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--slate-400);
  }
  .bandeau__nom {
    display: inline-flex; align-items: center; block-size: 30px; padding-inline: 12px;
    border: 1px dashed var(--slate-200); border-radius: var(--radius-sm);
    font: 600 14px/1 var(--font-display); color: var(--slate-400);
  }

  /* ── Contact ───────────────────────────────────────────────────────── */
  .contact {
    background: var(--gradient-plum-navy);
    border-radius: var(--radius-2xl);
    padding: 56px;
    /* `min(340px, 100%)` et non `340px` : sur un écran de 375 px la colonne
       forçait sa largeur minimale et poussait toute la page hors cadre. */
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: 48px; align-items: center;
  }
  .contact__discours { display: flex; flex-direction: column; gap: 16px; color: #fff; }
  .contact__mail { display: flex; align-items: center; gap: 10px; margin: 0; color: rgba(255, 255, 255, 0.75); font-size: var(--text-sm); }
  /* Une adresse n'offre aucune césure naturelle : sur un écran de 375 px elle
     poussait toute la section de contact hors cadre, et la page entière avec.
     On l'autorise à se couper — une adresse sur deux lignes reste lisible, une
     page qui défile de travers non. */
  .contact__mail .fb-num { min-inline-size: 0; overflow-wrap: anywhere; }
  .contact__form {
    background: #fff; border-radius: var(--radius-panel); padding: 28px;
    display: flex; flex-direction: column; gap: 14px;
    box-shadow: 0 12px 32px rgba(12, 19, 41, 0.3);
  }
  .champ { display: flex; flex-direction: column; gap: 6px; }
  .champ > span { font: var(--type-label); color: var(--slate-600); }
  .champ input, .champ textarea {
    inline-size: 100%; padding: 10px 12px;
    border: 1px solid var(--slate-200); border-radius: var(--radius-control);
    font: var(--type-body-sm); color: var(--navy-900); background: #fff;
    transition: var(--transition-control);
  }
  /* Safari iOS zoome sur tout champ dont la police descend sous 16 px : la
     page saute au premier appui, et le visiteur perd le formulaire de vue.
     On monte la police sur mobile plutôt que de bloquer le zoom, qui reste
     un besoin d'accessibilité. */
  @media (max-width: 820px) {
    .champ input, .champ textarea { font-size: 16px; }
  }
  .champ textarea { resize: vertical; }
  .champ input:focus-visible, .champ textarea:focus-visible {
    outline: none; border-color: var(--plum-400); box-shadow: var(--shadow-focus);
  }
  .contact__merci { align-items: center; text-align: center; gap: 10px; padding: 40px 28px; }
  .contact__merci strong { font: 600 var(--text-lg) / 1.3 var(--font-display); }
  .contact__coche {
    display: inline-flex; align-items: center; justify-content: center;
    inline-size: 44px; block-size: 44px; border-radius: 50%;
    background: var(--green-100); color: var(--green-700);
  }
  .piege { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); }

  @media (max-width: 820px) { .contact { padding: 28px; gap: 28px; } }
</style>
