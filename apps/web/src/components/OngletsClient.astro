---
/**
 * Les onglets d'un client : tout ce qu'on a à dire de lui, au même endroit.
 *
 * Le rail range les écrans par métier — le commercial ici, l'onboarding là, les
 * accès ailleurs. C'est le bon classement quand on fait une tournée de tous les
 * clients, et le mauvais quand on en regarde **un** : chaque question obligeait
 * à changer de rubrique et à refiltrer sur son nom.
 *
 * Sept onglets, sept questions, dans l'ordre où elles se posent :
 *
 *   fiche          qui est-il, qui le suit
 *   charte         de quelles couleurs s'habillent ses applications
 *   modules        qu'a-t-il acheté
 *   contrats       où en est le papier, et sa signature
 *   applications   qu'est-ce qui tourne, et sur quelles API
 *   journal        que s'est-il passé chez lui
 *   facturation    qu'est-ce qui lui est facturé
 *
 * Un bandeau plutôt qu'une fusion. Ces pages ne se ressemblent pas — la fiche
 * lit, la charte édite et publie, le journal déroule — et les coudre en une
 * seule produirait un écran que personne ne relit.
 *
 * Les écrans d'ensemble restent dans le rail : « Chartes clients » dit qui a
 * surchargé quoi, « Jetons » dit qui accède à quoi. Ce bandeau sert l'autre
 * chemin, qui n'existait pas : je regarde un client, je veux tout de lui.
 */
const { prospect, actif } = Astro.props;
import { lien } from '../lib/lien.mjs';

const ONGLETS = [
  { cle: 'fiche', libelle: 'Fiche', href: `/admin/prospects/${prospect}` },
  { cle: 'charte', libelle: 'Charte graphique', href: `/admin/charte/${prospect}` },
  { cle: 'modules', libelle: 'Modules', href: `/admin/prospects/${prospect}/modules` },
  { cle: 'contrats', libelle: 'Contrats', href: `/admin/prospects/${prospect}/contrats` },
  { cle: 'applications', libelle: 'Applications', href: `/admin/prospects/${prospect}/applications` },
  { cle: 'journal', libelle: 'Journal technique', href: `/admin/prospects/${prospect}/journal` },
  { cle: 'facturation', libelle: 'Facturation', href: `/admin/prospects/${prospect}/facturation` },
];
---

<nav class="onglets-client" aria-label="Sections du client">
  {ONGLETS.map((o) => (
    <a
      class="onglets-client__lien"
      href={lien(o.href)}
      aria-current={actif === o.cle ? 'page' : undefined}
    >
      {o.libelle}
    </a>
  ))}
</nav>

<style is:global>
  .onglets-client {
    display: flex;
    gap: 2px;
    margin-block-end: 20px;
    border-block-end: 1px solid var(--slate-200);
    /* Six onglets tiennent sur un écran de bureau et pas sur un portable. Ils
       défilent plutôt que de passer à la ligne : un bandeau sur deux rangées
       fait perdre le repère du trait actif. */
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .onglets-client__lien {
    padding: 10px 16px;
    white-space: nowrap;
    font: 500 var(--text-sm) / 1.3 var(--font-sans);
    color: var(--slate-600);
    text-decoration: none;
    /* Le trait actif est posé à l'intérieur, sur la bordure du conteneur :
       un `border-bottom` sur le lien décalerait le texte d'un pixel au
       survol, et le bandeau entier tremblerait. */
    box-shadow: inset 0 -2px 0 transparent;
    transition: color var(--duration-fast) ease, box-shadow var(--duration-fast) ease;
  }
  .onglets-client__lien:hover { color: var(--slate-900); }
  .onglets-client__lien[aria-current='page'] {
    color: var(--brand);
    box-shadow: inset 0 -2px 0 var(--brand);
  }
</style>
