# Database — MySQL (Prisma), the `tfb_landing` schema. All tfb_ tables live here.
# prompt_technique_tfb.md suggested PostgreSQL but marked the stack "à adapter";
# tfb_landing is MySQL, so that is what the schema targets.
DATABASE_URL=mysql://user:password@host:3306/tfb_landing

# Default locale. Every landing string falls back to this language when a
# tfb_translations row is missing.
DEFAULT_LOCALE=fr

# Sous-chemin de service, par ex. /landing_tfb. Vide = racine du domaine.
# ATTENTION : cette valeur est INLINÉE AU BUILD. La changer impose de relancer
# `npm run build`, et elle doit être présente dans l'environnement du build —
# pas seulement dans celui du service.
NEXT_PUBLIC_BASE_PATH=

# Server-side file storage. Uploads (module screenshots, brand logos) are written
# to folders under this path; the DB stores only the relative path.
STORAGE_PATH=./storage

# Back-office sessions (signed JWT in an httpOnly cookie). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-me-32-bytes-minimum-for-hs256

# Stripe — STUBBED in this cut. With no keys set, /api/checkout returns a stub
# response and the webhook rejects unsigned calls. Fill these in to go live.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Billing service (separate Laravel/MySQL service — uploads/billing_service_db.sql).
# Unset: the back office's billing screens read the fixture dataset shipped in
# src/lib/billing/fixtures.ts. Set it to point at the real service.
BILLING_SERVICE_URL=
BILLING_SERVICE_TOKEN=

# Recette en HTTP nu uniquement. Sans TLS, le cookie de session `Secure` n'est
# jamais envoyé et la connexion au back office échoue en silence. Mettez cette
# variable à `true` le temps de tester sur une IP sans certificat, et retirez-la
# dès que HTTPS est en place — sinon le cookie circule en clair.
ALLOW_INSECURE_COOKIES=
