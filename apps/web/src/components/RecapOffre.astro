---
/**
 * Le récapitulatif chiffré d'une offre.
 *
 * Trois colonnes et non deux : une fois, par mois, par an. Le prix par vue
 * étant mensuel, l'option « location » est entièrement récurrente — la mettre
 * dans la même colonne que les six chiffres de l'achat ferme est la façon
 * exacte de vendre à perte. Une colonne vide reste affichée : son absence
 * ferait croire à un oubli.
 *
 * Le calcul n'a pas lieu ici. Ce composant reçoit ce que `calculerOffre` a
 * rendu côté serveur et se contente de le mettre en forme — recalculer quoi
 * que ce soit à l'affichage voudrait dire écrire la formule deux fois.
 */
import { RECURRENCES, formater, formaterTaux } from '../lib/offres/calcul.mjs';

const { resultat, langue = 'fr', devise = 'EUR', mention = null } = Astro.props;
const { seaux, remiseIgnoree, tauxTva, exoneree } = resultat;

const EN_TETE = {
  unique: { titre: 'Une fois', note: 'à la signature' },
  mensuel: { titre: 'Par mois', note: 'tant que le service tourne' },
  annuel: { titre: 'Par an', note: 'maintenance' },
};

const LIBELLE_TYPE = {
  prestation: 'Onboarding',
  formation: 'Formation',
  vue: 'Application',
  achat: 'Application',
  maintenance: 'Maintenance',
};

const montant = (cents) => formater(cents, langue, devise);

/** Un seau sans la moindre ligne : on l'affiche quand même, à zéro. */
const vide = (cle) => seaux[cle].lignes.length === 0;
---

<div class="recap">
  <div class="recap__colonnes">
    {RECURRENCES.map((cle) => {
      const seau = seaux[cle];
      return (
        <section class={`recap__seau ${vide(cle) ? 'recap__seau--vide' : ''}`}>
          <header class="recap__tete">
            <span class="recap__titre">{EN_TETE[cle].titre}</span>
            <span class="recap__note">{EN_TETE[cle].note}</span>
          </header>

          {vide(cle) ? (
            <p class="recap__rien">—</p>
          ) : (
            <ul class="recap__lignes" role="list">
              {seau.lignes.map((l) => (
                <li>
                  <span class="recap__ligne-nom">
                    {l.libelle}
                    <span class="recap__ligne-type">{LIBELLE_TYPE[l.type] || l.type}</span>
                    {l.quantite > 1 && <span class="recap__ligne-qte fb-num">× {l.quantite}</span>}
                  </span>
                  <span class="recap__ligne-montant fb-num">{montant(l.total_cents)}</span>
                </li>
              ))}
            </ul>
          )}

          <dl class="recap__totaux">
            <div><dt>Sous-total</dt><dd class="fb-num">{montant(seau.sousTotal)}</dd></div>
            {seau.remise > 0 && (
              <div class="recap__remise"><dt>Remise</dt><dd class="fb-num">− {montant(seau.remise)}</dd></div>
            )}
            <div><dt>Hors taxes</dt><dd class="fb-num">{montant(seau.ht)}</dd></div>
            <div>
              <dt>TVA {exoneree ? '' : formaterTaux(tauxTva)}</dt>
              <dd class="fb-num">{exoneree ? '—' : montant(seau.tva)}</dd>
            </div>
            <div class="recap__ttc"><dt>Total</dt><dd class="fb-num">{montant(seau.ttc)}</dd></div>
          </dl>
        </section>
      );
    })}
  </div>

  {remiseIgnoree > 0 && (
    <p class="recap__alerte">
      La remise dépassait le montant payé une fois de <strong>{montant(remiseIgnoree)}</strong>.
      Ces {montant(remiseIgnoree)} n'ont pas été déduits : une remise ne crée pas d'avoir.
      {' '}Réduisez-la, ou passez en pourcentage pour qu'elle porte aussi sur le récurrent.
    </p>
  )}

  {exoneree && (
    <p class="recap__mention">
      <strong>Exonéré de TVA.</strong>{' '}
      {mention || "Aucune mention d'exonération n'est renseignée dans les tarifs — une exonération sans mention légale n'en est pas une."}
    </p>
  )}
</div>

<style is:global>
  .recap { display: flex; flex-direction: column; gap: 12px; }
  .recap__colonnes { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr)); }

  .recap__seau {
    display: flex; flex-direction: column; gap: 10px;
    padding: 14px;
    border: 1px solid var(--slate-200); border-radius: var(--radius-card);
    background: #fff;
  }
  /* Un rythme sans ligne reste visible, en retrait : le masquer laisserait
     croire qu'on a oublié de le calculer. */
  .recap__seau--vide { background: var(--slate-50); color: var(--slate-400); }

  .recap__tete { display: flex; flex-direction: column; gap: 1px; }
  .recap__titre {
    font: 600 var(--text-xs) / 1.2 var(--font-sans);
    letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--text-brand);
  }
  .recap__seau--vide .recap__titre { color: var(--slate-400); }
  .recap__note { font: 400 11px/1.3 var(--font-sans); color: var(--slate-400); }
  .recap__rien { margin: 0; font: 400 var(--text-sm) / 1 var(--font-sans); }

  .recap__lignes { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .recap__lignes li { display: flex; align-items: baseline; gap: 10px; }
  .recap__ligne-nom {
    display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; min-inline-size: 0;
    font: 400 var(--text-sm) / 1.35 var(--font-sans);
  }
  .recap__ligne-type {
    font: 500 10px/1 var(--font-sans);
    letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--slate-400);
  }
  .recap__ligne-qte { font-size: 11px; color: var(--slate-400); }
  .recap__ligne-montant { margin-inline-start: auto; font-size: var(--text-sm); white-space: nowrap; }

  .recap__totaux {
    margin: 0; display: flex; flex-direction: column; gap: 4px;
    padding-block-start: 10px; border-block-start: 1px solid var(--slate-100);
  }
  .recap__totaux > div { display: flex; align-items: baseline; gap: 10px; }
  .recap__totaux dt { font: 400 var(--text-xs) / 1.4 var(--font-sans); color: var(--slate-600); }
  .recap__totaux dd { margin: 0; margin-inline-start: auto; font-size: var(--text-xs); white-space: nowrap; }
  .recap__remise dt, .recap__remise dd { color: var(--teal-700); }
  .recap__ttc { padding-block-start: 6px; border-block-start: 1px solid var(--slate-100); }
  .recap__ttc dt { font-weight: 600; color: var(--navy-900); }
  .recap__ttc dd { font: 600 var(--text-md) / 1.2 var(--font-display); color: var(--navy-900); }
  .recap__seau--vide .recap__ttc dd { color: var(--slate-400); }

  .recap__alerte, .recap__mention {
    margin: 0; padding: 10px 12px; border-radius: var(--radius-control);
    font: 400 var(--text-sm) / 1.5 var(--font-sans);
  }
  .recap__alerte { background: var(--amber-50); color: var(--amber-700); border: 1px solid var(--amber-300); }
  .recap__mention { background: var(--slate-50); color: var(--slate-600); border: 1px solid var(--slate-200); }
</style>
