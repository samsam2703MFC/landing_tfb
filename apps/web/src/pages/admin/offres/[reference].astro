---
/**
 * La fiche d'une offre : on la configure et on la lit chiffrée, au même
 * endroit.
 *
 * Le récapitulatif se met à jour à chaque enregistrement, par un
 * POST-redirection-GET. C'est volontairement un aller-retour serveur plutôt
 * qu'un calcul dans le navigateur : la formule n'existe qu'à un seul endroit.
 * La recopier en JavaScript pour gagner cent millisecondes reviendrait à
 * pouvoir afficher un prix et en facturer un autre.
 *
 * Une offre envoyée ne se modifie plus. Le formulaire passe en lecture seule
 * et le seul geste possible est d'en faire une nouvelle version — sinon le
 * document dans la boîte du client et celui en base finiraient par dire deux
 * prix différents.
 */
import Console from '../../../components/Console.astro';
import Icone from '../../../components/Icone.astro';
import RecapOffre from '../../../components/RecapOffre.astro';
import {
  chargerOffre,
  changerStatutOffre,
  changerEtapeOffre,
  contratDeLOffre,
  genererContrat,
  compteurs,
  etapeParCle,
  journaliser,
  listerEtapes,
  listerSuivi,
  configDe,
  enregistrerOffre,
  languesOffre,
  listerPrestations,
  instantanePacks,
  modulesOptionnels,
  packsVendables,
  nouvelleVersion,
  offreFigee,
  supprimerOffre,
  tarifsEnVigueur,
} from '../../../lib/admin/donnees.mjs';
import { calculerOffre, formater, lignesIncompletes } from '../../../lib/offres/calcul.mjs';
import { aRelancer, prochaineRelance } from '../../../lib/offres/relances.mjs';
import { construireCourriel, serviceCourriel } from '../../../lib/offres/courriel.mjs';
import { depuisCents, depuisPoints, enCents, enEntier, enPoints } from '../../../lib/offres/montants.mjs';
import { cleAnnexe } from '../../../lib/admin/session.mjs';

/**
 * Le lien d'annexe remis au client, signé et absolu.
 *
 * Absolu parce qu'il part dans un courriel : un chemin relatif n'y mène nulle
 * part. `SITE_DOMAIN` le fournit ; sans lui, on retombe sur l'adresse du
 * serveur, ce qui reste cliquable pour un essai.
 */
function lienAnnexe(offre, origine) {
  const racine = (import.meta.env.SITE_DOMAIN || process.env.SITE_DOMAIN || origine || '').replace(/\/+$/, '');
  const base = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
  const cle = cleAnnexe(offre.reference, String(offre.version));
  return `${racine}${base}/annexe/${offre.reference}?version=${offre.version}&cle=${cle}`;
}

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
const { reference } = Astro.params;
const versionDemandee = Astro.url.searchParams.get('version');
let erreur = null;
// Ce qui vient d'être soumis mais n'a pas pu être enregistré : le formulaire
// se réaffiche avec, plutôt qu'avec ce que la base contient encore.
let soumis = null;

/** Une ligne incomplète, dite en français. */
function direManque(m) {
  if (m.ou === 'vue' && m.manque === 'description') {
    return `Vue n° ${m.rang} : pas de description — elle s'imprimerait « Vue » sur l'offre.`;
  }
  if (m.ou === 'vue') {
    return `Vue n° ${m.rang} « ${m.nom} » : le nombre est à zéro — elle ne s'imprimerait nulle part.`;
  }
  if (m.ou === 'libre') {
    return `Ligne libre n° ${m.rang} : pas d'intitulé — c'est ce qui s'imprime sur l'offre.`;
  }
  return 'Une prestation sans intitulé.';
}

/**
 * Lit la configuration soumise.
 *
 * Rien n'est levé : les saisies fautives sont **toutes** collectées dans
 * `soucis`, et la configuration est rendue quand même. C'est ce qui permet
 * de réafficher le formulaire tel qu'il a été rempli au lieu de le recharger
 * depuis la base — perdre dix minutes de saisie parce qu'un prix contenait
 * une lettre serait la meilleure façon de faire détester l'écran.
 */
async function lireConfig(f, catalogues, soucis) {
  // La saisie telle qu'elle a été tapée, pour les seuls champs refusés :
  // réafficher « 0,00 » à la place de « environ 1000 » ferait croire que la
  // valeur est passée, dans le champ précisément qu'on demande de corriger.
  const refusees = new Map();

  /** Convertit, ou note le grief, garde la saisie et rend zéro. */
  const lire = (convertir, saisie, champ, cle) => {
    try {
      return convertir(saisie, champ);
    } catch (err) {
      soucis.push(err.message);
      refusees.set(cle, String(saisie ?? ''));
      return 0;
    }
  };

  const choisies = new Set(f.getAll('prestation').map(String));
  const prestations = catalogues.prestations
    .filter((p) => choisies.has(String(p.id)))
    // Le prix est recopié : une remise de catalogue le mois prochain ne doit
    // pas changer le montant d'une offre déjà chiffrée.
    .map((p) => ({ cle: p.cle, nom: p.nom, description: p.description, prix_cents: p.prix_cents }));

  // Les lignes libres : ce qu'un commercial ajoute pour cette offre-là, sans
  // toucher au catalogue — qu'il n'a d'ailleurs pas le droit de modifier.
  const libresNoms = f.getAll('libre_nom');
  const libresPrix = f.getAll('libre_prix');
  for (let i = 0; i < libresNoms.length; i += 1) {
    const nom = String(libresNoms[i] || '').trim();
    const prix = String(libresPrix[i] || '').trim();
    if (!nom && !prix) continue;
    // Une ligne sans intitulé est conservée telle quelle : elle sera signalée
    // à l'écran, ligne par ligne, et l'offre ne pourra pas partir tant qu'elle
    // le reste. La faire disparaître à l'enregistrement serait pire — le
    // commercial croirait avoir saisi quelque chose qui n'existe plus.
    prestations.push({
      cle: `libre-${i + 1}`,
      nom,
      description: null,
      prix_cents: lire(enCents, prix || '0', `Prix de la ligne libre n° ${i + 1}`, `libre_prix.${i}`),
      libre: true,
    });
  }

  // Les modules de l'ERP retenus, avec leur prix et leur argumentaire du
  // jour : une fiche réécrite plus tard ne doit pas changer une offre partie.
  const cochés = new Set(f.getAll('module').map(String));
  const modulesRetenus = catalogues.modules
    .filter((m) => cochés.has(String(m.id)))
    .map((m) => ({
      slug: m.slug, nom: m.nom, prix_cents: m.prix_cents,
      pourquoi: m.pourquoi, apporte: m.apporte,
    }));

  // Les packs retenus, recopiés avec leur prix et leur unité du jour.
  const packsCoches = new Set(f.getAll('pack').map(String));
  const packsRetenus = instantanePacks(catalogues.packs.filter((p) => packsCoches.has(p.cle)));

  const nombres = f.getAll('vue_nombre');
  const notes = f.getAll('vue_note');
  const internes = f.getAll('vue_interne');
  const vues = [];
  for (let i = 0; i < nombres.length; i += 1) {
    const note = String(notes[i] || '').trim();
    const interne = String(internes[i] || '').trim();
    const brut = String(nombres[i] || '').trim();
    // Une ligne entièrement vide est un reliquat du formulaire, pas une vue.
    if (!note && !brut && !interne) continue;
    vues.push({
      nombre: lire(enEntier, brut || '0', `Nombre de la vue n° ${i + 1}`, `vue_nombre.${i}`),
      note,
      // Ne part jamais chez le client : c'est le pense-bête du commercial.
      interne: interne || null,
    });
  }

  const remiseType = String(f.get('remise_type') || 'pourcent');
  const remiseBrute = String(f.get('remise_valeur') || '0').trim() || '0';
  const exoneree = f.get('tva_exoneree') === '1';

  return {
    refusees,
    langue: String(f.get('langue') || 'fr'),
    jours_formation: lire(enEntier, String(f.get('jours_formation') || '0').trim() || '0', 'Jours de formation', 'jours_formation'),
    nombre_postes: lire(enEntier, String(f.get('nombre_postes') || '0').trim() || '0', 'Points de vente', 'nombre_postes'),
    postes_franchiseur: lire(enEntier, String(f.get('postes_franchiseur') || '0').trim() || '0', 'Postes franchiseur', 'postes_franchiseur'),
    postes_onboardes: lire(enEntier, String(f.get('postes_onboardes') || '0').trim() || '0', 'Postes à onboarder', 'postes_onboardes'),
    mois_offerts: lire(enEntier, String(f.get('mois_offerts') || '0').trim() || '0', 'Mois offerts', 'mois_offerts'),
    option_app: String(f.get('option_app') || 'aucune'),
    packs: packsRetenus,
    socle_pos: String(f.get('socle_pos') || 'pos') === 'api' ? 'api' : 'pos',
    prestations,
    modules: modulesRetenus,
    vues,
    remise_type: remiseType,
    remise_valeur: remiseType === 'fixe'
      ? lire(enCents, remiseBrute, 'Remise', 'remise_valeur')
      : lire(enPoints, remiseBrute, 'Remise', 'remise_valeur'),
    tva_taux: lire(enPoints, String(f.get('tva_taux') || '21').trim() || '0', 'TVA', 'tva_taux'),
    tva_exoneree: exoneree,
    tva_mention: exoneree ? String(f.get('tva_mention') || '').trim() : null,
    portee: String(f.get('portee') || '').trim(),
    delai: String(f.get('delai') || '').trim(),
    valide_jusqu_au: f.get('valide_jusqu_au') ? new Date(String(f.get('valide_jusqu_au'))) : null,
  };
}

if (Astro.request.method === 'POST') {
  try {
    const f = await Astro.request.formData();
    const action = String(f.get('action') || 'enregistrer');
    const session = Astro.locals.session || {};
    const courante = await chargerOffre(reference, versionDemandee);
    if (!courante) throw new Error('Offre introuvable.');

    if (action === 'version') {
      const neuve = await nouvelleVersion(reference);
      return Astro.redirect(
        `${BASE}/admin/offres/${neuve.reference}?version=${neuve.version}&ok=${encodeURIComponent(`Version ${neuve.version} créée, aux tarifs d'aujourd'hui.`)}`,
        303,
      );
    }

    if (action === 'note') {
      const texte = String(f.get('texte') || '').trim();
      if (!texte) throw new Error('Une note vide n’apprend rien à personne.');
      await journaliser(courante.id, { type: 'note', texte, utilisateurId: session.id });
      return Astro.redirect(
        `${BASE}/admin/offres/${reference}?version=${courante.version}&ok=${encodeURIComponent('Note ajoutée.')}`,
        303,
      );
    }

    if (action === 'etape') {
      await changerEtapeOffre(courante.id, String(f.get('etape') || ''), session.id);
      return Astro.redirect(
        `${BASE}/admin/offres/${reference}?version=${courante.version}&ok=${encodeURIComponent('Étape mise à jour.')}`,
        303,
      );
    }

    if (action === 'contrat') {
      const { reference: ref, regenere } = await genererContrat(courante.id, session.id);
      return Astro.redirect(
        `${BASE}/admin/contrats/${ref}?ok=${encodeURIComponent(regenere ? 'Contrat régénéré.' : 'Contrat édité.')}`,
        303,
      );
    }

    if (action === 'suppression') {
      await supprimerOffre(courante.id);
      return Astro.redirect(`${BASE}/admin/offres?ok=${encodeURIComponent('Brouillon supprimé.')}`, 303);
    }

    if (action === 'envoyer') {
      // Dernier filet avant la boîte du client : une ligne à moitié remplie
      // s'imprimerait sans nom, ou disparaîtrait sans que personne ne le voie.
      const restes = lignesIncompletes(configDe(courante));
      if (restes.length > 0) {
        throw new Error(
          `Offre incomplète, ${restes.length} ligne(s) à reprendre — ${restes.map(direManque).join(' ')}`,
        );
      }
      const tarifs = await tarifsEnVigueur();
      const message = construireCourriel({
        offre: courante,
        resultat: calculerOffre(configDe(courante)),
        gabarits: {
          sujet: tarifs.courriel_sujet,
          corps: tarifs.courriel_corps,
          css: tarifs.courriel_css,
          annexe: lienAnnexe(courante, Astro.url.origin),
        },
        formater: (c) => formater(c, courante.langue, courante.devise),
      });
      if (!message.destinataire) {
        throw new Error(
          "Ce client n'a pas d'adresse de courriel. Corrigez ses coordonnées avant d'envoyer.",
        );
      }
      // Le bouton est grisé quand l'offre n'est pas prête, mais un bouton
      // grisé se contourne : c'est ici que le refus compte.
      const chiffre = calculerOffre(configDe(courante));
      const totalTtc = chiffre.seaux.unique.ttc + chiffre.seaux.mensuel.ttc + chiffre.seaux.annuel.ttc;
      if (lignesIncompletes(configDe(courante)).length > 0 || totalTtc === 0 || !courante.valide_jusqu_au) {
        throw new Error(
          "Cette offre n'est pas prête à partir : il lui manque un chiffrage, une date de validité, ou une ligne est à moitié remplie.",
        );
      }
      const service = serviceCourriel();
      await service.envoyer(message);
      await changerStatutOffre(courante.id, 'envoyee', session.id);
      const dit = service.expedie
        ? `Offre envoyée à ${message.destinataire}.`
        : `Offre marquée envoyée, mais RIEN N'A ÉTÉ EXPÉDIÉ : aucun service de courriel n'est configuré. Le message est dans le journal du serveur — envoyez-le à la main à ${message.destinataire}.`;
      return Astro.redirect(
        `${BASE}/admin/offres/${reference}?version=${courante.version}&ok=${encodeURIComponent(dit)}`,
        303,
      );
    }

    const soucis = [];
    const config = await lireConfig(f, {
      prestations: await listerPrestations(),
      modules: await modulesOptionnels(),
      packs: await packsVendables(),
    }, soucis);
    // « Ajouter une vue » enregistre d'abord, puis pose une ligne vide : sans
    // JavaScript, c'est un aller-retour, et perdre la saisie en cours serait
    // le meilleur moyen de faire détester l'écran.
    if (action === 'ajouter_vue') config.vues.push({ nombre: 1, note: '', interne: null });
    if (action === 'ajouter_libre') config.prestations.push({ cle: 'libre-neuve', nom: '', prix_cents: 0, libre: true });

    // Une saisie illisible arrête l'enregistrement, mais pas la page : on
    // réaffiche ce qui vient d'être tapé, avec la liste de ce qui coince.
    if (soucis.length > 0) {
      erreur = soucis.join(' · ');
      soumis = config;
    } else {
      await enregistrerOffre(courante.id, config);
      return Astro.redirect(`${BASE}/admin/offres/${reference}?version=${courante.version}`, 303);
    }
  } catch (err) {
    erreur = err.message;
  }
}

let offre = null;
let catalogue = [];
let modules = [];
let packs = [];
let etapes = [];
let suivi = [];
let langues = [];
let vigueur = null;
let chiffres = {};
try {
  offre = await chargerOffre(reference, versionDemandee);
  langues = await languesOffre();
  catalogue = await listerPrestations({ activesSeulement: true });
  modules = await modulesOptionnels();
  packs = await packsVendables();
  etapes = await listerEtapes({ activesSeulement: true });
  vigueur = await tarifsEnVigueur();
  chiffres = await compteurs();
} catch (err) {
  erreur = erreur || `Base injoignable : ${err.message}`;
}

if (!offre && !erreur) return new Response('Offre introuvable', { status: 404 });

// La saisie refusée prime sur ce que la base contient encore : les deux
// portent les mêmes noms de champ, la fusion suffit à réafficher le
// formulaire exactement comme il vient d'être rempli.
if (offre && soumis) offre = { ...offre, ...soumis };

if (offre) suivi = await listerSuivi(offre.id);
const etapeCourante = offre ? await etapeParCle(offre.etape) : null;
const contrat = offre ? await contratDeLOffre(offre.id) : null;

const figee = offreFigee(offre);
const resultat = offre ? calculerOffre(configDe(offre)) : null;

// Les lignes à moitié remplies, et de quoi les montrer du doigt : le rang
// rendu par le calculateur est celui de la ligne à l'écran.
const incompletes = offre ? lignesIncompletes(configDe(offre)) : [];

/** La saisie refusée d'un champ, s'il y en a une — sinon la valeur en base. */
const refus = (cle, defaut) => (soumis?.refusees?.has(cle) ? soumis.refusees.get(cle) : defaut);
/**
 * Ce qui empêche l'offre de partir, dit en français.
 *
 * Les lignes à moitié remplies n'étaient pas seules à mériter un refus : une
 * offre entièrement vide passait, et le client recevait une lettre à zéro
 * euro sans date de validité. Personne n'avait rien saisi — c'est justement
 * le cas où l'écran doit arrêter la main.
 */
const empechements = [];
if (offre) {
  for (const m of incompletes) empechements.push(direManque(m));
  const total = resultat
    ? resultat.seaux.unique.ttc + resultat.seaux.mensuel.ttc + resultat.seaux.annuel.ttc
    : 0;
  if (total === 0) {
    empechements.push("L'offre ne chiffre rien : aucun pack, aucun module, aucune prestation.");
  }
  if (!offre.valide_jusqu_au) {
    empechements.push("Pas de date de validité — la lettre annoncerait « valable jusqu'au — ».");
  }
}

const vuesFautives = new Set(incompletes.filter((m) => m.ou === 'vue').map((m) => m.rang - 1));
const libresFautives = new Set(incompletes.filter((m) => m.ou === 'libre').map((m) => m.rang - 1));
const message = Astro.url.searchParams.get('ok');
const choisies = new Set((offre?.prestations || []).filter((p) => !p.libre).map((p) => p.cle));
const modulesRetenus = new Set((offre?.modules || []).map((m) => m.slug));
// Les packs de l'offre, et la question qu'ils posent : faut-il demander un
// nombre de points de vente ? Seulement si l'un d'eux s'y facture.
const retenus = new Set((offre?.packs || []).map((p) => p.cle));
// L'unité se lit sur le **catalogue**, pas sur la copie posée dans l'offre :
// une offre d'avant les packs n'en a aucune, et le champ le plus important de
// l'écran disparaissait alors sans un mot. Le catalogue, lui, l'a toujours.
const packsAuPoste = packs.filter((p) => retenus.has(p.cle) && p.unite === 'poste_mois');
// Le choix de la caisse ne se pose que si un pack retenu en contient une, et
// alors il est obligatoire : livrer une offre sans dire laquelle des deux
// c'est laisserait la question ouverte jusqu'à l'installation.
const packCaisse = packs.find((p) => retenus.has(p.cle) && p.avec_caisse) || null;
const pointsDeVente = Number(offre?.nombre_postes) || 0;

// Les lignes libres, avec une ligne vide en réserve tant que l'offre s'édite.
// La ligne de réserve s'affiche entièrement vide — un « 0,00 » préimprimé en
// ferait une ligne à moitié remplie dès le premier enregistrement, et l'écran
// réclamerait un intitulé pour une ligne que personne n'a demandée.
const libres = (offre?.prestations || []).filter((p) => p.libre);
if (!figee && libres.length === 0) libres.push({ nom: '', prix_cents: 0, reserve: true });

// Une ligne vide en réserve : on peut décrire une vue sans avoir à demander
// d'abord une ligne au serveur.
const vues = [...(offre?.vues || [])];
if (!figee && vues.length === 0) vues.push({ nombre: '', note: '', reserve: true });

/** Une date courte, et une date avec l'heure pour le journal. */
const jourCourt = (v) => (v ? new Date(v).toLocaleDateString('fr-BE') : '—');
const jourHeure = (v) =>
  (v ? new Date(v).toLocaleString('fr-BE', { dateStyle: 'short', timeStyle: 'short' }) : '—');

/** Une date au format que `<input type="date">` attend. */
const pourChamp = (valeur) => (valeur ? new Date(valeur).toISOString().slice(0, 10) : '');

// Le message tel qu'il partirait. Construit à l'affichage pour que l'aperçu
// suive la moindre modification de l'offre ou du gabarit.
const service = serviceCourriel();
const courriel = offre
  ? construireCourriel({
      offre,
      resultat,
      gabarits: {
        sujet: vigueur?.courriel_sujet || '',
        corps: vigueur?.courriel_corps || '',
        css: vigueur?.courriel_css || '',
        annexe: lienAnnexe(offre, Astro.url.origin),
      },
      formater: (c) => formater(c, offre.langue, offre.devise),
    })
  : null;

// Le courriel que l'étape propose, avec ses jetons déjà remplacés : le
// commercial le copie tel quel plutôt que de chercher ce que remplace quoi.
const courrielEtape = offre && etapeCourante?.gabarit_actif
  ? construireCourriel({
      offre,
      resultat,
      gabarits: {
        sujet: etapeCourante.gabarit_sujet || '',
        corps: etapeCourante.gabarit_corps || '',
        css: vigueur?.courriel_css || '',
        annexe: lienAnnexe(offre, Astro.url.origin),
      },
      formater: (c) => formater(c, offre.langue, offre.devise),
    })
  : null;

const ETAT_STATUT = {
  brouillon: 'etat',
  envoyee: 'etat etat--on',
  acceptee: 'etat etat--on',
  refusee: 'etat etat--manque',
  expiree: 'etat etat--manque',
};
---

<Console
  titre={offre ? `Offre ${offre.reference}` : 'Offre'}
  fil={`TFB Admin · Commercial · ${reference}`}
  actif="offres"
  message={message}
  erreur={erreur}
  compteurs={chiffres}
>
  {offre && (
    <>
      <section class="bloc" style="margin-block-end:20px">
        <div class="bloc__tete">
          <div>
            <h2>
              {offre.prospect?.raison_sociale || 'Client inconnu'}
              <span class={ETAT_STATUT[offre.statut]}>{offre.statut}</span>
            </h2>
            <p>
              <code class="slug">{offre.reference}</code> version {offre.version}
              {offre.auteur?.nom && <> · par {offre.auteur.nom}</>}
              {offre.prospect?.contact_nom && <> · {offre.prospect.contact_nom} — {offre.prospect.contact_email}</>}
              {offre.prospect && (
                <> · <a href={`${BASE}/admin/prospects/${offre.prospect.id}`}>corriger ses coordonnées</a></>
              )}
            </p>
          </div>
          <div class="actions">
            {offre.versions.length > 1 && (
              <span class="champ__aide">
                {offre.versions.map((v) => (
                  <a
                    class="jeton"
                    href={`${BASE}/admin/offres/${offre.reference}?version=${v.version}`}
                    aria-current={v.version === offre.version ? 'page' : undefined}
                  >v{v.version}</a>
                ))}
              </span>
            )}
          </div>
        </div>

        {figee && (
          <div class="bloc__pied">
            Cette offre est <strong>{offre.statut}</strong> : elle ne se modifie plus. Le client
            a reçu ces montants — les réécrire ferait dire deux prix différents au même document.
            Créez une nouvelle version pour renégocier.
          </div>
        )}
      </section>

      <form method="post">
        {!figee && (
          <div class="barre-actions">
            <button class="bouton bouton--marque" type="submit">Enregistrer et recalculer</button>
            <span class="barre-actions__note">Le chiffrage, en bas de page, se met à jour à chaque enregistrement.</span>
          </div>
        )}

        <fieldset class="nu" disabled={figee}>
          <section class="bloc" style="margin-block-end:20px">
            <div class="bloc__tete">
              <div>
                <h2>Les packs</h2>
                <p>
                  Ce qui se vend d'un bloc. Les modules qu'un pack comprend sont dedans : ils
                  ne se refacturent pas à l'unité et ne figurent pas dans les options.
                </p>
              </div>
            </div>

            <div class="pdv">
              <div class="champ pdv__champ">
                <label for="o-postes">Points de vente</label>
                <span class="tarif__saisie pdv__saisie">
                  <input
                    id="o-postes"
                    type="text"
                    name="nombre_postes"
                    value={refus('nombre_postes', pointsDeVente)}
                    inputmode="numeric"
                  />
                  <span class="tarif__unite">×</span>
                </span>
              </div>
              <p class="pdv__effet">
                {packsAuPoste.length === 0 ? (
                  <>Aucun pack retenu ne se facture au point de vente : ce nombre ne change
                  rien au chiffrage pour l'instant.</>
                ) : pointsDeVente === 0 ? (
                  <>
                    <strong>Sans ce nombre, {packsAuPoste.map((p) => p.nom).join(' et ')} ne
                    se facture{packsAuPoste.length > 1 ? 'nt' : ''} pas.</strong>{' '}
                    On ne devine pas « au moins un ».
                  </>
                ) : (
                  <>
                    {packsAuPoste.map((p) => (
                      <span class="pdv__ligne">
                        {p.nom} : {pointsDeVente} × {formater(p.prix_cents)} ={' '}
                        <strong class="fb-num">{formater(pointsDeVente * p.prix_cents)}</strong> par mois
                      </span>
                    ))}
                  </>
                )}
              </p>
            </div>

            {packs.length === 0 ? (
              <div class="bloc__pied">
                Aucun pack au catalogue. Un administrateur en crée depuis l'écran Modules.
              </div>
            ) : (
              <>
                <div class="socles">
                  {packs.map((p) => (
                    <label class="case case--seule">
                      <input type="checkbox" name="pack" value={p.cle} checked={retenus.has(p.cle)} />
                      <span>
                        <span class="case__tete">
                          <strong>{p.nom}</strong>
                          <span class="fb-num case__prix">
                            {formater(p.prix_cents)}{p.unite === 'poste_mois' ? '/mois par point de vente' : '/mois'}
                          </span>
                        </span>
                        <span class="champ__aide">
                          {p.modules.map((m) => m.nom).join(' · ') || 'Aucun module rattaché.'}
                        </span>
                        {p.base && <span class="case__apporte">→ Modèle de base</span>}
                      </span>
                    </label>
                  ))}
                </div>

                {packCaisse && (
                  <fieldset class="caisse">
                    <legend class="legende">
                      La caisse<span class="champ__requis" aria-hidden="true"> *</span>
                      <span class="champ__aide">
                        Comprise dans {packCaisse.nom}. L'une ou l'autre, jamais les deux ni aucune.
                      </span>
                    </legend>
                    <div class="caisse__choix">
                      <label class="case case--seule">
                        <input
                          type="radio"
                          name="socle_pos"
                          value="pos"
                          required
                          checked={offre.socle_pos !== 'api'}
                        />
                        <span>
                          <strong>Caisse POS</strong>
                          <span class="champ__aide">La nôtre, installée dans le point de vente.</span>
                        </span>
                      </label>
                      <label class="case case--seule">
                        <input
                          type="radio"
                          name="socle_pos"
                          value="api"
                          required
                          checked={offre.socle_pos === 'api'}
                        />
                        <span>
                          <strong>Intégration API</strong>
                          <span class="champ__aide">Le réseau garde sa caisse ; on s'y branche.</span>
                        </span>
                      </label>
                    </div>
                  </fieldset>
                )}
              </>
            )}

          </section>

          <section class="bloc" style="margin-block-end:20px">
            <div class="bloc__tete">
              <div>
                <h2>Les options</h2>
                <p>
                  Les modules qui s'ajoutent au modèle de base, facturés au mois. Le texte
                  affiché ici est celui de la fiche du module — il part tel quel sur l'offre.
                </p>
              </div>
            </div>

            {modules.length === 0 ? (
              <div class="bloc__pied">
                Aucune option : tous les modules actifs font partie du modèle de base.
              </div>
            ) : (
              <div class="cases">
                {modules.map((m) => (
                  <label class="case case--module">
                    <input type="checkbox" name="module" value={m.id} checked={modulesRetenus.has(m.slug)} />
                    <span>
                      <span class="case__tete">
                        <strong>{m.nom}</strong>
                        <span class="fb-num case__prix">{formater(m.prix_cents)}/mois</span>
                      </span>
                      {m.pourquoi && <span class="champ__aide">{m.pourquoi}</span>}
                      {m.apporte && <span class="case__apporte">→ {m.apporte}</span>}
                    </span>
                  </label>
                ))}
              </div>
            )}
          </section>

          <section class="bloc" style="margin-block-end:20px">
            <div class="bloc__tete">
              <div>
                <h2>Onboarding</h2>
                <p>Ce qui se facture une seule fois, au démarrage.</p>
              </div>
            </div>

            {catalogue.length === 0 ? (
              <div class="bloc__pied">
                Aucune prestation active au catalogue. Un administrateur en ajoute depuis
                l'écran Prestations.
              </div>
            ) : (
              <div class="cases">
                {catalogue.map((p) => (
                  <label class="case">
                    <input type="checkbox" name="prestation" value={p.id} checked={choisies.has(p.cle)} />
                    <span>
                      <strong>{p.nom}</strong>
                      <span class="fb-num case__prix">{formater(p.prix_cents)}</span>
                      {p.description && <span class="champ__aide">{p.description}</span>}
                    </span>
                  </label>
                ))}
              </div>
            )}

            <div class="duo" style="margin-block-start:14px">
              <div class="champ champ--nombre">
                <label for="o-formation">Jours de formation</label>
                <span class="tarif__saisie">
                  <input
                    id="o-formation"
                    type="text"
                    name="jours_formation"
                    value={refus('jours_formation', offre.jours_formation || 0)}
                    inputmode="numeric"
                  />
                  <span class="tarif__unite">j</span>
                </span>
                <span class="champ__aide">
                  {formater(offre.prix_jour_formation_cents)} la journée, soit
                  {' '}{formater((offre.jours_formation || 0) * offre.prix_jour_formation_cents)} une fois.
                </span>
              </div>
              <input type="hidden" name="postes_franchiseur" value={offre.postes_franchiseur || 0} />
              <div class="champ champ--nombre">
                <label for="o-onboardes">Postes à onboarder</label>
                <span class="tarif__saisie">
                  <input
                    id="o-onboardes"
                    type="text"
                    name="postes_onboardes"
                    value={refus('postes_onboardes', offre.postes_onboardes || 0)}
                    inputmode="numeric"
                  />
                  <span class="tarif__unite">×</span>
                </span>
                <span class="champ__aide">
                  {formater(offre.prix_onboarding_poste_cents)} par poste, une seule fois — soit
                  {' '}{formater((offre.postes_onboardes || 0) * offre.prix_onboarding_poste_cents)}.
                  On n'onboarde pas forcément tout le réseau d'un coup.
                </span>
              </div>
            </div>

            <div class="lignes-libres">
              <div class="vues__tete">
                <span class="oeil">Lignes libres</span>
                <span class="champ__aide">
                  Ce que cette offre comprend en plus du catalogue. Elles ne s'ajoutent pas
                  aux prestations : elles ne valent que pour cette offre.
                </span>
              </div>
              {libres.map((l, i) => (
                <div class={libresFautives.has(i) ? 'vue vue--manque' : 'vue'}>
                  <input
                    type="text"
                    name="libre_nom"
                    value={l.nom || ''}
                    placeholder="Intitulé, tel qu'il apparaîtra sur l'offre"
                    aria-label={`Intitulé, ligne libre ${i + 1}`}
                    aria-invalid={libresFautives.has(i) ? 'true' : undefined}
                  />
                  <span class="tarif__saisie" style="flex:none;inline-size:8rem">
                    <input
                      type="text"
                      name="libre_prix"
                      value={refus(`libre_prix.${i}`, l.reserve ? '' : depuisCents(l.prix_cents || 0))}
                      inputmode="decimal"
                      aria-label={`Prix, ligne libre ${i + 1}`}
                    />
                    <span class="tarif__unite">€</span>
                  </span>
                  {libresFautives.has(i) && (
                    <span class="vue__manque">il manque l'intitulé</span>
                  )}
                </div>
              ))}
              {!figee && (
                <button class="bouton bouton--sobre bouton--sm" type="submit" name="action" value="ajouter_libre">
                  <Icone nom="plus" taille={14} /> Ajouter une ligne
                </button>
              )}
            </div>
          </section>

          <section class="bloc" style="margin-block-end:20px">
            <div class="bloc__tete">
              <div>
                <h2>L'application</h2>
                <p>
                  Les vues servent aux deux formules : louée, chacune se paie au mois ;
                  achetée, leur total donne le coût qu'on multiplie.
                </p>
              </div>
            </div>

            <div class="formules">
              <label class="formule">
                <input type="radio" name="option_app" value="aucune" checked={offre.option_app === 'aucune'} />
                <span>
                  <strong>Pas d'application</strong>
                  <span class="champ__aide">Seulement l'onboarding et la formation.</span>
                </span>
              </label>
              <label class="formule">
                <input type="radio" name="option_app" value="par_vue" checked={offre.option_app === 'par_vue'} />
                <span>
                  <strong>Location à la vue</strong>
                  <span class="champ__aide">
                    {formater(offre.prix_par_vue_cents)} par vue et par mois. Rien à payer à la signature.
                  </span>
                </span>
              </label>
              <label class="formule">
                <input type="radio" name="option_app" value="achat" checked={offre.option_app === 'achat'} />
                <span>
                  <strong>Achat ferme</strong>
                  <span class="champ__aide">
                    {offre.multiplicateur_achat} mois de location payés d'un coup,
                    puis {offre.taux_annuel / 100} % par an de maintenance.
                  </span>
                </span>
              </label>
            </div>

            <div class="vues">
              <div class="vues__tete">
                <span class="oeil">Les vues</span>
                <span class="champ__aide">
                  Une ligne par écran de l'application. La description part telle quelle sur
                  l'offre ; la note interne reste ici et n'est jamais envoyée au client.
                </span>
              </div>
              {vues.map((v, i) => (
                <div class={vuesFautives.has(i) ? 'vue vue--manque' : 'vue'}>
                  <span class="tarif__saisie">
                    <input
                      type="text"
                      name="vue_nombre"
                      value={refus(`vue_nombre.${i}`, v.nombre)}
                      inputmode="numeric"
                      aria-label={`Nombre, ligne ${i + 1}`}
                      aria-invalid={vuesFautives.has(i) ? 'true' : undefined}
                    />
                    <span class="tarif__unite">×</span>
                  </span>
                  <input
                    type="text"
                    name="vue_note"
                    value={v.note || ''}
                    placeholder="Ce que fait cette vue"
                    aria-label={`Description, ligne ${i + 1}`}
                    aria-invalid={vuesFautives.has(i) ? 'true' : undefined}
                  />
                  <input
                    class="vue__interne"
                    type="text"
                    name="vue_interne"
                    value={v.interne || ''}
                    placeholder="Note interne"
                    aria-label={`Note interne, ligne ${i + 1}`}
                  />
                  <span class="fb-num vue__montant">
                    {formater((Number(v.nombre) || 0) * offre.prix_par_vue_cents)}
                    <span class="champ__aide">/mois</span>
                  </span>
                  {vuesFautives.has(i) && (
                    <span class="vue__manque">
                      {String(v.note || '').trim()
                        ? "le nombre est à zéro : cette vue ne s'imprimera nulle part"
                        : "pas de description : cette vue s'imprimera « Vue »"}
                    </span>
                  )}
                </div>
              ))}
              {!figee && (
                <button class="bouton bouton--sobre bouton--sm" type="submit" name="action" value="ajouter_vue">
                  <Icone nom="plus" taille={14} /> Ajouter une vue
                </button>
              )}
              <p class="champ__aide">
                Vider entièrement une ligne la supprime au prochain enregistrement.
              </p>
            </div>
          </section>

          <section class="bloc" style="margin-block-end:20px">
            <div class="bloc__tete">
              <div>
                <h2>Commercial</h2>
                <p>Remise, TVA, validité. La remise en montant fixe ne porte que sur le paiement unique.</p>
              </div>
            </div>

            <div class="duo">
              <div class="champ">
                <label for="o-remise-type">Type de remise</label>
                <select id="o-remise-type" name="remise_type">
                  <option value="pourcent" selected={offre.remise_type === 'pourcent'}>Pourcentage — sur les trois rythmes</option>
                  <option value="fixe" selected={offre.remise_type === 'fixe'}>Montant fixe — sur le paiement unique</option>
                </select>
              </div>
              <div class="champ">
                <label for="o-remise">Remise</label>
                <span class="tarif__saisie">
                  <input
                    id="o-remise"
                    type="text"
                    name="remise_valeur"
                    value={refus('remise_valeur', offre.remise_type === 'fixe' ? depuisCents(offre.remise_valeur) : depuisPoints(offre.remise_valeur))}
                    inputmode="decimal"
                  />
                  <span class="tarif__unite">{offre.remise_type === 'fixe' ? '€' : '%'}</span>
                </span>
              </div>
              <div class="champ">
                <label for="o-tva">Taux de TVA</label>
                <span class="tarif__saisie">
                  <input id="o-tva" type="text" name="tva_taux" value={refus('tva_taux', depuisPoints(offre.tva_taux))} inputmode="decimal" />
                  <span class="tarif__unite">%</span>
                </span>
              </div>
              <div class="champ">
                <span class="legende">Exonération</span>
                <label class="case case--seule">
                  <input type="checkbox" name="tva_exoneree" value="1" checked={offre.tva_exoneree} />
                  <span>
                    <strong>Exonéré — autoliquidation</strong>
                    <span class="champ__aide">La TVA tombe à zéro sur les trois rythmes.</span>
                  </span>
                </label>
              </div>
              <div class="champ" style="grid-column:1/-1">
                <label for="o-mention">Mention d'exonération</label>
                <textarea id="o-mention" name="tva_mention" rows="2" placeholder={vigueur?.mention_autoliquidation}>{offre.tva_mention || ''}</textarea>
                <span class="champ__aide">Vide : celle des tarifs est utilisée.</span>
              </div>
              <div class="champ">
                <label for="o-offerts">Mois offerts</label>
                <span class="tarif__saisie">
                  <input id="o-offerts" type="text" name="mois_offerts" value={refus('mois_offerts', offre.mois_offerts || 0)} inputmode="numeric" />
                  <span class="tarif__unite">m</span>
                </span>
                <span class="champ__aide">
                  Les N premières échéances mensuelles ne sont pas facturées. Ce n'est pas une
                  remise : le prix mensuel ne bouge pas.
                </span>
              </div>
              <div class="champ">
                <label for="o-valide">Valable jusqu'au</label>
                <input id="o-valide" type="date" name="valide_jusqu_au" value={pourChamp(offre.valide_jusqu_au)} />
              </div>
              <div class="champ">
                <label for="o-langue">Langue</label>
                <select id="o-langue" name="langue">
                  {langues.map((l) => (
                    <option value={l.code} selected={offre.langue === l.code}>{l.nom}</option>
                  ))}
                </select>
              </div>
              <div class="champ" style="grid-column:1/-1">
                <label for="o-portee">Périmètre et notes</label>
                <textarea id="o-portee" name="portee" rows="4" placeholder="Ce qui est compris, ce qui ne l'est pas.">{offre.portee || ''}</textarea>
              </div>
              <div class="champ" style="grid-column:1/-1">
                <label for="o-delai">Délai annoncé</label>
                <input id="o-delai" type="text" name="delai" value={offre.delai || ''} placeholder="Mise en service sous six semaines" />
              </div>
            </div>
          </section>
        </fieldset>

        {!figee && (
          <div class="actions">
            <button class="bouton bouton--marque" type="submit">Enregistrer et recalculer</button>
          </div>
        )}
      </form>

      <section class="bloc" style="margin-block-end:20px">
        <div class="bloc__tete">
          <div>
            <h2>Le chiffrage</h2>
            <p>
              Recalculé à chaque enregistrement, côté serveur. Tarifs de cette offre :
              {' '}{formater(offre.prix_par_vue_cents)} par vue et par mois,
              {' '}achat à {offre.multiplicateur_achat} mois,
              {' '}maintenance {offre.taux_annuel / 100} %.
            </p>
          </div>
        </div>

        {incompletes.length > 0 && (
          <div class="recap__alerte">
            <strong>{incompletes.length} ligne(s) à reprendre</strong> — l'offre ne partira pas
            tant qu'elles le sont. Elles sont encadrées dans le formulaire ci-dessus.
            <ul class="manques">
              {incompletes.map((m) => <li>{direManque(m)}</li>)}
            </ul>
          </div>
        )}

        <RecapOffre
          resultat={resultat}
          langue={offre.langue}
          devise={offre.devise}
          mention={offre.tva_mention || vigueur?.mention_autoliquidation}
        />
      </section>

      <section class="bloc" style="margin-block-end:20px">
        <div class="bloc__tete">
          <div>
            <h2>Le courriel</h2>
            <p>
              Tel qu'il partirait, gabarit des tarifs appliqué. Les jetons entre accolades
              sont déjà remplacés — ce que vous lisez est ce que le client lirait.
            </p>
          </div>
        </div>

        {courriel.destinataire ? (
          <>
            <div class="apercu">
              <div class="apercu__entete">
                <span><b>À</b> {courriel.destinataire}</span>
                <span><b>Sujet</b> {courriel.sujet}</span>
              </div>
              {/* La lettre rendue dans un cadre isolé : sans lui, la feuille
                  de style du courriel déborderait sur la console, et celle de
                  la console mentirait sur ce que le client verra. */}
              <iframe
                class="apercu__rendu"
                title="La lettre telle qu'elle arrivera"
                sandbox=""
                srcdoc={courriel.corps_html}
              ></iframe>
            </div>

            <details class="apercu__brut">
              <summary>La version texte, pour les messageries qui refusent le HTML</summary>
              <pre class="apercu__corps">{courriel.corps}</pre>
            </details>

            <div class={service.expedie ? 'bloc__pied' : 'recap__alerte'} style="margin-block-start:12px">
              {service.expedie ? (
                <>Envoyé par : {service.nom}.</>
              ) : (
                <>
                  <strong>Aucun service de courriel n'est configuré sur ce serveur.</strong>{' '}
                  « Envoyer » écrira ce message dans le journal et marquera l'offre comme envoyée,
                  mais <strong>rien ne partira</strong>. Copiez le texte ci-dessus et envoyez-le
                  depuis votre messagerie — puis marquez l'offre envoyée.
                </>
              )}
            </div>

            {empechements.length > 0 && (
              <div class="recap__alerte" style="margin-block-start:12px">
                <strong>L'offre ne peut pas partir :</strong>
                <ul style="margin:6px 0 0; padding-inline-start:20px">
                  {empechements.map((e) => <li>{e}</li>)}
                </ul>
              </div>
            )}

            <div class="actions">
              <form method="post" onsubmit={service.expedie ? undefined : "return confirm('Aucun courriel ne partira réellement. Marquer quand même l’offre comme envoyée ?')"}>
                <input type="hidden" name="action" value="envoyer" />
                <button class="bouton bouton--marque" type="submit" disabled={empechements.length > 0}>
                  <Icone nom="mail" taille={16} />
                  {service.expedie ? "Envoyer l'offre" : "Journaliser et marquer envoyée"}
                </button>
              </form>
            </div>
          </>
        ) : (
          <div class="recap__alerte">
            Ce client n'a pas d'adresse de courriel — l'offre ne peut pas lui être envoyée.
            {' '}<a href={`${BASE}/admin/prospects/${offre.prospect?.id}`}>Corriger ses coordonnées</a>.
          </div>
        )}
      </section>

      <section class="bloc" style="margin-block-end:20px">
        <div class="bloc__tete">
          <div>
            <h2>Le suivi</h2>
            <p>
              Où en est la négociation, et ce qui s'est passé. Le journal ne se réécrit
              pas : c'est ce qui permet de répondre à « qui a dit quoi, et quand »
              trois mois plus tard.
            </p>
          </div>
        </div>

        <div class="duo">
          <div class="champ">
            <label for="o-etape">Étape</label>
            <form method="post" class="ligne-serree">
              <input type="hidden" name="action" value="etape" />
              <select id="o-etape" name="etape">
                <option value="">— hors pipeline —</option>
                {etapes.map((e) => (
                  <option value={e.cle} selected={e.cle === offre.etape}>{e.nom}</option>
                ))}
              </select>
              <button class="bouton bouton--sobre bouton--sm" type="submit">Déplacer</button>
            </form>
            {etapeCourante?.description && (
              <span class="champ__aide">{etapeCourante.description}</span>
            )}
            <span class="champ__aide">
              L'étape commande l'état de l'offre
              {etapeCourante?.statut && etapeCourante.statut !== 'brouillon'
                ? " : celle-ci la fige, et elle ne se modifie plus."
                : " : celle-ci la laisse modifiable, sauf si elle est déjà partie."}
            </span>
          </div>
          <div class="champ">
            <span class="legende">Relance</span>
            <p class="champ__aide" style="margin:0">
              {(() => {
                const r = aRelancer(offre, etapeCourante);
                const suivante = prochaineRelance(offre, etapeCourante);
                if (suivante) return `Sans mouvement, le commercial sera prévenu le ${jourCourt(suivante)} — ${r.dort} j écoulés.`;
                if (r.relancer) return `Relance due : ${r.raison}.`;
                return `Aucune relance prévue — ${r.raison}.`;
              })()}
            </p>
          </div>
        </div>

        {/* Le contrat n'apparaît qu'une fois l'offre acceptée : le proposer
            plus tôt inviterait à écrire un contrat pour une offre que le
            client n'a pas encore dite bonne. */}
        {offre.statut === 'acceptee' && (
          <div class="champ" style="margin-block-start:14px">
            <span class="legende">Le contrat</span>
            {contrat ? (
              <p class="champ__aide" style="margin:0">
                <a href={`${BASE}/admin/contrats/${contrat.reference}`}><strong>{contrat.reference}</strong></a>
                {' '}— {contrat.statut}, édité le {jourCourt(contrat.genere_le)}.
              </p>
            ) : (
              <>
                <p class="champ__aide" style="margin:0">
                  Aucun contrat pour cette offre. Il se rédige depuis le gabarit et le dossier
                  du client — s'il en manque une pièce, l'écran le dira nommément.
                </p>
                <form method="post" class="actions actions--case">
                  <input type="hidden" name="action" value="contrat" />
                  <button class="bouton bouton--marque bouton--sm" type="submit">
                    <Icone nom="handshake" taille={16} /> Éditer le contrat
                  </button>
                </form>
              </>
            )}
          </div>
        )}

        {etapeCourante?.gabarit_actif && (
          <div class="champ" style="margin-block-start:14px">
            <span class="legende">Le courriel proposé à cette étape</span>
            <div class="apercu">
              <div class="apercu__entete">
                <span><b>Sujet</b> {courrielEtape.sujet}</span>
              </div>
              <pre class="apercu__corps">{courrielEtape.corps}</pre>
            </div>
            <span class="champ__aide">
              À copier dans votre messagerie. Il se règle sur
              {' '}<a href={`${BASE}/admin/etapes`}>l'écran Étapes</a>.
            </span>
          </div>
        )}

        <form method="post">
          <input type="hidden" name="action" value="note" />
          <div class="champ" style="margin-block-start:14px">
            <label for="o-note">Ajouter au journal</label>
            <textarea id="o-note" name="texte" rows="2" placeholder="Ce qui s'est dit, ce qui bloque, ce qu'on attend."></textarea>
          </div>
          <div class="actions">
            <button class="bouton bouton--sobre bouton--sm" type="submit">Noter</button>
          </div>
        </form>

        {suivi.length === 0 ? (
          <div class="bloc__pied">Rien au journal pour l'instant.</div>
        ) : (
          <div class="roule">
            <table>
              <tbody>
                {suivi.map((l) => (
                  <tr>
                    <td style="inline-size:9rem" class="champ__aide fb-num">{jourHeure(l.quand)}</td>
                    <td style="inline-size:6rem"><span class="etat">{l.type}</span></td>
                    <td>{l.texte}</td>
                    <td style="inline-size:9rem" class="champ__aide">{l.auteur_nom || l.auteur_identifiant || '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>

      <section class="bloc">
        <div class="bloc__tete">
          <div>
            <h2>Le dossier</h2>
            <p>Où en est cette offre, et quoi en faire.</p>
          </div>
        </div>
        <div class="actions">
          <a
            class="bouton bouton--sobre bouton--sm"
            href={`${BASE}/admin/offres/${offre.reference}/annexe?version=${offre.version}`}
            target="_blank"
            rel="noopener"
          >
            <Icone nom="file-text" taille={14} /> Annexe imprimable
          </a>
          <form method="post">
            <input type="hidden" name="action" value="version" />
            <button class="bouton bouton--sobre bouton--sm" type="submit">
              <Icone nom="plus" taille={14} /> Nouvelle version
            </button>
          </form>
          {!figee && (
            <form method="post" onsubmit="return confirm('Supprimer ce brouillon ?')">
              <input type="hidden" name="action" value="suppression" />
              <button class="bouton bouton--sobre bouton--sm" type="submit">Supprimer le brouillon</button>
            </form>
          )}
        </div>
        <div class="bloc__pied">
          Une offre se déplace depuis <a href={`${BASE}/admin/offres`}>la liste</a> ou depuis
          le bloc « Le suivi » ci-dessus : c'est l'étape qui commande, l'état n'en est que
          la conséquence.
          Une nouvelle version repart des <strong>tarifs d'aujourd'hui</strong> : rouvrir une
          offre de l'an dernier pour la renégocier au prix de l'an dernier n'aurait pas de sens.
        </div>
      </section>
    </>
  )}
</Console>

<style is:global>
  /* Un `fieldset` sert uniquement à désactiver tout le formulaire d'un coup
     quand l'offre est figée ; il ne doit rien dessiner. */
  .nu { border: 0; margin: 0; padding: 0; min-inline-size: 0; }
  .nu:disabled { opacity: 0.75; }


  /* Les packs, en cartes de même hauteur. Elles le sont parce qu'elles sont
     seules dans la grille : le choix de la caisse vivait dans la colonne du
     pack franchisé, qui devenait deux fois plus haute que ses voisines. Il a
     désormais son propre bloc, sous la grille, où il se lit mieux. */
  .socles { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr)); }
  /* Le choix de la caisse, sous la grille des packs : dans la colonne de son
     pack, il la rendait deux fois plus haute que ses voisines. */
  .caisse { margin: 12px 0 0; padding: 0; border: 0; min-inline-size: 0; }
  .caisse > .legende { padding: 0 0 8px; }
  .caisse > .legende .champ__aide { display: block; margin-block-start: 2px; font-weight: 400; }
  .caisse__choix { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr)); }

  /* Le nombre de points de vente multiplie la plus grosse ligne de l'offre :
     ce n'est pas un champ parmi d'autres, et il ne se lit pas en bas de bloc.
     Il ouvre la section, et dit ce qu'il produit. */
  .pdv {
    display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
    margin-block-end: 16px; padding: 14px 16px;
    border: 1px solid var(--plum-200); border-radius: var(--radius-card);
    background: var(--plum-50);
  }
  .pdv__champ { gap: 3px; }
  .pdv__champ > label { font: 600 var(--text-sm) / 1.2 var(--font-sans); color: var(--plum-700, #532d5b); }
  .pdv__saisie { inline-size: 8rem; }
  .pdv__saisie input {
    font: 700 var(--text-lg, 20px) / 1.2 var(--font-display, var(--font-sans));
    text-align: end;
  }
  .pdv__effet {
    margin: 0; flex: 1; min-inline-size: 14rem;
    display: flex; flex-direction: column; gap: 2px;
    font: 400 var(--text-sm) / 1.5 var(--font-sans); color: var(--slate-600);
  }
  .pdv__effet strong { color: var(--navy-900); }
  .pdv__ligne { display: block; }
  /* Les réglages ne servent que si le pack est pris. Grisés sinon, ils disent
     d'un coup d'œil que la case au-dessus commande. La règle vise la case du
     pack lui-même : nommée autrement, elle grisait tout, y compris le choix
     de caisse d'un pack bel et bien retenu. */
  /* Dans une carte de pack, le prix suit le nom au lieu d'être poussé au
     bout : renvoyé à la ligne, il se retrouvait seul et aligné à droite,
     détaché de ce qu'il chiffre. */
  .socles .case__tete .case__prix { margin-inline-start: 0; white-space: normal; }

  .formules { display: grid; gap: 8px; grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr)); }

  .vues { margin-block-start: 16px; display: flex; flex-direction: column; gap: 8px; }
  .vues__tete { display: flex; flex-direction: column; gap: 2px; }
  .vue { display: flex; align-items: center; gap: 8px; }
  .vue .tarif__saisie { flex: none; inline-size: 6rem; }
  .vue input[name='vue_note'] { flex: 2; min-inline-size: 0; }
  .vue__interne { flex: 1; min-inline-size: 0; background: var(--slate-50); }
  .vue input[name='libre_nom'] { flex: 1; min-inline-size: 0; }
  .lignes-libres { margin-block-start: 16px; display: flex; flex-direction: column; gap: 8px; }
  .vue__montant {
    flex: none; inline-size: 9rem; text-align: end;
    font-size: var(--text-sm); color: var(--slate-600);
  }

  /* Une ligne à moitié remplie. Le liseré la désigne au premier coup d'œil ;
     la phrase dit ce qui manque, parce qu'un cadre rouge tout seul laisse
     deviner. La couleur n'est jamais le seul signal : `aria-invalid` porte la
     même information pour qui ne la voit pas. */
  .vue--manque { flex-wrap: wrap; }
  .vue--manque input[aria-invalid='true'] { border-color: var(--red-500); background: var(--red-100); }
  .vue__manque {
    flex-basis: 100%;
    font: 500 var(--text-xs) / 1.4 var(--font-sans); color: var(--red-700);
  }
  .manques { margin: 6px 0 0; padding-inline-start: 18px; display: grid; gap: 2px; }

  /* Le fond du cadre est celui d'une messagerie, pas celui d'une page : la
     lettre y flotte comme elle flottera dans la boîte du client, au lieu de
     se détacher sur un blanc qui n'existera nulle part. */
  .apercu {
    border: 1px solid var(--slate-200); border-radius: var(--radius-card);
    overflow: hidden; background: var(--slate-50);
  }
  /* Le rendu fait la largeur d'une lettre, pas celle du bloc : au-delà, la
     carte de 600 px se centrait au milieu d'un désert gris. Sa hauteur est
     fixe parce qu'une iframe isolée ne peut pas dire la sienne — mieux vaut
     un cadre qui défile qu'un script pour l'ajuster. */
  .apercu__rendu {
    display: block; margin-inline: auto;
    inline-size: 100%; max-inline-size: 41rem; block-size: 32rem;
    border: 0; background: #fff;
  }
  .apercu__brut { margin-block-start: 10px; }
  .apercu__brut > summary {
    cursor: pointer; font: var(--type-label); color: var(--slate-600);
    padding-block: 4px;
  }
  .apercu__brut .apercu__corps {
    margin-block-start: 6px;
    border: 1px solid var(--slate-200); border-radius: var(--radius-card);
  }
  .apercu__entete {
    display: flex; flex-direction: column; gap: 4px;
    padding: 12px 14px; background: var(--slate-50);
    border-block-end: 1px solid var(--slate-200);
    font: 400 var(--text-sm) / 1.4 var(--font-sans); color: var(--slate-600);
  }
  .apercu__entete b { color: var(--navy-900); margin-inline-end: 6px; }
  /* Le corps est du texte brut : on le montre tel qu'il partira, sans
     reformatage, sinon l'aperçu ment sur ce que le client recevra. */
  .apercu__corps {
    margin: 0; padding: 14px;
    font: 400 13px/1.6 var(--font-mono, monospace);
    white-space: pre-wrap; overflow-wrap: anywhere;
    color: var(--navy-900); background: #fff;
  }

  @media (max-width: 640px) {
    /* Au téléphone, les trois colonnes d'une vue ne tiennent pas : le montant
       passe sous la description plutôt que d'écraser les deux champs. */
    .vue { flex-wrap: wrap; }
    .vue__montant { inline-size: auto; margin-inline-start: auto; }
  }
</style>
