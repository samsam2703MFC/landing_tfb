---
/**
 * L'assistant d'import — lit la base et propose une ressource.
 *
 * Il ne crée aucune route et n'émet aucun DDL. Il produit deux textes : la
 * déclaration à coller dans `catalogue.mjs`, et l'instruction `CREATE VIEW` à
 * exécuter par quelqu'un. Un back-office capable de modifier la forme d'une
 * base est un back-office capable de le faire par accident.
 *
 * Les défauts sont ceux d'un écran qui connaît ses propres pièges : rien de
 * sensible n'est coché, aucun filtre exact n'est proposé sur une colonne non
 * indexée, et la colonne du client est présélectionnée mais reste obligatoire.
 */
import Console from '../../../components/Console.astro';
import Icone from '../../../components/Icone.astro';
import { lien } from '../../../lib/lien.mjs';
import { compteurs } from '../../../lib/admin/donnees.mjs';
import { COLONNE_CLIENT, OPERATEURS, OPERATEURS_DITS } from '../../../lib/donnees/catalogue.mjs';
import {
  decrireSource,
  instructionVue,
  introspectionDisponible,
  listerSources,
  nomVuePour,
} from '../../../lib/donnees/introspection.mjs';
import { ajouterProposition, codeProposition } from '../../../lib/donnees/propositions.mjs';

let souci = null;
let message = null;
let resultat = null;

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const session = Astro.locals.session || {};
  const colonnes = f.getAll('colonne').map(String);

  const filtres = {};
  for (const c of colonnes) {
    const ops = f.getAll(`filtre_${c}`).map(String).filter((o) => OPERATEURS.includes(o));
    if (ops.length > 0) filtres[c] = ops;
  }

  const proposition = {
    cle: String(f.get('cle') || '').trim(),
    source: String(f.get('source') || ''),
    sourceGenre: String(f.get('genre') || 'table'),
    vue: String(f.get('vue') || '').trim(),
    colonnes,
    filtres,
    triables: f.getAll('triable').map(String).filter((c) => colonnes.includes(c)),
    maxLignes: Number(f.get('max_lignes') || 500),
    colonneClient: String(f.get('colonne_client') || '').trim(),
  };

  const r = await ajouterProposition(proposition, session.nom || session.identifiant || null);
  if (!r.ok) {
    souci = r.erreur;
  } else {
    message = 'Proposition enregistrée. Elle ne sert rien tant que personne ne la colle au catalogue.';
    resultat = {
      code: codeProposition(proposition),
      vue: proposition.sourceGenre === 'table'
        ? instructionVue(proposition.source, proposition.vue, proposition.colonnes, proposition.colonneClient)
        : null,
    };
  }
}

const dispo = introspectionDisponible();
const choisie = Astro.url.searchParams.get('source');

const [chiffres, sources] = await Promise.all([
  compteurs(),
  dispo ? listerSources().catch((e) => { souci = souci || e.message; return []; }) : Promise.resolve([]),
]);

const source = choisie ? sources.find((s) => s.nom === choisie) || null : null;
const colonnes = source ? await decrireSource(source.nom).catch(() => null) : null;
const vueProposee = source ? (source.genre === 'vue' ? source.nom : nomVuePour(source.nom)) : '';
const clientDefaut = colonnes?.find((c) => c.clientProbable)?.nom || COLONNE_CLIENT;

/** Cochée par défaut : ni sensible, ni la colonne qui porte le client. */
const retenue = (c) => !c.sensible && !c.clientProbable;
---

<Console titre="Assistant d'import" actif="catalogue" compteurs={chiffres} message={message} erreur={souci}>
  {!dispo && (
    <p class="cellule avert">
      <Icone nom="triangle-alert" taille={16} />
      L'introspection est écrite pour MySQL. La base est configurée en PostgreSQL — l'assistant
      préfère le dire plutôt que produire des propositions fausses.
    </p>
  )}

  {resultat && (
    <div class="cellule sortie">
      <h3>À coller dans <span class="mono">src/lib/donnees/catalogue.mjs</span></h3>
      <pre class="code">{resultat.code}</pre>
      {resultat.vue && (
        <>
          <h3>À exécuter sur la base — cette application n'émet aucun DDL</h3>
          <pre class="code">{resultat.vue}</pre>
          <p class="aide">
            La colonne du client figure dans la vue même si elle n'est pas exposée : sans elle, la
            vue ne pourrait plus être filtrée par client, et la ressource rendrait les lignes de
            tout le monde.
          </p>
        </>
      )}
      <a class="bouton bouton--sobre" href={lien('/admin/catalogue')}>Retour au catalogue</a>
    </div>
  )}

  {dispo && !source && (
    <>
      <p class="intro">
        Choisissez la source à exposer. Une <strong>vue</strong> peut être exposée telle quelle ;
        une <strong>table</strong> passera d'abord par un <span class="mono">CREATE VIEW</span> —
        exposer une table fait de ses noms de colonnes votre contrat public, que vous ne pourrez
        plus renommer sans casser l'application installée chez chaque client.
      </p>
      <div class="cellule">
        <table>
          <thead>
            <tr><th>Source</th><th>Type</th><th>Lignes (estimation)</th><th>Colonnes</th><th></th></tr>
          </thead>
          <tbody>
            {sources.map((s) => (
              <tr>
                <td class="mono">{s.nom}</td>
                <td>{s.genre === 'vue' ? <span class="jeton jeton--vue">vue</span> : <span class="jeton">table</span>}</td>
                <td class="chiffre">{s.lignes.toLocaleString('fr-FR')}</td>
                <td class="chiffre">{s.colonnes}</td>
                <td class="fin">
                  <a class="bouton bouton--sobre bouton--sm" href={lien(`/admin/catalogue/import?source=${encodeURIComponent(s.nom)}`)}>
                    Choisir
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  {source && colonnes && (
    <form method="post">
      <input type="hidden" name="source" value={source.nom} />
      <input type="hidden" name="genre" value={source.genre} />

      <div class="cellule bloc">
        <h3>La ressource</h3>
        <div class="grille">
          <label class="champ">
            <span>Clé du catalogue</span>
            <input type="text" name="cle" placeholder="ventes.par_jour" pattern="[a-z][a-z0-9_]*\.[a-z][a-z0-9_]*" required />
            <em>Format « groupe.ressource », en minuscules — elle part dans un chemin d'URL.</em>
          </label>
          <label class="champ">
            <span>Vue exposée</span>
            <input type="text" name="vue" value={vueProposee} required />
            <em>{source.genre === 'table' ? 'La table sera exposée à travers cette vue.' : 'Cette vue est déjà exposable.'}</em>
          </label>
          <label class="champ">
            <span>Plafond de lignes</span>
            <input type="number" name="max_lignes" value="500" min="1" max="1000" required />
            <em>Entre 1 et 1000. Jamais illimité.</em>
          </label>
          <label class="champ">
            <span>Colonne portant le client</span>
            <select name="colonne_client" required>
              {colonnes.map((c) => (
                <option value={c.nom} selected={c.nom === clientDefaut}>{c.nom}</option>
              ))}
            </select>
            <em>Injectée côté serveur. Elle filtre, elle ne sort pas — ne la cochez pas ci-dessous.</em>
          </label>
        </div>
      </div>

      <div class="cellule bloc">
        <h3>Les colonnes exposées</h3>
        <p class="aide">
          Rien n'est coché par défaut quand le nom évoque une marge, une donnée personnelle ou un
          secret : ce doit être un geste, pas un oubli. Les filtres exacts ne sont proposés que sur
          les colonnes indexées — un filtre sur une colonne sans index, c'est un balayage complet
          de table à chaque appel de chaque client.
        </p>

        {colonnes.map((c) => (
          <div class:list={['colonne', c.sensible && 'colonne--sensible']}>
            <label class="colonne__nom">
              <input type="checkbox" name="colonne" value={c.nom} checked={retenue(c)} />
              <span class="mono">{c.nom}</span>
              <span class="type">{c.typeComplet}{c.nullable ? ' · nullable' : ''}</span>
              {c.indexee && <span class="jeton jeton--index">indexée</span>}
              {c.clientProbable && <span class="jeton jeton--client">ressemble au client</span>}
              {c.sensible && <span class="jeton jeton--sensible"><Icone nom="triangle-alert" taille={11} /> {c.sensible}</span>}
            </label>

            {/* Une colonne non retenue ne porte pas de filtre coché : le
                traitement les écarte de toute façon, mais des cases cochées sur
                une ligne décochée font douter de ce que l'écran a compris. */}
            <div class="colonne__options">
              {OPERATEURS.map((op) => (
                <label class:list={['op', !c.filtresSuggeres.includes(op) && 'op--pale']}>
                  <input type="checkbox" name={`filtre_${c.nom}`} value={op}
                         checked={retenue(c) && c.filtresSuggeres.includes(op)} />
                  {OPERATEURS_DITS[op]}
                </label>
              ))}
              <label class="op">
                <input type="checkbox" name="triable" value={c.nom}
                       checked={retenue(c) && c.indexee && c.filtresSuggeres.length > 0} />
                triable
              </label>
            </div>
          </div>
        ))}

        {source.genre === 'vue' && (
          <p class="aide">
            Pour une vue, MySQL ne tient aucune statistique d'index : la mention « indexée » est un
            indice fondé sur le nom de la colonne, pas une garantie.
          </p>
        )}
      </div>

      <div class="pied">
        <a class="bouton bouton--sobre" href={lien('/admin/catalogue/import')}>Changer de source</a>
        <button class="bouton bouton--marque" type="submit">
          <Icone nom="save" taille={15} />
          Proposer — sans rien servir
        </button>
      </div>
    </form>
  )}

  {source && !colonnes && (
    <p class="cellule avert">
      <Icone nom="circle-alert" taille={16} />
      <span><span class="mono">{source.nom}</span> n'a pas de colonnes lisibles dans ce schéma.</span>
    </p>
  )}
</Console>

<style>
  .intro, .aide { max-inline-size: 78ch; color: var(--slate-600); }
  .aide { font-size: var(--text-sm); }
  .avert { display: flex; gap: 10px; align-items: flex-start; padding: 12px 16px; }
  .bloc { padding: 16px; margin-block-end: var(--space-4); }
  .bloc h3 { margin: 0 0 8px; }
  .grille { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: var(--space-4); }
  .champ { display: flex; flex-direction: column; gap: 4px; }
  .champ > span { font: 500 var(--text-sm) / 1.3 var(--font-sans); }
  .champ input, .champ select { inline-size: 100%; }
  .champ em { font-style: normal; font-size: var(--text-xs); color: var(--slate-500); }
  .colonne { display: flex; align-items: center; gap: var(--space-4); flex-wrap: wrap;
             padding: 9px 4px; border-block-start: 1px solid var(--slate-200); }
  .colonne--sensible { background: color-mix(in srgb, var(--amber-100, #fceed6) 55%, transparent); }
  .colonne__nom { display: flex; align-items: center; gap: 9px; flex: 1 1 340px; font-size: var(--text-sm); }
  .colonne__options { display: flex; gap: 12px; flex-wrap: wrap; margin-inline-start: auto; }
  .op { display: inline-flex; align-items: center; gap: 5px; font-size: var(--text-xs); color: var(--slate-600); }
  .op--pale { opacity: .55; }
  .type { color: var(--slate-500); font-size: var(--text-xs); font-family: var(--font-mono); }
  .jeton { font: 600 11px / 1.5 var(--font-sans); padding: 1px 8px; border-radius: 999px;
           background: var(--slate-100); color: var(--slate-600); }
  .jeton--vue { background: var(--green-100, #dbf1e6); color: var(--green-700, #0e5c41); }
  .jeton--index { background: var(--teal-100, #d7efe9); color: var(--teal-700, #0d6861); }
  .jeton--client { background: color-mix(in srgb, var(--plum-500, #7b4488) 14%, transparent); color: var(--plum-600, #6a3a76); }
  .jeton--sensible { display: inline-flex; align-items: center; gap: 4px;
                     background: var(--amber-100, #fceed6); color: var(--amber-700, #8a5900); }
  .pied { display: flex; gap: var(--space-3); align-items: center; }
  table { inline-size: 100%; border-collapse: collapse; }
  th { text-align: start; font: 600 var(--text-xs) / 1.4 var(--font-sans); text-transform: uppercase;
       letter-spacing: .09em; color: var(--slate-500); padding: 10px 14px; }
  td { padding: 9px 14px; border-block-start: 1px solid var(--slate-200); font-size: var(--text-sm); }
  .chiffre { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  .fin { text-align: end; }
  .sortie { padding: 16px; margin-block-end: var(--space-4); }
  .sortie h3 { margin: var(--space-3) 0 6px; }
  .code { background: var(--navy-900); color: #e7eaf3; border-radius: var(--radius-control);
          padding: 12px 14px; overflow-x: auto; font: 12px / 1.6 var(--font-mono); }
  .mono { font-family: var(--font-mono); }
</style>
