---
/**
 * La table des modules. C'est ici qu'on règle l'ordre d'affichage et qu'on
 * masque un module sans le supprimer — un module supprimé de la base
 * reviendrait à la prochaine ingestion, alors qu'un module masqué reste
 * masqué.
 */
import Console from '../../../components/Console.astro';
import Icone from '../../../components/Icone.astro';
import Pastille from '../../../components/Pastille.astro';
import { lien } from '../../../lib/lien.mjs';
import { leviersDe } from '../../../lib/leviers.mjs';
import {
  basculerFonction,
  basculerModule,
  chargerModuleAdmin,
  compteurs,
  enregistrerLigneModule,
  famillesConnues,
  listerModules,
  tarifsEnVigueur,
  validerFonction,
  validerModule,
} from '../../../lib/admin/donnees.mjs';
import { LEVIERS, titreLevier } from '../../../lib/leviers.mjs';
import { depuisCents } from '../../../lib/offres/montants.mjs';
import { formater } from '../../../lib/offres/calcul.mjs';

/** Les icônes proposées, prises dans le jeu embarqué. */
const ICONES = [
  'shopping-cart', 'layout-dashboard', 'store', 'building-2', 'chef-hat', 'clipboard-check',
  'truck', 'monitor', 'handshake', 'credit-card', 'megaphone', 'utensils', 'graduation-cap',
  'receipt', 'wallet', 'percent', 'layers', 'bar-chart', 'package', 'map-pin', 'users',
  'book-open', 'qr-code', 'smartphone', 'bot', 'chart-line',
];

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
let erreur = null;

if (Astro.request.method === 'POST') {
  try {
    const f = await Astro.request.formData();
    const slug = String(f.get('slug') || '');

    const action = String(f.get('action') || '');

    // La relecture : le module et ses composants encore « nouveaux » passent
    // d'un coup en ligne.
    if (action === 'valider-module') {
      await validerModule(slug);
      return Astro.redirect(`${BASE}/admin/modules?ok=${encodeURIComponent(`${slug} validé et publié.`)}`, 303);
    }
    if (action === 'valider-fonction') {
      await validerFonction(f.get('id'));
      return Astro.redirect(`${BASE}/admin/modules?ok=${encodeURIComponent('Composant validé et mis en ligne.')}`, 303);
    }
    if (action === 'bascule-fonction') {
      await basculerFonction(f.get('id'), f.get('en_ligne') === '1');
      return Astro.redirect(`${BASE}/admin/modules?ok=${encodeURIComponent('Composant mis à jour.')}`, 303);
    }

    // Deux actions sur la même table : basculer la publication, ou
    // enregistrer la ligne modifiée sur place.
    if (action === 'publication') {
      const actif = f.get('actif') === '1';
      await basculerModule(slug, actif);
      return Astro.redirect(
        `${BASE}/admin/modules?ok=${encodeURIComponent(`${slug} ${actif ? 'publié' : 'masqué'}.`)}`,
        303,
      );
    }

    await enregistrerLigneModule(slug, {
      groupe: f.get('groupe'),
      icone: f.get('icone'),
      ordre: f.get('ordre'),
      prix: f.get('prix'),
      socle: f.get('socle'),
      leviers: f.getAll('leviers').map(String),
    });
    return Astro.redirect(`${BASE}/admin/modules?ok=${encodeURIComponent(`${slug} enregistré.`)}`, 303);
  } catch (err) {
    erreur = err.message;
  }
}

const message = Astro.url.searchParams.get('ok');

let modules = [];
let chiffres = {};
let familles = [];
let prixParDefaut = 0;
try {
  modules = await listerModules();
  prixParDefaut = (await tarifsEnVigueur()).prix_module_cents;
  chiffres = await compteurs();
  familles = await famillesConnues();
  // Les composants de chaque module, pour la ligne dépliable.
  for (const m of modules) {
    const complet = await chargerModuleAdmin(m.slug).catch(() => null);
    m.composants = complet?.fonctions || [];
  }
} catch (err) {
  erreur = erreur || `Base injoignable : ${err.message}`;
}

const total = modules.reduce((n, m) => n + m.nb_fonctions, 0);
---

<Console
  titre="Modules"
  fil="TFB Admin · Contenu · Modules"
  actif="modules"
  message={message}
  erreur={erreur}
  compteurs={chiffres}
>
  <section class="bloc">
    <div class="bloc__tete">
      <div>
        <h2>Modules</h2>
        <p>
          <span class="jeton">landing_modules</span> — régénérés depuis les dépôts GitHub par le pipeline.
          L'ordre gouverne l'affichage sur l'accueil et dans le fil d'onboarding.
        </p>
      </div>
    </div>

    <div class="roule">
      <table>
        <thead>
          <tr>
            <th colspan="8" style="padding:0">
              <span class="ligne-module ligne-module--entete">
                <span>Module</span>
                <span>Icône</span>
                <span>Famille</span>
                <span>Leviers</span>
                <span>Ordre</span>
                <span>Socle</span>
                <span>Prix / mois</span>
                <span>Comp.</span>
                <span>Capt.</span>
                <span>Statut</span>
                <span></span>
              </span>
            </th>
          </tr>
        </thead>
        <tbody>
          {modules.map((m) => (
            <tr>
              <td colspan="8" style="padding:0">
                <form method="post" class="ligne-module">
                  <input type="hidden" name="slug" value={m.slug} />

                  <div class="ligne-module__nom">
                    <span style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                      <a href={lien(`/admin/modules/${m.slug}`)}><strong>{m.nom || m.slug}</strong></a>
                      {m.nouveau && <span class="neuf">nouveau</span>}
                    </span>
                    <code class="slug">{m.slug}</code>
                  </div>

                  <label class="ligne-module__icone" title="Icône du module">
                    <span class="apercu"><Icone nom={m.icone || 'layers'} taille={16} /></span>
                    <select name="icone">
                      {ICONES.map((i) => <option value={i} selected={i === m.icone}>{i}</option>)}
                    </select>
                  </label>

                  <select name="groupe" title="Famille" aria-label="Famille">
                    {familles.map((g) => <option value={g} selected={g === m.groupe}>{g}</option>)}
                  </select>

                  <span class="choix-leviers">
                    {LEVIERS.map((l) => (
                      <label class="choix-levier" title={titreLevier(l)} style={`--fond:${l.fond};--encre:${l.encre}`}>
                        <input type="checkbox" name="leviers" value={l.cle} checked={(m.leviers || []).includes(l.cle)} />
                        <span>{l.lettre}</span>
                      </label>
                    ))}
                  </span>

                  <input class="ligne-module__ordre num" type="number" name="ordre" min="1" value={m.ordre ?? 100} title="Ordre" aria-label="Ordre" />

                  <select
                    class="ligne-module__socle"
                    name="socle"
                    title="Un module de socle vient avec le modèle de base : son prix est compris dedans."
                    aria-label={`Socle de ${m.nom || m.slug}`}
                  >
                    <option value="" selected={!m.socle}>option</option>
                    <option value="franchise" selected={m.socle === 'franchise'}>franchisé</option>
                    <option value="franchiseur" selected={m.socle === 'franchiseur'}>franchiseur</option>
                  </select>

                  <span class="tarif__saisie ligne-module__prix">
                    <input
                      type="text"
                      name="prix"
                      value={m.prix_cents ? depuisCents(m.prix_cents) : ''}
                      inputmode="decimal"
                      placeholder={depuisCents(prixParDefaut)}
                      title={`Prix mensuel. Vide : le tarif général, ${formater(prixParDefaut)}.`}
                      aria-label={`Prix mensuel de ${m.nom || m.slug}`}
                    />
                    <span class="tarif__unite">€</span>
                  </span>

                  <span class="num ligne-module__compte">{m.nb_fonctions}</span>
                  <span class="num ligne-module__compte" style={m.nb_captures === 0 ? 'color:var(--amber-700)' : undefined}>
                    {m.nb_captures}
                  </span>

                  <span class={m.actif ? 'etat etat--on' : 'etat'}>{m.actif ? 'publié' : 'masqué'}</span>

                  <span class="actions actions--case">
                    {m.nouveau && (
                      <button class="bouton bouton--valider bouton--sm" type="submit" name="action" value="valider-module">
                        Valider
                      </button>
                    )}
                    <button class="bouton bouton--marque bouton--sm" type="submit">Enregistrer</button>
                    <button
                      class="bouton bouton--sobre bouton--sm"
                      type="submit"
                      name="action"
                      value="publication"
                    >{m.actif ? 'Masquer' : 'Publier'}</button>
                    <input type="hidden" name="actif" value={m.actif ? '0' : '1'} />
                  </span>
                </form>

                <details class="composants">
                  <summary>
                    <Icone nom="chevron-right" taille={14} classe="icone--miroir composants__fleche" />
                    {(m.composants || []).length} composant(s)
                    {m.nb_nouvelles > 0 && <span class="neuf">{m.nb_nouvelles} à valider</span>}
                  </summary>
                  <div class="composants__liste">
                    {(m.composants || []).map((c) => (
                      <div class="composant-ligne">
                        <span class="composant-ligne__nom">
                          {c.nom || c.cle}
                          {c.nouveau && <span class="neuf">nouveau</span>}
                        </span>
                        <span class="pastilles">{leviersDe(c.leviers).map((l) => <Pastille levier={l} />)}</span>
                        <form method="post" class="composant-ligne__etat">
                          <input type="hidden" name="slug" value={m.slug} />
                          <input type="hidden" name="id" value={c.id} />
                          {c.nouveau ? (
                            <Fragment>
                              <span class="interrupteur interrupteur--bloque" title="À valider avant mise en ligne"></span>
                              <span class="composant-ligne__mot">hors ligne</span>
                              <button class="bouton bouton--valider bouton--sm" type="submit" name="action" value="valider-fonction">
                                Valider
                              </button>
                            </Fragment>
                          ) : (
                            <Fragment>
                              <input type="hidden" name="en_ligne" value={c.en_ligne ? '0' : '1'} />
                              <button
                                class={c.en_ligne ? 'interrupteur interrupteur--on' : 'interrupteur'}
                                type="submit"
                                name="action"
                                value="bascule-fonction"
                                title={c.en_ligne ? 'Mettre hors ligne' : 'Mettre en ligne'}
                              ><span></span></button>
                              <span class="composant-ligne__mot" style={c.en_ligne ? 'color:var(--teal-700)' : undefined}>
                                {c.en_ligne ? 'en ligne' : 'hors ligne'}
                              </span>
                            </Fragment>
                          )}
                        </form>
                        <span class="composant-ligne__gain">{c.benefice || '—'}</span>
                      </div>
                    ))}
                  </div>
                </details>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="bloc__pied">
      {modules.length} module(s), {total} composants. Famille, icône, leviers et ordre se modifient
      directement ici. Le reste de la fiche — accroche, description, liens — est derrière le nom du module.
      Un module s'ajoute au dépôt, pas ici : une ligne dans <span class="jeton">modules.json</span> et sa
      fiche dans <span class="jeton">pipeline/contenu-initial.mjs</span>.
    </div>
  </section>
</Console>

<style is:global>
  /* Une ligne de module est un formulaire : la grille tient les colonnes
     alignées entre l'en-tête et les lignes, sans table imbriquée. */
  .ligne-module {
    display: grid;
    grid-template-columns:
      minmax(9rem, 1.2fr) 10rem 9rem 8.5rem 4.5rem 7rem 7rem 3.5rem 3.5rem 5.5rem auto;
    gap: 12px;
    align-items: center;
    padding: 11px 16px;
    inline-size: 100%;
  }
  .ligne-module--entete {
    padding-block: 0;
    font: 600 var(--text-xs) / 1 var(--font-sans);
    letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--slate-400);
  }
  .ligne-module__nom { min-inline-size: 0; }
  /* Les six pastilles tiennent sur une ligne : c'est ce qui rend la colonne
     lisible d'un coup d'œil, module après module. */
  .ligne-module .choix-leviers { flex-wrap: nowrap; }
  .ligne-module__nom a { text-decoration: none; }
  .ligne-module__icone { display: flex; align-items: center; gap: 8px; }
  .ligne-module__icone .apercu {
    display: inline-flex; align-items: center; justify-content: center;
    inline-size: 26px; block-size: 26px; border-radius: 6px;
    background: var(--plum-50); color: var(--plum-600); flex: none;
  }
  .ligne-module__icone select { font-family: var(--font-mono); font-size: var(--text-xs); }
  .ligne-module__ordre { text-align: end; }
  .ligne-module__prix { inline-size: 7rem; }
  /* Un module de socle n'a pas de prix propre : son prix est celui du socle.
     Le champ reste lisible mais dit qu'il ne sert plus. */
  .ligne-module__socle { font-size: var(--text-xs); }
  .ligne-module:has(.ligne-module__socle option[value='franchise']:checked) .ligne-module__prix,
  .ligne-module:has(.ligne-module__socle option[value='franchiseur']:checked) .ligne-module__prix {
    opacity: 0.45;
  }
  .ligne-module__compte { text-align: end; color: var(--slate-600); }
  @media (max-width: 1200px) {
    .ligne-module { grid-template-columns: 1fr 1fr; }
    .ligne-module--entete { display: none; }
  }
</style>
