---
/**
 * Un contrat : son texte figé, son dossier, et sa signature.
 *
 * Le corps affiché ici est celui qui a été édité, pas le gabarit du jour. La
 * différence compte : un gabarit réécrit le mois prochain ne doit pas changer
 * le texte de ce qu'un client a signé.
 */
import Console from '../../../components/Console.astro';
import Icone from '../../../components/Icone.astro';
import {
  chargerContrat,
  chargerProspect,
  compteurs,
  envoyerEnSignature,
  genererContrat,
  listerPieces,
  rafraichirSignature,
} from '../../../lib/admin/donnees.mjs';
import { TYPES_PIECE, dossierComplet } from '../../../lib/contrats/gabarit.mjs';
import { serviceSignature } from '../../../lib/contrats/signature.mjs';

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
const { reference } = Astro.params;
let erreur = null;

if (Astro.request.method === 'POST') {
  try {
    const f = await Astro.request.formData();
    const qui = (Astro.locals.session || {}).id || null;
    const action = String(f.get('action') || '');
    let dit = '';
    if (action === 'envoi') {
      const r = await envoyerEnSignature(reference, qui);
      dit = r.expedie
        ? `Contrat envoyé en signature par ${r.service}.`
        : `Aucun service de signature configuré : rien n'est parti. Le contrat reste un brouillon, et le texte est dans le journal du serveur.`;
    } else if (action === 'etat') {
      const r = await rafraichirSignature(reference, qui);
      dit = r.change ? `Signature : ${r.statut}.` : `Rien de neuf — toujours ${r.statut}.`;
    } else if (action === 'regeneration') {
      const c = await chargerContrat(reference);
      await genererContrat(c.offre_id, qui);
      dit = 'Contrat régénéré aux conditions du jour.';
    }
    return Astro.redirect(`${BASE}/admin/contrats/${reference}?ok=${encodeURIComponent(dit)}`, 303);
  } catch (err) {
    erreur = err.message;
  }
}

let contrat = null;
let prospect = null;
let pieces = [];
let chiffres = {};
try {
  contrat = await chargerContrat(reference);
  if (contrat) {
    prospect = await chargerProspect(contrat.prospect_id);
    pieces = await listerPieces(contrat.prospect_id);
  }
  chiffres = await compteurs();
} catch (err) {
  erreur = erreur || `Base injoignable : ${err.message}`;
}

if (!contrat && !erreur) return new Response('Contrat introuvable', { status: 404 });

const service = serviceSignature();
const etat = prospect ? dossierComplet(prospect, { pieces }) : { complet: false, manque: [] };
const message = Astro.url.searchParams.get('ok');
const jour = (v) => (v ? new Date(v).toLocaleDateString('fr-BE') : '—');
const libellePiece = (cle) => (TYPES_PIECE.find((t) => t.cle === cle) || {}).libelle || cle;
const modifiable = contrat && contrat.statut === 'brouillon';
---

<Console
  titre={contrat?.reference || 'Contrat'}
  fil={`TFB Admin · Commercial · ${contrat?.reference || 'Contrat'}`}
  actif="contrats"
  message={message}
  erreur={erreur}
  compteurs={chiffres}
>
  {contrat && (
    <>
      <div class="barre-actions">
        <a class="bouton bouton--sobre bouton--sm" href={`${BASE}/admin/contrats`}>
          <Icone nom="arrow-left" taille={16} /> Tous les contrats
        </a>
        {contrat.offre_reference && (
          <a class="bouton bouton--sobre bouton--sm" href={`${BASE}/admin/offres/${contrat.offre_reference}`}>
            Offre {contrat.offre_reference}
          </a>
        )}
        <span class="barre-actions__note">
          {modifiable
            ? 'Brouillon — le texte se régénère tant que rien n’est parti.'
            : 'Le texte est figé : le signataire a cette version sous les yeux.'}
        </span>
      </div>

      <section class="bloc" style="margin-block-end:20px">
        <div class="bloc__tete">
          <div>
            <h2>Où en est la signature</h2>
            <p>
              Édité le {jour(contrat.genere_le)}
              {contrat.envoye_le && <>, envoyé le {jour(contrat.envoye_le)}</>}
              {contrat.signe_le && <>, signé le {jour(contrat.signe_le)}</>}.
            </p>
          </div>
          <span class={contrat.statut === 'signe' ? 'etat etat--on' : 'etat'}>{contrat.statut}</span>
        </div>

        <div class="duo">
          <div class="champ">
            <span class="legende">Conditions</span>
            <p class="champ__aide" style="margin:0">
              Effet le {jour(contrat.date_effet)}, {contrat.duree_mois} mois,
              préavis de {contrat.preavis_jours} jours.
              {contrat.reconduction && <> {contrat.reconduction}</>}
            </p>
          </div>
          <div class="champ">
            <span class="legende">Prestataire de signature</span>
            <p class="champ__aide" style="margin:0">
              {contrat.signature_enveloppe
                ? <>{contrat.signature_service} — enveloppe <code class="slug">{contrat.signature_enveloppe}</code>, relevée le {jour(contrat.signature_maj_le)}.</>
                : <>Aucune enveloppe. Service en vigueur : <strong>{service.nom}</strong>{!service.signe && <> — rien ne part réellement.</>}</>}
            </p>
          </div>
        </div>

        <div class="actions">
          {modifiable && (
            <form method="post">
              <input type="hidden" name="action" value="envoi" />
              <button class="bouton bouton--marque" type="submit">
                <Icone nom="mail" taille={16} /> Envoyer en signature
              </button>
            </form>
          )}
          {contrat.signature_enveloppe && (
            <form method="post">
              <input type="hidden" name="action" value="etat" />
              <button class="bouton bouton--sobre" type="submit">
                <Icone nom="refresh-cw" taille={16} /> Relever l'état
              </button>
            </form>
          )}
          {modifiable && (
            <form method="post" onsubmit="return confirm('Régénérer le contrat aux conditions et au dossier du jour ? Le texte actuel sera remplacé.')">
              <input type="hidden" name="action" value="regeneration" />
              <button class="bouton bouton--sobre" type="submit">Régénérer</button>
            </form>
          )}
        </div>
      </section>

      <section class="bloc" style="margin-block-end:20px">
        <div class="bloc__tete">
          <div>
            <h2>Le dossier de {contrat.raison_sociale}</h2>
            <p>Ce qui a servi à écrire le contrat, et ce qui l'accompagne.</p>
          </div>
          <a class="bouton bouton--sobre bouton--sm" href={`${BASE}/admin/prospects/${contrat.prospect_id}`}>
            Ouvrir la fiche client
          </a>
        </div>

        {!etat.complet && (
          <div class="champ">
            <span class="champ__aide">
              Le dossier n'est plus complet : il manque {etat.manque.map((m) => m.libelle).join(', ')}.
              Le contrat déjà écrit n'en souffre pas — mais une régénération sera refusée.
            </span>
          </div>
        )}

        {pieces.length === 0 ? (
          <div class="champ"><span class="champ__aide">Aucune pièce au dossier.</span></div>
        ) : (
          <div class="roule">
            <table>
              <tbody>
                {pieces.map((p) => (
                  <tr>
                    <td><strong>{libellePiece(p.type)}</strong></td>
                    <td><a href={`${BASE}/admin/pieces/${p.id}`}>{p.nom}</a></td>
                    <td class="champ__aide">{jour(p.depose_le)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>

      <section class="bloc">
        <div class="bloc__tete">
          <div>
            <h2>Le texte</h2>
            <p>
              Tel qu'il a été écrit le {jour(contrat.genere_le)}. Modifier le gabarit sur
              l'écran Tarifs ne le change pas.
            </p>
          </div>
          <button class="bouton bouton--sobre bouton--sm" type="button" onclick="window.print()">
            <Icone nom="download" taille={16} /> Imprimer
          </button>
        </div>

        <pre class="contrat__corps">{contrat.corps}</pre>
      </section>
    </>
  )}
</Console>

<style is:global>
  /* Le contrat est un texte à lire, pas du code : la police à chasse fixe
     servirait mal une phrase de trois lignes. La chasse reste préservée par
     `pre`, qui garde les retours à la ligne du gabarit. */
  .contrat__corps {
    margin: 0 16px 16px;
    padding: 20px 22px;
    border: 1px solid var(--slate-200);
    border-radius: 10px;
    background: var(--slate-50);
    font: var(--text-sm) / 1.65 var(--font-sans);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  @media print {
    /* À l'impression, le contrat et rien d'autre : ni rail, ni boutons. */
    .rail, .barre-actions, .bloc__tete, .actions, .bloc__pied { display: none !important; }
    .contrat__corps { border: 0; background: none; margin: 0; padding: 0; }
  }
</style>
