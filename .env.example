# ---------------------------------------------------------------------------
# landing-tfb — variables d'environnement
#
# Copier en `.env` sur le serveur (jamais commité). Aucune valeur en dur
# ailleurs dans le projet : tout passe par ces variables.
#
# Les noms DB_LOGIN / DB_NAME / DB_PASS / SSH_* reprennent EXACTEMENT les
# secrets GitHub déjà présents sur le dépôt. Le mapping vers les variables
# attendues par Directus (DB_USER, DB_DATABASE, DB_PASSWORD) est fait dans
# infra/docker-compose.yml — on ne renomme pas les secrets.
# ---------------------------------------------------------------------------

# --- Base de données existante ---------------------------------------------
# `pg` (PostgreSQL) ou `mysql` (MySQL / MariaDB).
DB_CLIENT=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_LOGIN=tfb_landing
DB_NAME=tfb_landing
DB_PASS=change-moi

# --- Directus ---------------------------------------------------------------
# URL publique du CMS (utilisée par le pipeline et par la landing en SSR).
DIRECTUS_URL=https://cms.example.com
# Jeton statique d'un utilisateur Directus ayant les droits admin.
# Sert au bootstrap (création des collections) et à la lecture côté serveur.
# Il n'est JAMAIS transmis au navigateur.
DIRECTUS_TOKEN=change-moi
# Clés internes Directus : deux chaînes aléatoires stables (openssl rand -hex 32).
# Si elles changent, toutes les sessions sont invalidées.
DIRECTUS_KEY=change-moi
DIRECTUS_SECRET=change-moi
# Compte administrateur créé au tout premier démarrage de Directus.
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-moi

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-change-moi
# Modèle utilisé pour la génération de contenu (facultatif).
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- GitHub -----------------------------------------------------------------
# Jeton de lecture sur les dépôts modules (scope `repo` si dépôts privés).
GH_INGEST_TOKEN=ghp_change-moi

# --- Domaines ---------------------------------------------------------------
SITE_DOMAIN=www.example.com
CMS_DOMAIN=cms.example.com

# --- Déploiement (utilisé par GitHub Actions, pas par les conteneurs) -------
SSH_HOST=203.0.113.10
SSH_USER=deploy
SSH_PORT=22
DEPLOY_PATH=/opt/landing-tfb
