# systemd unit for the TFB landing + back office.
#
#   sudo cp deploy/tfb-landing.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tfb-landing
#   sudo journalctl -u tfb-landing -f
#
# Adjust User, WorkingDirectory and the node path to match your server.

[Unit]
Description=The Franchise Buddy — landing + back office (Next.js)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=tfb
Group=tfb
WorkingDirectory=/srv/tfb-landing

# Secrets live in this file, not in the unit — keep it 0600 and owned by root.
EnvironmentFile=/etc/tfb-landing.env
Environment=NODE_ENV=production
Environment=PORT=3000
# NEXT_PUBLIC_BASE_PATH vient de EnvironmentFile : le serveur en a besoin au
# runtime, et le build en a eu besoin pour l'inliner côté client.

ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --port 3000
Restart=always
RestartSec=5

# Hardening. The app needs to write uploads and nothing else on the filesystem.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tfb/storage /srv/tfb-landing/.next
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tfb-landing

[Install]
WantedBy=multi-user.target
