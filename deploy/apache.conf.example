# Apache — proxy vers l'app Next, servie sous /landing_tfb.
#
# Votre serveur tourne sous Apache 2.4 (c'est lui qui sert phpMyAdmin, et lui qui
# renvoie le « Not Found » tant qu'aucune règle ne couvre /landing_tfb).
#
#   sudo a2enmod proxy proxy_http headers
#   # collez le bloc <Location> ci-dessous dans le VirtualHost *:443 existant
#   sudo apache2ctl configtest && sudo systemctl reload apache2
#
# À insérer DANS le <VirtualHost *:443> qui répond déjà sur 185.180.206.46 —
# pas dans un nouveau vhost, sinon les deux se disputent le port 443.

# --- à coller dans le VirtualHost *:443 --------------------------------------

    ProxyPreserveHost On
    ProxyRequests Off

    # Pas de réécriture de chemin : l'app est BUILDÉE avec
    # NEXT_PUBLIC_BASE_PATH=/landing_tfb, donc elle attend le chemin complet,
    # /landing_tfb compris. Les deux côtés de ProxyPass portent le même préfixe.
    ProxyPass        /landing_tfb  http://127.0.0.1:3000/landing_tfb
    ProxyPassReverse /landing_tfb  http://127.0.0.1:3000/landing_tfb

    <Location /landing_tfb>
        # Next lit X-Forwarded-Proto pour savoir qu'il est derrière du TLS.
        RequestHeader set X-Forwarded-Proto "https"
        RequestHeader set X-Forwarded-Port  "443"

        # Le back office n'est pas pour les moteurs de recherche. L'app envoie
        # déjà `robots: noindex` sur /admin ; ceci est la ceinture.
        <If "%{REQUEST_URI} =~ m#^/landing_tfb/admin#">
            Header always set X-Robots-Tag "noindex, nofollow"
        </If>

        Require all granted
    </Location>

    # Le webhook Stripe a besoin du corps brut pour la vérification de signature.
    # Aucun filtre de sortie ne doit y toucher.
    <Location /landing_tfb/api/stripe/webhook>
        SetEnv proxy-sendchunked 1
    </Location>

    # Timeout confortable pour les uploads de screenshots.
    ProxyTimeout 120

# --- fin du bloc --------------------------------------------------------------


# ============================================================================
# Diagnostic du « Not Found »
# ============================================================================
#
# Le 404 vient d'Apache, pas de l'app. Deux causes possibles, à distinguer
# DEPUIS LE SERVEUR :
#
#   curl -s http://127.0.0.1:3000/landing_tfb/api/health
#
#   • Réponse {"ok":true,...}  → l'app tourne, c'est Apache qui ne proxifie pas.
#                                 Appliquez le bloc ci-dessus.
#
#   • Connexion refusée        → l'app ne tourne pas. Vérifiez :
#                                 systemctl status tfb-landing
#                                 journalctl -u tfb-landing -n 50
#                                 Si le service n'existe pas, bootstrap.sh n'a
#                                 pas encore été lancé.
#
#   • 404 depuis le port 3000  → l'app tourne mais a été buildée SANS
#                                 NEXT_PUBLIC_BASE_PATH=/landing_tfb. Rebuild :
#                                 sudo BASE_PATH_CFG=/landing_tfb bash bootstrap.sh
#
# ============================================================================
# phpMyAdmin
# ============================================================================
#
# Il est servi par ce même Apache et joignable depuis Internet — c'est un accès
# complet à la base. Restreignez-le :
#
#   <Location /phpmyadmin>
#       Require ip VOTRE.IP.FIXE.ICI
#   </Location>
