---
/**
 * Les réseaux affichés sur la landing.
 *
 * Le bandeau « Des réseaux qui travaillent avec TFB » ne s'affiche que si
 * cette table contient des lignes actives. Tant qu'elle est vide, la section
 * disparaît — un bandeau de références inventées vaut moins que pas de
 * bandeau.
 */
import Console from '../../components/Console.astro';
import Icone from '../../components/Icone.astro';
import { lien } from '../../lib/lien.mjs';
import {
  ajouterClient,
  appliquerViesClient,
  compteurs,
  enregistrerClient,
  enregistrerLogoClient,
  listerClients,
  supprimerClient,
  supprimerLogoClient,
} from '../../lib/admin/donnees.mjs';
import { TAILLE_MAX, TYPES_ACCEPTES } from '../../lib/admin/images.mjs';
import { serviceVies } from '../../lib/onboarding/vies.mjs';

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
let erreur = null;

if (Astro.request.method === 'POST') {
  try {
    const f = await Astro.request.formData();
    const action = String(f.get('action') || '');
    let note = '';
    if (action === 'ajout') {
      const { avecLogo } = await ajouterClient({
        nom: f.get('nom'), note: f.get('note'), ordre: f.get('ordre'), logo: f.get('logo'),
        tva: f.get('tva'), pays: f.get('pays'), adresse: f.get('adresse'), site_web: f.get('site_web'),
      });
      note = avecLogo ? 'Réseau ajouté, logo compris.' : 'Réseau ajouté.';
    } else if (action === 'ajout-vies') {
      // L'import à la création : on interroge d'abord, on crée ensuite avec ce
      // que le registre a dit. C'est le seul endroit où l'on recopie le nom
      // sans le demander — la ligne n'existe pas encore, il n'y a pas de nom
      // d'usage à écraser, et il se corrige juste après si besoin.
      const r = await serviceVies().verifier(f.get('tva'), f.get('pays'));
      if (!r.ok) throw new Error(r.message);
      const { id } = await ajouterClient({
        nom: String(f.get('nom') || '').trim() || r.nom || r.tva,
        note: f.get('note'),
        ordre: f.get('ordre'),
        logo: f.get('logo'),
        tva: r.tva,
        pays: r.pays === 'EL' ? 'GR' : r.pays,
        adresse: r.adresse,
        site_web: f.get('site_web'),
      });
      await appliquerViesClient(id, r);
      note = r.nom
        ? `Réseau ajouté depuis VIES — le registre dit « ${r.nom} ».`
        : 'Réseau ajouté : le numéro est valide, mais cet État membre ne publie pas le nom.';
    } else if (action === 'vies') {
      // On enregistre d'abord : vérifier un numéro qu'on vient de taper sans
      // l'enregistrer vérifierait celui d'avant.
      await enregistrerClient(f.get('id'), {
        nom: f.get('nom'), note: f.get('note'), actif: f.get('actif') === 'on', ordre: f.get('ordre'),
        tva: f.get('tva'), pays: f.get('pays'), adresse: f.get('adresse'), site_web: f.get('site_web'),
      });
      const r = await serviceVies().verifier(f.get('tva'), f.get('pays'));
      if (!r.ok) throw new Error(r.message);
      await appliquerViesClient(f.get('id'), r);
      note = r.nom
        ? `TVA vérifiée — le registre dit « ${r.nom} ». Le nom du bandeau, lui, n'a pas bougé.`
        : 'TVA vérifiée : le numéro est valide. Cet État membre ne publie pas le nom.';
    } else if (action === 'suppression') {
      await supprimerClient(f.get('id'));
      note = 'Réseau retiré.';
    } else if (action === 'logo_retire') {
      await supprimerLogoClient(f.get('id'));
      note = 'Logo retiré — le bandeau réaffiche le nom.';
    } else {
      await enregistrerClient(f.get('id'), {
        nom: f.get('nom'),
        note: f.get('note'),
        actif: f.get('actif') === 'on',
        ordre: f.get('ordre'),
        tva: f.get('tva'),
        pays: f.get('pays'),
        adresse: f.get('adresse'),
        site_web: f.get('site_web'),
      });
      // Le champ de fichier laissé vide ne touche pas au logo en place : on
      // doit pouvoir corriger un nom sans redéposer l'image.
      const avecLogo = await enregistrerLogoClient(f.get('id'), f.get('logo'));
      note = avecLogo ? 'Réseau et logo enregistrés.' : 'Réseau enregistré.';
    }
    return Astro.redirect(`${BASE}/admin/clients?ok=${encodeURIComponent(note)}`, 303);
  } catch (err) {
    erreur = err.message;
  }
}

let clients = [];
let chiffres = {};
try {
  clients = await listerClients();
  chiffres = await compteurs();
} catch (err) {
  erreur = erreur || `Base injoignable : ${err.message}`;
}

const message = Astro.url.searchParams.get('ok');
const affiches = clients.filter((c) => c.actif).length;
const identifies = clients.filter((c) => c.tva).length;
const jour = (v) => (v ? new Date(v).toLocaleDateString('fr-BE') : null);
---

<Console
  titre="Réseaux clients"
  fil="TFB Admin · Réseau · Réseaux clients"
  actif="clients"
  message={message}
  erreur={erreur}
  compteurs={chiffres}
>
  <a slot="actions" class="bouton bouton--sobre" href={lien('/#clients')} target="_blank">Voir le bandeau</a>

  <section class="bloc">
    <div class="bloc__tete">
      <div>
        <h2>Réseaux affichés</h2>
        <p>
          <span class="jeton">landing_clients</span> — le bandeau de la page d'accueil.
          Vide, il ne s'affiche pas du tout.
        </p>
      </div>
    </div>

    {clients.length > 0 && (
      <div class="roule">
        <table>
          <thead>
            <tr><th>Logo</th><th>Réseau</th><th>Note interne</th><th class="a-droite">Ordre</th><th>Affiché</th><th><span class="invisible">Actions</span></th></tr>
          </thead>
          <tbody>
            {clients.map((c) => (
              <tr>
                <td colspan="6" style="padding:0">
                  <form method="post" enctype="multipart/form-data">
                    <input type="hidden" name="id" value={c.id} />
                    <div class="ligne-client">
                    <span class="logo-case">
                      {c.logo_type ? (
                        <img class="logo-vu" src={`${BASE}/logos/${c.id}`} alt="" width="64" height="32" loading="lazy" />
                      ) : (
                        <span class="logo-vide">sans logo</span>
                      )}
                      <input type="file" name="logo" accept={TYPES_ACCEPTES} aria-label={`Logo de ${c.nom}`} />
                    </span>
                    <input type="text" name="nom" value={c.nom} aria-label="Nom" />
                    <input type="text" name="note" value={c.note || ''} placeholder="Ne s'affiche pas sur le site" aria-label={`Note interne de ${c.nom}`} />
                    <input type="number" name="ordre" min="1" value={c.ordre ?? 100} aria-label={`Ordre de ${c.nom}`} />
                    <label style="display:flex;align-items:center;gap:8px;font:var(--type-body-sm)">
                      <input type="checkbox" name="actif" checked={c.actif} style="inline-size:auto" />
                      Affiché
                    </label>
                    <div class="actions actions--case">
                      <button class="bouton bouton--marque bouton--sm" type="submit">Enregistrer</button>
                      {c.logo_type && (
                        <button
                          class="bouton bouton--sobre bouton--sm"
                          type="submit"
                          name="action"
                          value="logo_retire"
                        >Retirer le logo</button>
                      )}
                      <button
                        class="bouton bouton--danger bouton--sm"
                        type="submit"
                        name="action"
                        value="suppression"
                        onclick="return confirm('Retirer ce réseau du bandeau ?')"
                      >Retirer</button>
                    </div>
                    </div>

                    <details class="identite" open={Boolean(c.tva)}>
                      <summary>
                        L'identité derrière l'enseigne
                        {c.tva
                          ? <span class={c.tva_verifiee_le ? 'etat etat--on' : 'etat'}>
                              {c.tva}{c.tva_verifiee_le ? ` · vérifiée le ${jour(c.tva_verifiee_le)}` : ' · non vérifiée'}
                            </span>
                          : <span class="etat">aucun numéro</span>}
                      </summary>
                      <div class="duo">
                        <div class="champ">
                          <label for={`c${c.id}-tva`}>Numéro de TVA</label>
                          <input id={`c${c.id}-tva`} type="text" name="tva" value={c.tva || ''} maxlength="20" placeholder="BE0123456789" />
                        </div>
                        <div class="champ">
                          <label for={`c${c.id}-pays`}>Pays</label>
                          <input id={`c${c.id}-pays`} type="text" name="pays" value={c.pays || ''} maxlength="2" placeholder="BE" />
                        </div>
                        <div class="champ">
                          <label for={`c${c.id}-web`}>Site web</label>
                          <input id={`c${c.id}-web`} type="text" name="site_web" value={c.site_web || ''} maxlength="255" />
                        </div>
                        <div class="champ" style="grid-column:1/-1">
                          <label for={`c${c.id}-adresse`}>Adresse du siège</label>
                          <textarea id={`c${c.id}-adresse`} name="adresse" rows="2">{c.adresse || ''}</textarea>
                        </div>
                      </div>
                      {c.tva_verifiee_nom && (
                        <p class="champ__aide">
                          Le registre européen connaît ce numéro sous le nom
                          <strong> {c.tva_verifiee_nom}</strong>. Le bandeau, lui, garde l'enseigne —
                          c'est elle que le visiteur reconnaît.
                        </p>
                      )}
                      <div class="actions">
                        <button class="bouton bouton--sobre bouton--sm" type="submit" name="action" value="vies">
                          <Icone nom="search" taille={14} /> Vérifier auprès de VIES
                        </button>
                      </div>
                    </details>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <div class="bloc__corps">
      {/*
        Aucun champ caché « action » ici, et c'est important : un formulaire
        qui porte à la fois un `<input type="hidden" name="action">` et un
        bouton `name="action"` envoie **les deux**, et `formData.get()` rend
        le premier — c'est-à-dire toujours le champ caché. Le second bouton
        semble alors marcher tout en faisant autre chose, ce qui est la pire
        forme de panne. Chaque bouton porte donc son action, et le premier
        est celui par défaut.
      */}
      <form method="post" enctype="multipart/form-data" class="repet__item">
        <div class="duo">
          <div class="champ">
            <label for="cl-nom">Nom du réseau<span class="champ__requis" aria-hidden="true"> *</span></label>
            <input id="cl-nom" type="text" name="nom" required placeholder="L'Atelier By" />
          </div>
          <div class="champ">
            <label for="cl-note">Note interne</label>
            <input id="cl-note" type="text" name="note" placeholder="Ne s'affiche pas sur le site" />
          </div>
          <div class="champ">
            <label for="cl-ordre">Ordre</label>
            <input id="cl-ordre" type="number" name="ordre" min="1" value="100" />
          </div>
          <div class="champ">
            <label for="c-logo">Logo</label>
            <input id="c-logo" type="file" name="logo" accept={TYPES_ACCEPTES} />
            <span class="champ__aide">
              PNG, JPEG ou WebP, {TAILLE_MAX / 1024} ko au plus. Sans logo, le bandeau
              affiche le nom. Le SVG est refusé : il peut porter du JavaScript.
            </span>
          </div>
          <div class="champ">
            <label for="cl-tva">Numéro de TVA</label>
            <input id="cl-tva" type="text" name="tva" maxlength="20" placeholder="BE0123456789" />
            <span class="champ__aide">
              Facultatif — mais avec lui, « Chercher dans VIES » remplit le nom légal et
              l'adresse depuis le registre européen, sans ressaisie et sans faute.
            </span>
          </div>
          <div class="champ">
            <label for="cl-pays">Pays</label>
            <input id="cl-pays" type="text" name="pays" maxlength="2" placeholder="BE" />
          </div>
          <div class="champ" style="grid-column:1/-1">
            <label for="cl-adresse">Adresse du siège</label>
            <textarea id="cl-adresse" name="adresse" rows="2"></textarea>
          </div>
        </div>
        <div class="actions">
          <button class="bouton bouton--marque bouton--sm" type="submit" name="action" value="ajout">Ajouter ce réseau</button>
          <button class="bouton bouton--sobre bouton--sm" type="submit" name="action" value="ajout-vies">
            <Icone nom="search" taille={14} /> Ajouter depuis VIES
          </button>
        </div>
        <p class="champ__aide">
          « Ajouter depuis VIES » part du numéro de TVA : le nom et l'adresse arrivent du
          registre, et le nom du bandeau se corrige ensuite si l'enseigne diffère de la
          raison sociale — ce qui est le cas le plus souvent.
        </p>
      </form>
    </div>

    <div class="bloc__pied">
      {clients.length} réseau(x), {affiches} affiché(s),
      {' '}{clients.filter((c) => c.logo_type).length} avec logo,
      {' '}{identifies} avec un numéro de TVA.
      {clients.length === 0 && " Le bandeau reste masqué tant qu'aucun réseau n'est saisi."}
      {' '}Les logos sont stockés en base, pas dans un dossier : ils survivent au déploiement
      et sont sauvegardés avec le reste du contenu.
    </div>
  </section>
</Console>

<style is:global>
  .ligne-client {
    display: grid; gap: 12px; align-items: center; padding: 11px 16px;
    grid-template-columns: 8rem minmax(10rem, 1fr) minmax(10rem, 1.2fr) 5rem 7rem auto;
  }
  .logo-case { display: flex; flex-direction: column; gap: 4px; min-inline-size: 0; }
  /* Fond damé : un logo blanc sur fond blanc se verrait comme une case vide,
     et on ne saurait pas s'il est là. */
  .logo-vu {
    inline-size: 100%; block-size: 32px; object-fit: contain;
    border-radius: var(--radius-sm); padding: 2px;
    background:
      linear-gradient(45deg, var(--slate-100) 25%, transparent 25%, transparent 75%, var(--slate-100) 75%),
      linear-gradient(45deg, var(--slate-100) 25%, #fff 25%, #fff 75%, var(--slate-100) 75%);
    background-size: 10px 10px;
    background-position: 0 0, 5px 5px;
  }
  .logo-vide {
    display: flex; align-items: center; justify-content: center;
    block-size: 32px; border-radius: var(--radius-sm);
    border: 1px dashed var(--slate-200);
    font: 400 10px/1 var(--font-sans); color: var(--slate-400);
  }
  .logo-case input[type='file'] { font-size: 11px; padding: 4px; }

  /* L'identité légale, repliée par défaut : le bandeau se règle en trois
     champs, et faire cohabiter le nom d'enseigne avec une adresse de siège
     sur la même ligne rendrait les deux illisibles. Elle s'ouvre d'office
     quand un numéro est saisi — s'il est là, c'est qu'on s'en sert. */
  .identite { padding: 0 16px 14px; border-block-start: 1px dashed var(--slate-200); }
  .identite > summary {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    padding-block: 10px; cursor: pointer;
    font: var(--type-body-sm); color: var(--slate-500);
  }
  .identite > summary::marker { color: var(--slate-400); }

  /* Le formulaire d'ajout finit par une zone de texte pleine largeur : sans
     cet air, ses boutons se collent dessous et « Ajouter » se lit comme la
     dernière ligne de l'adresse. */
  .repet__item > .actions { margin-block-start: 14px; }

  @media (max-width: 1100px) {
    /* En dessous, six colonnes deviennent illisibles : la ligne se replie. */
    .ligne-client { grid-template-columns: 8rem 1fr; }
    .ligne-client .actions { grid-column: 1 / -1; }
  }
</style>
