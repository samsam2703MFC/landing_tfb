---
/**
 * Les demandes de démonstration reçues par le formulaire de la landing.
 *
 * Rien n'est envoyé par courriel : le serveur n'a pas de SMTP. Les demandes
 * arrivent ici, et c'est la seule trace — d'où le bouton de suppression, qui
 * demande confirmation.
 */
import Console from '../../components/Console.astro';
import { compteurs, listerLeads, marquerLead, supprimerLead } from '../../lib/admin/donnees.mjs';

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
let erreur = null;

if (Astro.request.method === 'POST') {
  try {
    const f = await Astro.request.formData();
    const action = String(f.get('action') || '');
    if (action === 'suppression') {
      await supprimerLead(f.get('id'));
      return Astro.redirect(`${BASE}/admin/leads?ok=${encodeURIComponent('Demande supprimée.')}`, 303);
    }
    await marquerLead(f.get('id'), f.get('traite') === '1');
    return Astro.redirect(`${BASE}/admin/leads?ok=${encodeURIComponent('Demande mise à jour.')}`, 303);
  } catch (err) {
    erreur = err.message;
  }
}

let leads = [];
let chiffres = {};
try {
  leads = await listerLeads();
  chiffres = await compteurs();
} catch (err) {
  erreur = erreur || `Base injoignable : ${err.message}`;
}

const message = Astro.url.searchParams.get('ok');
const attente = leads.filter((l) => !l.traite).length;

/** Une date lisible, sans dépendance : « 31/07/2026 à 14:05 ». */
function quand(valeur) {
  if (!valeur) return '—';
  const d = valeur instanceof Date ? valeur : new Date(valeur);
  if (Number.isNaN(d.getTime())) return String(valeur);
  const deuxChiffres = (n) => String(n).padStart(2, '0');
  return `${deuxChiffres(d.getDate())}/${deuxChiffres(d.getMonth() + 1)}/${d.getFullYear()} à ${deuxChiffres(d.getHours())}:${deuxChiffres(d.getMinutes())}`;
}
---

<Console
  titre="Demandes"
  fil="TFB Admin · Réseau · Demandes"
  actif="leads"
  message={message}
  erreur={erreur}
  compteurs={chiffres}
>
  <section class="bloc">
    <div class="bloc__tete">
      <div>
        <h2>Demandes de démonstration</h2>
        <p>
          <span class="jeton">landing_leads</span> — reçues par le formulaire de la page d'accueil.
          Aucun courriel n'est envoyé : cette table est la seule trace.
        </p>
      </div>
    </div>

    {leads.length === 0 ? (
      <div class="bloc__corps"><p class="tuile__note">Aucune demande pour l'instant.</p></div>
    ) : (
      <div class="roule">
        <table>
          <thead>
            <tr><th>Reçue</th><th>Personne</th><th>Réseau</th><th>Sa situation</th><th>Statut</th><th><span class="invisible">Actions</span></th></tr>
          </thead>
          <tbody>
            {leads.map((l) => (
              <tr>
                <td class="num" style="white-space:nowrap">{quand(l.recu_le)}</td>
                <td style="white-space:nowrap">
                  <strong>{l.nom}</strong>
                  <a class="slug" href={`mailto:${l.email}`}>{l.email}</a>
                </td>
                <td>{l.reseau || '—'}</td>
                <td style="color:var(--slate-600);max-inline-size:30rem">{l.situation || '—'}</td>
                <td><span class={l.traite ? 'etat etat--on' : 'etat etat--manque'}>{l.traite ? 'traitée' : 'en attente'}</span></td>
                <td>
                  <div class="actions">
                    <form method="post">
                      <input type="hidden" name="id" value={l.id} />
                      <input type="hidden" name="traite" value={l.traite ? '0' : '1'} />
                      <button class="bouton bouton--sobre bouton--sm" type="submit">
                        {l.traite ? 'Remettre en attente' : 'Marquer traitée'}
                      </button>
                    </form>
                    <form method="post">
                      <input type="hidden" name="id" value={l.id} />
                      <button
                        class="bouton bouton--danger bouton--sm"
                        type="submit"
                        name="action"
                        value="suppression"
                        onclick="return confirm('Supprimer cette demande ? Elle n’existe nulle part ailleurs.')"
                      >Supprimer</button>
                    </form>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <div class="bloc__pied">{leads.length} demande(s) · {attente} en attente.</div>
  </section>
</Console>
