---
/**
 * Gabarit commun : en-tête, pied de page, styles globaux et chargement de
 * Mermaid côté navigateur (les diagrammes sont stockés en texte dans Directus
 * et rendus dans le navigateur, jamais au build).
 */
import { lien } from '../lib/lien.mjs';

const { titre, description, modules = [] } = Astro.props;

const titreComplet = titre ? `${titre} — ERP réseau` : 'ERP réseau';
const canonique = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    {description && <meta name="description" content={description} />}
    {canonique && <link rel="canonical" href={canonique} />}
    <meta property="og:title" content={titreComplet} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <style is:global>
      :root {
        --encre: #101820;
        --encre-douce: #46525f;
        --papier: #ffffff;
        --papier-teinte: #f5f6f7;
        --trait: #e2e5e8;
        --accent: #1f5f8b;
        --accent-clair: #eaf1f6;
        --rayon: 10px;
        --largeur: 1120px;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial,
          sans-serif;
        color: var(--encre);
        background: var(--papier);
        line-height: 1.6;
        font-size: 17px;
        -webkit-font-smoothing: antialiased;
      }

      h1,
      h2,
      h3 {
        line-height: 1.2;
        letter-spacing: -0.015em;
        margin: 0 0 0.5em;
      }

      h1 { font-size: clamp(2rem, 4.5vw, 3.1rem); }
      h2 { font-size: clamp(1.5rem, 2.6vw, 2.1rem); }
      h3 { font-size: 1.15rem; }

      p { margin: 0 0 1em; }

      a { color: var(--accent); }

      .contenant {
        width: 100%;
        max-width: var(--largeur);
        margin: 0 auto;
        padding: 0 24px;
      }

      .section {
        padding: 72px 0;
        border-top: 1px solid var(--trait);
      }

      .section--teinte { background: var(--papier-teinte); }
      .section__chapeau { max-width: 62ch; margin-bottom: 40px; }
      .section__oeil {
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--accent);
        margin-bottom: 12px;
      }

      .grille {
        display: grid;
        gap: 20px;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      }

      .carte {
        background: var(--papier);
        border: 1px solid var(--trait);
        border-radius: var(--rayon);
        padding: 24px;
      }

      .carte h3 { margin-bottom: 8px; }
      .carte p { color: var(--encre-douce); margin-bottom: 0; }

      .carte--lien {
        display: block;
        color: inherit;
        text-decoration: none;
        transition: border-color 0.15s ease, transform 0.15s ease;
      }
      .carte--lien:hover {
        border-color: var(--accent);
        transform: translateY(-2px);
      }

      .bouton {
        display: inline-block;
        background: var(--accent);
        color: #fff;
        text-decoration: none;
        font-weight: 600;
        padding: 13px 26px;
        border-radius: var(--rayon);
      }
      .bouton:hover { filter: brightness(1.08); }

      .bouton--fantome {
        background: transparent;
        color: var(--accent);
        border: 1px solid var(--accent);
      }

      .etiquette {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--accent);
        background: var(--accent-clair);
        border-radius: 999px;
        padding: 3px 12px;
      }

      .schema {
        background: var(--papier);
        border: 1px solid var(--trait);
        border-radius: var(--rayon);
        padding: 24px;
        overflow-x: auto;
      }
      .schema svg { max-width: 100%; height: auto; }

      .entete {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(6px);
        border-bottom: 1px solid var(--trait);
      }
      .entete__barre {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        min-height: 64px;
      }
      .entete__marque {
        font-weight: 700;
        text-decoration: none;
        color: var(--encre);
        letter-spacing: -0.02em;
      }
      .entete__nav {
        display: flex;
        gap: 20px;
        align-items: center;
        flex-wrap: wrap;
      }
      .entete__nav a {
        text-decoration: none;
        color: var(--encre-douce);
        font-size: 0.94rem;
      }
      .entete__nav a:hover { color: var(--accent); }

      .pied {
        border-top: 1px solid var(--trait);
        padding: 40px 0;
        color: var(--encre-douce);
        font-size: 0.9rem;
      }
      .pied__colonnes {
        display: grid;
        gap: 24px;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      }
      .pied a { color: var(--encre-douce); text-decoration: none; display: block; padding: 2px 0; }
      .pied a:hover { color: var(--accent); }

      .prose h2 { margin-top: 1.6em; }
      .prose ul { padding-left: 1.2em; }
      .prose code {
        background: var(--papier-teinte);
        padding: 2px 5px;
        border-radius: 4px;
        font-size: 0.9em;
      }

      @media (max-width: 640px) {
        .section { padding: 48px 0; }
        .entete__nav a:not(.bouton) { display: none; }
      }
    </style>
  </head>

  <body>
    <header class="entete">
      <div class="contenant entete__barre">
        <a class="entete__marque" href={lien("/")}>ERP réseau</a>
        <nav class="entete__nav">
          <a href={lien("/#problemes")}>Problèmes</a>
          <a href={lien("/#reponses")}>Réponses</a>
          <a href={lien("/#modules")}>Modules</a>
          <a class="bouton" href={lien("/#contact")}>Nous contacter</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="pied">
      <div class="contenant pied__colonnes">
        <div>
          <strong>ERP réseau</strong>
          <p>
            Le contenu de ce site est généré automatiquement à partir du code source des modules.
          </p>
        </div>
        {modules.length > 0 && (
          <div>
            <strong>Modules</strong>
            {modules.map((module) => (
              <a href={lien(`/modules/${module.slug}`)}>{module.nom || module.slug}</a>
            ))}
          </div>
        )}
        <div>
          <strong>Contact</strong>
          <a href={lien("/#contact")}>Demander une démonstration</a>
        </div>
      </div>
    </footer>

    <!--
      Mermaid est chargé depuis le CDN et exécuté dans le navigateur.
      `is:inline` empêche Astro de l'inclure dans son bundle.
    -->
    <script is:inline type="module">
      const schemas = document.querySelectorAll('.mermaid');
      if (schemas.length > 0) {
        const { default: mermaid } = await import(
          'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs'
        );
        mermaid.initialize({
          startOnLoad: false,
          theme: 'neutral',
          securityLevel: 'strict',
          flowchart: { curve: 'basis', useMaxWidth: true },
        });
        try {
          await mermaid.run({ nodes: schemas });
        } catch (err) {
          // Un diagramme mal formé ne doit pas casser la page : on le masque.
          console.warn('Diagramme ignoré :', err);
          schemas.forEach((noeud) => {
            if (!noeud.querySelector('svg')) noeud.closest('.schema')?.remove();
          });
        }
      }
    </script>
  </body>
</html>
