---
/**
 * Édition d'un module : sa fiche, ses leviers, ses liens vers les autres
 * modules, ses problèmes et bénéfices, puis ses fonctions une à une.
 *
 * Trois formulaires distincts sur la page, séparés par un champ caché
 * `action`. Chacun renvoie ici en POST puis redirige (motif POST-redirect-GET)
 * pour qu'un rafraîchissement ne rejoue pas l'enregistrement.
 */
import Console from '../../../components/Console.astro';
import { lien } from '../../../lib/lien.mjs';
import ChoixLeviers from '../../../components/ChoixLeviers.astro';
import Pastille from '../../../components/Pastille.astro';
import { LEVIERS, leviersDe } from '../../../lib/leviers.mjs';
import {
  CHAMPS_MODULE,
  ajouterFonction,
  chargerModuleAdmin,
  enregistrerFonction,
  enregistrerModule,
  lireBlocs,
  lireListe,
  lireLiens,
  compteurs,
  slugsModules,
  supprimerFonction,
} from '../../../lib/admin/donnees.mjs';

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
const { slug } = Astro.params;

let erreur = null;

if (Astro.request.method === 'POST') {
  try {
    const f = await Astro.request.formData();
    const action = String(f.get('action') || '');
    let note = '';

    if (action === 'module') {
      const valeurs = Object.fromEntries(CHAMPS_MODULE.map((c) => [c.nom, String(f.get(c.nom) ?? '')]));
      await enregistrerModule(slug, {
        ...valeurs,
        ordre: Number(f.get('ordre')) || 100,
        actif: f.get('actif') === 'on',
        leviers: f.getAll('leviers').map(String),
        liens: lireLiens(f),
        problemes: lireBlocs(f, 'probleme'),
        benefices: lireBlocs(f, 'benefice'),
        stack: lireListe(f.get('stack')),
        mots_cles: lireListe(f.get('mots_cles')),
      });
      note = 'Fiche enregistrée.';
    } else if (action === 'fonction') {
      await enregistrerFonction(f.get('id'), {
        nom: String(f.get('nom') ?? ''),
        description: String(f.get('description') ?? ''),
        benefice: String(f.get('benefice') ?? ''),
        icone: String(f.get('icone') ?? ''),
        ordre: f.get('ordre'),
        leviers: f.getAll('leviers').map(String),
      });
      note = `Fonction « ${f.get('nom')} » enregistrée.`;
    } else if (action === 'ajout-fonction') {
      await ajouterFonction(f.get('module_id'), {
        cle: String(f.get('cle') ?? ''),
        nom: String(f.get('nom') ?? ''),
        description: String(f.get('description') ?? ''),
        benefice: String(f.get('benefice') ?? ''),
        icone: String(f.get('icone') ?? ''),
        ordre: f.get('ordre'),
        leviers: f.getAll('leviers').map(String),
      });
      note = 'Fonction ajoutée.';
    } else if (action === 'suppression-fonction') {
      await supprimerFonction(f.get('id'));
      note = 'Fonction supprimée.';
    }

    return Astro.redirect(`${BASE}/admin/modules/${slug}?ok=${encodeURIComponent(note)}`, 303);
  } catch (err) {
    erreur = err.message;
  }
}

const module = await chargerModuleAdmin(slug);
if (!module) return new Response(`Module « ${slug} » introuvable.`, { status: 404 });

const autres = (await slugsModules()).filter((m) => m.slug !== slug);
const chiffres = await compteurs().catch(() => ({}));
const message = Astro.url.searchParams.get('ok');

// Une ligne vide en fin de liste sert de champ d'ajout, sans JavaScript.
const problemes = [...module.problemes, { titre: '', texte: '' }];
const benefices = [...module.benefices, { titre: '', texte: '' }];
const liens = [...module.liens, { slug: '', sens: 'envoie', quoi: '' }];
---

<Console
  titre={module.nom || module.slug}
  fil={`TFB Admin · Modules · ${module.slug}`}
  actif="modules"
  message={message}
  erreur={erreur}
  compteurs={chiffres}
>
  <a slot="actions" class="bouton bouton--sobre" href={lien(`/modules/${module.slug}`)} target="_blank">
    Voir la page publique
  </a>

  <!-- ── La fiche ─────────────────────────────────────────────────────── -->
  <form method="post">
    <input type="hidden" name="action" value="module" />

    <section class="bloc">
      <div class="bloc__tete">
        <div>
          <h2>Fiche du module</h2>
          <p>
            <span class="jeton">{module.slug}</span> ·
            <span class="jeton">{module.repo}</span>
            {module.genere_le && ' · dernière génération enregistrée en base'}
          </p>
        </div>
      </div>
      <div class="bloc__corps">
        {CHAMPS_MODULE.map((champ) => (
          <div class="champ">
            <label for={champ.nom}>{champ.libelle}</label>
            {champ.type === 'ligne' ? (
              <input id={champ.nom} name={champ.nom} type="text" value={module[champ.nom] || ''} />
            ) : (
              <textarea
                id={champ.nom}
                name={champ.nom}
                rows={champ.lignes || 4}
                class={champ.type === 'code' ? 'code' : undefined}
              >{module[champ.nom] || ''}</textarea>
            )}
            {champ.aide && <span class="champ__aide">{champ.aide}</span>}
          </div>
        ))}

        <div class="duo">
          <div class="champ">
            <label for="ordre">Ordre d'affichage</label>
            <input id="ordre" name="ordre" type="number" min="1" value={module.ordre ?? 100} />
          </div>
          <div class="champ">
            <label for="stack">Technologies</label>
            <input id="stack" name="stack" type="text" value={(module.stack || []).join(', ')} />
            <span class="champ__aide">Séparées par des virgules.</span>
          </div>
          <div class="champ">
            <label for="mots_cles">Mots-clés</label>
            <input id="mots_cles" name="mots_cles" type="text" value={(module.mots_cles || []).join(', ')} />
            <span class="champ__aide">Séparés par des virgules.</span>
          </div>
        </div>

        <div class="champ">
          <span class="legende">Leviers actionnés</span>
          <ChoixLeviers choisis={module.leviers} large={true} />
        </div>

        <div class="champ">
          <label style="display: flex; gap: var(--space-2); align-items: center;">
            <input type="checkbox" name="actif" checked={module.actif} style="width: auto;" />
            Afficher ce module sur le site
          </label>
        </div>
      </div>
    </section>

    <!-- ── Les problèmes du franchiseur ───────────────────────────────── -->
    <section class="bloc" style="margin-top: var(--space-5);">
      <div class="bloc__tete">
        <div>
          <h2>Problèmes traités</h2>
          <p>Ce que vit le franchiseur avant. Vider les deux champs supprime le bloc.</p>
        </div>
      </div>
      <div class="bloc__corps">
        <div class="repet">
          {problemes.map((bloc) => (
            <div class="repet__item">
              <input type="text" name="probleme_titre" value={bloc.titre} placeholder="Titre du problème" />
              <textarea name="probleme_texte" rows="3" placeholder="Ce que ça coûte, concrètement.">{bloc.texte}</textarea>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Les bénéfices ──────────────────────────────────────────────── -->
    <section class="bloc" style="margin-top: var(--space-5);">
      <div class="bloc__tete">
        <div>
          <h2>Bénéfices apportés</h2>
          <p>La réponse du module, dans les mêmes termes que le problème.</p>
        </div>
      </div>
      <div class="bloc__corps">
        <div class="repet">
          {benefices.map((bloc) => (
            <div class="repet__item">
              <input type="text" name="benefice_titre" value={bloc.titre} placeholder="Titre du bénéfice" />
              <textarea name="benefice_texte" rows="3" placeholder="Ce que ça change.">{bloc.texte}</textarea>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Les liens entre modules ────────────────────────────────────── -->
    <section class="bloc" style="margin-top: var(--space-5);">
      <div class="bloc__tete">
        <div>
          <h2>Liens avec les autres modules</h2>
          <p>Ce que ce module envoie et reçoit. C'est la matière du fil d'onboarding.</p>
        </div>
      </div>
      <div class="bloc__corps">
        <div class="repet">
          {liens.map((l) => (
            <div class="repet__item repet__trio">
              <select name="lien_slug">
                <option value="">— aucun —</option>
                {autres.map((m) => (
                  <option value={m.slug} selected={m.slug === l.slug}>{m.nom || m.slug}</option>
                ))}
              </select>
              <select name="lien_sens">
                <option value="envoie" selected={l.sens !== 'recoit'}>envoie</option>
                <option value="recoit" selected={l.sens === 'recoit'}>reçoit</option>
              </select>
              <input type="text" name="lien_quoi" value={l.quoi} placeholder="quoi, exactement" />
            </div>
          ))}
        </div>
      </div>
    </section>

    <div class="actions" style="margin-top: var(--space-5);">
      <button class="bouton bouton--marque" type="submit">Enregistrer la fiche</button>
      <a class="bouton bouton--sobre" href={lien('/admin/modules')}>Retour à la liste</a>
    </div>
  </form>

  <!-- ── Les fonctions ────────────────────────────────────────────────── -->
  <section class="bloc" style="margin-top: var(--space-6);">
    <div class="bloc__tete">
      <div>
        <h2>{module.fonctions.length} fonction(s)</h2>
        <p>Les entrées de menu du module. Chacune s'enregistre séparément.</p>
      </div>
    </div>
    <div class="bloc__corps">
      {module.fonctions.map((fonction) => (
        <details class="fiche">
          <summary>
            <span>{fonction.nom || fonction.cle}</span>
            <span class="actions">
              <span class="pastilles">{leviersDe(fonction.leviers).map((l) => <Pastille levier={l} />)}</span>
              <span class="jeton">{fonction.cle}</span>
            </span>
          </summary>

          <form method="post" class="fiche__corps">
            <input type="hidden" name="action" value="fonction" />
            <input type="hidden" name="id" value={fonction.id} />

            <div class="duo">
              <div class="champ">
                <label>Nom</label>
                <input type="text" name="nom" value={fonction.nom || ''} />
              </div>
              <div class="champ">
                <label>Icône</label>
                <input type="text" name="icone" value={fonction.icone || ''} />
              </div>
              <div class="champ">
                <label>Ordre</label>
                <input type="number" name="ordre" min="1" value={fonction.ordre ?? 100} />
              </div>
            </div>

            <div class="champ">
              <label>À quoi sert cette entrée de menu</label>
              <textarea name="description" rows="3">{fonction.description || ''}</textarea>
            </div>

            <div class="champ">
              <label>Le gain, en une phrase</label>
              <input type="text" name="benefice" value={fonction.benefice || ''} />
            </div>

            <div class="champ">
              <span class="legende">Leviers</span>
              <ChoixLeviers choisis={fonction.leviers} />
            </div>

            <div class="actions">
              <button class="bouton bouton--marque bouton--sm" type="submit">Enregistrer</button>
            </div>
          </form>

          <form method="post" class="fiche__corps" style="padding-top: 0;">
            <input type="hidden" name="action" value="suppression-fonction" />
            <input type="hidden" name="id" value={fonction.id} />
            <button
              class="bouton bouton--danger bouton--sm"
              type="submit"
              onclick="return confirm('Supprimer cette fonction ? Une ingestion du dépôt la recréerait si elle existe toujours dans le code.')"
            >Supprimer</button>
          </form>
        </details>
      ))}

      <!-- Ajout -->
      <details class="fiche">
        <summary><span>+ Ajouter une fonction</span></summary>
        <form method="post" class="fiche__corps">
          <input type="hidden" name="action" value="ajout-fonction" />
          <input type="hidden" name="module_id" value={module.id} />

          <div class="duo">
            <div class="champ">
              <label>Clé technique</label>
              <input type="text" name="cle" required placeholder="checklists" />
              <span class="champ__aide">Minuscules et tirets. Stable : c'est elle qui relie la fonction au code.</span>
            </div>
            <div class="champ">
              <label>Nom</label>
              <input type="text" name="nom" />
            </div>
            <div class="champ">
              <label>Icône</label>
              <input type="text" name="icone" placeholder="layers" />
            </div>
            <div class="champ">
              <label>Ordre</label>
              <input type="number" name="ordre" min="1" value="100" />
            </div>
          </div>

          <div class="champ">
            <label>À quoi sert cette entrée de menu</label>
            <textarea name="description" rows="3"></textarea>
          </div>

          <div class="champ">
            <label>Le gain, en une phrase</label>
            <input type="text" name="benefice" />
          </div>

          <div class="champ">
            <span class="legende">Leviers</span>
            <ChoixLeviers />
          </div>

          <div class="actions">
            <button class="bouton bouton--marque bouton--sm" type="submit">Ajouter</button>
          </div>
        </form>
      </details>
    </div>
  </section>

  <!-- ── Les captures ─────────────────────────────────────────────────── -->
  <section class="bloc">
    <div class="bloc__tete">
      <div>
        <h2>{module.captures.length} capture(s)</h2>
        <p>Publiées par le dépôt dans <span class="jeton">docs/landing/*.png</span>, reprises au déploiement.</p>
      </div>
      <a class="bouton bouton--sobre bouton--sm" href={lien('/admin/captures')}>Les gérer</a>
    </div>
    {module.captures.length > 0 && (
      <table>
        <thead>
          <tr><th>Ordre</th><th>Fichier</th><th>Titre</th><th>Fonction</th></tr>
        </thead>
        <tbody>
          {module.captures.map((c) => (
            <tr>
              <td class="num">{c.ordre}</td>
              <td><span class="jeton">{c.fichier}</span></td>
              <td>{c.titre || '—'}</td>
              <td>{c.fonction_cle ? <span class="jeton">{c.fonction_cle}</span> : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </section>
</Console>
