---
/**
 * Connexion à la console — **un seul champ**.
 *
 * On tape ce qu'on a, et ce qu'on tape dit à la fois qui on est et qu'on a le
 * droit d'entrer :
 *
 *   · **Un code à six chiffres**, propre à un compte. Il identifie *et*
 *     authentifie, c'est ce qui permet un formulaire à un champ sans perdre
 *     l'attribution : une offre porte toujours le nom de qui l'a faite.
 *   · **La clé de secours** (`ADMIN_PASSWORD`), qui ouvre toujours la console
 *     en administrateur. Sans elle, une base vide ou un dernier code perdu
 *     fermeraient la porte à tout le monde, y compris à qui pourrait la rouvrir.
 *
 * SIX CHIFFRES, C'EST UN MILLION DE COMBINAISONS — quelques minutes pour une
 * machine. Ce qui rend ce code utilisable n'est pas sa longueur mais le nombre
 * d'essais accordés : cinq, puis une attente qui double. Voir `verrou.mjs`.
 *
 * En cas d'échec, le message reste laconique et identique dans tous les cas :
 * distinguer « code inconnu » de « code du mauvais compte » reviendrait à
 * répondre aux questions de qui essaie.
 */
import '../../design-system/styles.css';
import { lien } from '../../lib/lien.mjs';
import {
  NOM_COOKIE,
  creerJeton,
  jetonValide,
  motDePasseValide,
  optionsCookie,
} from '../../lib/admin/session.mjs';
import { utilisateurParCode } from '../../lib/admin/donnees.mjs';
import { noterEchec, noterReussite, origine, peutEssayer } from '../../lib/admin/verrou.mjs';

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');

/** Le retour n'est accepté que s'il désigne une page de la console. */
function destination(brut) {
  const chemin = typeof brut === 'string' ? brut : '';
  return chemin.startsWith('/admin') && !chemin.startsWith('//') ? chemin : '/admin';
}

let erreur = null;
const retourDemande = destination(Astro.url.searchParams.get('retour'));

// Déjà connecté : inutile de redemander.
if (Astro.request.method === 'GET' && jetonValide(Astro.cookies.get(NOM_COOKIE)?.value)) {
  return Astro.redirect(`${BASE}${retourDemande}`, 302);
}

let attente = 0;

if (Astro.request.method === 'POST') {
  const formulaire = await Astro.request.formData();
  const secret = String(formulaire.get('code') || '').trim();
  const qui = origine(Astro.request, Astro.clientAddress);
  const porte = peutEssayer(qui);

  if (!porte.permis) {
    // On refuse avant de vérifier quoi que ce soit : vérifier d'abord
    // laisserait le temps de réponse dire si le code était bon.
    attente = porte.attendreS;
    erreur = `Trop d’essais. Réessayez dans ${attente} seconde(s).`;
  } else {
    let session = null;

    // La clé de secours d'abord : elle doit fonctionner même quand la base ne
    // répond pas, et c'est exactement le cas pour lequel elle existe.
    if (motDePasseValide(secret)) {
      session = { id: 0, role: 'admin' };
    } else {
      try {
        const compte = await utilisateurParCode(secret);
        if (compte) session = { id: compte.id, role: compte.role };
      } catch (err) {
        console.error(`[connexion] comptes illisibles : ${err.message}`);
      }
    }

    if (session) {
      noterReussite(qui);
      Astro.cookies.set(NOM_COOKIE, creerJeton(session), optionsCookie(Astro.request, Astro.url));
      return Astro.redirect(`${BASE}${destination(formulaire.get('retour'))}`, 302);
    }

    noterEchec(qui);
    const apres = peutEssayer(qui);
    erreur = apres.permis
      ? `Code refusé. ${apres.restants} essai(s) avant blocage.`
      : `Code refusé. Trop d’essais : attendez ${apres.attendreS} seconde(s).`;
  }
}
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Console TFB — connexion</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href={lien('/brand/logo-mark.png')} />

    <style is:global>
      /* Six chiffres se relisent d'un coup d'œil quand ils sont espacés : on
         repère une faute de frappe sans recompter. */
      .porte__code {
        text-align: center; letter-spacing: .5em; text-indent: .5em;
        font-family: var(--font-mono); font-size: 20px;
      }
      body {
        min-height: 100vh;
        display: grid; place-items: center;
        padding: var(--space-6);
        background:
          radial-gradient(60rem 30rem at 20% -10%, rgba(123, 68, 136, 0.35), transparent 60%),
          radial-gradient(50rem 26rem at 90% 10%, rgba(21, 158, 150, 0.22), transparent 55%),
          var(--navy-900);
      }
      .porte {
        width: min(100%, 25rem);
        background: var(--surface-card);
        border-radius: var(--radius-panel);
        box-shadow: var(--shadow-xl);
        padding: var(--space-8);
        display: grid; gap: var(--space-5);
      }
      .porte__marque { display: flex; align-items: center; gap: var(--space-3); }
      .porte__marque img { width: 36px; height: 36px; }
      .porte__marque b { font-family: var(--font-display); letter-spacing: var(--tracking-tight); }
      .porte__marque span { display: block; font: var(--type-caption); color: var(--text-tertiary); }
      .porte label { font: var(--type-label); color: var(--text-secondary); display: block; margin-bottom: var(--space-1); }
      .porte input {
        width: 100%; padding: var(--space-3);
        border: 1px solid var(--border-default); border-radius: var(--radius-control);
        font: var(--type-body);
      }
      @media (max-width: 820px) { .porte input { font-size: 16px; } }
      .porte input:focus-visible { outline: none; border-color: var(--border-brand); box-shadow: var(--shadow-focus); }
      .porte button {
        width: 100%; height: 42px;
        border: 0; border-radius: var(--radius-control);
        background: var(--brand); color: var(--brand-on);
        font: var(--type-title); cursor: pointer;
        transition: var(--transition-control);
      }
      .porte button:hover { background: var(--brand-hover); }
      .porte__erreur {
        font: var(--type-body-sm); color: var(--text-danger);
        background: var(--surface-danger-subtle);
        padding: var(--space-2) var(--space-3); border-radius: var(--radius-control);
      }
      .porte__note { font: var(--type-caption); color: var(--text-tertiary); }
    </style>
  </head>

  <body>
    <form class="porte" method="post">
      <div class="porte__marque">
        <img src={lien('/brand/logo-mark.png')} alt="" width="36" height="36" />
        <div>
          <b>Console TFB</b>
          <span>Contenu de la landing</span>
        </div>
      </div>

      {erreur && <p class="porte__erreur">{erreur}</p>}

      <div>
        <label for="code">Code</label>
        <input
          id="code"
          name="code"
          type="password"
          class="porte__code"
          inputmode="numeric"
          autocomplete="one-time-code"
          autocapitalize="none"
          autocorrect="off"
          spellcheck="false"
          required
          autofocus
          disabled={attente > 0}
        />
      </div>

      <input type="hidden" name="retour" value={retourDemande} />
      <button type="submit" disabled={attente > 0}>Entrer</button>

      <p class="porte__note">
        Accès réservé. Cette page n'est pas indexée.<br />
        Six chiffres. Cinq essais, puis une attente qui double à chaque échec.
      </p>
    </form>
  </body>
</html>
