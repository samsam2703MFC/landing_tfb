# nginx reverse proxy for the TFB landing + back office.
#
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/tfb-landing
#   sudo ln -s /etc/nginx/sites-available/tfb-landing /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Then get a real certificate:
#   sudo certbot --nginx -d franchisebuddy.eu -d www.franchisebuddy.eu
#
# A certificate cannot be issued for a bare IP address, which is why the current
# https://185.180.206.46/ shows a name mismatch. Point a domain at the server
# first — the landing needs a valid certificate for SEO and for the AA target.

server {
    listen 80;
    listen [::]:80;
    server_name franchisebuddy.eu www.franchisebuddy.eu;

    # certbot replaces this block with a redirect to 443 once it runs.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
    }

    # Module screenshots and brand logos, served out of STORAGE_PATH by the app.
    # 4 Mo is the upload ceiling the API enforces; nginx must not cut it off first.
    location /api/admin/upload {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 5m;
    }

    location ~ ^/api/admin/modules/[0-9]+/screenshots$ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Several screenshots can be uploaded in one request.
        client_max_body_size 25m;
    }

    # Next's build assets are immutable and content-hashed.
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_cache_valid 200 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # The Stripe webhook needs the raw body — no buffering games.
    location /api/stripe/webhook {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host            $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_request_buffering off;
    }

    # The back office is not for crawlers. The app also sends
    # `robots: noindex` on /admin, this is the belt to that braces.
    location /admin {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    # phpMyAdmin should not be reachable from the open internet. If you keep it
    # on this host, restrict it — replace with your own address.
    # location /phpmyadmin {
    #     allow 203.0.113.4;
    #     deny all;
    #     ...
    # }

    access_log /var/log/nginx/tfb-landing.access.log;
    error_log  /var/log/nginx/tfb-landing.error.log;
}
