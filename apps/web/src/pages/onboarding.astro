---
/**
 * Onboarding, d'après la maquette Claude Design.
 *
 * Le franchiseur ne choisit pas des modules : il coche ce qui lui ressemble,
 * et son système s'assemble en dessous. C'est la même idée que la page
 * d'accueil — ses problèmes d'abord — poussée jusqu'à la composition.
 *
 * Sans JavaScript la page reste entière : les cases restent cochables, et le
 * mécanisme d'affichage repose sur `:has()`, donc sur le navigateur seul. Là
 * où `:has()` manque, tous les modules sont montrés — mieux vaut tout voir
 * que rien.
 */
import Layout from '../components/Layout.astro';
import Icone from '../components/Icone.astro';
import Pastille from '../components/Pastille.astro';
import { chargerParcours, chargerQuestions } from '../lib/db.mjs';
import { textes } from '../lib/textes.mjs';
import { leviersDe } from '../lib/leviers.mjs';
import { lien } from '../lib/lien.mjs';

const langue = Astro.locals.langue || 'fr';
const [t, modules, questions] = await Promise.all([
  textes(langue),
  chargerParcours(langue),
  chargerQuestions(langue),
]);

/** Pour chaque module, les clés de question qui le déclenchent. */
const declencheurs = new Map(modules.map((m) => [m.slug, []]));
for (const q of questions) {
  for (const s of q.slugs || []) {
    if (declencheurs.has(s)) declencheurs.get(s).push(q.cle);
  }
}

/**
 * La règle CSS qui montre un module dès qu'une de ses questions est cochée.
 * On la construit ici plutôt que dans la feuille de style : elle dépend
 * entièrement du contenu de la base.
 */
const reveleurs = modules
  .filter((m) => declencheurs.get(m.slug).length > 0)
  .map((m) => {
    const conditions = declencheurs.get(m.slug).map((cle) => `#q-${cle}:checked`).join(', ');
    return `body:has(:is(${conditions})) [data-module='${m.slug}'] { display: grid; }`;
  })
  .join('\n');

/** Les captures d'un module, rangées par clé de fonction. */
function capturesDe(module) {
  const parCle = new Map();
  for (const c of module.captures || []) {
    if (c.fonction_cle) parCle.set(c.fonction_cle, c);
  }
  return parCle;
}
---

<Layout
  titre={t('onboarding.meta_titre')}
  description={t('onboarding.meta_description')}
  actif="onboarding"
  fond="var(--slate-50)"
>
  <!-- ── L'accroche ──────────────────────────────────────────────────── -->
  <section class="bande bande--sombre" style="padding:64px 40px 56px">
    <div class="dedans" style="max-width:880px;display:flex;flex-direction:column;gap:16px">
      <span class="oeil oeil--clair">{t('onboarding.oeil')}</span>
      <h1 class="h-grand" style="color:#fff">{t('onboarding.titre')}</h1>
      <p class="chapo chapo--clair" style="max-width:58ch">{t('onboarding.chapo')}</p>
    </div>
  </section>

  <!-- ── Le questionnaire ────────────────────────────────────────────── -->
  <section class="bande bande--serree" style="padding-block:48px 24px">
    <div class="dedans etroit">
      <div class="questions">
        {questions.map((q) => (
          <div class="question">
            <input type="checkbox" id={`q-${q.cle}`} class="question__case" />
            <label for={`q-${q.cle}`} class="question__cadre">
              <span class="question__coche"><Icone nom="check" taille={14} /></span>
              <span class="question__texte">
                <span class={`question__tag question__tag--${q.tag === 'Besoin' ? 'besoin' : 'probleme'}`}>{q.tag}</span>
                <span class="question__phrase">{q.texte}</span>
                <span class="question__cible fb-num">→ {q.cible}</span>
              </span>
            </label>
          </div>
        ))}
      </div>

      <div class="questions__actions">
        <a class="bouton bouton--marque" href="#systeme">
          {t('onboarding.cta')}
          <Icone nom="arrow-right" taille={14} classe="icone--miroir" />
        </a>
        <span class="questions__note">{t('onboarding.note')}</span>
      </div>
    </div>
  </section>

  <!-- ── Le système assemblé ─────────────────────────────────────────── -->
  <section class="bande" id="systeme" style="padding-block:40px 96px">
    <div class="dedans etroit">
      <div class="systeme__tete">
        <span class="oeil">{t('onboarding.systeme.oeil')}</span>
        <span class="fb-num systeme__compte">{t('onboarding.systeme.compte', { n: modules.length })}</span>
      </div>

      <p class="systeme__vide">{t('onboarding.systeme.vide')}</p>

      <div class="fil">
        {modules.map((m, i) => {
          const captures = capturesDe(m);
          return (
            <div class="fil__ligne" data-module={m.slug}>
              <div class="fil__rail">
                <span class="fil__noeud"><Icone nom={m.icone || 'layers'} taille={20} /></span>
                {i < modules.length - 1 && <span class="fil__trait"></span>}
              </div>

              <details class="fil__module">
                <summary class="fil__tete">
                  <span class="fb-num fil__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="fil__intitule">
                    <span class="fil__nom">
                      {m.nom || m.slug}
                      <span class="fil__groupe">{m.groupe}</span>
                    </span>
                    <span class="texte">{m.accroche}</span>
                  </span>
                  <span class="fil__droite">
                    <span class="pastilles">{leviersDe(m.leviers).map((l) => <Pastille levier={l} />)}</span>
                    <span class="fb-num fil__nb">{t('onboarding.systeme.composants', { n: (m.fonctions || []).length })}</span>
                    <Icone nom="chevron-down" taille={16} classe="fil__chevron" />
                  </span>
                </summary>

                <div class="fil__corps">
                  {m.onboarding && <p class="fil__phrase">{m.onboarding}</p>}

                  {(m.fonctions || []).map((f) => {
                    const capture = captures.get(f.cle);
                    return (
                      <div class="composant">
                        <div class="composant__vue">
                          {capture ? (
                            <img
                              src={lien(`/captures/${capture.fichier}`)}
                              alt={capture.titre || f.nom}
                              loading="lazy"
                              decoding="async"
                            />
                          ) : (
                            <span class="composant__sans">
                              <Icone nom="image" taille={14} />
                              <code>{t('onboarding.systeme.sans_capture')}</code>
                            </span>
                          )}
                        </div>
                        <div class="composant__texte">
                          <span class="composant__nom">
                            {f.nom || f.cle}
                            <span class="pastilles">{leviersDe(f.leviers).map((l) => <Pastille levier={l} />)}</span>
                          </span>
                          <p class="texte">{f.description}</p>
                          {f.benefice && <p class="composant__gain">{f.benefice}</p>}
                        </div>
                      </div>
                    );
                  })}

                  <a class="fil__fiche" href={lien(`/modules/${m.slug}`)}>{t('onboarding.systeme.fiche')}</a>
                </div>
              </details>
            </div>
          );
        })}
      </div>

      <div class="systeme__appel">
        <span>{t('onboarding.appel')}</span>
        <a class="bouton bouton--chaud" href={lien('/#contact')}>
          {t('nav.demo')}
          <Icone nom="arrow-right" taille={14} classe="icone--miroir" />
        </a>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .etroit { max-width: 880px; }

  /* ── Questionnaire ─────────────────────────────────────────────────── */
  .questions { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 10px; }
  .question__case { position: absolute; opacity: 0; inline-size: 1px; block-size: 1px; }
  .question__cadre {
    display: flex; gap: 12px; align-items: flex-start;
    background: #fff; border: 1px solid var(--slate-200);
    border-radius: var(--radius-card); padding: 14px 16px;
    cursor: pointer; block-size: 100%;
    box-shadow: var(--shadow-xs);
    transition: var(--transition-control);
  }
  .question__cadre:hover { border-color: var(--slate-300); }
  .question__coche {
    display: inline-flex; align-items: center; justify-content: center;
    inline-size: 22px; block-size: 22px; border-radius: var(--radius-sm);
    flex: none; margin-block-start: 2px;
    border: 1px solid var(--slate-300); background: #fff; color: transparent;
    transition: var(--transition-control);
  }
  .question__case:checked + .question__cadre { background: var(--plum-50); border-color: var(--plum-400); }
  .question__case:checked + .question__cadre .question__coche {
    background: var(--plum-500); border-color: var(--plum-500); color: #fff;
  }
  .question__case:focus-visible + .question__cadre { box-shadow: var(--shadow-focus); }
  .question__texte { display: flex; flex-direction: column; gap: 4px; min-inline-size: 0; }
  .question__tag {
    font: 600 10px/1.2 var(--font-sans); letter-spacing: var(--tracking-caps); text-transform: uppercase;
  }
  .question__tag--probleme { color: var(--red-500); }
  .question__tag--besoin { color: var(--teal-700); }
  .question__phrase { font: 500 14.5px/1.45 var(--font-sans); }
  .question__cible { font: 400 11.5px/1.4 var(--font-mono); color: var(--slate-400); }

  .questions__actions { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-block-start: 20px; }
  .questions__note { font: 400 var(--text-xs) / 1.4 var(--font-sans); color: var(--slate-500); }

  /* ── Le système ────────────────────────────────────────────────────── */
  .systeme__tete {
    display: flex; align-items: baseline; gap: 12px;
    border-block-start: 1px solid var(--slate-200); padding-block-start: 32px; margin-block-end: 16px;
  }
  .systeme__compte { font: 500 var(--text-xs) / 1 var(--font-mono); color: var(--slate-400); }
  .systeme__vide {
    display: none;
    border: 1px dashed var(--slate-300); border-radius: var(--radius-card);
    padding: 28px; text-align: center; margin: 0 0 16px;
    font: 400 14px/1.6 var(--font-sans); color: var(--slate-500);
  }

  .fil { display: flex; flex-direction: column; }
  .fil__ligne { display: grid; grid-template-columns: 56px 1fr; column-gap: 20px; }
  .fil__rail { display: flex; flex-direction: column; align-items: center; }
  .fil__noeud {
    display: inline-flex; align-items: center; justify-content: center;
    inline-size: 44px; block-size: 44px; border-radius: var(--radius-lg);
    border: 1px solid var(--slate-200); background: #fff; color: var(--plum-600);
    flex: none; box-shadow: var(--shadow-xs);
  }
  .fil__trait { inline-size: 2px; flex: 1; background: var(--slate-200); min-block-size: 20px; }

  .fil__module { padding-block-end: 20px; min-inline-size: 0; }
  .fil__tete {
    display: flex; align-items: center; gap: 14px;
    background: #fff; border: 1px solid var(--slate-200);
    border-radius: var(--radius-card); padding: 14px 18px;
    cursor: pointer; list-style: none;
    box-shadow: var(--shadow-xs);
    transition: var(--transition-control);
  }
  .fil__tete::-webkit-details-marker { display: none; }
  .fil__tete::marker { content: ''; }
  .fil__tete:hover { background: var(--slate-25); }
  .fil__module[open] .fil__tete { border-radius: var(--radius-card) var(--radius-card) 0 0; border-color: var(--slate-300); }
  .fil__num { font: 500 var(--text-xs) / 1 var(--font-mono); color: var(--slate-400); flex: none; }
  .fil__intitule { display: flex; flex-direction: column; gap: 3px; min-inline-size: 0; }
  .fil__nom {
    display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap;
    font: 600 17px/1.2 var(--font-display); letter-spacing: var(--tracking-tight);
  }
  .fil__groupe {
    font: 600 10px/1.2 var(--font-sans); letter-spacing: var(--tracking-caps);
    text-transform: uppercase; color: var(--slate-400);
  }
  .fil__droite { margin-inline-start: auto; display: flex; align-items: center; gap: 12px; flex: none; }
  .fil__nb { font: 400 var(--text-xs) / 1 var(--font-mono); color: var(--slate-400); white-space: nowrap; }
  .fil__module .fil__chevron { color: var(--slate-400); transition: transform var(--duration-slow) var(--ease-standard); }
  .fil__module[open] .fil__chevron { transform: rotate(180deg); }

  .fil__corps {
    background: #fff; border: 1px solid var(--slate-300); border-block-start: 0;
    border-radius: 0 0 var(--radius-card) var(--radius-card);
    padding: 6px 22px 16px;
    box-shadow: var(--shadow-xs);
  }
  .fil__phrase {
    border-inline-start: 3px solid var(--teal-500);
    padding-inline-start: 14px; margin: 12px 0 4px;
    font: 400 14px/1.6 var(--font-sans); color: var(--slate-700);
  }
  .fil__fiche { display: inline-block; margin-block-start: 12px; font: 500 13px/1.3 var(--font-sans); }

  .composant {
    display: flex; gap: 16px; align-items: flex-start;
    padding-block: 14px; border-block-end: 1px solid var(--slate-100);
  }
  .composant:last-of-type { border-block-end: 0; }
  .composant__vue {
    flex: none; inline-size: 150px;
    border: 1px solid var(--slate-200); border-radius: var(--radius-md);
    overflow: hidden; background: #fff;
  }
  .composant__vue img { display: block; inline-size: 100%; block-size: auto; }
  .composant__sans {
    aspect-ratio: 16 / 10; background: var(--slate-50);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px;
    color: var(--slate-400);
  }
  .composant__sans code { font: 400 8.5px/1.3 var(--font-mono); }
  .composant__texte { display: flex; flex-direction: column; gap: 4px; min-inline-size: 0; }
  .composant__nom {
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    font: 600 14.5px/1.3 var(--font-sans);
  }
  .composant__gain { margin: 0; font: 500 12.5px/1.5 var(--font-sans); color: var(--teal-700); }

  .systeme__appel {
    display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
    background: var(--gradient-plum-navy); border-radius: var(--radius-panel);
    padding: 24px 28px; color: #fff; margin-block-start: 16px;
  }
  .systeme__appel > span {
    font: 600 17px/1.4 var(--font-display); letter-spacing: var(--tracking-tight);
    flex: 1; min-inline-size: 240px;
  }

  @media (max-width: 700px) {
    .fil__ligne { grid-template-columns: 36px 1fr; column-gap: 12px; }
    .fil__noeud { inline-size: 34px; block-size: 34px; }
    .fil__droite { display: none; }
    .composant { flex-direction: column; }
    .composant__vue { inline-size: 100%; }
  }
</style>

<!-- Le filtrage vit dans le navigateur, sans script : `:has()` suffit.
     Là où il manque, la règle entière est ignorée et tout reste visible. -->
<style is:inline set:html={`
@supports selector(:has(*)) {
  [data-module] { display: none; }
  ${reveleurs}
  .systeme__vide { display: block; }
  body:has(.question__case:checked) .systeme__vide { display: none; }
}
`}></style>
