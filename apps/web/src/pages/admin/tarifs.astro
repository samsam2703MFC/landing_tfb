---
/**
 * La grille tarifaire, modifiable sans redéploiement.
 *
 * Rien de ce qui chiffre une offre n'est écrit dans le code : le prix par
 * vue, le multiplicateur d'achat, la maintenance annuelle, le prix de la
 * journée de formation et la TVA par défaut vivent tous ici.
 *
 * Une modification ne touche que les offres **à venir**. Chaque offre garde
 * une copie des tarifs du jour où elle a été créée — sans quoi une
 * proposition partie chez un client changerait de montant dans son dos.
 */
import Console from '../../components/Console.astro';
import { compteurs, enregistrerTarifs, listerTarifs, tarifsEnVigueur } from '../../lib/admin/donnees.mjs';
import { afficherTarif } from '../../lib/offres/montants.mjs';
import { calculerOffre, formater } from '../../lib/offres/calcul.mjs';

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
let erreur = null;

if (Astro.request.method === 'POST') {
  try {
    const n = await enregistrerTarifs(await Astro.request.formData());
    const dit = n === 0 ? 'Aucun changement.' : `${n} tarif(s) enregistré(s).`;
    return Astro.redirect(`${BASE}/admin/tarifs?ok=${encodeURIComponent(dit)}`, 303);
  } catch (err) {
    erreur = err.message;
  }
}

let tarifs = [];
let vigueur = null;
let chiffres = {};
try {
  tarifs = await listerTarifs();
  vigueur = await tarifsEnVigueur();
  chiffres = await compteurs();
} catch (err) {
  erreur = erreur || `Base injoignable : ${err.message}`;
}

/** L'unité de saisie, dite au commercial plutôt que devinée. */
const UNITE = { cents: '€', points: '%', entier: '', texte: '' };

/**
 * Un exemple chiffré avec les tarifs du moment. Une grille tarifaire ne se
 * relit pas : cinq vues et deux jours de formation donnent tout de suite les
 * trois montants que le client verra, et un multiplicateur mal tapé saute
 * aux yeux avant d'atterrir sur une offre.
 */
const exemple = vigueur
  ? {
      location: calculerOffre({
        option_app: 'par_vue',
        vues: [{ nombre: 5 }],
        jours_formation: 2,
        tarifs: vigueur,
        tva: { taux: vigueur.tva_defaut, exoneree: false },
      }),
      achat: calculerOffre({
        option_app: 'achat',
        vues: [{ nombre: 5 }],
        jours_formation: 2,
        tarifs: vigueur,
        tva: { taux: vigueur.tva_defaut, exoneree: false },
      }),
    }
  : null;

const message = Astro.url.searchParams.get('ok');
// Le contrat a sa propre section : ses réglages ne chiffrent rien, et les
// mêler à la grille ferait chercher le préavis de résiliation entre le prix
// par vue et le taux de TVA.
const DU_CONTRAT = new Set([
  'contrat_auto', 'contrat_duree_mois', 'contrat_preavis_jours',
  'contrat_reconduction', 'contrat_gabarit', 'cgv',
]);
const contrat = tarifs.filter((t) => DU_CONTRAT.has(t.cle));
// Le guide d'appel non plus ne chiffre rien : il vit ici parce que tout ce qui
// se règle sans redéploiement vit ici, mais dans sa propre section.
const guide = tarifs.find((t) => t.cle === 'guide_appel') || null;
const aPart = new Set([...DU_CONTRAT, 'guide_appel']);
const chiffres_ = tarifs.filter((t) => t.type !== 'texte' && t.type !== 'booleen' && !aPart.has(t.cle));
const textes = tarifs.filter((t) => t.type === 'texte' && !aPart.has(t.cle));
---

<Console
  titre="Tarifs"
  fil="TFB Admin · Commercial · Tarifs"
  actif="tarifs"
  message={message}
  erreur={erreur}
  compteurs={chiffres}
>
  <form method="post">
    <div class="barre-actions">
      <button class="bouton bouton--marque" type="submit">Enregistrer</button>
      <span class="barre-actions__note">Ne change que les offres créées ensuite.</span>
    </div>

    <section class="bloc" style="margin-block-end:20px">
      <div class="bloc__tete">
        <div>
          <h2>La grille</h2>
          <p>
            <span class="jeton">landing_tarifs</span> — une modification ne s'applique qu'aux offres
            créées ensuite. Celles déjà faites gardent les tarifs de leur date.
          </p>
        </div>
      </div>

      <div class="roule">
        <table>
          <thead>
            <tr><th style="inline-size:18rem">Paramètre</th><th style="inline-size:9rem">Valeur</th><th>À quoi ça sert</th></tr>
          </thead>
          <tbody>
            {chiffres_.map((t) => (
              <tr>
                <td><strong>{t.libelle || t.cle}</strong><code class="slug">{t.cle}</code></td>
                <td>
                  <input type="hidden" name="cle" value={t.cle} />
                  <span class="tarif__saisie">
                    <input
                      type="text"
                      name="valeur"
                      value={afficherTarif(t)}
                      inputmode="decimal"
                      aria-label={t.libelle || t.cle}
                    />
                    {UNITE[t.type] && <span class="tarif__unite">{UNITE[t.type]}</span>}
                  </span>
                </td>
                <td class="champ__aide">{t.aide}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {exemple && (
      <section class="bloc" style="margin-block-end:20px">
        <div class="bloc__tete">
          <div>
            <h2>Ce que ça donne</h2>
            <p>Cinq vues et deux jours de formation, aux tarifs enregistrés. Recalculé à chaque enregistrement.</p>
          </div>
        </div>

        <div class="roule">
          <table>
            <thead>
              <tr><th>Formule</th><th class="nombre">Une fois</th><th class="nombre">Par mois</th><th class="nombre">Par an</th></tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Location à la vue</strong><code class="slug">option A</code></td>
                <td class="nombre fb-num">{formater(exemple.location.seaux.unique.ttc)}</td>
                <td class="nombre fb-num"><strong>{formater(exemple.location.seaux.mensuel.ttc)}</strong></td>
                <td class="nombre fb-num">{formater(exemple.location.seaux.annuel.ttc)}</td>
              </tr>
              <tr>
                <td><strong>Achat ferme</strong><code class="slug">option B</code></td>
                <td class="nombre fb-num"><strong>{formater(exemple.achat.seaux.unique.ttc)}</strong></td>
                <td class="nombre fb-num">{formater(exemple.achat.seaux.mensuel.ttc)}</td>
                <td class="nombre fb-num"><strong>{formater(exemple.achat.seaux.annuel.ttc)}</strong></td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="bloc__pied">
          Montants TTC, TVA à {(vigueur.tva_defaut / 100)} %. L'achat vaut
          {' '}{vigueur.multiplicateur_achat} mois de location — modifier le multiplicateur
          change le rapport entre les deux colonnes.
        </div>
      </section>
    )}

    {guide && (
      <section class="bloc" style="margin-block-end:20px">
        <div class="bloc__tete">
          <div>
            <h2>L'appel de découverte</h2>
            <p>
              Rappelé derrière le (i) de <a href={`${BASE}/admin/leads`}>l'écran Demandes</a>, au
              moment de décrocher. À réécrire au fil de ce qui marche : c'est la mémoire de
              l'équipe, pas un script à lire mot à mot.
            </p>
          </div>
        </div>
        <div class="champ">
          <label for="g-appel"><strong>{guide.libelle || guide.cle}</strong></label>
          <input type="hidden" name="cle" value={guide.cle} />
          <textarea id="g-appel" name="valeur" rows="20">{afficherTarif(guide)}</textarea>
        </div>
      </section>
    )}

    <section class="bloc" style="margin-block-end:20px">
      <div class="bloc__tete">
        <div>
          <h2>Le contrat</h2>
          <p>
            Ce qui se passe quand une offre est acceptée. Les conditions — durée, préavis,
            reconduction — sont <strong>recopiées sur le contrat</strong> au moment de son
            édition : les changer ici ne touche pas un contrat déjà signé.
          </p>
          {/* Ces champs ne commandent plus rien tant qu'un gabarit existe. Les
              laisser sans le dire ferait modifier une durée ici pendant qu'un
              contrat part avec une autre — et personne ne verrait pourquoi. */}
          <p class="champ__aide">
            <strong>Ces réglages ne servent plus que de repli.</strong> Chaque gabarit porte
            désormais son propre texte et ses propres conditions, dans
            <a href={`${BASE}/admin/gabarits`}> la bibliothèque de gabarits</a> —
            un pilote de trois mois et un contrat-cadre n'ont ni la même durée ni les mêmes
            clauses. Ce qui est saisi ici ne s'applique que si la bibliothèque est vide.
          </p>
        </div>
      </div>

      {contrat.filter((t) => t.type === 'booleen').map((t) => (
        <div class="champ">
          {/* Déclarée ici pour que l'enregistrement sache qu'elle existe :
              une case décochée n'envoie rien d'autre. */}
          <input type="hidden" name="cases" value={t.cle} />
          <label class="case case--seule">
            <input type="checkbox" name="case" value={t.cle} checked={String(t.valeur) === '1'} />
            <span>
              <strong>{t.libelle || t.cle}</strong>
              <span class="champ__aide">{t.aide}</span>
            </span>
          </label>
        </div>
      ))}

      <div class="duo" style="margin-block-start:16px">
        {contrat.filter((t) => t.type === 'entier').map((t) => (
          <div class="champ champ--nombre">
            <label for={`c-${t.cle}`}>{t.libelle || t.cle}</label>
            <input type="hidden" name="cle" value={t.cle} />
            <span class="tarif__saisie">
              <input id={`c-${t.cle}`} type="text" name="valeur" value={afficherTarif(t)} inputmode="numeric" />
            </span>
          </div>
        ))}
      </div>

      {contrat.filter((t) => t.type === 'texte').map((t) => (
        <div class="champ" style="margin-block-start:16px">
          <label for={`c-${t.cle}`}>
            <strong>{t.libelle || t.cle}</strong>
            {t.aide && <span class="champ__aide">{t.aide}</span>}
          </label>
          <input type="hidden" name="cle" value={t.cle} />
          <textarea id={`c-${t.cle}`} name="valeur" rows={String(t.valeur || '').length > 200 ? 18 : 4}>{afficherTarif(t)}</textarea>
        </div>
      ))}

      <div class="bloc__pied">
        La signature électronique se branche par variables d'environnement
        (<span class="jeton">DOCUSIGN_BASE_URI</span>, <span class="jeton">DOCUSIGN_ACCOUNT_ID</span>,
        <span class="jeton">DOCUSIGN_JETON</span>). Sans elles, un contrat s'édite et s'imprime,
        mais rien ne part en signature — et la console le dit plutôt que de le laisser croire.
      </div>
    </section>

    <section class="bloc">
      <div class="bloc__tete">
        <div>
          <h2>Mentions et courriel</h2>
          <p>Les textes imprimés sur l'offre et envoyés au client. Les jetons entre accolades sont remplacés à l'envoi.</p>
        </div>
      </div>

      {textes.map((t) => (
        <div class="champ" style="margin-block-end:14px">
          <label for={`t-${t.cle}`}>
            <strong>{t.libelle || t.cle}</strong>
            <span class="champ__aide">{t.aide}</span>
          </label>
          <input type="hidden" name="cle" value={t.cle} />
          <textarea id={`t-${t.cle}`} name="valeur" rows={String(t.valeur || '').length > 120 ? 10 : 2}>{afficherTarif(t)}</textarea>
        </div>
      ))}
    </section>

    <div class="actions">
      <button class="bouton bouton--marque" type="submit">Enregistrer</button>
    </div>
  </form>
</Console>

