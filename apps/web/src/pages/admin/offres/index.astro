---
/**
 * La liste des offres.
 *
 * Une ligne par référence, à sa dernière version : les précédentes se lisent
 * depuis la fiche. Afficher toutes les versions ferait apparaître trois fois
 * le même client pour une seule négociation.
 *
 * Les filtres passent par l'URL, sans JavaScript — un filtre se copie, se
 * met en favori et survit à un rechargement.
 */
import Console from '../../../components/Console.astro';
import Icone from '../../../components/Icone.astro';
import {
  changerEtapeOffre,
  listerEtapes,
  calculerTotauxOffre,
  compteurs,
  listerOffres,
  listerUtilisateurs,
} from '../../../lib/admin/donnees.mjs';
import { formater } from '../../../lib/offres/calcul.mjs';
import { aRelancer, prochaineRelance } from '../../../lib/offres/relances.mjs';

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
let erreur = null;

// Une offre se déplace ici, et non sur la fiche : c'est la liste qu'on ouvre
// le matin pour savoir où en est le portefeuille, et c'est là qu'on note ce
// qui a bougé — pas en rouvrant huit fiches l'une après l'autre.
//
// Et d'un seul geste : l'étape commande, l'état suit. Il y avait deux listes
// déroulantes par ligne, qui disaient la même chose et qu'il fallait tenir
// d'accord à la main.
if (Astro.request.method === 'POST') {
  try {
    const f = await Astro.request.formData();
    const qui = (Astro.locals.session || {}).id || null;
    await changerEtapeOffre(f.get('id'), String(f.get('etape') || ''), qui);
    return Astro.redirect(
      `${BASE}/admin/offres${Astro.url.search}${Astro.url.search ? '&' : '?'}ok=${encodeURIComponent('Offre déplacée.')}`,
      303,
    );
  } catch (err) {
    erreur = err.message;
  }
}

/**
 * La vue par défaut est « actives », et non « toutes ».
 *
 * Ouvrir cet écran, c'est demander où en est le portefeuille — pas relire
 * l'historique. Une offre refusée il y a huit mois n'a rien à y faire : elle
 * allonge la liste, décale ce qu'on cherche sous la ligne de flottaison, et
 * gonfle le compte affiché en haut. À trois cents offres, la liste complète
 * répond à une question que personne ne pose.
 *
 * Est **active** une offre qu'on peut encore gagner ou perdre : un brouillon
 * ou une offre envoyée. Gagnée, refusée, expirée — c'est fini, dans les trois
 * cas, et les trois restent à un clic.
 *
 * `vue=toutes` reste dans l'URL, donc partageable et mettable en favori.
 */
const VUES = {
  actives: { mot: 'Actives', garde: (o) => o.statut === 'brouillon' || o.statut === 'envoyee' },
  gagnees: { mot: 'Gagnées', garde: (o) => o.statut === 'acceptee' },
  closes: { mot: 'Sans suite', garde: (o) => o.statut === 'refusee' || o.statut === 'expiree' },
  toutes: { mot: 'Toutes', garde: () => true },
};
const VUE_DEFAUT = 'actives';
const vueDemandee = Astro.url.searchParams.get('vue') || VUE_DEFAUT;
const vue = VUES[vueDemandee] ? vueDemandee : VUE_DEFAUT;

const filtres = {
  prospect: Astro.url.searchParams.get('client') || '',
  etape: Astro.url.searchParams.get('etape') || '',
  auteur: Astro.url.searchParams.get('auteur') || '',
};

let toutes = [];
let etapes = [];
let commerciaux = [];
let chiffres = {};
try {
  toutes = await listerOffres(filtres);
  etapes = await listerEtapes({ activesSeulement: true });
  commerciaux = await listerUtilisateurs();
  chiffres = await compteurs();
} catch (err) {
  erreur = erreur || `Base injoignable : ${err.message}`;
}

// Les comptes des puces se lisent APRÈS les autres filtres : « 4 actives »
// doit dire quatre parmi ce qui est à l'écran, pas quatre dans toute la base.
const parVue = Object.fromEntries(
  Object.entries(VUES).map(([cle, v]) => [cle, toutes.filter(v.garde).length]),
);
const offres = toutes.filter(VUES[vue].garde);

const message = Astro.url.searchParams.get('ok');
const actifs = Object.values(filtres).filter(Boolean).length + (vue === VUE_DEFAUT ? 0 : 1);

const ETAT_STATUT = {
  brouillon: 'etat',
  envoyee: 'etat etat--on',
  acceptee: 'etat etat--on',
  refusee: 'etat etat--manque',
  expiree: 'etat etat--manque',
};

/** Le lien de la liste avec un filtre changé. */
function vers(modif) {
  const p = new URLSearchParams();
  const suivant = { ...filtres, vue, ...modif };
  if (suivant.prospect) p.set('client', suivant.prospect);
  if (suivant.etape) p.set('etape', suivant.etape);
  if (suivant.auteur) p.set('auteur', suivant.auteur);
  // La vue par défaut ne s'écrit pas dans l'URL : /admin/offres tout court
  // doit rester l'adresse de l'écran normal.
  if (suivant.vue && suivant.vue !== VUE_DEFAUT) p.set('vue', suivant.vue);
  const q = p.toString();
  return `${BASE}/admin/offres${q ? `?${q}` : ''}`;
}

const jour = (valeur) => (valeur ? new Date(valeur).toLocaleDateString('fr-BE') : '—');
---

<Console
  titre="Offres"
  fil="TFB Admin · Commercial · Offres"
  actif="offres"
  message={message}
  erreur={erreur}
  compteurs={chiffres}
>
  <a slot="actions" class="bouton bouton--marque" href={`${BASE}/admin/offres/nouvelle`}>
    <Icone nom="plus" taille={16} /> Nouvelle offre
  </a>

  <section class="bloc" style="margin-block-end:20px">
    <div class="bloc__tete">
      <div>
        <h2>Filtrer</h2>
        <p>
          {offres.length} offre(s) sur {toutes.length}
          {actifs > 0 && <> — {actifs} filtre(s) actif(s)</>}.
        </p>
      </div>
      {actifs > 0 && (
        <a class="bouton bouton--sobre bouton--sm" href={vers({ prospect: '', etape: '', auteur: '', vue: VUE_DEFAUT })}>
          Revenir aux actives
        </a>
      )}
    </div>

    {/* La vue d'abord : c'est elle qui décide de ce que les autres filtres
        vont pouvoir trouver, et l'écran doit dire d'emblée qu'il ne montre
        pas tout. */}
    <div class="tris" role="group" aria-label="Vue">
      {Object.entries(VUES).map(([cle, v]) => (
        <a
          class={`tri ${vue === cle ? 'tri--on' : ''} ${parVue[cle] === 0 ? 'tri--vide' : ''}`}
          href={vers({ vue: cle })}
        >{v.mot} <b>{parVue[cle]}</b></a>
      ))}
    </div>

    <form method="get" class="filtres">
      {vue !== VUE_DEFAUT && <input type="hidden" name="vue" value={vue} />}
      <div class="champ">
        <label for="f-client">Client</label>
        <input id="f-client" type="search" name="client" value={filtres.prospect} placeholder="Raison sociale" />
      </div>
      <div class="champ">
        <label for="f-etape">Étape</label>
        <select id="f-etape" name="etape">
          <option value="">Toutes</option>
          <option value="hors" selected={filtres.etape === 'hors'}>— hors pipeline —</option>
          {etapes.map((e) => (
            <option value={e.cle} selected={filtres.etape === e.cle}>{e.nom}</option>
          ))}
        </select>
      </div>
      <div class="champ">
        <label for="f-auteur">Commercial</label>
        <select id="f-auteur" name="auteur">
          <option value="">Tous</option>
          {commerciaux.map((c) => (
            <option value={c.id} selected={String(filtres.auteur) === String(c.id)}>{c.nom || c.identifiant}</option>
          ))}
        </select>
      </div>
      <div class="actions actions--case">
        <button class="bouton bouton--sobre" type="submit">Filtrer</button>
      </div>
    </form>
  </section>

  <section class="bloc">
    {offres.length === 0 ? (
      <div class="bloc__pied">
        {toutes.length === 0
          ? (actifs > 0
            ? 'Aucune offre ne correspond à ces filtres.'
            : "Aucune offre. La première se crée depuis le bouton en haut, ou depuis une demande de démonstration reçue par le site.")
          : (
            <>
              {/* La liste n'est pas vide, la vue l'est : le dire évite de
                  chercher un bug là où il n'y a qu'un filtre. */}
              Aucune offre active. Les {toutes.length} autres sont gagnées, refusées ou expirées —
              <a href={vers({ vue: 'toutes' })}> tout afficher</a>.
            </>
          )}
      </div>
    ) : (
      /*
       * Une liste de cartes, et non un tableau.
       *
       * C'est l'écran qu'on ouvre le matin et qu'on rouvre entre deux
       * rendez-vous — souvent depuis un téléphone, dans une voiture ou un
       * couloir. Un tableau de onze colonnes n'y survit pas : il défile de
       * côté, et l'action qu'on vient faire — déplacer une offre — se trouve
       * dans la colonne trois, hors de l'écran.
       *
       * Une seule structure pour les deux tailles. Le duo table/cartes
       * demanderait d'écrire deux fois le même contenu, et le second finirait
       * par prendre du retard sur le premier.
       */
      <div class="offres">
        {offres.map((o) => {
          const t = calculerTotauxOffre(o);
          const etape = etapes.find((e) => e.cle === o.etape) || null;
          const r = aRelancer(o, etape);
          const suivante = prochaineRelance(o, etape);
          const rang = etape ? etapes.findIndex((e) => e.cle === etape.cle) : -1;
          return (
            <article class="offre">
              <div class="offre__qui">
                <a class="offre__client" href={`${BASE}/admin/offres/${o.reference}`}>
                  {o.raison_sociale || 'Client inconnu'}
                </a>
                <span class="offre__ref">
                  {o.reference}
                  {o.version > 1 && ` · v${o.version}`}
                  {o.contact_nom && ` · ${o.contact_nom}`}
                </span>
              </div>

              <div class="offre__sous">
                {/* Le mensuel d'abord : c'est le chiffre qui décide, et le
                    ponctuel se lit à côté. Un montant nul ne s'affiche pas —
                    « — » sur trois colonnes ne dit rien de plus que rien. */}
                {t.seaux.mensuel.ttc > 0 && (
                  <strong class="fb-num">{formater(t.seaux.mensuel.ttc, o.langue, o.devise)}<span> /mois</span></strong>
                )}
                {t.seaux.annuel.ttc > 0 && (
                  <strong class="fb-num">{formater(t.seaux.annuel.ttc, o.langue, o.devise)}<span> /an</span></strong>
                )}
                {t.seaux.unique.ttc > 0 && (
                  <strong class="fb-num">{formater(t.seaux.unique.ttc, o.langue, o.devise)}<span> une fois</span></strong>
                )}
                <span class={r.relancer ? 'etat etat--manque' : 'champ__aide'}>
                  {r.dort} j sans bouger
                </span>
                {o.auteur_nom && <span class="champ__aide">{o.auteur_nom}</span>}
                {suivante && <span class="champ__aide">relance le {jour(suivante)}</span>}
                <span class="champ__aide">valable au {jour(o.valide_jusqu_au)}</span>
              </div>

              {/*
                Les étapes en boutons, et non dans une liste déroulante.
                Déplacer une offre était : ouvrir le menu, chercher la ligne,
                choisir, viser « OK ». Quatre gestes pour un, et sur un
                téléphone un menu natif recouvre l'écran — on ne voit plus de
                quelle offre il s'agit au moment de choisir.

                Un seul formulaire, un bouton par étape : c'est le bouton qui
                porte la valeur. Aucun JavaScript, et l'étape franchie part au
                premier appui.
              */}
              <form method="post" class="offre__etapes" aria-label={`Étape de ${o.reference}`}>
                <input type="hidden" name="id" value={o.id} />
                {etapes.map((e, i) => (
                  <button
                    type="submit" name="etape" value={e.cle}
                    class={`pas ${e.cle === o.etape ? 'pas--ici' : i < rang ? 'pas--fait' : ''}`}
                    aria-current={e.cle === o.etape ? 'step' : undefined}
                    disabled={e.cle === o.etape}
                    title={e.cle === o.etape ? `${o.reference} est à cette étape` : `Déplacer ${o.reference} vers ${e.nom}`}
                  >{e.nom}</button>
                ))}
                {/* Sortir du pipeline reste possible, mais ne se propose pas
                    au milieu des étapes : c'est l'exception, pas une étape. */}
                {o.etape && (
                  <button type="submit" name="etape" value="" class="pas pas--hors"
                    title={`Sortir ${o.reference} du pipeline`}>hors pipeline</button>
                )}
              </form>

              <div class="offre__etat">
                <span class={ETAT_STATUT[o.statut] || 'etat'}>{o.statut}</span>
              </div>
            </article>
          );
        })}
      </div>
    )}

    <div class="bloc__pied">
      Montants TTC, une ligne par référence, à sa dernière version.
      <strong> Appuyer sur une étape y déplace l'offre</strong> — celle où elle se trouve est
      pleine, les franchies sont cochées. L'étape commande, l'état suit : c'est elle qui décide
      si l'offre se modifie encore, et le lien se règle sur l'écran Étapes. Une offre déjà
      partie ne redevient pas un brouillon, même ramenée en début de pipeline.
    </div>
  </section>
</Console>

<style is:global>
  /* ── La liste des offres ─────────────────────────────────────────────────
     Une carte par offre, en grille. Large, la grille donne quatre colonnes et
     la liste se lit comme un tableau ; étroite, elle passe à une colonne et
     chaque carte s'empile. Une seule structure : le duo table/cartes
     demanderait d'écrire deux fois le même contenu, et le second finirait par
     prendre du retard sur le premier. */
  .offres { display: flex; flex-direction: column; }

  .offre {
    display: grid;
    grid-template-columns: minmax(14rem, 20rem) minmax(12rem, 1fr) auto 6.5rem;
    gap: 8px 18px;
    align-items: center;
    padding: 14px 20px;
    border-block-start: 1px solid var(--slate-100);
  }
  .offre:first-child { border-block-start: 0; }
  .offre:hover { background: var(--slate-25); }

  .offre__qui { display: flex; flex-direction: column; gap: 2px; min-inline-size: 0; }
  .offre__client {
    font: 600 var(--text-base) / 1.25 var(--font-sans);
    color: var(--navy-900); text-decoration: none;
    /* La cible la plus grande de la carte : c'est le geste le plus fréquent
       après le déplacement d'étape, et sur un téléphone on vise le nom. */
    padding-block: 2px;
  }
  .offre__client:hover { color: var(--brand); text-decoration: underline; }
  .offre__ref { font: 400 var(--text-xs) / 1.4 var(--font-mono); color: var(--slate-500); }

  .offre__sous { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
  .offre__sous strong { font: 600 var(--text-sm) / 1.3 var(--font-mono); white-space: nowrap; }
  /* L'unité en gris et en petit : le chiffre porte l'information, « /mois »
     n'est là que pour lever l'ambiguïté. */
  .offre__sous strong span { font: 400 var(--text-xs) var(--font-sans); color: var(--slate-500); }

  .offre__etat { justify-self: end; }

  /* ── Les étapes, en boutons ──────────────────────────────────────────────
     Déplacer une offre était : ouvrir un menu, chercher la ligne, choisir,
     viser « OK ». Quatre gestes pour un — et sur un téléphone, un menu natif
     recouvre l'écran, si bien qu'on ne voit plus de quelle offre il s'agit au
     moment de choisir. */
  .offre__etapes {
    display: flex; flex-wrap: wrap; gap: 4px;
    justify-self: start;
  }
  .pas {
    /* 36 px de haut au bureau, 44 au doigt — voir la requête média. C'est la
       taille en dessous de laquelle on rate le bouton d'à côté. */
    min-block-size: 36px;
    display: inline-flex; align-items: center;
    padding-inline: 12px;
    border: 1px solid var(--slate-200);
    border-radius: var(--radius-pill);
    background: #fff;
    font: 500 var(--text-xs) / 1.2 var(--font-sans);
    color: var(--slate-600);
    cursor: pointer;
    white-space: nowrap;
    transition: var(--transition-control);
  }
  .pas:hover { border-color: var(--brand); color: var(--brand); background: var(--brand-subtle); }
  /* Là où l'offre se trouve. Pleine, et non bordée : c'est le seul état qu'on
     doit reconnaître sans lire, en parcourant vingt lignes du regard. */
  .pas--ici {
    background: var(--brand); border-color: var(--brand); color: #fff;
    font-weight: var(--weight-semibold);
    cursor: default;
  }
  .pas--ici:hover { background: var(--brand); border-color: var(--brand); color: #fff; }
  /* `disabled` : le navigateur grise et réduit l'opacité de lui-même, ce qui
     ferait de l'étape courante la moins visible de la bande — l'inverse de ce
     qu'on veut. On reprend la main sur les deux. */
  .pas:disabled { opacity: 1; }
  .pas--ici:disabled { background: var(--brand); border-color: var(--brand); color: #fff; }
  /* Ce qui est derrière : lisible, mais qui ne réclame pas l'œil. Un pipeline
     où toutes les étapes crient autant ne se lit plus. */
  .pas--fait { color: var(--slate-400); border-color: var(--slate-100); }
  .pas--fait::before { content: '✓'; margin-inline-end: 5px; color: var(--status-success); }
  /* Sortir du pipeline est l'exception : à l'écart, et jamais coloré comme
     une étape. */
  .pas--hors { color: var(--slate-400); border-style: dashed; margin-inline-start: 8px; }

  /* ── Au doigt ────────────────────────────────────────────────────────────
     Sous 900 px, la grille tombe à une colonne. La bande d'étapes défile
     plutôt que de s'enrouler : enroulée, elle fait cinq rangées et pousse la
     carte suivante hors de l'écran — on perd la liste en voulant la lire. */
  @media (max-width: 900px) {
    .offre {
      grid-template-columns: 1fr auto;
      gap: 10px 12px;
      padding: 16px;
    }
    .offre__qui { grid-column: 1; }
    .offre__etat { grid-column: 2; grid-row: 1; align-self: start; }
    .offre__sous { grid-column: 1 / -1; }
    /* L'ordre change au doigt, et c'est le point le plus important de cet
       écran.

       Dans l'ordre du pipeline, l'étape courante d'une offre avancée se trouve
       au milieu de la bande — donc hors de l'écran à l'ouverture. On ouvrait la
       liste sans voir où était l'offre, et il fallait faire défiler chaque
       bande une par une pour le savoir. Sans JavaScript, rien ne recentre une
       bande au chargement.

       Alors on la réordonne : l'étape courante en tête, les suivantes après —
       ce vers quoi on peut avancer —, les franchies à la fin, où elles ne
       servent que de rappel. L'ordre du DOM ne bouge pas : un lecteur d'écran
       entend toujours le pipeline dans son ordre. */
    .pas { order: 1; }
    .pas--ici { order: 0; }
    .pas--fait { order: 2; }
    .pas--hors { order: 3; }

    .offre__etapes {
      grid-column: 1 / -1;
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      /* Le rembourrage rendu à la carte : la bande touche les bords, pour
         qu'on voie qu'elle continue au-delà. */
      margin-inline: -16px;
      padding-inline: 16px;
      padding-block: 2px;
      scroll-snap-type: x proximity;
    }
    .offre__etapes::-webkit-scrollbar { display: none; }
    .pas {
      min-block-size: 44px;
      padding-inline: 14px;
      font-size: var(--text-sm);
      scroll-snap-align: start;
    }
    .offre__client { font-size: var(--text-lg); }
  }
</style>
