---
/**
 * L'annexe de l'offre : ce que le client a retenu, montré plutôt que décrit.
 *
 * Une page à imprimer, pas un écran de console. Elle sort donc du gabarit
 * habituel — pas de rail, pas de barre — et porte ses propres règles `@page` :
 * A4, marges de 14 mm, et des sauts de page posés là où une fiche de module
 * ne doit pas se couper en deux.
 *
 * Le PDF se fabrique dans le navigateur, par « Imprimer → Enregistrer en
 * PDF ». C'est volontaire : produire le PDF côté serveur voudrait dire
 * embarquer un moteur de rendu — plusieurs centaines de mégaoctets — pour
 * obtenir exactement ce que le navigateur sait déjà faire.
 *
 * Ce qui est montré vient de la **copie** posée sur l'offre : une offre partie
 * doit rester lisible telle qu'elle a été signée. Seuls le texte des fiches et
 * les captures viennent du catalogue — ils décrivent le produit, pas le prix.
 *
 * Le même composant sert deux pages : celle de la console, où le commercial
 * relit et imprime, et celle du client, ouverte par un lien signé depuis le
 * courriel. Une seule annexe, deux portes.
 */
import { LEVIERS, leviersDe, titreLevier } from '../lib/leviers.mjs';
import { configDe, dossierAnnexe, tarifsEnVigueur } from '../lib/admin/donnees.mjs';
import { listerMaquettes } from '../lib/admin/maquettes.mjs';
import { calculerOffre, formater } from '../lib/offres/calcul.mjs';

const {
  offre,
  retour = null,
  // Le client ne peut signer que depuis sa propre porte : la page de la
  // console montre les mêmes maquettes, mais sans le formulaire. Un commercial
  // qui signerait à la place de son client produirait un accord sans valeur —
  // et personne ne s'en apercevrait avant le litige.
  signature = null,
  visa = null,
  perime = false,
  dit = null,
  souci = null,
} = Astro.props;

const [dossier, vigueur] = [await dossierAnnexe(offre), await tarifsEnVigueur()];
const maquettes = await listerMaquettes(offre.id);
const parRang = new Map(maquettes.map((m) => [Number(m.rang), m]));
const vues = (offre.vues || []).filter((v) => String(v.note || '').trim() || Number(v.nombre) > 0);
const resultat = calculerOffre(configDe(offre));
const sou = (c) => formater(c, offre.langue, offre.devise);

// Les leviers réellement actionnés par ce que le client a retenu : la légende
// du pied de page les met en avant, sans masquer les deux autres — un réseau
// qui n'en actionne que quatre doit voir qu'il en existe six.
const actionnes = new Set(dossier.flatMap((m) => m.leviers || []));

const jour = (v) => (v ? new Date(v).toLocaleDateString('fr-BE', { dateStyle: 'long' }) : '—');
const pointsDeVente = Number(offre.nombre_postes) || 0;

/** L'URL d'une capture, préfixée du chemin de montage. */
const BASE = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
const capture = (fichier) => `${BASE}/captures/${fichier}`;

/**
 * L'adresse d'une maquette, avec la clé qui a ouvert cette page.
 *
 * On réutilise la clé reçue plutôt que d'en refabriquer une : la page de la
 * console n'en a pas dans son URL, et une clé forgée ici passerait outre le
 * contrôle au lieu de s'y soumettre. Sans clé, pas d'image — et la vignette
 * dit alors qu'il faut ouvrir le lien reçu par courriel.
 */
const cleRecue = Astro.url?.searchParams?.get('cle') || null;
const lienMaquette = (m) => (cleRecue
  ? `${BASE}/maquettes/${m.id}?reference=${offre.reference}&version=${offre.version}&cle=${cleRecue}`
  : null);

const jourHeure = (v) => (v
  ? new Date(v).toLocaleString('fr-BE', { dateStyle: 'long', timeStyle: 'short' })
  : '—');
---

<html lang={offre.langue || 'fr'} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Annexe — {offre.reference}</title>
    <meta name="robots" content="noindex, nofollow" />

    <style is:global>
      /* ── Mise en page papier ─────────────────────────────────────────── */
      @page { size: A4; margin: 14mm; }

      :root {
        --encre: #0c1329;
        --gris: #565d73;
        --trait: #dddfe8;
        --marque: #7b4488;
        --fond-doux: #f5f6f9;
        --vert: #0c6a66;
      }

      * { box-sizing: border-box; }
      body {
        margin: 0; padding: 24px;
        font: 400 13px/1.55 -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        color: var(--encre); background: var(--fond-doux);
      }
      .feuille {
        max-inline-size: 210mm; margin-inline: auto; padding: 18mm 16mm;
        background: #fff; box-shadow: 0 1px 4px rgba(12, 19, 41, 0.1);
      }

      h1 { font-size: 21px; margin: 0 0 2px; letter-spacing: -0.01em; }
      h2 {
        font-size: 12px; margin: 0 0 10px;
        letter-spacing: 0.09em; text-transform: uppercase; color: var(--marque);
      }
      h3 { font-size: 15px; margin: 0 0 2px; }
      p { margin: 0 0 8px; }

      .tete { border-block-end: 2px solid var(--encre); padding-block-end: 12px; margin-block-end: 20px; }
      .tete__marque { font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--gris); }
      .tete__meta { display: flex; flex-wrap: wrap; gap: 4px 20px; font-size: 12px; color: var(--gris); margin-block-start: 8px; }
      .tete__meta b { color: var(--encre); font-weight: 600; }

      /* ── Ce qui est retenu, en une ligne par poste ───────────────────── */
      .sommaire { inline-size: 100%; border-collapse: collapse; margin-block-end: 22px; }
      .sommaire th {
        text-align: start; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase;
        color: var(--gris); font-weight: 600; padding-block-end: 5px; border-block-end: 1px solid var(--trait);
      }
      .sommaire td { padding-block: 6px; border-block-end: 1px solid var(--trait); vertical-align: top; }
      .sommaire .nombre { text-align: end; white-space: nowrap; font-variant-numeric: tabular-nums; }
      .sommaire tfoot td { font-weight: 700; border-block-end: 0; padding-block-start: 9px; }

      /* ── Une fiche de module ─────────────────────────────────────────── */
      .fiche {
        border-block-start: 1px solid var(--trait);
        padding-block: 16px;
        /* Une fiche ne se coupe pas en deux : le client tournerait la page au
           milieu d'un argument. */
        break-inside: avoid;
      }
      .fiche__tete { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-block-end: 8px; }
      .fiche__origine {
        font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase;
        color: var(--gris); margin-inline-start: auto;
      }
      .fiche__accroche { color: var(--gris); }

      .deux { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-block-start: 10px; }
      .colonne__titre { font-size: 11px; font-weight: 700; margin-block-end: 5px; }
      .colonne--perd .colonne__titre { color: var(--gris); }
      .colonne--gagne .colonne__titre { color: var(--vert); }
      .colonne ul { margin: 0; padding-inline-start: 15px; }
      .colonne li { margin-block-end: 5px; }
      .colonne li b { font-weight: 600; }
      .colonne li span { display: block; color: var(--gris); font-size: 12px; }

      .captures { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-block-start: 12px; }
      .captures figure { margin: 0; }
      .captures img {
        inline-size: 100%; display: block;
        border: 1px solid var(--trait); border-radius: 4px;
      }
      .captures figcaption { font-size: 10px; color: var(--gris); margin-block-start: 3px; }

      /* ── Les pastilles de levier ─────────────────────────────────────── */
      .pastilles { display: inline-flex; gap: 3px; }
      .pastille {
        /* `flex: none` : dans la légende, la pastille est l'enfant d'une
           rangée souple et se laissait écraser en un trait vertical. */
        flex: none;
        inline-size: 17px; block-size: 17px; border-radius: 4px;
        display: inline-flex; align-items: center; justify-content: center;
        font: 700 10px/1 -apple-system, 'Segoe UI', Roboto, sans-serif;
        /* Les fonds sont imprimés : sans cela, le code couleur disparaît sur
           papier et la légende du pied ne renvoie plus à rien. */
        print-color-adjust: exact; -webkit-print-color-adjust: exact;
      }

      /* ── La légende des leviers, en pied ─────────────────────────────── */
      .leviers { margin-block-start: 26px; padding-block-start: 16px; border-block-start: 2px solid var(--encre); break-inside: avoid; }
      .leviers__grille { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 20px; margin-block-start: 10px; }
      .levier { display: flex; gap: 9px; align-items: start; }
      .levier__nom { font-weight: 700; }
      .levier__quoi { color: var(--gris); }
      .levier__pourquoi { color: var(--gris); font-size: 12px; margin-block-start: 2px; }
      .levier--dehors { opacity: 0.55; }
      .levier__retenu {
        font-size: 9px; letter-spacing: 0.06em; text-transform: uppercase;
        color: var(--vert); font-weight: 700;
      }

      .pied { margin-block-start: 20px; font-size: 11px; color: var(--gris); }

      /* ── À l'écran seulement ─────────────────────────────────────────── */
      .imprimer {
        max-inline-size: 210mm; margin: 0 auto 14px; display: flex; gap: 12px; align-items: center;
        font-size: 13px; color: var(--gris);
      }
      .imprimer button {
        font: 600 13px/1 inherit; color: #fff; background: var(--marque);
        border: 0; border-radius: 8px; padding: 10px 16px; cursor: pointer;
      }
      .imprimer a { color: var(--marque); }

      /* ── Les écrans sur mesure, et leur bon pour accord ───────────────── */

      .flux { margin-block-start: 26px; break-inside: avoid; }
      .flux__grille {
        display: grid; gap: 14px; margin-block-start: 12px;
        grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
      }
      .flux__vue { margin: 0; break-inside: avoid; }
      /* Cadrée en haut : une capture d'application se reconnaît à son en-tête,
         pas à son pied. La rogner par le bas coûte moins que de la déformer. */
      .flux__vue img {
        inline-size: 100%; block-size: 13rem; object-fit: cover; object-position: top;
        border: 1px solid var(--trait); border-radius: 8px; background: #fff;
      }
      .flux__sans {
        display: flex; align-items: center; justify-content: center; text-align: center;
        block-size: 13rem; padding: 12px; border: 1px dashed var(--trait); border-radius: 8px;
        font-size: 12px; color: var(--gris);
      }
      .flux__vue figcaption { margin-block-start: 6px; font-size: 12px; color: var(--gris); }
      .flux__vue figcaption b { color: var(--encre); }

      .visa {
        display: flex; flex-direction: column; gap: 2px;
        margin-block-start: 14px; padding: 12px 14px; border-radius: 8px;
        font-size: 13px; border: 1px solid var(--trait);
      }
      .visa--ok { background: #f2f9f4; border-color: #bcdfc7; }
      .visa--perime { background: #fdf5f0; border-color: #efc9ae; }

      /* Le formulaire ne s'imprime pas : un bon pour accord se donne en ligne,
         daté par le serveur. Imprimé, il ferait croire qu'on peut le signer au
         stylo — et cette signature-là ne remonterait jamais jusqu'ici. */
      .visa-form {
        margin-block-start: 16px; padding: 16px; border: 1px solid var(--trait);
        border-radius: 10px; background: #fbfcfe; break-inside: avoid;
      }
      .visa-form h3 { margin: 0 0 4px; font-size: 15px; }
      .visa-form__champs {
        display: grid; gap: 12px; margin-block-start: 12px;
        grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
      }
      .visa-form__large { grid-column: 1 / -1; }
      .visa-form label { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--gris); }
      .visa-form input, .visa-form textarea {
        font: inherit; font-size: 14px; color: var(--encre);
        padding: 8px 10px; border: 1px solid var(--trait); border-radius: 6px; background: #fff;
        inline-size: 100%; box-sizing: border-box;
      }
      .visa-form__trace { display: flex; flex-direction: column; gap: 6px; margin-block-start: 12px; font-size: 12px; color: var(--gris); }
      .visa-form__trace canvas {
        inline-size: 100%; max-inline-size: 520px; block-size: 150px; touch-action: none;
        border: 1px dashed var(--trait); border-radius: 6px; background: #fff;
      }
      .visa-form__trace button { align-self: start; font: inherit; font-size: 12px; padding: 4px 10px; cursor: pointer; }
      .visa-form__ok {
        margin-block-start: 14px; font: inherit; font-size: 14px; font-weight: 700;
        padding: 10px 18px; border: 0; border-radius: 8px; cursor: pointer;
        color: #fff; background: var(--encre);
      }

      @media print {
        body { padding: 0; background: #fff; }
        .feuille { max-inline-size: none; padding: 0; box-shadow: none; }
        .imprimer { display: none; }
        .visa-form { display: none; }
      }
    </style>
  </head>

  <body>
    <div class="imprimer">
      <button type="button" onclick="window.print()">Imprimer — ou enregistrer en PDF</button>
      <span>Dans la boîte d'impression, choisissez « Enregistrer au format PDF ».</span>
      {retour && <a href={retour}>Retour à l'offre</a>}
    </div>

    <div class="feuille">
      <header class="tete">
        <div class="tete__marque">The Franchise Buddy — annexe technique</div>
        <h1>{offre.prospect?.raison_sociale || 'Client'}</h1>
        <div class="tete__meta">
          <span><b>Offre</b> {offre.reference} · version {offre.version}</span>
          <span><b>Établie le</b> {jour(offre.cree_le)}</span>
          {offre.valide_jusqu_au && <span><b>Valable jusqu'au</b> {jour(offre.valide_jusqu_au)}</span>}
          {pointsDeVente > 0 && <span><b>Points de vente</b> {pointsDeVente}</span>}
        </div>
      </header>

      <h2>Ce qui est retenu</h2>
      <table class="sommaire">
        <thead>
          <tr>
            <th>Poste</th>
            <th>Compris</th>
            <th class="nombre">Rythme</th>
            <th class="nombre">Montant</th>
          </tr>
        </thead>
        <tbody>
          {(offre.packs || []).map((p) => (
            <tr>
              <td><b>{p.nom}</b></td>
              <td>{(p.modules || []).map((m) => m.nom).join(' · ')}</td>
              <td class="nombre">{p.unite === 'poste_mois' ? `× ${pointsDeVente} / mois` : 'par mois'}</td>
              <td class="nombre">
                {sou(p.prix_cents * (p.unite === 'poste_mois' ? pointsDeVente : 1))}
              </td>
            </tr>
          ))}
          {(offre.modules || []).map((m) => (
            <tr>
              <td><b>{m.nom}</b></td>
              <td>{m.apporte || '—'}</td>
              <td class="nombre">par mois</td>
              <td class="nombre">{sou(m.prix_cents)}</td>
            </tr>
          ))}
          {(offre.prestations || []).map((p) => (
            <tr>
              <td><b>{p.nom}</b></td>
              <td>{p.description || '—'}</td>
              <td class="nombre">une fois</td>
              <td class="nombre">{sou(p.prix_cents)}</td>
            </tr>
          ))}
        </tbody>
        <tfoot>
          <tr>
            <td colspan="3">Total mensuel, taxes comprises</td>
            <td class="nombre">{sou(resultat.seaux.mensuel.ttc)}</td>
          </tr>
          {resultat.seaux.unique.ttc > 0 && (
            <tr>
              <td colspan="3">À la signature, taxes comprises</td>
              <td class="nombre">{sou(resultat.seaux.unique.ttc)}</td>
            </tr>
          )}
        </tfoot>
      </table>

      <h2>Ce que chaque module change</h2>
      {dossier.length === 0 ? (
        <p>Aucun module retenu pour l'instant.</p>
      ) : (
        dossier.map((m) => (
          <section class="fiche">
            <div class="fiche__tete">
              <h3>{m.nom}</h3>
              <span class="pastilles">
                {leviersDe(m.leviers).map((l) => (
                  <span class="pastille" style={`background:${l.fond};color:${l.encre}`} title={titreLevier(l)}>
                    {l.lettre}
                  </span>
                ))}
              </span>
              <span class="fiche__origine">{m.pack || 'Option'}</span>
            </div>
            {m.accroche && <p class="fiche__accroche">{m.accroche}</p>}

            <div class="deux">
              <div class="colonne colonne--perd">
                <div class="colonne__titre">Fait disparaître</div>
                <ul>
                  {m.problemes.map((p) => (
                    <li><b>{p.titre}</b><span>{p.texte}</span></li>
                  ))}
                </ul>
              </div>
              <div class="colonne colonne--gagne">
                <div class="colonne__titre">Apporte</div>
                <ul>
                  {m.benefices.map((b) => (
                    <li><b>{b.titre}</b><span>{b.texte}</span></li>
                  ))}
                </ul>
              </div>
            </div>

            {m.captures.length > 0 && (
              <div class="captures">
                {m.captures.slice(0, 3).map((c) => (
                  <figure>
                    <img src={capture(c.fichier)} alt={c.titre || m.nom} />
                    <figcaption>{c.titre}</figcaption>
                  </figure>
                ))}
              </div>
            )}
          </section>
        ))
      )}

      {vues.length > 0 && (
        <section class="flux">
          <h2>Vos écrans sur mesure</h2>
          <p class="levier__quoi">
            Voici à quoi ressembleront les {vues.length} écran(s) développés pour vous. Ce sont des
            maquettes : les chiffres sont fictifs, la disposition ne l'est pas. Regardez-les
            maintenant plutôt qu'à la livraison — c'est le moment où corriger ne coûte rien.
          </p>

          <div class="flux__grille">
            {vues.map((v, i) => {
              const m = parRang.get(i);
              const src = m ? lienMaquette(m) : null;
              return (
                <figure class="flux__vue">
                  {src
                    ? <img src={src} alt={`Maquette : ${String(v.note || '').trim() || `vue ${i + 1}`}`} loading="lazy" />
                    : <div class="flux__sans">
                        {m ? 'Ouvrez le lien reçu par courriel pour voir cette maquette.' : 'Pas encore de maquette pour cet écran.'}
                      </div>}
                  <figcaption>
                    <b>{i + 1}. {String(v.note || '').trim() || 'Vue'}</b>
                    {Number(v.nombre) > 1 && <span> — {v.nombre} écrans de ce type</span>}
                  </figcaption>
                </figure>
              );
            })}
          </div>

          {visa && (
            <div class={perime ? 'visa visa--perime' : 'visa visa--ok'}>
              {perime ? (
                <>
                  <b>Ces écrans ont changé depuis votre accord.</b>
                  <span>
                    Vous aviez validé le {jourHeure(visa.signe_le)}. Depuis, une vue ou une maquette
                    a bougé — merci de redonner votre accord ci-dessous après avoir regardé.
                  </span>
                </>
              ) : (
                <>
                  <b>Bon pour accord reçu.</b>
                  <span>
                    Validé par {visa.signataire_nom} le {jourHeure(visa.signe_le)}.
                    {visa.commentaire && <> Remarque notée : « {visa.commentaire} »</>}
                  </span>
                </>
              )}
            </div>
          )}

          {signature && (!visa || perime) && (
            <form class="visa-form" method="post" action={signature}>
              <h3>Votre bon pour accord</h3>
              <p class="levier__quoi">
                En signant, vous confirmez que ces écrans correspondent à ce que vous attendez.
                Ce n'est pas la signature du contrat — c'est la recette des maquettes, et c'est
                elle qui évite de découvrir un malentendu à la livraison.
              </p>

              {souci && <div class="visa visa--perime"><b>{souci}</b></div>}
              {dit && <div class="visa visa--ok"><b>{dit}</b></div>}

              <div class="visa-form__champs">
                <label>
                  <span>Votre nom complet <b aria-hidden="true">*</b></span>
                  <input type="text" name="nom" required maxlength="160" autocomplete="name" />
                </label>
                <label>
                  <span>Votre fonction</span>
                  <input type="text" name="role" maxlength="120" placeholder="Gérant, directeur d'exploitation…" />
                </label>
                <label>
                  <span>Votre courriel</span>
                  <input type="email" name="email" maxlength="200" autocomplete="email" />
                </label>
                <label class="visa-form__large">
                  <span>Une remarque ? Elle sera lue avant le développement.</span>
                  <textarea name="commentaire" rows="3" maxlength="2000"></textarea>
                </label>
              </div>

              <div class="visa-form__trace" data-trace hidden>
                <span>Signez du doigt ou à la souris — facultatif.</span>
                <canvas width="520" height="150" aria-label="Zone de signature"></canvas>
                <button type="button" data-effacer>Effacer</button>
              </div>
              <input type="hidden" name="trace" data-trace-valeur />

              <button class="visa-form__ok" type="submit">Je donne mon accord sur ces écrans</button>
              <p class="levier__quoi">
                La date, votre nom et une empreinte de ces maquettes sont enregistrés. Changer une
                maquette après coup ne réécrit pas votre accord : il resterait attaché à ce que
                vous avez vu aujourd'hui.
              </p>
            </form>
          )}
        </section>
      )}

      <section class="leviers">
        <h2>Les six leviers de gestion</h2>
        <p class="levier__quoi">
          Un réseau ne se pilote pas poste par poste mais levier par levier. Chaque module
          agit sur un ou plusieurs d'entre eux — les pastilles de couleur, ci-dessus,
          disent lesquels.
        </p>
        <div class="leviers__grille">
          {LEVIERS.map((l) => (
            <div class={actionnes.has(l.cle) ? 'levier' : 'levier levier--dehors'}>
              <span class="pastille" style={`background:${l.fond};color:${l.encre}`}>{l.lettre}</span>
              <div>
                <div>
                  <span class="levier__nom">{l.nom}</span>
                  <span class="levier__quoi"> — {l.question}</span>
                  {actionnes.has(l.cle) && <span class="levier__retenu"> · actionné</span>}
                </div>
                <div class="levier__pourquoi">{l.pourquoi}</div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <p class="pied">
        Annexe à l'offre {offre.reference} version {offre.version}. Les montants figurent
        sur l'offre elle-même et font foi ; cette annexe décrit ce qu'ils couvrent.
        {offre.tva_exoneree && (offre.tva_mention || vigueur?.mention_autoliquidation)
          ? ` ${offre.tva_mention || vigueur.mention_autoliquidation}`
          : ''}
      </p>
    </div>

    {signature && (
      <script is:inline>
        /*
         * La zone de signature, en amélioration progressive.
         *
         * Elle est masquée dans le HTML servi et ce script la révèle : sans
         * JavaScript, le client ne voit pas un cadre où l'on ne peut rien
         * dessiner. Son accord tient alors à son nom, à la date du serveur et
         * à l'empreinte des maquettes — c'est déjà ce qui fait sa valeur. Le
         * tracé n'est qu'un agrément.
         *
         * Aucune bibliothèque : trois évènements de pointeur et un trait.
         */
        (function () {
          var zone = document.querySelector('[data-trace]');
          var champ = document.querySelector('[data-trace-valeur]');
          if (!zone || !champ) return;
          var toile = zone.querySelector('canvas');
          var ctx = toile && toile.getContext && toile.getContext('2d');
          if (!ctx) return;
          zone.hidden = false;

          ctx.lineWidth = 2;
          ctx.lineCap = 'round';
          ctx.lineJoin = 'round';
          ctx.strokeStyle = '#0c1329';

          var trace = false;
          var vide = true;

          /* Le canevas est étiré par la CSS : sans ce rapport, le trait suit
             le doigt avec un décalage qui grandit vers la droite. */
          function point(e) {
            var r = toile.getBoundingClientRect();
            return {
              x: (e.clientX - r.left) * (toile.width / r.width),
              y: (e.clientY - r.top) * (toile.height / r.height),
            };
          }

          toile.addEventListener('pointerdown', function (e) {
            trace = true;
            vide = false;
            toile.setPointerCapture(e.pointerId);
            var p = point(e);
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            e.preventDefault();
          });
          toile.addEventListener('pointermove', function (e) {
            if (!trace) return;
            var p = point(e);
            ctx.lineTo(p.x, p.y);
            ctx.stroke();
            e.preventDefault();
          });
          ['pointerup', 'pointercancel', 'pointerleave'].forEach(function (nom) {
            toile.addEventListener(nom, function () { trace = false; });
          });

          zone.querySelector('[data-effacer]').addEventListener('click', function () {
            ctx.clearRect(0, 0, toile.width, toile.height);
            vide = true;
            champ.value = '';
          });

          /* Le tracé ne part qu'à l'envoi : le sérialiser à chaque trait
             coûterait cher pour rien, et un champ caché qui grossit pendant
             qu'on dessine finit par ralentir la page sur un téléphone. */
          zone.closest('form').addEventListener('submit', function () {
            champ.value = vide ? '' : toile.toDataURL('image/png');
          });
        })();
      </script>
    )}
  </body>
</html>
