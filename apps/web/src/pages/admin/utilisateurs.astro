---
/**
 * Les comptes de la console.
 *
 * Deux rôles, et la différence tient en une phrase : un **commercial** voit
 * ses prospects et ses offres, un **administrateur** voit tout — dont la
 * grille tarifaire. Un commercial qui pourrait changer le prix par vue
 * n'aurait pas de rôle du tout.
 *
 * UN COMPTE, UN CODE. La console ne demande plus qu'une chose pour entrer :
 * six chiffres. Ils identifient et authentifient à la fois, ce qui est
 * précisément ce qui permet un formulaire à un champ sans perdre le nom sur
 * les offres. Un compte sans code existe mais n'entre pas — la colonne le dit.
 *
 * Le code ne s'affiche qu'une fois, à l'attribution : la base n'en garde qu'une
 * empreinte scrypt, et un code réaffiché finit copié dans un ticket.
 *
 * Le dernier administrateur actif ne peut être ni supprimé, ni désactivé, ni
 * rétrogradé. La clé de secours du serveur rouvrirait la console, mais
 * compter dessus voudrait dire aller lire un fichier en SSH pour rentrer :
 * autant refuser le geste.
 */
import Console from '../../components/Console.astro';
import Icone from '../../components/Icone.astro';
import { ajouterUtilisateur,
  basculerUtilisateur,
  changerCode,
  changerRole,
  compteurs,
  listerUtilisateurs,
  supprimerUtilisateur } from '../../lib/admin/donnees.mjs';

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
let erreur = null;

if (Astro.request.method === 'POST') {
  try {
    const f = await Astro.request.formData();
    const action = String(f.get('action') || '');
    let dit = 'Enregistré.';

    if (action === 'ajout') {
      // Le code tapé, ou un code tiré au hasard si le champ est vide. Tirer au
      // hasard vaut mieux que laisser choisir : « 010203 » est un code que
      // quelqu'un choisit, jamais un code que le hasard donne.
      const r = await ajouterUtilisateur({
        identifiant: f.get('identifiant'),
        nom: f.get('nom'),
        code: f.get('code'),
        role: String(f.get('role') || 'commercial'),
      });
      dit = `Compte « ${r.cle} » créé. Son code est ${r.code} — notez-le maintenant, il ne sera plus affiché.`;
    } else if (action === 'code') {
      const r = await changerCode(f.get('id'), f.get('code'));
      if (!r.ok) throw new Error(r.erreur);
      dit = `Nouveau code : ${r.code}. Notez-le maintenant — il ne sera plus affiché.`;
    } else if (action === 'code-retrait') {
      await changerCode(f.get('id'), null);
      dit = 'Code retiré. Ce compte ne peut plus se connecter.';
    } else if (action === 'role') {
      await changerRole(f.get('id'), String(f.get('role')));
      dit = 'Rôle changé. Il ne prendra effet qu’à la prochaine connexion de la personne.';
    } else if (action === 'bascule') {
      await basculerUtilisateur(f.get('id'), f.get('actif') === '1');
      dit = 'Compte mis à jour.';
    } else if (action === 'suppression') {
      await supprimerUtilisateur(f.get('id'));
      dit = 'Compte supprimé. Les offres qu’il a créées gardent son nom.';
    }
    return Astro.redirect(`${BASE}/admin/utilisateurs?ok=${encodeURIComponent(dit)}`, 303);
  } catch (err) {
    erreur = err.message;
  }
}

let comptes = [];
let chiffres = {};
try {
  comptes = await listerUtilisateurs();
  chiffres = await compteurs();
} catch (err) {
  erreur = erreur || `Base injoignable : ${err.message}`;
}

const message = Astro.url.searchParams.get('ok');
const session = Astro.locals.session || {};
const admins = comptes.filter((c) => c.role === 'admin' && c.actif).length;

const ROLES_LISIBLES = {
  admin: 'Administrateur',
  commercial: 'Commercial',
};

/** Une date, sans l'heure : le détail n'apporte rien ici. */
const jour = (valeur) => (valeur ? new Date(valeur).toLocaleDateString('fr-BE') : '—');
---

<Console
  titre="Comptes"
  fil="TFB Admin · Système · Comptes"
  actif="utilisateurs"
  message={message}
  erreur={erreur}
  compteurs={chiffres}
>
  {session.secours && (
    <section class="bloc bloc--alerte" style="margin-block-end:20px">
      <div class="bloc__tete">
        <div>
          <h2>Vous êtes entré par la clé de secours</h2>
          <p>
            Aucun compte n'est derrière cette session : ce que vous ferez ne portera
            aucun nom. {comptes.length === 0
              ? 'Créez un premier administrateur ci-dessous, puis reconnectez-vous avec.'
              : 'Reconnectez-vous avec votre compte pour que vos offres portent votre nom.'}
          </p>
        </div>
      </div>
    </section>
  )}

  <section class="bloc" style="margin-block-end:20px">
    <div class="bloc__tete">
      <div>
        <h2>Les comptes</h2>
        <p>
          <span class="jeton">landing_utilisateurs</span> — {comptes.length} compte(s),
          dont {admins} administrateur(s) actif(s).
        </p>
      </div>
    </div>

    {comptes.length === 0 ? (
      <div class="bloc__pied">
        Aucun compte. Tant qu'il n'y en a pas, seule la clé de secours du serveur ouvre
        la console — et rien de ce qui est fait ne porte de nom.
      </div>
    ) : (
      <div class="roule">
        <table>
          <thead>
            <tr>
              <th>Personne</th>
              <th style="inline-size:16rem">Code de connexion</th>
              <th style="inline-size:12rem">Rôle</th>
              <th style="inline-size:5.5rem">État</th>
              <th style="inline-size:5.5rem">Vu le</th>
              <th style="inline-size:13rem"><span class="invisible">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            {comptes.map((c) => (
              <tr>
                <td>
                  <strong>{c.nom || c.identifiant}</strong>
                  <code class="slug">{c.identifiant}</code>
                  {c.id === session.id && <span class="etat etat--on">c'est vous</span>}
                </td>
                <td>
                  <div class="compte-code">
                    {c.aCode
                      ? <span class="etat etat--on">••••••</span>
                      : <span class="etat etat--manque">aucun — n'entre pas</span>}
                    <form method="post" class="ligne-serree">
                      <input type="hidden" name="action" value="code" />
                      <input type="hidden" name="id" value={c.id} />
                      <input
                        type="text"
                        name="code"
                        inputmode="numeric"
                        pattern="[0-9]{6}"
                        maxlength="6"
                        size="6"
                        placeholder="au hasard"
                        aria-label={`Nouveau code de ${c.identifiant}`}
                      />
                      <button class="bouton bouton--sobre bouton--sm" type="submit">
                        {c.aCode ? 'Changer' : 'Attribuer'}
                      </button>
                    </form>
                    {c.aCode && (
                      <form method="post">
                        <input type="hidden" name="action" value="code-retrait" />
                        <input type="hidden" name="id" value={c.id} />
                        <button class="bouton bouton--sobre bouton--sm" type="submit">Retirer</button>
                      </form>
                    )}
                  </div>
                </td>
                <td>
                  <form method="post" class="ligne-serree">
                    <input type="hidden" name="action" value="role" />
                    <input type="hidden" name="id" value={c.id} />
                    <select name="role" aria-label={`Rôle de ${c.identifiant}`}>
                      <option value="commercial" selected={c.role === 'commercial'}>Commercial</option>
                      <option value="admin" selected={c.role === 'admin'}>Administrateur</option>
                    </select>
                    <button class="bouton bouton--sobre bouton--sm" type="submit">OK</button>
                  </form>
                </td>
                <td><span class={c.actif ? 'etat etat--on' : 'etat'}>{c.actif ? 'actif' : 'désactivé'}</span></td>
                <td class="fb-num champ__aide">{jour(c.vu_le)}</td>
                <td>
                  <div class="actions">
                    <form method="post">
                      <input type="hidden" name="action" value="bascule" />
                      <input type="hidden" name="id" value={c.id} />
                      <input type="hidden" name="actif" value={c.actif ? '0' : '1'} />
                      <button class="bouton bouton--sobre bouton--sm" type="submit">
                        {c.actif ? 'Désactiver' : 'Réactiver'}
                      </button>
                    </form>
                    <form method="post" onsubmit="return confirm('Supprimer ce compte ? Les offres qu’il a créées gardent son nom.')">
                      <input type="hidden" name="action" value="suppression" />
                      <input type="hidden" name="id" value={c.id} />
                      <button class="bouton bouton--sobre bouton--sm" type="submit">Supprimer</button>
                    </form>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <div class="bloc__pied">
      Un <strong>commercial</strong> voit le tableau de bord, ses prospects, ses offres et
      les demandes reçues. Un <strong>administrateur</strong> voit en plus le contenu de la
      landing, les traductions, la grille tarifaire et les comptes.
      Un changement de rôle ne prend effet qu'à la prochaine connexion : le rôle voyage
      dans le cookie de session, signé.
      <br />
      Retirer le code ferme la porte à ce compte sans rien effacer de ce qu'il a fait —
      c'est le geste à faire quand quelqu'un part. Cinq essais ratés bloquent l'adresse
      qui essaie, et l'attente double ensuite : sans ce verrou, six chiffres se
      testeraient tous en quelques minutes.
    </div>
  </section>

  <section class="bloc">
    <div class="bloc__tete">
      <div>
        <h2>Créer un compte</h2>
        <p>
          On se connecte à la console avec <strong>six chiffres</strong>, et rien
          d'autre : le code dit à la fois qui entre et qu'il a le droit d'entrer.
          L'identifiant ne sert donc qu'à s'y retrouver ici. Laissez le code vide
          pour en tirer un au hasard — c'est le meilleur choix, un code choisi
          ressemble toujours à une date. Il s'affiche une fois, à la création.
        </p>
      </div>
    </div>

    <form method="post">
      <input type="hidden" name="action" value="ajout" />
      <div class="duo">
        <div class="champ">
          <label for="u-identifiant">Identifiant<span class="champ__requis" aria-hidden="true"> *</span></label>
          <input
            id="u-identifiant"
            type="text"
            name="identifiant"
            required
            autocapitalize="none"
            autocorrect="off"
            spellcheck="false"
            placeholder="prenom@thefranchisebuddy.eu"
          />
        </div>
        <div class="champ">
          <label for="u-nom">Nom affiché</label>
          <input id="u-nom" type="text" name="nom" placeholder="Prénom Nom" />
          <span class="champ__aide">C'est ce nom qui figurera sur les offres.</span>
        </div>
      </div>
      <div class="duo" style="margin-block-start:12px">
        <div class="champ">
          <label for="u-code">Code de connexion</label>
          <input
            id="u-code"
            type="text"
            name="code"
            inputmode="numeric"
            pattern="[0-9]{6}"
            maxlength="6"
            autocomplete="off"
            placeholder="Vide = tiré au hasard"
          />
          <span class="champ__aide">Six chiffres, propres à ce compte.</span>
        </div>
        <div class="champ">
          <label for="u-role">Rôle</label>
          <select id="u-role" name="role">
            <option value="commercial">Commercial</option>
            <option value="admin">Administrateur</option>
          </select>
        </div>
      </div>
      <div class="actions">
        <button class="bouton bouton--marque" type="submit">
          <Icone nom="plus" taille={16} /> Créer le compte
        </button>
      </div>
    </form>
  </section>
</Console>

<style is:global>
  .bloc--alerte { border-color: var(--amber-500); background: var(--amber-100); }

  .compte-code { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  /* La largeur passe par `flex-basis`, pas par `inline-size` — et c'est le
     détail qui décide.
     La règle de base de la console est `input:not([type=checkbox]):not(
     [type=radio]):not([type=hidden]) { inline-size: 100% }` : trois `:not`
     d'attribut, donc une spécificité de (0,3,1) que `.compte-code
     input[name=code]` (0,2,1) ne bat pas. Le champ restait à 100 % et poussait
     le bouton hors de sa cellule. `flex-basis`, lui, n'entre en concurrence
     avec rien et l'emporte sur `width` pour la taille d'un élément flex. */
  .compte-code input[name='code'] {
    flex: 0 0 6.5rem;
    font-family: var(--font-mono); letter-spacing: .1em;
  }
  /* Même raison, même remède : sans base fixe, « Administrateur » se lisait
     « Admir ». Un rôle à demi affiché est un rôle qu'on choisit au hasard. */
  .roule select[name='role'] { flex: 0 0 8rem; }
</style>
