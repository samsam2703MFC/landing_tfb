# Met le code à jour puis redémarre la landing. Déclenché à la main, ou par la
# clé de déploiement via /usr/local/bin/tfb-update-trigger (§9.3 pour le montage
# SSH, identique à celui de la sync).
#
#   sudo cp deploy/tfb-update.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#
# À la demande :
#   sudo systemctl start tfb-update.service && journalctl -u tfb-update -f

[Unit]
Description=TFB — met le code de la landing à jour et redémarre le service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# root, contrairement à la sync : ce service fait `systemctl restart` et écrit
# dans node_modules. Le script, lui, refuse de travailler sur un dépôt modifié.
User=root
WorkingDirectory=/var/www/landing_tfb
EnvironmentFile=/etc/tfb/landing.env

ExecStart=/usr/local/bin/tfb-update

# Une installation de dépendances plus un build : large, mais borné.
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
